//@version=6
indicator("Stock 1H - Structure & Planning (Dashboard)", overlay=true)

//===================== INPUTS =====================
tf1h            = input.timeframe("60", "1H timeframe (fixed)")
tf4h            = input.timeframe("240", "4H timeframe (for alignment)")
pivL            = input.int(3, "Pivot left", minval=1)
pivR            = input.int(3, "Pivot right", minval=1)

ema20Len        = input.int(20, "EMA20", minval=5)
ema50Len        = input.int(50, "EMA50", minval=10)
sma200Len       = input.int(200, "SMA200", minval=50)

atrLen          = input.int(14, "ATR len", minval=5)
anchorMidPct    = input.float(0.35, "Anchor 'Around' band (%)", step=0.05)

rangeN          = input.int(60, "1H range lookback", minval=20)
nearEdgePct     = input.float(18.0, "Near edge if within (%) of range", step=1.0)
nearLevelPct    = input.float(1.0, "Near SMA200/swing threshold (%)", step=0.1)

showDash        = input.bool(true, "Show dashboard")
pos             = input.string("Top Right", "Table position", options=["Top Right","Top Left","Bottom Right","Bottom Left"])
vis             = input.int(20, "Table transparency (0-90)", minval=0, maxval=90)

//===================== HELPERS =====================
f_pos(p) => p == "Top Right" ? position.top_right : p == "Top Left" ? position.top_left : p == "Bottom Right" ? position.bottom_right : position.bottom_left

f_anchorState(price, anchor) =>
    band = anchor * (anchorMidPct / 100.0)
    price > anchor + band ? "Above" : price < anchor - band ? "Below" : "Around"

f_locRange(price, priorHi, priorLo, hi, lo) =>
    rng = hi - lo
    rng == 0 ? "Mid-range" :
     (not na(priorHi) and price > priorHi) ? "Breaking range (Up)" :
     (not na(priorLo) and price < priorLo) ? "Breaking range (Down)" :
     ((price - lo) / rng) * 100.0 <= nearEdgePct ? "Near support" :
     ((hi - price) / rng) * 100.0 <= nearEdgePct ? "Near resistance" :
     "Mid-range"

f_locSma200(price, sma200) =>
    (na(price) or na(sma200) or price == 0) ? "Mid-range" :
     (math.abs(price - sma200) / price) * 100.0 <= nearLevelPct ? (price > sma200 ? "At support" : "At resistance") : "Mid-range"

f_locSwing(price, swingRes, swingSup) =>
    (not na(swingSup) and price != 0 and math.abs(price - swingSup) / price * 100.0 <= nearLevelPct) ? "At support" :
     (not na(swingRes) and price != 0 and math.abs(price - swingRes) / price * 100.0 <= nearLevelPct) ? "At resistance" :
     (not na(swingRes) and price > swingRes) ? "Breaking range (Up)" :
     (not na(swingSup) and price < swingSup) ? "Breaking range (Down)" :
     "Mid-range"

f_pack3(a, b, c) => "M1: " + a + "\nM2: " + b + "\nM3: " + c

//===================== 1H SERIES =====================
c1  = request.security(syminfo.tickerid, tf1h, close)
o1  = request.security(syminfo.tickerid, tf1h, open)
h1  = request.security(syminfo.tickerid, tf1h, high)
l1  = request.security(syminfo.tickerid, tf1h, low)

ema20_1  = request.security(syminfo.tickerid, tf1h, ta.ema(close, ema20Len))
ema50_1  = request.security(syminfo.tickerid, tf1h, ta.ema(close, ema50Len))
sma200_1 = request.security(syminfo.tickerid, tf1h, ta.sma(close, sma200Len))
atr1     = request.security(syminfo.tickerid, tf1h, ta.atr(atrLen))

rangeHi1 = request.security(syminfo.tickerid, tf1h, ta.highest(high, rangeN))
rangeLo1 = request.security(syminfo.tickerid, tf1h, ta.lowest(low, rangeN))

//===================== MICRO STRUCTURE (3 METHODS) =====================
// M1: pivots
ph1 = request.security(syminfo.tickerid, tf1h, ta.pivothigh(high, pivL, pivR))
pl1 = request.security(syminfo.tickerid, tf1h, ta.pivotlow(low, pivL, pivR))
lastPH1 = ta.valuewhen(not na(ph1), ph1, 0)
prevPH1 = ta.valuewhen(not na(ph1), ph1, 1)
lastPL1 = ta.valuewhen(not na(pl1), pl1, 0)
prevPL1 = ta.valuewhen(not na(pl1), pl1, 1)

isHH1 = not na(lastPH1) and not na(prevPH1) and lastPH1 > prevPH1
isLH1 = not na(lastPH1) and not na(prevPH1) and lastPH1 < prevPH1
isHL1 = not na(lastPL1) and not na(prevPL1) and lastPL1 > prevPL1
isLL1 = not na(lastPL1) and not na(prevPL1) and lastPL1 < prevPL1
structureM1 = (isHH1 and isHL1) ? "HH/HL" : (isLL1 and isLH1) ? "LL/LH" : "Mixed"

// M2: EMA20 slope + price
slope20 = request.security(syminfo.tickerid, tf1h, ta.linreg(ta.ema(close, ema20Len), 10, 0) - ta.linreg(ta.ema(close, ema20Len), 10, 1))
structureM2 = (slope20 > 0 and c1 > ema20_1) ? "HH/HL" : (slope20 < 0 and c1 < ema20_1) ? "LL/LH" : "Mixed"

// M3: EMA20 vs EMA50 + price
structureM3 = (ema20_1 > ema50_1 and c1 > ema20_1) ? "HH/HL" : (ema20_1 < ema50_1 and c1 < ema20_1) ? "LL/LH" : "Mixed"

//===================== ANCHOR STATE (EMA20) =====================
anchorState = (na(c1) or na(ema20_1)) ? "---" : f_anchorState(c1, ema20_1)

//===================== RANGE STATE (heuristic) =====================
priorHi = request.security(syminfo.tickerid, tf1h, ta.highest(high, rangeN)[1])
priorLo = request.security(syminfo.tickerid, tf1h, ta.lowest(low, rangeN)[1])
validSwingRes1 = (not na(lastPH1) and lastPH1 > c1) ? lastPH1 : na
validSwingSup1 = (not na(lastPL1) and lastPL1 < c1) ? lastPL1 : na
loc1M1 = f_locRange(c1, priorHi, priorLo, rangeHi1, rangeLo1)
loc1M2 = f_locSma200(c1, sma200_1)
loc1M3 = f_locSwing(c1, validSwingRes1, validSwingSup1)

breaking = (not na(priorHi) and c1 > priorHi) or (not na(priorLo) and c1 < priorLo)

rng = rangeHi1 - rangeLo1
posPct = rng == 0 ? 50.0 : ((c1 - rangeLo1) / rng) * 100.0
nearHigh = posPct >= (100.0 - nearEdgePct)
nearLow  = posPct <= nearEdgePct

// crude rejection: close back inside after probing near edge
rejectionHigh = nearHigh and h1 > c1 and c1 < rangeHi1
rejectionLow  = nearLow and l1 < c1 and c1 > rangeLo1
rejecting = (not breaking) and (rejectionHigh or rejectionLow)

rangeState =
     breaking ? "Breaking range" :
     rejecting ? "Rejecting level" :
     "Inside range"

//===================== 4H BIAS (for alignment) =====================
// Using stable MA-alignment on 4H
c4      = request.security(syminfo.tickerid, tf4h, close)
ema50_4 = request.security(syminfo.tickerid, tf4h, ta.ema(close, ema50Len))
sma200_4= request.security(syminfo.tickerid, tf4h, ta.sma(close, sma200Len))
bias4h  = (c4 > sma200_4 and ema50_4 > sma200_4) ? "Bullish" : (c4 < sma200_4 and ema50_4 < sma200_4) ? "Bearish" : "Neutral"

// 1H direction proxy (not a “Bias field” in UI, just to compute alignment)
dir1h =
     (c1 > ema20_1 and ema20_1 > ema20_1[1]) ? "Bullish" :
     (c1 < ema20_1 and ema20_1 < ema20_1[1]) ? "Bearish" :
     "Neutral"

alignment4h =
     (bias4h == "Neutral" or dir1h == "Neutral") ? "Minor pullback" :
     (bias4h == dir1h) ? "Aligned" :
     "Counter-trend"

//===================== INTRADAY LEVEL REACTION (what we can/can't do) =====================
// VWAP reclaim/loss: intraday vwap exists only on intraday series; might be na for some symbols.
vwap1 = request.security(syminfo.tickerid, tf1h, ta.vwap(hlc3))
vwapReaction =
     na(vwap1) ? "---" :
     (c1 > vwap1 and c1[1] < vwap1[1]) ? "VWAP reclaim" :
     (c1 < vwap1 and c1[1] > vwap1[1]) ? "VWAP loss" :
     "No clear"

// PDH/PDL can be computed from D
pdh = request.security(syminfo.tickerid, "D", high[1])
pdl = request.security(syminfo.tickerid, "D", low[1])
pdhpdlReaction =
     (na(pdh) or na(pdl)) ? "---" :
     (c1 > pdh) ? "Above PDH" :
     (c1 < pdl) ? "Below PDL" :
     "Inside PD range"

//===================== SETUP TYPE (AUTO HEURISTIC) =====================
setupType =
     (rangeState == "Breaking range" and c1 > priorHi) ? "Breakout hold" :
     (rangeState == "Breaking range" and c1 < priorLo) ? "Breakout hold" :
     (rangeState == "Breaking range" and vwapReaction == "VWAP loss") ? "Failed breakout" :
     (rangeState == "Rejecting level") ? "Rejection reversal" :
     "Pullback continuation"

//===================== RISK MODEL (AUTO HEURISTIC) =====================
atrPct1 = (c1 == 0 or atr1 == 0) ? na : (atr1 / c1) * 100.0
riskModel =
     na(atrPct1) ? "---" :
     (atrPct1 >= 1.8) ? "Volatility based" :
     (rangeState == "Rejecting level" or pdhpdlReaction != "Inside PD range") ? "Level based" :
     "Structure based"

//===================== TABLE =====================
bg   = color.new(color.black, vis)
kbg  = color.new(color.silver, vis)
txt  = color.new(color.white, vis)

var table t = table.new(f_pos(pos), 2, 12, border_width=1, frame_color=color.new(color.white, vis))

f_row(r, k, v) =>
    table.cell(t, 0, r, k, bgcolor=kbg, text_color=txt, text_halign=text.align_left)
    table.cell(t, 1, r, v, bgcolor=bg,  text_color=txt, text_halign=text.align_left)

if barstate.islast
    if showDash
        f_row(0,  "Structure", f_pack3(structureM1, structureM2, structureM3))
        f_row(1,  "Anchor state (EMA20)", anchorState)
        f_row(2,  "Range state", rangeState)
        f_row(3,  "Location", f_pack3(loc1M1, loc1M2, loc1M3))

        f_row(4,  "Intraday reaction: VWAP reclaim/loss", vwapReaction)
        f_row(5,  "Intraday reaction: PDH/PDL", pdhpdlReaction)

        f_row(6,  "Alignment with 4H", alignment4h)
        f_row(7,  "Setup type (auto)", setupType)
        f_row(8,  "Risk model (auto)", riskModel)

        supportLvl1 = not na(validSwingSup1) ? validSwingSup1 : ((not na(rangeLo1) and rangeLo1 < c1) ? rangeLo1 : na)
        resistLvl1  = not na(validSwingRes1) ? validSwingRes1 : ((not na(rangeHi1) and rangeHi1 > c1) ? rangeHi1 : na)
        f_row(9,  "Pivot S/R (suggest)", "S: " + (na(supportLvl1) ? "---" : str.tostring(supportLvl1, format.mintick)) + "\nR: " + (na(resistLvl1) ? "---" : str.tostring(resistLvl1, format.mintick)))
        f_row(10, "4H bias (ref)", bias4h)
        f_row(11, "1H dir proxy", dir1h)
    else
        table.clear(t, 0, 0, 1, 11)
