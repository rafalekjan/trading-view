//@version=6
indicator("ModMark Unified Template", overlay=true, max_labels_count=50)

// Inputs: table
showTable = input.bool(true, "Show table", group="Table")
showText = input.bool(true, "Show table text", group="Table")
showNumbers = input.bool(false, "Show numbers (debug)", group="Table")
visibilityPct = input.int(100, "Visibility 0-100", minval=0, maxval=100, group="Table")
fontSizeOpt = input.string("Tiny", "Font size", options=["Tiny", "Small", "Normal"], group="Table")
tablePos = input.string("Top Right", "Table position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group="Table")
tableMode = input.string("Full", "Table mode", options=["Summary", "Compact", "Full"], group="Table")
showWhenUnsupported = input.bool(true, "Show status on unsupported chart", group="Table")
showFrame = input.bool(true, "Show table frame", group="Table")
showBorders = input.bool(true, "Show cell borders", group="Table")
frameWidthInp = input.int(1, "Frame width", minval=0, maxval=5, group="Table")
borderWidthInp = input.int(1, "Cell border width", minval=0, maxval=5, group="Table")
frameColorInp = input.color(color.new(color.white, 0), "Frame color", group="Table")
borderColorInp = input.color(color.new(color.white, 0), "Cell border color", group="Table")

// Inputs: context
symbolScope = input.string("Any", "Symbol scope", options=["Any", "Market (SPY/QQQ only)", "Stock (exclude SPY/QQQ)"], group="Context")
useTfFilter = input.bool(true, "Enforce timeframe", group="Context")
requiredTf = input.timeframe("D", "Required timeframe", group="Context")
benchTicker = input.string("SPY", "Benchmark ticker (RS)", group="Context")

// Inputs: backend
pivotLR = input.int(3, "Swing pivot L/R", minval=1, maxval=20, group="Structure")
majorPivotLR = input.int(10, "Major pivot L/R", minval=3, maxval=50, group="Structure")
lookKeyLvls = input.int(252, "Key levels lookback", minval=50, maxval=1000, group="Structure")
slopeLen = input.int(10, "MA slope lookback", minval=2, maxval=100, group="Moving Averages")
flatSlopePct = input.float(0.08, "MA flat slope threshold (%)", minval=0.0, step=0.01, group="Moving Averages")
atrLen = input.int(14, "ATR length", minval=2, group="Volatility")
atrPctHigh = input.float(3.0, "ATR% high", minval=0.1, step=0.1, group="Volatility")
atrPctExtreme = input.float(5.0, "ATR% extreme", minval=0.1, step=0.1, group="Volatility")
atrJumpMult = input.float(1.6, "ATR jump multiplier", minval=1.0, step=0.1, group="Volatility")
nearLevelAtr = input.float(1.0, "Near structure if within ATR *", minval=0.1, step=0.1, group="Location")
extATR_20 = input.float(2.0, "Extended if |price-20EMA| >= ATR *", minval=0.5, step=0.1, group="Location")
extATR_50 = input.float(2.5, "Extended if |price-50SMA| >= ATR *", minval=0.5, step=0.1, group="Location")
rsLen = input.int(20, "RS lookback bars", minval=5, maxval=200, group="Momentum")
rsPullbackBars = input.int(5, "Benchmark pullback bars", minval=2, maxval=30, group="Momentum")
rsiLen = input.int(14, "RSI length", minval=2, group="Momentum")
rsiPivotLR = input.int(3, "RSI pivot L/R", minval=1, maxval=20, group="Momentum")
macdFast = input.int(12, "MACD fast", minval=1, group="Momentum")
macdSlow = input.int(26, "MACD slow", minval=2, group="Momentum")
macdSig = input.int(9, "MACD signal", minval=1, group="Momentum")
macdFlipLookback = input.int(60, "MACD flip lookback", minval=10, maxval=300, group="Momentum")
macdFlipWarn = input.int(10, "MACD flips warn if >=", minval=1, maxval=50, group="Momentum")
volMaLen = input.int(20, "Volume MA length", minval=5, group="Volume")
breakVolMult = input.float(1.2, "Breakout volume confirms if >= volMA *", minval=0.5, step=0.1, group="Volume")
wickWarnPct = input.float(55, "Sloppy if wick% >=", minval=0, maxval=100, step=1, group="Behavior")
sloppyLookback = input.int(30, "Sloppy lookback", minval=10, maxval=200, group="Behavior")
sloppyWarnCount = input.int(10, "Sloppy if count >=", minval=1, maxval=100, group="Behavior")
maxStopAtr = input.float(2.0, "Risk definable if stop distance <= ATR *", minval=0.5, step=0.1, group="Risk/Reward")
minRR_Accept = input.float(2.0, "RR acceptable >=", minval=1.0, step=0.1, group="Risk/Reward")
minRR_Strong = input.float(3.0, "RR strong >=", minval=1.0, step=0.1, group="Risk/Reward")
gapLookback = input.int(60, "Gap lookback", minval=20, maxval=400, group="Overnight")
gapPctWarn = input.float(1.0, "Gap% warning if >", minval=0.1, step=0.1, group="Overnight")
gapCountWarn = input.int(6, "Overnight unfriendly if gap-count >=", minval=1, maxval=50, group="Overnight")

// Context / eligibility
tickerU = str.upper(syminfo.ticker)
tickerIdU = str.upper(syminfo.tickerid)
isSpy = (tickerU == "SPY") or str.contains(tickerIdU, ":SPY")
isQqq = (tickerU == "QQQ") or str.contains(tickerIdU, ":QQQ")
isSpyQqq = isSpy or isQqq
tkr = syminfo.ticker

reqSec = timeframe.in_seconds(requiredTf)
curSec = timeframe.in_seconds(timeframe.period)
tfMatches = not useTfFilter or (not na(reqSec) and not na(curSec) and reqSec == curSec)
scopeMatches = symbolScope == "Any" ? true : symbolScope == "Market (SPY/QQQ only)" ? isSpyQqq : not isSpyQqq
ctxEligible = tfMatches and scopeMatches
ctxDebugTxt = "TF=" + timeframe.period + " req=" + requiredTf + " scope=" + symbolScope

// Helpers
pos = tablePos == "Top Left" ? position.top_left : tablePos == "Bottom Left" ? position.bottom_left : tablePos == "Bottom Right" ? position.bottom_right : position.top_right

slopePct(src, len) =>
    base = src[len]
    na(base) or base == 0.0 ? 0.0 : nz(100.0 * (src - base) / base)

clamp(x, lo, hi) =>
    math.max(lo, math.min(hi, x))

// Backend calculations
ema20 = ta.ema(close, 20)
sma50 = ta.sma(close, 50)
sma200 = ta.sma(close, 200)
ema20Slope = slopePct(ema20, slopeLen)
sma50Slope = slopePct(sma50, slopeLen)
sma200Slope = slopePct(sma200, slopeLen)
ema20Flat = math.abs(ema20Slope) < flatSlopePct
sma50Flat = math.abs(sma50Slope) < flatSlopePct
sma200Flat = math.abs(sma200Slope) < flatSlopePct
maShapeTxt = (ema20Flat and sma50Flat) ? "20/50 flat (chop risk)" : (ema20Slope > 0 and sma50Slope > 0) ? "20/50 sloped up" : (ema20Slope < 0 and sma50Slope < 0) ? "20/50 sloped down" : "20/50 mixed"

atr = ta.atr(atrLen)
atrPct = 100.0 * atr / close
atrMA = ta.sma(atr, 20)
atrJump = (not na(atrMA) and atrMA > 0) ? atr / atrMA : na
volTxt = atrPct >= atrPctExtreme ? "EXTREME volatility" : atrPct >= atrPctHigh ? "HIGH volatility" : "Controlled volatility"
unstableTxt = na(atrJump) ? "ATR stability N/A" : atrJump >= atrJumpMult ? "ATR unstable" : "ATR stable"

ph = ta.pivothigh(high, pivotLR, pivotLR)
pl = ta.pivotlow(low, pivotLR, pivotLR)
var float lastPH = na
var float prevPH = na
var float lastPL = na
var float prevPL = na
if not na(ph)
    prevPH := lastPH
    lastPH := ph
if not na(pl)
    prevPL := lastPL
    lastPL := pl
haveSwings = not na(lastPH) and not na(prevPH) and not na(lastPL) and not na(prevPL)
hh = haveSwings and lastPH > prevPH
lh = haveSwings and lastPH < prevPH
hl = haveSwings and lastPL > prevPL
ll = haveSwings and lastPL < prevPL
structureTxt = not haveSwings ? "Structure N/A" : (hh and hl) ? "Bull structure (HH+HL)" : (lh and ll) ? "Bear structure (LH+LL)" : "Overlapping / unclear (chop)"
dirTxt = not haveSwings ? "Direction N/A" : (hh and hl) ? "BULL" : (lh and ll) ? "BEAR" : "UNCLEAR"
structIntact = (hh and hl) ? close > lastPL : (lh and ll) ? close < lastPH : false
integrityTxt = not haveSwings ? "Integrity N/A" : structIntact ? "Structure intact" : "Structure broken"

mph = ta.pivothigh(high, majorPivotLR, majorPivotLR)
mpl = ta.pivotlow(low, majorPivotLR, majorPivotLR)
var float lastMajorH = na
var float lastMajorL = na
if not na(mph)
    lastMajorH := mph
if not na(mpl)
    lastMajorL := mpl
hiRef = ta.highest(high, lookKeyLvls)
loRef = ta.lowest(low, lookKeyLvls)
nearestLevelDist = na(atr) or atr == 0 ? na : math.min(math.min(math.abs(close - nz(lastPH, close)), math.abs(close - nz(lastPL, close))), math.min(math.abs(close - nz(lastMajorH, close)), math.abs(close - nz(lastMajorL, close)))) / atr
nearStructure = not na(nearestLevelDist) and nearestLevelDist <= nearLevelAtr
locationTxt = not haveSwings ? "Location N/A" : nearStructure ? "Near structure / key level" : "Far from structure"

bias200Txt = na(sma200) ? "200MA N/A" : close > sma200 ? "Above 200MA (long bias)" : close < sma200 ? "Below 200MA (short bias)" : "At 200MA"
pullbackRespect20 = not na(ema20) and low <= ema20 and close >= ema20
pullbackTxt = pullbackRespect20 ? "20EMA pullback respected" : "No clear 20EMA respect"
dist20ATR = atr > 0 ? math.abs(close - ema20) / atr : na
dist50ATR = atr > 0 ? math.abs(close - sma50) / atr : na
extended20 = not na(dist20ATR) and dist20ATR >= extATR_20
extended50 = not na(dist50ATR) and dist50ATR >= extATR_50
extendedTxt = (extended20 and extended50) ? "Extended vs 20EMA & 50MA" : extended20 ? "Extended vs 20EMA" : extended50 ? "Extended vs 50MA" : "Not extended"

rsi = ta.rsi(close, rsiLen)
rsiPH = ta.pivothigh(rsi, rsiPivotLR, rsiPivotLR)
rsiPL = ta.pivotlow(rsi, rsiPivotLR, rsiPivotLR)
var float lastRsiPH = na
var float prevRsiPH = na
var float lastRsiPL = na
var float prevRsiPL = na
if not na(rsiPH)
    prevRsiPH := lastRsiPH
    lastRsiPH := rsiPH
if not na(rsiPL)
    prevRsiPL := lastRsiPL
    lastRsiPL := rsiPL
haveRsiSwings = not na(lastRsiPH) and not na(prevRsiPH) and not na(lastRsiPL) and not na(prevRsiPL)
rsiLevelTxt = rsi > 50 ? "RSI > 50" : rsi < 50 ? "RSI < 50" : "RSI ~ 50"
rsiSwingsTxt = not haveRsiSwings ? "RSI swings N/A" : (lastRsiPL > prevRsiPL and lastRsiPH > prevRsiPH) ? "RSI HH+HL" : (lastRsiPL < prevRsiPL and lastRsiPH < prevRsiPH) ? "RSI LH+LL" : "RSI swings mixed"
rsiRecover = (rsi[3] < 50 and rsi > 50) or (rsi[3] < 55 and rsi > 55)
rsiRecoverTxt = rsiRecover ? "RSI recovered" : "No RSI recovery flag"
rsiConflict = (hh and hl and rsi < 50) or (lh and ll and rsi > 50)
divTxt = not (haveSwings and haveRsiSwings) ? "Divergence N/A" : (lastPL < prevPL and lastRsiPL > prevRsiPL) ? "Bull divergence warning" : (lastPH > prevPH and lastRsiPH < prevRsiPH) ? "Bear divergence warning" : "No divergence warning"

[macdLine, macdSignal, macdHist] = ta.macd(close, macdFast, macdSlow, macdSig)
macdTxt = macdLine > macdSignal and macdHist > 0 ? "MACD bullish momentum" : macdLine < macdSignal and macdHist < 0 ? "MACD bearish momentum" : "MACD mixed/flat"
macdFlip = ta.cross(macdLine, macdSignal)
macdFlipCount = math.sum(macdFlip ? 1.0 : 0.0, macdFlipLookback)
macdFlipTxt = macdFlipCount >= macdFlipWarn ? "MACD flips often" : "MACD flips not elevated"

volMA = ta.sma(volume, volMaLen)
priceUp = close > close[1]
volUp = volume > volMA
volumeTxt = priceUp and volUp ? "Rising price + rising volume" : priceUp and not volUp ? "Rising price + weak volume" : (not priceUp) and volUp ? "Down day + strong volume" : "Volume neutral"
breakAbove = haveSwings and close > lastPH
breakBelow = haveSwings and close < lastPL
breakVolTxt = not haveSwings ? "Breakout N/A" : breakAbove ? (volume >= volMA * breakVolMult ? "Breakout up + volume confirms" : "Breakout up but weak volume") : breakBelow ? (volume >= volMA * breakVolMult ? "Breakdown + volume confirms" : "Breakdown but weak volume") : "No active swing breakout"

rng = high - low
body = math.abs(close - open)
wickPct = rng > 0 ? 100.0 * (rng - body) / rng : 0.0
outsideBar = high > high[1] and low < low[1]
sloppyCandle = wickPct >= wickWarnPct
sloppyCount = math.sum(sloppyCandle ? 1.0 : 0.0, sloppyLookback)
outsideCount = math.sum(outsideBar ? 1.0 : 0.0, sloppyLookback)
behaviorTxt = (sloppyCount >= sloppyWarnCount or outsideCount >= math.ceil(sloppyWarnCount / 2)) ? "Sloppy / erratic behavior" : "Clean/controlled behavior"
consLen = 20
consRange = ta.highest(high, consLen) - ta.lowest(low, consLen)
consAtr = atr > 0 ? consRange / atr : na
consTxt = not na(consAtr) and consAtr <= 6.0 ? "Consolidation present" : "No clear consolidation"

gapPct = 100.0 * math.abs(open - close[1]) / close[1]
gapEvent = gapPct > gapPctWarn
gapCount = math.sum(gapEvent ? 1.0 : 0.0, gapLookback)
overnightTxt = gapCount >= gapCountWarn ? "Overnight unfriendly" : "Overnight acceptable"

benchClose = request.security(benchTicker, timeframe.period, close, barmerge.gaps_off, barmerge.lookahead_off)
rsRatio = not na(benchClose) and benchClose != 0 ? close / benchClose : na
rsSlope = slopePct(rsRatio, rsLen)
benchPullback = benchClose < benchClose[rsPullbackBars]
stockHeld = close >= close[rsPullbackBars]
rsTxt = na(benchClose) ? "RS N/A" : (rsSlope > 0 and benchPullback and stockHeld) ? "Relative strength (holding pullback)" : rsSlope > 0 ? "Relative strength improving" : rsSlope < 0 ? "Relative weakness" : "RS flat"

invalLong = lastPL
invalShort = lastPH
riskLong = atr > 0 and not na(invalLong) ? (close - invalLong) : na
riskShort = atr > 0 and not na(invalShort) ? (invalShort - close) : na
riskDefLong = not na(riskLong) and riskLong > 0 and (riskLong / atr <= maxStopAtr)
riskDefShort = not na(riskShort) and riskShort > 0 and (riskShort / atr <= maxStopAtr)
riskDefTxt = not haveSwings ? "Risk definition N/A" : (hh and hl) ? (riskDefLong ? "Risk definable (long)" : "Risk not clean (long)") : (lh and ll) ? (riskDefShort ? "Risk definable (short)" : "Risk not clean (short)") : "Risk weak (no direction)"
targetLong = math.min(nz(lastMajorH, hiRef), hiRef)
targetShort = math.max(nz(lastMajorL, loRef), loRef)
rewardLong = not na(targetLong) ? targetLong - close : na
rewardShort = not na(targetShort) ? close - targetShort : na
rrLong = not na(riskLong) and riskLong > 0 and not na(rewardLong) ? rewardLong / riskLong : na
rrShort = not na(riskShort) and riskShort > 0 and not na(rewardShort) ? rewardShort / riskShort : na
rrTxt = not haveSwings ? "Reward N/A" : (hh and hl) ? (na(rrLong) ? "RR N/A" : rrLong >= minRR_Strong ? "Reward strong (3:1+)" : rrLong >= minRR_Accept ? "Reward acceptable (2:1+)" : "Reward weak (<2:1)") : (lh and ll) ? (na(rrShort) ? "RR N/A" : rrShort >= minRR_Strong ? "Reward strong (3:1+)" : rrShort >= minRR_Accept ? "Reward acceptable (2:1+)" : "Reward weak (<2:1)") : "Reward unclear"
rrValue = (hh and hl) ? rrLong : (lh and ll) ? rrShort : na
rrDisplayTxt = showNumbers and not na(rrValue) ? rrTxt + " (" + str.tostring(rrValue, "#.##") + "x)" : rrTxt

// Unified decision model
volHardStop = atrPct >= atrPctExtreme or (not na(atrJump) and atrJump >= atrJumpMult)
hardNoDir = (not haveSwings) or ((not hh or not hl) and (not lh or not ll))
hardStruct = haveSwings and not structIntact
hardOvernight = gapCount >= gapCountWarn
hardStopActive = hardNoDir or hardStruct or volHardStop or hardOvernight
riskDefOk = (hh and hl and riskDefLong) or (lh and ll and riskDefShort)
rrWeak = (hh and hl and (na(rrLong) or rrLong < minRR_Accept)) or (lh and ll and (na(rrShort) or rrShort < minRR_Accept))
badLocation = not nearStructure
badExtended = extended20 or extended50
badMomentum = rsiConflict or macdFlipCount >= macdFlipWarn
warnChop = hardNoDir or (ema20Flat and sma50Flat) or macdFlipCount >= macdFlipWarn
warnChaos = sloppyCount >= sloppyWarnCount or outsideCount >= math.ceil(sloppyWarnCount / 2)

overallPenalty = (hardNoDir ? 35.0 : 0.0) + (hardStruct ? 35.0 : 0.0) + (volHardStop ? 30.0 : 0.0) + (hardOvernight ? 25.0 : 0.0) + (badLocation ? 12.0 : 0.0) + (badExtended ? 12.0 : 0.0) + (badMomentum ? 15.0 : 0.0) + (not riskDefOk ? 20.0 : 0.0) + (rrWeak ? 15.0 : 0.0) + ((not na(atrJump) and atrJump >= atrJumpMult) ? 10.0 : 0.0) + ((priceUp and not volUp) ? 8.0 : 0.0) + (warnChaos ? 10.0 : 0.0)
overallScore = clamp(100.0 - overallPenalty, 0.0, 100.0)
overallRank = hardStopActive ? 1 : overallScore >= 80 ? 4 : overallScore >= 65 ? 3 : overallScore >= 45 ? 2 : 1
overallTxt = overallRank == 4 ? "A TRADEABLE" : overallRank == 3 ? "B SELECTIVE" : overallRank == 2 ? "C DEFENSIVE" : "D NO-TRADE"
overallDisplayTxt = showNumbers ? overallTxt + " (" + str.tostring(overallScore, "#.##") + "/100)" : overallTxt

qualityTxt = hardStopActive ? "DO NOTHING (cash valid)" : (badExtended or badLocation) ? "B/C (location/extended caution)" : badMomentum ? "B/C (momentum caution)" : "A/B (supportive context)"
riskModeTxt = overallRank == 4 ? "NORMAL" : overallRank == 3 ? "REDUCED" : "DEFENSIVE"
riskPlanTxt = riskModeTxt == "NORMAL" ? "FULL" : riskModeTxt == "REDUCED" ? "HALF" : "NO TRADE"
riskModePlanTxt = riskModeTxt + " / " + riskPlanTxt
goNoGo = not hardStopActive and overallRank >= 3
decisionTxt = goNoGo ? "GO" : "NO-GO"

topBlockerTxt = volHardStop ? "Volatility EXTREME" : hardOvernight ? "Overnight risk elevated" : warnChop ? "CHOP conditions" : hardNoDir ? "Structure unclear / no trend" : badMomentum ? "Momentum conflict" : warnChaos ? "Chaos high" : badExtended ? "Price extended" : "None"
warning1Txt = badMomentum ? "Momentum conflict" : warnChaos ? "Chaos caution" : badExtended ? "Price extended" : badLocation ? "Far from structure" : not riskDefOk ? "Risk definition weak" : rrWeak ? "Reward/RR weak" : "None"
warning2Txt = warning1Txt != "Chaos caution" and warnChaos ? "Chaos caution" : warning1Txt != "Momentum conflict" and badMomentum ? "Momentum conflict" : warning1Txt != "Price extended" and badExtended ? "Price extended" : "None"
warningsTxt = warning1Txt == "None" ? "None" : warning2Txt == "None" ? warning1Txt : warning1Txt + " | " + warning2Txt
waitForTxt = topBlockerTxt == "Volatility EXTREME" ? "Wait: ATR/volatility cools down" : topBlockerTxt == "Overnight risk elevated" ? "Wait: gaps normalize" : topBlockerTxt == "CHOP conditions" ? "Wait: clearer trend and follow-through" : topBlockerTxt == "Structure unclear / no trend" ? "Wait: clear HH/HL or LH/LL" : topBlockerTxt == "Momentum conflict" ? "Wait: RSI and MACD align" : topBlockerTxt == "Chaos high" ? "Wait: cleaner candles" : topBlockerTxt == "Price extended" ? "Wait: pullback toward EMA/SMA" : "No unlock condition needed"
nextStepTxt = not goNoGo ? "Wait for unlock conditions" : riskModeTxt == "NORMAL" ? "Proceed to setup planning" : "Proceed with reduced risk"

decisionSev = goNoGo ? 2 : 0
overallSev = overallRank == 4 ? 2 : overallRank == 3 ? 1 : 0
riskModeSev = riskModeTxt == "NORMAL" ? 2 : riskModeTxt == "REDUCED" ? 1 : 0
riskPlanSev = riskPlanTxt == "FULL" ? 2 : riskPlanTxt == "HALF" ? 1 : 0
riskModePlanSev = math.min(riskModeSev, riskPlanSev)
qualitySev = str.contains(qualityTxt, "A/B") ? 2 : str.contains(qualityTxt, "B/C") ? 1 : 0
overallQualitySev = math.min(overallSev, qualitySev)
overallQualityTxt = overallDisplayTxt + " | " + qualityTxt
blockersSev = topBlockerTxt == "None" ? 2 : 0
warningsSev = warning1Txt == "None" ? 2 : 1
waitForSev = blockersSev == 2 and warningsSev == 2 ? 2 : 1
nextStepSev = not goNoGo ? 0 : riskModeTxt == "NORMAL" ? 2 : 1
volSev = volHardStop ? 0 : atrPct >= atrPctHigh ? 1 : 2
overnightSev = hardOvernight ? 0 : gapCount >= math.max(1, gapCountWarn - 2) ? 1 : 2
riskDefSev = not haveSwings ? 1 : riskDefOk ? 2 : 0
rrSev = not haveSwings ? 1 : rrWeak ? 0 : 2

// Table lifecycle
var table t = na
var int rowsActive = 0
isSummaryMode = tableMode == "Summary"
isFullMode = tableMode == "Full"
rowsSummary = 9
rowsCompactExtra = 16
rowsFullExtra = 17
rowsSupported = isSummaryMode ? rowsSummary : isFullMode ? rowsSummary + rowsCompactExtra + rowsFullExtra : rowsSummary + rowsCompactExtra
rowsUnsupported = showWhenUnsupported ? 5 : 0
rowsTarget = ctxEligible ? rowsSupported : rowsUnsupported
panelEnabled = showTable and rowsTarget > 0

visPctNow = float(math.max(0, math.min(100, visibilityPct)))
visAlphaNow = int(math.round(100.0 - visPctNow))
textColorNow = showText ? color.new(chart.fg_color, visAlphaNow) : color.new(chart.fg_color, 100)
rowBgAlphaNow = int(math.round(100.0 - visPctNow * 0.30))
sectionBgAlphaNow = int(math.round(100.0 - visPctNow * 0.45))
rowBgColorNow = color.new(color.black, rowBgAlphaNow)
sectionBgColorNow = color.new(color.gray, sectionBgAlphaNow)
frameColorNow = color.new(frameColorInp, visAlphaNow)
borderColorNow = color.new(borderColorInp, visAlphaNow)
textSizeNow = fontSizeOpt == "Tiny" ? size.tiny : fontSizeOpt == "Small" ? size.small : size.normal
emphTextColorNow = showText ? color.new(color.white, visAlphaNow) : color.new(color.white, 100)
statusAlphaNow = int(math.min(95, visAlphaNow + 35))
goodBgColorNow = color.new(color.green, statusAlphaNow)
warnBgColorNow = color.new(color.orange, statusAlphaNow)
badBgColorNow = color.new(color.red, statusAlphaNow)

bgFromSev(_sev) =>
    _sev == 2 ? goodBgColorNow : _sev == 1 ? warnBgColorNow : badBgColorNow

statusTag(_sev) =>
    _sev == 2 ? "OK" : _sev == 1 ? "WARN" : "BAD"

setRow(_r, _k, _v) =>
    table.cell(t, 0, _r, _k, text_halign=text.align_left, text_color=textColorNow, bgcolor=rowBgColorNow, text_size=textSizeNow)
    table.cell(t, 1, _r, "-", text_halign=text.align_center, text_color=textColorNow, bgcolor=rowBgColorNow, text_size=textSizeNow)
    table.cell(t, 2, _r, _v, text_halign=text.align_left, text_color=textColorNow, bgcolor=rowBgColorNow, text_size=textSizeNow)

setHeader(_r, _txt) =>
    table.cell(t, 0, _r, _txt, text_halign=text.align_left, text_color=textColorNow, bgcolor=sectionBgColorNow, text_size=textSizeNow)
    table.cell(t, 1, _r, "", text_halign=text.align_left, text_color=textColorNow, bgcolor=sectionBgColorNow, text_size=textSizeNow)
    table.cell(t, 2, _r, "", text_halign=text.align_left, text_color=textColorNow, bgcolor=sectionBgColorNow, text_size=textSizeNow)
    table.merge_cells(t, 0, _r, 2, _r)

setRowStatus(_r, _k, _sev, _v) =>
    _bg = bgFromSev(_sev)
    table.cell(t, 0, _r, _k, text_halign=text.align_left, text_color=emphTextColorNow, bgcolor=_bg, text_size=textSizeNow)
    table.cell(t, 1, _r, statusTag(_sev), text_halign=text.align_center, text_color=emphTextColorNow, bgcolor=_bg, text_size=textSizeNow)
    table.cell(t, 2, _r, _v, text_halign=text.align_left, text_color=emphTextColorNow, bgcolor=_bg, text_size=textSizeNow)

if barstate.islast
    if not panelEnabled
        if not na(t)
            table.delete(t)
            t := na
            rowsActive := 0
    else
        if na(t) or rowsActive != rowsTarget
            if not na(t)
                table.delete(t)
            t := table.new(pos, 3, rowsTarget, frame_width=1, border_width=1, frame_color=frameColorInp, border_color=borderColorInp)
            rowsActive := rowsTarget

        table.set_position(t, pos)
        table.set_frame_color(t, frameColorNow)
        table.set_border_color(t, borderColorNow)
        table.set_frame_width(t, showFrame and visibilityPct > 0 ? frameWidthInp : 0)
        table.set_border_width(t, showBorders and visibilityPct > 0 ? borderWidthInp : 0)

        atrStatsTxt = showNumbers ? "ATR% " + str.tostring(atrPct, "#.##") + " | jump x" + str.tostring(atrJump, "#.##") : volTxt + " | " + unstableTxt
        benchmarkDisplayTxt = showNumbers ? benchTicker + " | RS slope " + str.tostring(rsSlope, "#.##") + "%" : rsTxt

        r = 0
        if not ctxEligible
            setRow(r, "Unified -> " + timeframe.period, tkr)
            r += 1
            setRow(r, "Status", "Unsupported context")
            r += 1
            setRow(r, "Required TF", useTfFilter ? requiredTf : "Any")
            r += 1
            setRow(r, "Required Scope", symbolScope)
            r += 1
            setRow(r, "Detected", ctxDebugTxt)
        else
            setRow(r, "Unified -> " + timeframe.period, tkr)
            r += 1
            setHeader(r, "--- SUMMARY ---")
            r += 1
            setRowStatus(r, "Decision", decisionSev, decisionTxt)
            r += 1
            setRowStatus(r, "Overall / Quality", overallQualitySev, overallQualityTxt)
            r += 1
            setRowStatus(r, "Risk Mode / Plan", riskModePlanSev, riskModePlanTxt)
            r += 1
            setRowStatus(r, "Top Blocker", blockersSev, topBlockerTxt)
            r += 1
            setRowStatus(r, "Warnings", warningsSev, warningsTxt)
            r += 1
            setRowStatus(r, "Wait For", waitForSev, waitForTxt)
            r += 1
            setRowStatus(r, "Next Step", nextStepSev, nextStepTxt)
            r += 1

            if not isSummaryMode
                setHeader(r, "--- STRUCTURE ---")
                r += 1
                setRow(r, "Direction", dirTxt)
                r += 1
                setRow(r, "Structure", structureTxt)
                r += 1
                setRow(r, "Integrity", integrityTxt)
                r += 1
                setRow(r, "Location", locationTxt)
                r += 1
                setRow(r, "Extended", extendedTxt)
                r += 1
                setRow(r, "200MA Bias", bias200Txt)
                r += 1

                setHeader(r, "--- MOMENTUM ---")
                r += 1
                setRow(r, "Relative Strength", rsTxt)
                r += 1
                setRow(r, "RSI", rsiLevelTxt)
                r += 1
                setRow(r, "MACD", macdTxt)
                r += 1

                setHeader(r, "--- RISK / OVERNIGHT ---")
                r += 1
                setRowStatus(r, "Volatility", volSev, volTxt)
                r += 1
                setRowStatus(r, "Overnight", overnightSev, overnightTxt)
                r += 1
                setRowStatus(r, "Risk Definition", riskDefSev, riskDefTxt)
                r += 1
                setRowStatus(r, "Reward / RR", rrSev, rrDisplayTxt)
                r += 1

                if isFullMode
                    setHeader(r, "--- VALIDATION ---")
                    r += 1
                    setRow(r, "Volume", volumeTxt)
                    r += 1
                    setRow(r, "Breakout Volume", breakVolTxt)
                    r += 1
                    setRow(r, "ATR Stability", unstableTxt)
                    r += 1
                    setRow(r, "Behavior", behaviorTxt)
                    r += 1

                    setHeader(r, "--- BEHAVIOR ---")
                    r += 1
                    setRow(r, "Consolidation", consTxt)
                    r += 1
                    setRow(r, "MA Shape", maShapeTxt)
                    r += 1

                    setHeader(r, "--- DETAILS ---")
                    r += 1
                    setRow(r, "20EMA Pullback", pullbackTxt)
                    r += 1
                    setRow(r, "RSI Swings", rsiSwingsTxt)
                    r += 1
                    setRow(r, "RSI Recover", rsiRecoverTxt)
                    r += 1
                    setRow(r, "RSI Divergence", divTxt)
                    r += 1
                    setRow(r, "MACD Flips", macdFlipTxt)
                    r += 1
                    setRow(r, "ATR Stats", atrStatsTxt)
                    r += 1
                    setRow(r, "Benchmark", benchmarkDisplayTxt)
                    r += 1
                    setRow(r, "Score", showNumbers ? str.tostring(overallScore, "#.##") + "/100" : overallTxt)
                    r += 1
