//@version=6
indicator("ModMark Stock 4H", overlay=true, max_labels_count=50)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// INPUTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
groupTable = "Table"
showTable     = input.bool(true, "Show table", group=groupTable)
visibilityPct = input.int(85, "Visibility (0-100)", minval=0, maxval=100, group=groupTable)
tablePos      = input.string("Top Right", "Position", options=["Top Right","Top Left","Bottom Right","Bottom Left"], group=groupTable)
tableMode     = input.string("Summary", "Mode", options=["Summary","Compact","Full"], group=groupTable)
showNumbers   = input.bool(false, "Show numbers (debug)", group=groupTable)
fontSizeOpt   = input.string("Tiny", "Font size", options=["Tiny","Small","Normal"], group=groupTable)
summaryCaseOpt = input.string("Original", "Summary text case", options=["Original","UPPER","lower"], group=groupTable)
summaryGoodInp = input.color(color.new(color.lime, 0), "Summary GOOD bg", group=groupTable)
summaryWarnInp = input.color(color.new(color.orange, 0), "Summary WARN bg", group=groupTable)
summaryBadInp  = input.color(color.new(color.red, 0), "Summary BAD bg", group=groupTable)

groupStruct = "Structure"
pivotLR      = input.int(3,  "Swing pivot L/R", minval=1, maxval=20, group=groupStruct)
minorPivotLR = input.int(2,  "Minor pivot L/R (confirmation)", minval=1, maxval=10, group=groupStruct)
majorPivotLR = input.int(10, "Major pivot L/R (targets/levels)", minval=3, maxval=60, group=groupStruct)
followBars   = input.int(2,  "Follow-through bars", minval=1, maxval=10, group=groupStruct)
pivotTolAtr  = input.float(0.15, "Swing tolerance (ATR, wick filter)", minval=0.0, step=0.05, group=groupStruct)

groupMA = "Moving Averages"
maSlopeLen   = input.int(10, "MA slope lookback", minval=2, maxval=100, group=groupMA)
flatSlopePct = input.float(0.10, "MA flat slope threshold (%)", minval=0.0, step=0.01, group=groupMA)

groupVol = "ATR / Volatility"
atrLen        = input.int(14, "ATR length", minval=2, group=groupVol)
atrPctHigh    = input.float(2.5, "ATR% HIGH", minval=0.1, step=0.1, group=groupVol)
atrPctExtreme = input.float(4.0, "ATR% EXTREME", minval=0.1, step=0.1, group=groupVol)

groupLoc = "Location / Extended"
nearLevelAtr = input.float(1.0, "Near level if within ATR *", minval=0.1, step=0.1, group=groupLoc)
extATR_20     = input.float(2.0, "Extended if |price-20EMA| ≥ ATR *", minval=0.5, step=0.1, group=groupLoc)
extATR_50     = input.float(2.5, "Extended if |price-50SMA| ≥ ATR *", minval=0.5, step=0.1, group=groupLoc)

groupMom = "RSI / MACD"
rsiLen     = input.int(14, "RSI length", minval=2, group=groupMom)
rsiPivotLR = input.int(3,  "RSI pivot L/R", minval=1, maxval=20, group=groupMom)
macdFast   = input.int(12, "MACD fast", minval=1, group=groupMom)
macdSlow   = input.int(26, "MACD slow", minval=2, group=groupMom)
macdSig    = input.int(9,  "MACD signal", minval=1, group=groupMom)
macdFlipLB = input.int(60, "MACD flip lookback", minval=10, maxval=300, group=groupMom)
macdFlipWarn = input.int(10, "MACD flips warn if ≥", minval=1, maxval=60, group=groupMom)

groupVolm = "Volume"
volMaLen     = input.int(20, "Volume MA length", minval=5, group=groupVolm)
breakVolMult = input.float(1.2, "Breakout volume confirms if ≥ volMA *", minval=0.5, step=0.1, group=groupVolm)
pullbackBars = input.int(4, "Pullback window bars", minval=2, maxval=20, group=groupVolm)

groupRR = "Risk / Reward"
maxStopAtr   = input.float(2.0, "Risk definable if stop distance ≤ ATR *", minval=0.5, step=0.1, group=groupRR)
minRR_Accept = input.float(2.0, "RR acceptable ≥", minval=1.0, step=0.1, group=groupRR)
minRR_Strong = input.float(3.0, "RR strong ≥", minval=1.0, step=0.1, group=groupRR)

groupMTF = "Daily alignment (optional)"
useDailyAlignment = input.bool(true, "Use Daily direction alignment", group=groupMTF)
dailyPivotLR = input.int(3, "Daily swing pivot L/R", minval=1, maxval=20, group=groupMTF)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CONTEXT GATING: only 4H and not SPY/QQQ
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
tkr = syminfo.ticker
isSpy = (tkr == "SPY") or str.contains(syminfo.tickerid, ":SPY")
isQqq = (tkr == "QQQ") or str.contains(syminfo.tickerid, ":QQQ")
isSpyQqq = isSpy or isQqq

// 4H detection (TV commonly uses 240 for 4h)
is4H = (timeframe.isminutes and timeframe.multiplier == 240) or (timeframe.period == "240")
ctxEligible = showTable and is4H and not isSpyQqq

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// UI HELPERS (visibility + border)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
pos =
     tablePos == "Top Left" ? position.top_left :
     tablePos == "Bottom Left" ? position.bottom_left :
     tablePos == "Bottom Right" ? position.bottom_right :
     position.top_right

visPct = math.max(0, math.min(100, visibilityPct))
bgAlpha = int(math.round(100.0 - visPct))
txtAlpha = int(math.min(90, bgAlpha + 10))
bgBase  = color.new(color.black, bgAlpha)
headBg  = color.new(color.gray, math.min(100, bgAlpha + 5))
goodBg  = color.new(color.lime,  math.min(100, bgAlpha + 10))
warnBg  = color.new(color.orange,math.min(100, bgAlpha + 10))
badBg   = color.new(color.red,   math.min(100, bgAlpha + 10))
summaryGoodBg = color.new(summaryGoodInp, math.min(100, bgAlpha + 10))
summaryWarnBg = color.new(summaryWarnInp, math.min(100, bgAlpha + 10))
summaryBadBg  = color.new(summaryBadInp,  math.min(100, bgAlpha + 10))
txtCol  = color.new(color.white, txtAlpha)
textSizeNow = fontSizeOpt == "Tiny" ? size.tiny : fontSizeOpt == "Small" ? size.small : size.normal
frameCol = color.new(color.gray, bgAlpha)
borderCol = color.new(color.gray, bgAlpha)

slopePct(src, len) => nz(100.0 * (src - src[len]) / src[len])
isFlat(v) => math.abs(v) < flatSlopePct
summaryCase(_txt) => summaryCaseOpt == "UPPER" ? str.upper(_txt) : summaryCaseOpt == "lower" ? str.lower(_txt) : _txt

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// BACKEND CALCS (4H) — zgodnie z rolą "Structure & Planning" :contentReference[oaicite:1]{index=1}
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
ema20  = ta.ema(close, 20)
sma50  = ta.sma(close, 50)
sma200 = ta.sma(close, 200)

ema20Slope = slopePct(ema20, maSlopeLen)
sma50Slope = slopePct(sma50, maSlopeLen)
ema20Flat  = isFlat(ema20Slope)
sma50Flat  = isFlat(sma50Slope)

atr = ta.atr(atrLen)
atrPct = 100.0 * atr / close

// Swings (structure)
ph = ta.pivothigh(high, pivotLR, pivotLR)
pl = ta.pivotlow(low,  pivotLR, pivotLR)

var float lastPH = na
var float prevPH = na
var float lastPL = na
var float prevPL = na
if not na(ph)
    prevPH := lastPH
    lastPH := ph
if not na(pl)
    prevPL := lastPL
    lastPL := pl

haveSwings = not na(lastPH) and not na(prevPH) and not na(lastPL) and not na(prevPL)
pivotTol = atr * pivotTolAtr
hh = haveSwings and (lastPH > prevPH + pivotTol)
lh = haveSwings and (lastPH < prevPH - pivotTol)
hl = haveSwings and (lastPL > prevPL + pivotTol)
ll = haveSwings and (lastPL < prevPL - pivotTol)
hEq = haveSwings and not hh and not lh
lEq = haveSwings and not hl and not ll
bullStruct = haveSwings and hh and (hl or lEq)
bearStruct = haveSwings and ll and (lh or hEq)

directionClear = bullStruct or bearStruct
structureTxt =
     not haveSwings ? "Structure: N/A" :
     bullStruct ? "Structure: BULL (HH+HL)" :
     bearStruct ? "Structure: BEAR (LH+LL)" :
     "Structure: CHOP (overlap)"

// Pullback structure integrity (must not break thesis) :contentReference[oaicite:2]{index=2}
structIntact =
     not haveSwings ? false :
     bullStruct ? (close > lastPL) :
     bearStruct ? (close < lastPH) :
     false

pullbackTxt =
     not haveSwings ? "Pullback: N/A" :
     structIntact ? "Pullback: controlled (structure intact)" :
     "Pullback: breaks structure (quality down)"

// Confirmation on middle TF: HL + break minor high / LH + break minor low :contentReference[oaicite:3]{index=3}
mPH = ta.pivothigh(high, minorPivotLR, minorPivotLR)
mPL = ta.pivotlow(low,  minorPivotLR, minorPivotLR)
var float lastMinorH = na
var float lastMinorL = na
if not na(mPH)
    lastMinorH := mPH
if not na(mPL)
    lastMinorL := mPL

confirmLong = bullStruct and not na(lastMinorH) and close > lastMinorH
confirmShort= bearStruct and not na(lastMinorL) and close < lastMinorL
confirmTxt =
     not directionClear ? "Confirmation: N/A" :
     confirmLong ? "Confirmation: bull control (break minor high)" :
     confirmShort ? "Confirmation: bear control (break minor low)" :
     "Confirmation: not present (wait)"

// Key levels (major pivots) for targets/space/location :contentReference[oaicite:4]{index=4}
mph = ta.pivothigh(high, majorPivotLR, majorPivotLR)
mpl = ta.pivotlow(low,  majorPivotLR, majorPivotLR)
var float lastMajorH = na
var float lastMajorL = na
if not na(mph)
    lastMajorH := mph
if not na(mpl)
    lastMajorL := mpl

// Location near a logical level: swings / MAs :contentReference[oaicite:5]{index=5}
distToLevelATR(_lvl) => (atr > 0 and not na(_lvl)) ? math.abs(close - _lvl) / atr : na
d1 = distToLevelATR(lastPH)
d2 = distToLevelATR(lastPL)
d3 = distToLevelATR(lastMajorH)
d4 = distToLevelATR(lastMajorL)
d5 = distToLevelATR(ema20)
d6 = distToLevelATR(sma50)
d7 = distToLevelATR(sma200)

nearest = math.min(math.min(math.min(nz(d1, 1e9), nz(d2, 1e9)), math.min(nz(d3, 1e9), nz(d4, 1e9))), math.min(math.min(nz(d5, 1e9), nz(d6, 1e9)), nz(d7, 1e9)))
nearStructure = (atr > 0) and (nearest <= nearLevelAtr)

locationTxt =
     not haveSwings ? "Location: N/A" :
     nearStructure ? "Location: at structure/MA (good)" :
     "Location: middle of nowhere (wait)"

// Extended (avoid chasing impulse) :contentReference[oaicite:6]{index=6}
dist20ATR = (atr > 0) ? math.abs(close - ema20) / atr : na
dist50ATR = (atr > 0) ? math.abs(close - sma50) / atr : na
extended = (not na(dist20ATR) and dist20ATR >= extATR_20) or (not na(dist50ATR) and dist50ATR >= extATR_50)
extendedTxt = extended ? "Extended: YES (chasing risk)" : "Extended: NO"

// MAs context: slope/flat + bias 200 :contentReference[oaicite:7]{index=7}
maTxt =
     (ema20Flat and sma50Flat) ? "MA: flat (chop risk)" :
     (ema20Slope > 0 and sma50Slope > 0) ? "MA: sloped up" :
     (ema20Slope < 0 and sma50Slope < 0) ? "MA: sloped down" :
     "MA: mixed (transition)"

bias200Txt =
     na(sma200) ? "200MA: N/A" :
     close > sma200 ? "200MA: above (bias long if aligned)" :
     close < sma200 ? "200MA: below (bias short if aligned)" :
     "200MA: at (caution)"

// RSI (momentum confirmation) :contentReference[oaicite:8]{index=8}
rsi = ta.rsi(close, rsiLen)
rsiTxt =
     rsi >= 50 ? "RSI: bullish regime (≥50)" :
     rsi <= 40 ? "RSI: weak/bear (≤40)" :
     "RSI: mixed (40–50)"

// RSI swings (HL/LH heads-up)
rsiPH = ta.pivothigh(rsi, rsiPivotLR, rsiPivotLR)
rsiPL = ta.pivotlow(rsi,  rsiPivotLR, rsiPivotLR)
var float lastRsiPL = na
var float prevRsiPL = na
if not na(rsiPL)
    prevRsiPL := lastRsiPL
    lastRsiPL := rsiPL
haveRsiLows = not na(lastRsiPL) and not na(prevRsiPL)
rsiSwingsTxt =
     not haveRsiLows ? "RSI swings: N/A" :
     (lastRsiPL > prevRsiPL) ? "RSI swings: HL (ok)" :
     "RSI swings: not HL (caution)"

// MACD (momentum support + avoid flip-chop) :contentReference[oaicite:9]{index=9}
[macdLine, macdSigLine, macdHist] = ta.macd(close, macdFast, macdSlow, macdSig)
macdTxt =
     macdLine > macdSigLine and macdHist > 0 ? "MACD: bullish momentum" :
     macdLine < macdSigLine and macdHist < 0 ? "MACD: bearish momentum" :
     "MACD: mixed/flat"

macdFlip = ta.cross(macdLine, macdSigLine) ? 1 : 0
macdFlipCount = math.sum(macdFlip, macdFlipLB)
macdFlipTxt = macdFlipCount >= macdFlipWarn ? "MACD flips: HIGH (chop risk)" : "MACD flips: OK"

// Volume: impulse confirm + pullback dries up (healthy) + breakout participation :contentReference[oaicite:10]{index=10}
volMA = ta.sma(volume, volMaLen)
priceUp = close > close[1]
volUp   = volume > volMA

pullbackCountBull = math.sum(close < close[1] ? 1 : 0, pullbackBars)
pullbackCountBear = math.sum(close > close[1] ? 1 : 0, pullbackBars)
pullbackCount = bullStruct ? pullbackCountBull : bearStruct ? pullbackCountBear : pullbackCountBull
pullbackNow = pullbackCount >= math.ceil(pullbackBars * 0.6)
pullbackVolSma = ta.sma(volume, pullbackBars)
pullbackVolDry = pullbackNow and (pullbackVolSma < volMA)
volumeImpulse = (bullStruct and priceUp and volUp) or (bearStruct and (not priceUp) and volUp) or ((not bullStruct and not bearStruct) and priceUp and volUp)
volumeWeak = (bullStruct and priceUp and not volUp) or (bearStruct and (not priceUp) and not volUp) or ((not bullStruct and not bearStruct) and priceUp and not volUp)
volumeDirOk = (bullStruct and priceUp and volUp) or (bearStruct and (not priceUp) and volUp)

volumeTxt =
     volumeImpulse ? "Volume: impulse confirmed" :
     pullbackVolDry ? "Volume: pullback drying up (healthy)" :
     volumeWeak ? "Volume: weak participation (caution)" :
     "Volume: mixed"

// Breakout volume + follow-through + failed breaks (respect levels) :contentReference[oaicite:11]{index=11}
breakAbove = haveSwings and close > lastPH
breakBelow = haveSwings and close < lastPL

breakVolTxt =
     not haveSwings ? "Breakout: N/A" :
     breakAbove ? (volume >= volMA * breakVolMult ? "Breakout UP + volume confirms" : "Breakout UP but volume weak") :
     breakBelow ? (volume >= volMA * breakVolMult ? "Breakdown + volume confirms" : "Breakdown but volume weak") :
     "Breakout: none"

ftUp = haveSwings and breakAbove and (math.sum(close > lastPH ? 1 : 0, followBars) == followBars)
ftDn = haveSwings and breakBelow and (math.sum(close < lastPL ? 1 : 0, followBars) == followBars)

failUpNow = haveSwings and close[1] > lastPH and close < lastPH
failDnNow = haveSwings and close[1] < lastPL and close > lastPL
failedLB = 80
failedWarn = 4
failedCount = math.sum((failUpNow or failDnNow) ? 1 : 0, failedLB)

respectTxt =
     not haveSwings ? "Respect: N/A" :
     (ftUp or ftDn) ? "Respect: follow-through present" :
     (failedCount >= failedWarn) ? "Respect: many failed breakouts" :
     "Respect: mixed/neutral"

// Volatility text :contentReference[oaicite:12]{index=12}
volTxt =
     atrPct >= atrPctExtreme ? "Volatility: EXTREME (reduce/avoid)" :
     atrPct >= atrPctHigh ? "Volatility: HIGH (reduce size)" :
     "Volatility: controlled"

// Risk definition (clear invalidation on structure) :contentReference[oaicite:13]{index=13}
invalLong  = lastPL
invalShort = lastPH
riskLong   = (atr > 0 and not na(invalLong))  ? (close - invalLong) : na
riskShort  = (atr > 0 and not na(invalShort)) ? (invalShort - close) : na
riskDefLong  = not na(riskLong)  and riskLong  > 0 and (riskLong/atr <= maxStopAtr)
riskDefShort = not na(riskShort) and riskShort > 0 and (riskShort/atr <= maxStopAtr)

riskDefTxt =
     not haveSwings ? "Risk: N/A" :
     bullStruct ? (riskDefLong ? "Risk: definable (clear invalidation)" : "Risk: not clean (stop too wide)") :
     bearStruct ? (riskDefShort ? "Risk: definable (clear invalidation)" : "Risk: not clean (stop too wide)") :
     "Risk: unclear (no structure)"

// Reward justification + space (must be realistic) :contentReference[oaicite:14]{index=14}
// Use the nearest confirmed level in trade direction only.
// Long: nearest resistance above current price.
// Short: nearest support below current price.
longLvl1 = (not na(lastPH) and lastPH > close) ? lastPH : na
longLvl2 = (not na(lastMajorH) and lastMajorH > close) ? lastMajorH : na
targetLong =
     na(longLvl1) ? longLvl2 :
     na(longLvl2) ? longLvl1 :
     math.min(longLvl1, longLvl2)

shortLvl1 = (not na(lastPL) and lastPL < close) ? lastPL : na
shortLvl2 = (not na(lastMajorL) and lastMajorL < close) ? lastMajorL : na
targetShort =
     na(shortLvl1) ? shortLvl2 :
     na(shortLvl2) ? shortLvl1 :
     math.max(shortLvl1, shortLvl2)

rewardLong  = not na(targetLong)  ? (targetLong - close) : na
rewardShort = not na(targetShort) ? (close - targetShort) : na

rrLong  = (not na(riskLong)  and riskLong  > 0 and not na(rewardLong))  ? (rewardLong / riskLong) : na
rrShort = (not na(riskShort) and riskShort > 0 and not na(rewardShort)) ? (rewardShort / riskShort) : na

rrTxt =
     not haveSwings ? "Reward: N/A" :
     bullStruct ?
         (na(rrLong) ? "Reward: N/A" : rrLong >= minRR_Strong ? "Reward: strong (3:1+)" : rrLong >= minRR_Accept ? "Reward: acceptable (2:1+)" : "Reward: weak (<2:1)") :
     bearStruct ?
         (na(rrShort) ? "Reward: N/A" : rrShort >= minRR_Strong ? "Reward: strong (3:1+)" : rrShort >= minRR_Accept ? "Reward: acceptable (2:1+)" : "Reward: weak (<2:1)") :
     "Reward: unclear (no direction)"

spaceOk =
     not haveSwings ? false :
     bullStruct ? (not na(rewardLong) and rewardLong > atr) :
     bearStruct ? (not na(rewardShort) and rewardShort > atr) :
     false
spaceTxt =
     not haveSwings ? "Space: N/A" :
     spaceOk ? "Space: available (room to target)" :
     "Space: tight (reward constrained)"

// Daily alignment (optional): Daily direction vs 4H structure :contentReference[oaicite:15]{index=15}
f_daily_state() =>
    dPH = ta.pivothigh(high, dailyPivotLR, dailyPivotLR)
    dPL = ta.pivotlow(low,  dailyPivotLR, dailyPivotLR)
    var float dLastPH = na
    var float dPrevPH = na
    var float dLastPL = na
    var float dPrevPL = na
    if not na(dPH)
        dPrevPH := dLastPH
        dLastPH := dPH
    if not na(dPL)
        dPrevPL := dLastPL
        dLastPL := dPL
    dHave = not na(dLastPH) and not na(dPrevPH) and not na(dLastPL) and not na(dPrevPL)
    dHH = dHave and (dLastPH > dPrevPH)
    dLH = dHave and (dLastPH < dPrevPH)
    dHL = dHave and (dLastPL > dPrevPL)
    dLL = dHave and (dLastPL < dPrevPL)
    not dHave ? "Daily: N/A" : (dHH and dHL) ? "Daily: BULL" : (dLH and dLL) ? "Daily: BEAR" : "Daily: CHOP"

dailyState = request.security(syminfo.tickerid, "D", f_daily_state(), barmerge.gaps_off, barmerge.lookahead_off)
dailyAlign =
     not useDailyAlignment ? true :
     (dailyState == "Daily: BULL" and (structureTxt == "Structure: BEAR (LH+LL)")) ? false :
     (dailyState == "Daily: BEAR" and (structureTxt == "Structure: BULL (HH+HL)")) ? false :
     true
dailyAlignTxt =
     not useDailyAlignment ? "Daily align: disabled" :
     (dailyState == "Daily: N/A") ? "Daily align: N/A" :
     dailyAlign ? "Daily align: OK" :
     "Daily align: CONFLICT (wait)"

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// PLANNING LAYER (4H planability + blocker + unlock) :contentReference[oaicite:16]{index=16}
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
hardStop = (not directionClear) or (not structIntact) or (atrPct >= atrPctExtreme) or (not dailyAlign)
riskDefAny = bullStruct ? riskDefLong : bearStruct ? riskDefShort : false

// Overnight proxy for 4H holding risk.
overnightHard = atrPct >= atrPctExtreme or failedCount >= failedWarn
overnightWarn = (not overnightHard) and (atrPct >= atrPctHigh or not directionClear or not structIntact or not riskDefAny)
overnightOk = not overnightHard and not overnightWarn

// Score model (0..100) aligned to blueprint buckets.
maAligned = (ema20Slope > 0 and sma50Slope > 0) or (ema20Slope < 0 and sma50Slope < 0)
momAlignedUp = bullStruct and rsi >= 50 and macdLine > macdSigLine and macdHist > 0
momAlignedDn = bearStruct and rsi <= 40 and macdLine < macdSigLine and macdHist < 0
rrValue = bullStruct ? rrLong : bearStruct ? rrShort : na

scoreStructure = directionClear and structIntact and not (ema20Flat and sma50Flat) ? 20.0 : directionClear and structIntact ? 12.0 : directionClear ? 6.0 : 0.0
scoreLocation = nearStructure and not extended ? 15.0 : (nearStructure or not extended) ? 8.0 : 0.0
scoreRespect = (ftUp or ftDn) and failedCount < failedWarn ? 10.0 : failedCount < failedWarn ? 5.0 : 0.0
scoreMA = maAligned and not (ema20Flat or sma50Flat) ? 10.0 : (not (ema20Flat and sma50Flat) ? 5.0 : 0.0)
scoreMomentum = (momAlignedUp or momAlignedDn) ? 10.0 : (((rsi >= 50 and macdLine > macdSigLine) or (rsi <= 40 and macdLine < macdSigLine)) ? 5.0 : 0.0)
scoreVolume = (volumeDirOk or pullbackVolDry) ? 5.0 : (volume > volMA ? 2.0 : 0.0)
scoreVolatility = atrPct < atrPctHigh ? 10.0 : atrPct < atrPctExtreme ? 5.0 : 0.0
scoreRisk = riskDefAny ? 10.0 : 0.0
scoreReward = (not na(rrValue) and rrValue >= minRR_Strong and spaceOk) ? 10.0 : (not na(rrValue) and rrValue >= minRR_Accept and spaceOk ? 6.0 : 0.0)
scoreOvernight = overnightOk ? 10.0 : (not overnightHard ? 5.0 : 0.0)

rawScore = scoreStructure + scoreLocation + scoreRespect + scoreMA + scoreMomentum + scoreVolume + scoreVolatility + scoreRisk + scoreReward + scoreOvernight
scoreCapped = rawScore
if not riskDefAny
    scoreCapped := math.min(scoreCapped, 40.0)
if not directionClear or not structIntact
    scoreCapped := math.min(scoreCapped, 50.0)
if atrPct >= atrPctExtreme
    scoreCapped := math.min(scoreCapped, 60.0)

overallScore = math.max(0.0, math.min(100.0, scoreCapped))
overallGrade = overallScore >= 80 ? "A" : overallScore >= 65 ? "B" : overallScore >= 50 ? "C" : "D"

planable = directionClear and structIntact and not hardStop
planSoft =
     planable and
     ((not nearStructure) or extended or (not riskDefAny) or (not spaceOk) or na(rrValue) or (rrValue < minRR_Accept) or overnightWarn or (macdFlipCount >= macdFlipWarn) or (ema20Flat and sma50Flat))
planabilityTxt = not planable ? "NO ❌ (do not drop lower)" : planSoft ? "CONDITIONAL ⚠️ (selective)" : "YES ✅ (plan-ready)"

locationSummaryTxt = extended ? "Extended (chasing risk)" : nearStructure ? "At level / MA (good)" : "Middle of nowhere"
riskClarityTxt = not haveSwings ? "N/A (waiting for swings)" : riskDefAny ? "Definable invalidation" : "Not clean / too wide"
targetSpaceTxt =
     not haveSwings ? "N/A" :
     (not na(rrValue) and rrValue >= minRR_Strong and spaceOk) ? "Strong (3:1+ + space)" :
     (not na(rrValue) and rrValue >= minRR_Accept and spaceOk) ? "Acceptable (2:1+ + space)" :
     spaceOk ? "Space OK, RR weak" :
     "Space tight / weak RR"
pullbackSummaryTxt = not haveSwings ? "N/A" : structIntact ? "Controlled" : "Breaks structure"
holdingSupportTxt = overnightHard ? "NO ❌" : overnightWarn ? "CAUTION ⚠️" : "OK ✅"
holdingFactorsTxt =
     overnightHard ? "ATR extreme or failed breaks elevated" :
     overnightWarn ? "High ATR or weak structure/risk clarity" :
     "Holding conditions stable"

// Top blocker & wait-for (“co przeszkadza / na co czekać”) :contentReference[oaicite:17]{index=17}
topIssueTxt =
     (atrPct >= atrPctExtreme) ? "Blocker: volatility extreme" :
     (not dailyAlign) ? "Blocker: conflicts with Daily" :
     (not directionClear) ? "Blocker: structure messy / overlap" :
     (not structIntact) ? "Blocker: pullback breaks structure" :
     (not riskDefAny) ? "Blocker: no clean invalidation" :
     overnightHard ? "Blocker: overnight risk elevated" :
     (failedCount >= failedWarn) ? "Blocker: many failed breakouts" :
     (ema20Flat and sma50Flat) ? "Blocker: MAs flat (chop)" :
     (macdFlipCount >= macdFlipWarn) ? "Blocker: MACD flips (chop)" :
     (not nearStructure) ? "Blocker: middle of nowhere" :
     extended ? "Blocker: extended (no chase)" :
     (rrTxt == "Reward: weak (<2:1)") ? "Blocker: reward weak" :
     (not spaceOk) ? "Blocker: no space to target" :
     "No major blocker"

waitForTxt =
     (atrPct >= atrPctExtreme) ? "Wait: volatility cool-down" :
     (not dailyAlign) ? "Wait: 4H aligns back with Daily" :
     (not directionClear) ? "Wait: clean HH/HL or LH/LL forms" :
     (not structIntact) ? "Wait: structure rebuild (new swing)" :
     (not riskDefAny) ? "Wait: clear invalidation prints" :
     overnightHard ? "Wait: overnight conditions stabilize" :
     (failedCount >= failedWarn) ? "Wait: follow-through / fewer fails" :
     (ema20Flat and sma50Flat) ? "Wait: MA slope returns" :
     (macdFlipCount >= macdFlipWarn) ? "Wait: momentum stabilizes" :
     (not nearStructure) ? "Wait: return to level/MA (location)" :
     extended ? "Wait: pullback/base near 20/50" :
     (rrTxt == "Reward: weak (<2:1)") ? "Wait: better location improves RR" :
     (not spaceOk) ? "Wait: more room to next level" :
     "Wait: none"

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// TABLE RENDERING (border + visibility)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
isSummary = tableMode == "Summary"
isCompact = tableMode == "Compact"
isFull    = tableMode == "Full"
scoreInSummary = showNumbers or not isSummary

rowsSummary = 10 + (scoreInSummary ? 1 : 0)
rowsCompact = rowsSummary + 22
rowsFull    = rowsCompact + (showNumbers ? 5 : 0)
rowsTarget  = isSummary ? rowsSummary : isCompact ? rowsCompact : rowsFull

var table t = na
var int lastRows = na

newTable() =>
    table.new(pos, 2, rowsTarget, border_width=1, frame_width=1, border_color=borderCol, frame_color=frameCol)

setHeader(_r, _txt) =>
    table.cell(t, 0, _r, _txt, bgcolor=headBg, text_color=txtCol, text_halign=text.align_left, text_size=textSizeNow)
    table.cell(t, 1, _r, "", bgcolor=headBg, text_size=textSizeNow)
    table.merge_cells(t, 0, _r, 1, _r)

setRow(_r, _k, _v, _bg) =>
    table.cell(t, 0, _r, _k, bgcolor=bgBase, text_color=txtCol, text_halign=text.align_left, text_size=textSizeNow)
    table.cell(t, 1, _r, _v, bgcolor=bgBase, text_color=txtCol, text_halign=text.align_left, text_size=textSizeNow)

setRowStatus(_r, _k, _v, _bg) =>
    table.cell(t, 0, _r, _k, bgcolor=_bg, text_color=txtCol, text_halign=text.align_left, text_size=textSizeNow)
    table.cell(t, 1, _r, _v, bgcolor=_bg, text_color=txtCol, text_halign=text.align_left, text_size=textSizeNow)

if barstate.islast
    if not ctxEligible
        if not na(t)
            table.delete(t)
            t := na
            lastRows := na
    else
        if na(t) or (lastRows != rowsTarget)
            if not na(t)
                table.delete(t)
            t := newTable()
            lastRows := rowsTarget

        table.set_frame_color(t, frameCol)
        table.set_border_color(t, borderCol)
        table.set_frame_width(t, visPct > 0 ? 1 : 0)
        table.set_border_width(t, visPct > 0 ? 1 : 0)

        overallBg = overallGrade == "A" ? summaryGoodBg : overallGrade == "B" ? summaryWarnBg : overallGrade == "C" ? summaryWarnBg : summaryBadBg
        planabilityBg = not planable ? summaryBadBg : planSoft ? summaryWarnBg : summaryGoodBg
        locationSummaryBg = nearStructure and not extended ? summaryGoodBg : summaryWarnBg
        riskClarityBg = not haveSwings ? summaryWarnBg : riskDefAny ? summaryGoodBg : summaryBadBg
        targetSpaceStrong = haveSwings and not na(rrValue) and rrValue >= minRR_Accept and spaceOk
        targetSpaceWarn = haveSwings and (not spaceOk)
        targetSpaceBg = not haveSwings ? summaryWarnBg : targetSpaceStrong ? summaryGoodBg : targetSpaceWarn ? summaryWarnBg : summaryBadBg
        pullbackSummaryBg = not haveSwings ? summaryWarnBg : structIntact ? summaryGoodBg : summaryBadBg
        holdingSupportBg = overnightHard ? summaryBadBg : overnightWarn ? summaryWarnBg : summaryGoodBg
        blockerNone = topIssueTxt == "No major blocker"
        blockerIsHard = hardStop or (not riskDefAny)
        blockerBg = blockerNone ? summaryGoodBg : blockerIsHard ? summaryBadBg : summaryWarnBg
        waitForBg = waitForTxt == "Wait: none" ? summaryGoodBg : summaryWarnBg
        scoreTxt = str.tostring(overallScore, "#.##") + "/100"
        momentumSummaryTxt = rsiTxt + " | " + macdTxt
        momentumSummaryBg = (momAlignedUp or momAlignedDn) ? goodBg : warnBg
        holdingFactorsBg = overnightHard ? badBg : overnightWarn ? warnBg : goodBg
        rrRawTxt = bullStruct and not na(rrLong) ? str.tostring(rrLong, "#.##") : bearStruct and not na(rrShort) ? str.tostring(rrShort, "#.##") : "na"
        rrTargetTxt = bullStruct and not na(targetLong) ? str.tostring(targetLong, "#.##") : bearStruct and not na(targetShort) ? str.tostring(targetShort, "#.##") : "na"

        r = 0
        setHeader(r, "— STOCK 4H (Structure & Planning) —")
        r += 1
        setRow(r, "Ticker / TF", tkr + " | " + timeframe.period, bgBase)
        r += 1

        // SUMMARY (4H planning): structure -> location -> risk -> target -> hold
        setRowStatus(r, summaryCase("Planable?"), summaryCase(planabilityTxt), planabilityBg)
        r += 1
        setRowStatus(r, summaryCase("Location"), summaryCase(locationSummaryTxt), locationSummaryBg)
        r += 1
        setRowStatus(r, summaryCase("Invalidation"), summaryCase(riskClarityTxt), riskClarityBg)
        r += 1
        setRowStatus(r, summaryCase("Target & Space"), summaryCase(targetSpaceTxt), targetSpaceBg)
        r += 1
        setRowStatus(r, summaryCase("Pullback Quality"), summaryCase(pullbackSummaryTxt), pullbackSummaryBg)
        r += 1
        setRowStatus(r, summaryCase("Holding Support"), summaryCase(holdingSupportTxt), holdingSupportBg)
        r += 1
        setRowStatus(r, summaryCase("Top Blocker"), summaryCase(topIssueTxt), blockerBg)
        r += 1
        setRowStatus(r, summaryCase("Wait For / Unlock"), summaryCase(waitForTxt), waitForBg)
        r += 1
        if scoreInSummary
            setRowStatus(r, summaryCase("Score"), summaryCase(scoreTxt), overallBg)
            r += 1

        if not isSummary
            setHeader(r, "— DETAILS —")
            r += 1
            setRow(r, "Daily alignment", dailyAlignTxt, dailyAlign ? goodBg : warnBg)
            r += 1
            setRow(r, "Volatility", volTxt, atrPct >= atrPctExtreme ? badBg : atrPct >= atrPctHigh ? warnBg : goodBg)
            r += 1
            setRow(r, "Structure", structureTxt, directionClear ? goodBg : badBg)
            r += 1
            setRow(r, "Confirmation", confirmTxt, (confirmTxt == "Confirmation: not present (wait)") ? warnBg : goodBg)
            r += 1
            setRow(r, "MA Context", maTxt, (ema20Flat and sma50Flat) ? warnBg : goodBg)
            r += 1
            setRow(r, "Momentum", momentumSummaryTxt, momentumSummaryBg)
            r += 1
            setRow(r, "Holding Factors", holdingFactorsTxt, holdingFactorsBg)
            r += 1

            setHeader(r, "— STRUCTURE / LEVELS —")
            r += 1
            setRow(r, "Pullback Quality", pullbackTxt, structIntact ? goodBg : badBg)
            r += 1
            setRow(r, "Respect Levels", respectTxt, (failedCount >= failedWarn) ? badBg : (ftUp or ftDn) ? goodBg : warnBg)
            r += 1
            setRow(r, "Extended", extendedTxt, extended ? warnBg : goodBg)
            r += 1
            setRow(r, "MA Context", maTxt, (ema20Flat and sma50Flat) ? warnBg : goodBg)
            r += 1
            setRow(r, "200MA Bias", bias200Txt, bgBase)
            r += 1

            setHeader(r, "— MOMENTUM —")
            r += 1
            setRow(r, "RSI", rsiTxt, (rsi >= 50 or rsi <= 40) ? goodBg : warnBg)
            r += 1
            setRow(r, "RSI swings", rsiSwingsTxt, (rsiSwingsTxt == "RSI swings: HL (ok)") ? goodBg : warnBg)
            r += 1
            setRow(r, "MACD", macdTxt, (macdTxt == "MACD: mixed/flat") ? warnBg : goodBg)
            r += 1
            setRow(r, "MACD Flips", macdFlipTxt, (macdFlipCount >= macdFlipWarn) ? warnBg : goodBg)
            r += 1

            setHeader(r, "— VOLUME —")
            r += 1
            setRow(r, "Volume", volumeTxt, str.contains(volumeTxt, "weak") ? warnBg : goodBg)
            r += 1
            setRow(r, "Breakout Volume", breakVolTxt, str.contains(breakVolTxt, "volume weak") ? warnBg : goodBg)
            r += 1

            if isFull
                if showNumbers
                    setHeader(r, "— DEBUG (optional) —")
                    r += 1
                    setRow(r, "ATR% (raw)", "atr%=" + str.tostring(atrPct, "#.##"), bgBase)
                    r += 1
                    setRow(r, "MACD flips#", "flips=" + str.tostring(macdFlipCount), bgBase)
                    r += 1
                    setRow(r, "Failed breaks#", "fails=" + str.tostring(failedCount), bgBase)
                    r += 1
                    setRow(r, "RR raw / Target", "rr=" + rrRawTxt + " | tgt=" + rrTargetTxt, bgBase)
                    r += 1
