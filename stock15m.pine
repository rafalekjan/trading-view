//@version=6
indicator("Ticker - Execution & Timing 15m", overlay=true, max_labels_count=500)

//========================
// Inputs
//========================
showTable   = input.bool(true, "Show table", group="UI")
use15mOnly  = input.bool(true, "Use 15m (warn if other TF)", group="UI")
hardStopWrongTF = input.bool(false, "Hard stop if not 15m", group="UI")

// 15m logic params
atrLen      = input.int(14, "ATR length", minval=1, group="15m")
emaLen      = input.int(20, "EMA length", minval=1, group="15m")
pivotLen    = input.int(5, "Pivot length (HL/LH)", minval=2, group="15m")
volMaLen    = input.int(20, "Volume MA length", minval=5, group="15m")

// 4H context params
tf4h        = input.timeframe("240", "HTF for context (4H)", group="4H Context")
piv4hLen    = input.int(5, "4H Pivot length (S/R)", minval=2, group="4H Context")

// Thresholds (ATR-based)
nearAtr     = input.float(0.30, "Near level (ATR)", step=0.05, group="Thresholds")
midAtr      = input.float(0.80, "Medium distance (ATR)", step=0.05, group="Thresholds")
extAtr      = input.float(1.50, "Extended (ATR)", step=0.05, group="Thresholds")
chaseAtr    = input.float(0.60, "Chasing breakout (ATR)", step=0.05, group="Thresholds")

//========================
// Helpers
//========================
f_str(b) => b ? "Yes" : "No"
f_fmt(x) => na(x) ? "na" : str.tostring(x, format.mintick)

f_sign(x) =>
    x > 0 ? 1 : x < 0 ? -1 : 0

f_abs(x) => math.abs(x)

//========================
// Timeframe warning
//========================
is15 = (timeframe.isintraday and timeframe.multiplier == 15) or (timeframe.in_seconds(timeframe.period) == 15 * 60)
tfWarn = use15mOnly and not is15

if use15mOnly and hardStopWrongTF and not is15
    runtime.error("This script is designed for 15m timeframe. Switch chart to 15m.")

//========================
// 15m Core Metrics
//========================
c   = close
h   = high
l   = low
v   = volume

atr = ta.atr(atrLen)
ema = ta.ema(c, emaLen)

// VWAP (session)
vwap = ta.vwap(hlc3)
vwapState =
     c > vwap ? "Above" :
     c < vwap ? "Below" : "Middle"

// Bias (15m) - simple & stable
bias15 =
     c > ema and c > vwap ? "Bullish" :
     c < ema and c < vwap ? "Bearish" : "Neutral"

// Structure (15m) via last pivot HL/LH progression
ph = ta.pivothigh(h, pivotLen, pivotLen)
pl = ta.pivotlow(l, pivotLen, pivotLen)

var float lastPH = na
var float lastPL = na
var float prevPH = na
var float prevPL = na

if not na(ph)
    prevPH := lastPH
    lastPH := ph

if not na(pl)
    prevPL := lastPL
    lastPL := pl

hh = not na(lastPH) and not na(prevPH) and lastPH > prevPH
hl = not na(lastPL) and not na(prevPL) and lastPL > prevPL
ll = not na(lastPL) and not na(prevPL) and lastPL < prevPL
lh = not na(lastPH) and not na(prevPH) and lastPH < prevPH

structure15 =
     (hh and hl) ? "HH/HL" :
     (ll and lh) ? "LL/LH" : "Mixed"

//========================
// 15m Trigger / Liquidity heuristics
//========================
// "Level" for micro triggers: use EMA20 + VWAP + last pivot levels (when available)
microRes = na(lastPH) ? na : lastPH
microSup = na(lastPL) ? na : lastPL

// Breakout / Breakdown detection vs last pivot levels
crossUpPivot = ta.crossover(c, microRes)
crossDnPivot = ta.crossunder(c, microSup)
breakUp   = not na(microRes) and crossUpPivot
breakDown = not na(microSup) and crossDnPivot

// "Hold" concept: after break, stays above/below for N bars
holdBars = 2
holdUp   = not na(microRes) and c > microRes and ta.lowest(c, holdBars) > microRes
holdDn   = not na(microSup) and c < microSup and ta.highest(c, holdBars) < microSup
confirmUp = not na(microRes) and ta.barssince(breakUp) <= holdBars and c > microRes
confirmDn = not na(microSup) and ta.barssince(breakDown) <= holdBars and c < microSup

// Reclaim concept: wick below support then close back above (bull) / wick above resistance then close below (bear)
reclaimBull = not na(microSup) and l < microSup and c > microSup
reclaimBear = not na(microRes) and h > microRes and c < microRes

// Failed breakout: cross above then close back below level soon
failedUp = not na(microRes) and ta.barssince(breakUp) <= 2 and c < microRes
failedDn = not na(microSup) and ta.barssince(breakDown) <= 2 and c > microSup

// Trigger status (single label)
triggerStatus =
     (failedUp or failedDn) ? "Failed" :
     (confirmUp or confirmDn or reclaimBull or reclaimBear) ? "Confirmed" :
     "No trigger"

// Liquidity event
liquidityEvent =
     reclaimBull ? "Stop run low" :
     reclaimBear ? "Stop run high" :
     (failedUp or failedDn) ? "Failed breakout" :
     "None"

// Entry type suggestion (HINT)
crossUpVwap = ta.crossover(c, vwap)
crossDnVwap = ta.crossunder(c, vwap)
entryTypeHint =
     (reclaimBull or reclaimBear) ? "Liquidity sweep reclaim" :
     (confirmUp or confirmDn) ? "Break & hold" :
     (crossUpVwap or crossDnVwap) ? "Reclaim level" :
     (math.abs(c - vwap) <= atr * nearAtr) ? "Pullback to VWAP" :
     (math.abs(c - ema) <= atr * nearAtr) ? "Pullback to EMA20" :
     "-"

// Volume assessment
volMa = ta.sma(v, volMaLen)
volRel = volMa > 0 ? v / volMa : na

// Heuristic: "on move" if bar range expands and volume above avg
rangeNow = h - l
rangeMa  = ta.sma(rangeNow, 20)
isImpulse = rangeMa > 0 and rangeNow > rangeMa * 1.1

volState =
     (not na(volRel) and volRel >= 1.2 and isImpulse) ? "Increasing on move" :
     (not na(volRel) and volRel <= 0.9 and not isImpulse) ? "Reduced on pullbacks" :
     "Weak / no confirm"

//========================
// Stop logic suggestion (HINT)
//========================
stopLogicHint =
     bias15 == "Bullish" and not na(lastPL) ? "Below last HL" :
     bias15 == "Bearish" and not na(lastPH) ? "Above last LH" :
     (bias15 == "Bullish") ? "Below VWAP" :
     (bias15 == "Bearish") ? "Above VWAP" :
     "Structure invalidation"

//========================
// 4H Context: Support/Resistance + Bias4H (simple, stable)
//========================
c4 = request.security(syminfo.tickerid, tf4h, close, barmerge.gaps_off, barmerge.lookahead_off)
h4 = request.security(syminfo.tickerid, tf4h, high, barmerge.gaps_off, barmerge.lookahead_off)
l4 = request.security(syminfo.tickerid, tf4h, low, barmerge.gaps_off, barmerge.lookahead_off)

ema4 = request.security(syminfo.tickerid, tf4h, ta.ema(close, 20), barmerge.gaps_off, barmerge.lookahead_off)
vwap4 = request.security(syminfo.tickerid, tf4h, ta.vwap(hlc3), barmerge.gaps_off, barmerge.lookahead_off)

ph4 = request.security(syminfo.tickerid, tf4h, ta.pivothigh(high, piv4hLen, piv4hLen), barmerge.gaps_off, barmerge.lookahead_off)
pl4 = request.security(syminfo.tickerid, tf4h, ta.pivotlow(low, piv4hLen, piv4hLen), barmerge.gaps_off, barmerge.lookahead_off)

var float lastPH4 = na
var float lastPL4 = na
if not na(ph4)
    lastPH4 := ph4
if not na(pl4)
    lastPL4 := pl4

support4 = lastPL4
resist4  = lastPH4

bias4h =
     c4 > ema4 and c4 > vwap4 ? "Bullish" :
     c4 < ema4 and c4 < vwap4 ? "Bearish" : "Neutral"

//========================
// Location vs 4H plan (HINT)
//========================
distToSup = not na(support4) ? f_abs(c - support4) : na
distToRes = not na(resist4)  ? f_abs(c - resist4)  : na

// Determine relevant "planned zone" based on 4H bias
planLevel =
     bias4h == "Bullish" ? support4 :
     bias4h == "Bearish" ? resist4 :
     // neutral: nearest of both
     (na(distToSup) ? resist4 : na(distToRes) ? support4 : (distToSup <= distToRes ? support4 : resist4))

distToPlan = not na(planLevel) ? f_abs(c - planLevel) : na
distAtr    = (not na(distToPlan) and atr > 0) ? distToPlan / atr : na

// "Chasing breakout" if trigger confirmed and price moved far away from plan level
isChasing =
     triggerStatus == "Confirmed" and not na(distAtr) and distAtr >= chaseAtr

locationVs4h =
     na(distAtr) ? "No data" :
     isChasing ? "Chasing breakout" :
     distAtr <= nearAtr ? "At planned entry zone" :
     distAtr <= midAtr  ? "Early" :
     distAtr >= extAtr  ? "Late / extended" :
     "Early"

//========================
// Time of day (simple buckets)
//========================
// Uses exchange time via `time` series.
// You can tweak buckets to your market.
sessHour = hour(time)
sessMin  = minute(time)

// For US equities (rough):
// Open: 09:30-10:30, Midday: 11:30-14:00, Power hour: 15:00-16:00
// We'll approximate by hour blocks:
timeOfDay =
     (sessHour == 9 and sessMin >= 30) or (sessHour == 10 and sessMin < 30) ? "Open" :
     (sessHour >= 11 and sessHour < 14) ? "Midday" :
     (sessHour >= 15) ? "Power hour" :
     "After lunch reclaim"

//========================
// Suggest Entry/Stop/Target numbers (HINT only)
//========================
entryHint = c

// Stop hint: ATR buffer around plan level depending on bias15
stopBuf = atr * 0.2
stopHint =
     bias15 == "Bullish" and not na(support4) ? (support4 - stopBuf) :
     bias15 == "Bearish" and not na(resist4)  ? (resist4 + stopBuf) :
     (bias15 == "Bullish") ? (vwap - stopBuf) :
     (bias15 == "Bearish") ? (vwap + stopBuf) : na

// Target hint: opposite 4H level
targetHint =
     bias15 == "Bullish" and not na(resist4)  ? resist4 :
     bias15 == "Bearish" and not na(support4) ? support4 : na

//========================
// Table (top-right)
//========================
var table t = table.new(position.top_right, 2, 26, border_width=1)

f_set(row, k, v, isHeader, valColor) =>
    leftBg  = isHeader ? color.new(color.blue, 80) : color.new(color.black, 0)
    rightBg = isHeader ? color.new(color.blue, 80) : color.new(color.black, 0)
    txtCol  = color.white
    table.cell(t, 0, row, k, text_size=size.small, text_halign=text.align_left, bgcolor=leftBg, text_color=txtCol)
    table.cell(t, 1, row, v, text_size=size.small, text_halign=text.align_left, bgcolor=rightBg, text_color=valColor)

if barstate.islast
    if not showTable
        table.clear(t, 0, 0, 1, 25)
    else
        table.clear(t, 0, 0, 1, 25)
        white = color.white
        warnCol = tfWarn ? color.new(color.red, 0) : white

        f_set(0, "Stock 15m Exec", tfWarn ? "WARN: Use 15m" : syminfo.ticker, true, warnCol)

        f_set(1, "Bias", bias15, false, white)
        f_set(2, "Structure", structure15, false, white)
        f_set(3, "VWAP", vwapState, false, white)
        f_set(4, "Location vs 4H", locationVs4h, false, white)
        f_set(5, "Entry type", entryTypeHint, false, white)
        f_set(6, "Trigger status", triggerStatus, false, white)
        f_set(7, "Volume", volState, false, white)
        f_set(8, "Stop logic", stopLogicHint, false, white)
        f_set(9, "Time of day", timeOfDay, false, white)
        f_set(10, "Liquidity event", liquidityEvent, false, white)
        f_set(11, "Entry", f_fmt(entryHint), false, white)
        f_set(12, "Stop", f_fmt(stopHint), false, white)
        f_set(13, "Target", f_fmt(targetHint), false, white)

        f_set(14, "4H Context", "", true, white)
        f_set(15, "Bias 4H", bias4h, false, white)
        f_set(16, "4H Support", f_fmt(support4), false, white)
        f_set(17, "4H Resistance", f_fmt(resist4), false, white)

        f_set(18, "Levels", "", true, white)
        f_set(19, "Close", f_fmt(c), false, white)
        f_set(20, "ATR(14)", f_fmt(atr), false, white)
        f_set(21, "VWAP", f_fmt(vwap), false, white)
        f_set(22, "EMA20", f_fmt(ema), false, white)
        f_set(23, "Last HL", f_fmt(lastPL), false, white)
        f_set(24, "Last LH", f_fmt(lastPH), false, white)

        f_set(25, "Vol rel (xMA)", na(volRel) ? "na" : str.tostring(volRel, format.mintick), false, white)

//========================
// Optional visual markers (kept minimal)
//========================
plotchar(showTable and triggerStatus == "Confirmed", title="Trigger Confirmed", char="C", location=location.top, color=color.new(color.lime, 0), size=size.tiny)
plotchar(showTable and triggerStatus == "Failed", title="Trigger Failed", char="F", location=location.top, color=color.new(color.red, 0), size=size.tiny)

