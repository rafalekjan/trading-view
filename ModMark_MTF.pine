//@version=6
indicator("ModMark MTF", overlay = true, max_lines_count = 100, max_labels_count = 100)

//=============================================================================
// INPUTS
//=============================================================================
groupBench = "Benchmark / Context"
benchmark = input.symbol("AMEX:SPY", "Benchmark (SPY / QQQ)", group = groupBench)

groupCore = "Core"
swingLen = input.int(5, "Swing pivot length", minval = 2, maxval = 20, group = groupCore)
baseLen  = input.int(20, "Consolidation lookback", minval = 10, maxval = 80, group = groupCore)
atrLen   = input.int(14, "ATR length", minval = 5, maxval = 50, group = groupCore)
diLen    = input.int(14, "DMI / ADX length", minval = 5, maxval = 50, group = groupCore)

groupFlex = "Flexibility"
nearATR        = input.float(0.90, "Near level <= ATR x", minval = 0.20, maxval = 3.00, step = 0.05, group = groupFlex)
extendedATR    = input.float(1.90, "Extended > ATR x", minval = 0.50, maxval = 5.00, step = 0.05, group = groupFlex)
baseATRMax     = input.float(4.50, "Max base width for breakout/breakdown (ATR)", minval = 1.0, maxval = 10.0, step = 0.1, group = groupFlex)
highVolPct     = input.float(3.50, "High-vol threshold ATR%", minval = 0.5, maxval = 10.0, step = 0.1, group = groupFlex)
stopBufAtr     = input.float(0.20, "Stop buffer (x ATR)", minval = 0.0, maxval = 1.0, step = 0.05, group = groupFlex)
rrFloor        = input.float(1.50, "Minimum usable R:R", minval = 0.5, maxval = 5.0, step = 0.05, group = groupFlex)
weekRangeMult  = input.float(1.35, "5D range vs average = high-vol week", minval = 1.0, maxval = 3.0, step = 0.05, group = groupFlex)

groupOptions = "Options guidance"
sameWeekRRMin   = input.float(3.00, "Same-week min R:R", minval = 1.0, maxval = 10.0, step = 0.25, group = groupOptions)
sameWeekRiskATR = input.float(1.00, "Same-week max risk (ATR)", minval = 0.25, maxval = 3.0, step = 0.05, group = groupOptions)

groupVis = "Visuals"
showEMAs    = input.bool(true, "Show EMA 20 / 50 + 200 MA", group = groupVis)
showLevels  = input.bool(true, "Show nearest support / resistance", group = groupVis)
showSignals = input.bool(true, "Show breakout / breakdown markers", group = groupVis)

//=============================================================================
// HELPERS
//=============================================================================
f_clamp(float x, float lo, float hi) =>
    math.max(lo, math.min(hi, x))

f_safeMin(float a, float b) =>
    na(a) ? b : na(b) ? a : math.min(a, b)

f_safeMax(float a, float b) =>
    na(a) ? b : na(b) ? a : math.max(a, b)

f_macdHist() =>
    [_, __, hist] = ta.macd(close, 12, 26, 9)
    hist

f_biasLabel(float score, float chopScore) =>
    chopScore > 68 and math.abs(score) < 18 ? "Range / Chop" :
     score >= 25 ? "Bullish" :
     score <= -25 ? "Bearish" :
     "Neutral"

f_contextLabel(float score, float atrPctVal, float hvPct) =>
    atrPctVal > hvPct ? "Volatile" :
     score >= 25 ? "Bullish" :
     score <= -25 ? "Bearish" :
     "Range"

f_marketLabel(float score, float atrPctVal, float hvPct) =>
    atrPctVal > hvPct ? "Volatile" :
     math.abs(score) >= 25 ? "Trend" :
     "Range"

f_qualityLabel(float q) =>
    q >= 55 ? "Clean" : "Messy"

f_relLabel(float score) =>
    score >= 20 ? "Strong" :
     score <= -20 ? "Weak" :
     "In-line"

f_rrBand(float rr) =>
    na(rr) ? "<2:1" :
     rr >= 3.0 ? "3:1+" :
     rr >= 2.0 ? "2:1" :
     "<2:1"

f_rrText(float rr) =>
    na(rr) ? "n/a" : "1 : " + str.tostring(rr, "#.##")

f_grade(float score) =>
    score >= 76 ? "A" :
     score >= 60 ? "B" :
     score >= 44 ? "C" :
     "D"

f_resultBg(string statusText) =>
    statusText == "Bullish" or statusText == "Calls" or statusText == "Trend" or statusText == "Strong" or statusText == "Clean" or statusText == "Execute" or statusText == "3:1+" or statusText == "7-14 DTE" or statusText == "Breakout" or statusText == "Pullback" or statusText == "Trending up" ? color.new(color.green, 20) :
     statusText == "Bearish" or statusText == "Puts" or statusText == "Weak" or statusText == "Breakdown" or statusText == "Trending down" ? color.new(color.red, 15) :
     statusText == "Pass" or statusText == "Erratic" or statusText == "Avoid / thin chain likely" or statusText == "Skip" or statusText == "<2:1" or statusText == "No trade" ? color.new(color.red, 5) :
     statusText == "Range" or statusText == "Volatile" or statusText == "Messy" or statusText == "Mid-range" or statusText == "Mixed" or statusText == "Neutral" or statusText == "Neutral / Chop" or str.contains(statusText, "Wait") or statusText == "2:1" or statusText == "Manual check" or statusText == "In-line" or statusText == "Reduced size" or statusText == "Plan only" or statusText == "Ranging / mixed" or statusText == "High-volatility week" or statusText == "Range week" ? color.new(color.orange, 15) :
     color.new(color.silver, 55)

f_gradeBg(string g) =>
    g == "A" ? color.new(color.green, 10) :
     g == "B" ? color.new(color.green, 30) :
     g == "C" ? color.new(color.orange, 10) :
     color.new(color.red, 5)

f_marketStateBg(string stateText) =>
    str.contains(stateText, "Trending") ? color.new(color.green, 25) :
     str.contains(stateText, "high vol") ? color.new(color.red, 15) :
     color.new(color.orange, 20)

f_row(table t, int row, string item, string result, string details, color resultBg) =>
    table.cell(t, 0, row, item, text_color = color.white, bgcolor = color.new(color.black, 0), text_halign = text.align_left)
    table.cell(t, 1, row, result, text_color = color.white, bgcolor = resultBg, text_halign = text.align_left)
    table.cell(t, 2, row, details, text_color = color.silver, bgcolor = color.new(color.black, 0), text_halign = text.align_left)

//=============================================================================
// MODE DETECTION
//=============================================================================
tickerUpper = str.upper(syminfo.ticker)
isSpyQqq = tickerUpper == "SPY" or tickerUpper == "QQQ"
is15m = timeframe.in_seconds(timeframe.period) == timeframe.in_seconds("15")
is1h = timeframe.in_seconds(timeframe.period) == timeframe.in_seconds("60")
is4h = timeframe.in_seconds(timeframe.period) == timeframe.in_seconds("240")
is1d = timeframe.in_seconds(timeframe.period) == timeframe.in_seconds("1D")
isSupported = is15m or is1h or is4h or is1d

if not isSupported
    runtime.error("Use this script on 15m, 1H, 4H, or 1D.")

tfLabel = is15m ? "15m" : is1h ? "1H" : is4h ? "4H" : "1D"
modeLabel = is15m ? "15m timing layer" : is1h ? "1H execution dashboard" : is4h ? "4H planning dashboard" : isSpyQqq ? "SPY/QQQ daily dashboard" : "Ticker daily dashboard"

//=============================================================================
// CURRENT TF CORE
//=============================================================================
ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)
ma200 = ta.sma(close, 200)

atr = ta.atr(atrLen)
atrPct = atr / close * 100.0
[diPlus, diMinus, adx] = ta.dmi(diLen, diLen)

rsi = ta.rsi(close, 14)
[macdLine, macdSignal, macdHist] = ta.macd(close, 12, 26, 9)

volSma20 = ta.sma(volume, 20)
rvol = volume / math.max(volSma20, 1.0)
avgDollarVol20 = ta.sma(volume * close, 20)

//=============================================================================
// BENCHMARK DAILY CONTEXT
//=============================================================================
benchCloseD = request.security(benchmark, "D", close, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
benchEma20D = request.security(benchmark, "D", ta.ema(close, 20), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
benchEma50D = request.security(benchmark, "D", ta.ema(close, 50), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
benchMa200D = request.security(benchmark, "D", ta.sma(close, 200), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
benchAtrPctD = request.security(benchmark, "D", ta.atr(atrLen) / close * 100.0, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
benchRangePosD = request.security(benchmark, "D", (close - ta.lowest(low, 60)) / math.max(ta.highest(high, 60) - ta.lowest(low, 60), syminfo.mintick), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

marketStack = 0.0
marketStack += benchCloseD > benchEma20D ? 10 : -10
marketStack += benchEma20D > benchEma50D ? 12 : -12
marketStack += benchEma50D > benchMa200D ? 14 : -14
marketSlope = f_clamp((benchEma20D - benchEma20D[3]) / math.max(benchCloseD * 0.01, syminfo.mintick), -1.0, 1.0) * 18.0
marketRange = (benchRangePosD - 0.5) * 24.0
marketScore = f_clamp(marketStack + marketSlope + marketRange, -100.0, 100.0)
marketContext = f_marketLabel(marketScore, benchAtrPctD, highVolPct)
marketDir = marketScore > 12 ? 1 : marketScore < -12 ? -1 : 0

//=============================================================================
// DAILY STOCK CONTEXT
//=============================================================================
dClose = request.security(syminfo.tickerid, "D", close, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
dEma20 = request.security(syminfo.tickerid, "D", ta.ema(close, 20), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
dEma50 = request.security(syminfo.tickerid, "D", ta.ema(close, 50), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
dMa200 = request.security(syminfo.tickerid, "D", ta.sma(close, 200), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
dRsi = request.security(syminfo.tickerid, "D", ta.rsi(close, 14), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
dMacdHist = request.security(syminfo.tickerid, "D", f_macdHist(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
dAtrPct = request.security(syminfo.tickerid, "D", ta.atr(atrLen) / close * 100.0, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
dRangePos = request.security(syminfo.tickerid, "D", (close - ta.lowest(low, 60)) / math.max(ta.highest(high, 60) - ta.lowest(low, 60), syminfo.mintick), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
dBodyRange = request.security(syminfo.tickerid, "D", ta.sma(math.abs(close - open) / math.max(high - low, syminfo.mintick), 5), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
dCompression = request.security(syminfo.tickerid, "D", (math.abs(ta.ema(close, 20) - ta.ema(close, 50)) + math.abs(ta.ema(close, 50) - ta.sma(close, 200))) / math.max(ta.atr(atrLen), syminfo.mintick), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

dailyStack = 0.0
dailyStack += dClose > dEma20 ? 10 : -10
dailyStack += dEma20 > dEma50 ? 12 : -12
dailyStack += dEma50 > dMa200 ? 14 : -14
dailySlope = f_clamp((dEma20 - dEma20[3]) / math.max(dClose * 0.01, syminfo.mintick), -1.0, 1.0) * 18.0
dailyRange = (dRangePos - 0.5) * 24.0
dailyScore = f_clamp(dailyStack + dailySlope + dailyRange, -100.0, 100.0)
dailyContext = f_contextLabel(dailyScore, dAtrPct, highVolPct)
dailyQualityScore = f_clamp(dBodyRange * 45.0 + math.min(dCompression / 4.0, 1.0) * 55.0, 0.0, 100.0)
dailyChartQuality = f_qualityLabel(dailyQualityScore)

dailyBullCtx = dClose >= dEma20 and dEma20 >= dEma50 and dEma50 >= dMa200 and dRsi >= 50 and dMacdHist >= 0
dailyBearCtx = dClose <= dEma20 and dEma20 <= dEma50 and dEma50 <= dMa200 and dRsi <= 50 and dMacdHist <= 0

//=============================================================================
// 1H / 2H CONTEXT
//=============================================================================
h1Close = request.security(syminfo.tickerid, "60", close, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
h1Ema20 = request.security(syminfo.tickerid, "60", ta.ema(close, 20), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
h1Ema50 = request.security(syminfo.tickerid, "60", ta.ema(close, 50), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
h1Ma200 = request.security(syminfo.tickerid, "60", ta.sma(close, 200), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
h1Rsi = request.security(syminfo.tickerid, "60", ta.rsi(close, 14), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
h1MacdHist = request.security(syminfo.tickerid, "60", f_macdHist(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

h2Close = request.security(syminfo.tickerid, "120", close, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
h2Ema20 = request.security(syminfo.tickerid, "120", ta.ema(close, 20), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
h2Ema50 = request.security(syminfo.tickerid, "120", ta.ema(close, 50), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
h2Ma200 = request.security(syminfo.tickerid, "120", ta.sma(close, 200), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
h2Rsi = request.security(syminfo.tickerid, "120", ta.rsi(close, 14), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
h2MacdHist = request.security(syminfo.tickerid, "120", f_macdHist(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

h1BullCtx = h1Close >= h1Ema20 and h1Ema20 >= h1Ema50 and h1Ema50 >= h1Ma200 and h1Rsi >= 50 and h1MacdHist >= 0
h1BearCtx = h1Close <= h1Ema20 and h1Ema20 <= h1Ema50 and h1Ema50 <= h1Ma200 and h1Rsi <= 50 and h1MacdHist <= 0
h2BullCtx = h2Close >= h2Ema20 and h2Ema20 >= h2Ema50 and h2Ema50 >= h2Ma200 and h2Rsi >= 50 and h2MacdHist >= 0
h2BearCtx = h2Close <= h2Ema20 and h2Ema20 <= h2Ema50 and h2Ema50 <= h2Ma200 and h2Rsi <= 50 and h2MacdHist <= 0

h1Context = h1BullCtx ? "Bullish" : h1BearCtx ? "Bearish" : "Mixed"
h2Context = h2BullCtx ? "Bullish" : h2BearCtx ? "Bearish" : "Mixed"

//=============================================================================
// CURRENT TF SWINGS / LEVELS
//=============================================================================
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

var float lastSwingHigh = na
var float prevSwingHigh = na
var float lastSwingLow = na
var float prevSwingLow = na

if not na(ph)
    prevSwingHigh := lastSwingHigh
    lastSwingHigh := ph

if not na(pl)
    prevSwingLow := lastSwingLow
    lastSwingLow := pl

priorDayHigh = request.security(syminfo.tickerid, "D", high[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
priorDayLow = request.security(syminfo.tickerid, "D", low[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
priorWeekHigh = request.security(syminfo.tickerid, "W", high[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
priorWeekLow = request.security(syminfo.tickerid, "W", low[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

recent20High = ta.highest(high[1], 20)
recent20Low = ta.lowest(low[1], 20)
baseHigh = ta.highest(high[1], baseLen)
baseLow = ta.lowest(low[1], baseLen)
baseWidthATR = (baseHigh - baseLow) / math.max(atr, syminfo.mintick)

rangeHigh60 = ta.highest(high, 60)
rangeLow60 = ta.lowest(low, 60)
rangeWidth60 = math.max(rangeHigh60 - rangeLow60, syminfo.mintick)
rangePos60 = (close - rangeLow60) / rangeWidth60

//=============================================================================
// BIAS / RELATIVE STRENGTH / QUALITY
//=============================================================================
maStackScore = 0.0
maStackScore += close > ema20 ? 8 : -8
maStackScore += ema20 > ema50 ? 10 : -10
maStackScore += ema50 > ma200 ? 12 : -12

slopeFastScore = f_clamp((ema20 - ema20[5]) / math.max(atr * 1.20, syminfo.mintick), -1.0, 1.0) * 12.0
slopeMidScore = f_clamp((ema50 - ema50[10]) / math.max(atr * 1.80, syminfo.mintick), -1.0, 1.0) * 8.0
swingHighScore = na(lastSwingHigh) or na(prevSwingHigh) ? 0.0 : f_clamp((lastSwingHigh - prevSwingHigh) / math.max(atr * 2.0, syminfo.mintick), -1.0, 1.0) * 10.0
swingLowScore = na(lastSwingLow) or na(prevSwingLow) ? 0.0 : f_clamp((lastSwingLow - prevSwingLow) / math.max(atr * 2.0, syminfo.mintick), -1.0, 1.0) * 10.0
rangeScore = (rangePos60 - 0.5) * 14.0
dmiScore = ((diPlus - diMinus) / math.max(diPlus + diMinus, 1.0)) * 16.0
contextBonus = marketDir * 4.0 + (dailyScore > 12 ? 4.0 : dailyScore < -12 ? -4.0 : 0.0)

biasScoreRaw = maStackScore + slopeFastScore + slopeMidScore + swingHighScore + swingLowScore + rangeScore + dmiScore + contextBonus
biasScore = f_clamp(biasScoreRaw, -100.0, 100.0)

overlapNow = math.max(0.0, math.min(high, high[1]) - math.max(low, low[1]))
overlapPct = overlapNow / math.max(high - low, syminfo.mintick)
overlapAvg = ta.sma(overlapPct, 5)
bodyToRange = ta.sma(math.abs(close - open) / math.max(high - low, syminfo.mintick), 5)
maCompression = (math.abs(ema20 - ema50) + math.abs(ema50 - ma200)) / math.max(atr, syminfo.mintick)

chopScore = f_clamp(
     (1.0 - math.min(adx / 25.0, 1.0)) * 40.0 +
     overlapAvg * 25.0 +
     (1.0 - bodyToRange) * 20.0 +
     (1.0 - math.min(maCompression / 4.0, 1.0)) * 15.0,
     0.0, 100.0
)

bullSwingStructure = not na(lastSwingHigh) and not na(prevSwingHigh) and not na(lastSwingLow) and not na(prevSwingLow) and lastSwingHigh > prevSwingHigh and lastSwingLow > prevSwingLow
bearSwingStructure = not na(lastSwingHigh) and not na(prevSwingHigh) and not na(lastSwingLow) and not na(prevSwingLow) and lastSwingHigh < prevSwingHigh and lastSwingLow < prevSwingLow
bullMAContext = close >= ema20 and ema20 >= ema50 and ema50 >= ma200 and ema20 >= ema20[5]
bearMAContext = close <= ema20 and ema20 <= ema50 and ema50 <= ma200 and ema20 <= ema20[5]

biasBull = bullSwingStructure or (bullMAContext and biasScore >= 25)
biasBear = bearSwingStructure or (bearMAContext and biasScore <= -25)
biasLabel = f_biasLabel(biasScore, chopScore)

benchCloseCur = is15m ? request.security(benchmark, "15", close, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off) :
     is1h ? request.security(benchmark, "60", close, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off) :
     is4h ? request.security(benchmark, "240", close, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off) :
     benchCloseD

ratio = close / math.max(benchCloseCur, syminfo.mintick)
relScore = f_clamp((ta.roc(close, 20) - ta.roc(benchCloseCur, 20)) / 8.0, -1.0, 1.0) * 55.0 +
           f_clamp(ta.roc(ratio, 10) / 4.0, -1.0, 1.0) * 45.0
relLabel = is1d and isSpyQqq ? "n/a" : f_relLabel(relScore)

upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low
wickiness = ta.sma((upperWick + lowerWick) / math.max(high - low, syminfo.mintick), 5)
qualityPenalty = overlapAvg * 35.0 + wickiness * 25.0 + (1.0 - math.min(adx / 25.0, 1.0)) * 20.0 + (1.0 - math.min(maCompression / 4.0, 1.0)) * 20.0
qualityScore = f_clamp(100.0 - qualityPenalty, 0.0, 100.0)
erraticState = (atrPct > highVolPct * 1.25 and wickiness > 0.55) or (chopScore > 78 and bodyToRange < 0.35)
chartBehavior = erraticState ? "Erratic" : f_qualityLabel(qualityScore)

//=============================================================================
// SUPPORT / RESISTANCE / STRUCTURE
//=============================================================================
float supportLevel = na
string supportName = "n/a"

if not na(lastSwingLow) and lastSwingLow <= close
    supportLevel := lastSwingLow
    supportName := "Swing low"

if priorDayLow <= close and (na(supportLevel) or close - priorDayLow < close - supportLevel)
    supportLevel := priorDayLow
    supportName := "Prior day low"

if priorWeekLow <= close and (na(supportLevel) or close - priorWeekLow < close - supportLevel)
    supportLevel := priorWeekLow
    supportName := "Prior week low"

if ema20 <= close and (na(supportLevel) or close - ema20 < close - supportLevel)
    supportLevel := ema20
    supportName := "EMA20"

if ema50 <= close and (na(supportLevel) or close - ema50 < close - supportLevel)
    supportLevel := ema50
    supportName := "EMA50"

if ma200 <= close and (na(supportLevel) or close - ma200 < close - supportLevel)
    supportLevel := ma200
    supportName := "MA200"

if recent20Low <= close and (na(supportLevel) or close - recent20Low < close - supportLevel)
    supportLevel := recent20Low
    supportName := "20-bar low"

float resistanceLevel = na
string resistanceName = "n/a"

if not na(lastSwingHigh) and lastSwingHigh >= close
    resistanceLevel := lastSwingHigh
    resistanceName := "Swing high"

if priorDayHigh >= close and (na(resistanceLevel) or priorDayHigh - close < resistanceLevel - close)
    resistanceLevel := priorDayHigh
    resistanceName := "Prior day high"

if priorWeekHigh >= close and (na(resistanceLevel) or priorWeekHigh - close < resistanceLevel - close)
    resistanceLevel := priorWeekHigh
    resistanceName := "Prior week high"

if ema20 >= close and (na(resistanceLevel) or ema20 - close < resistanceLevel - close)
    resistanceLevel := ema20
    resistanceName := "EMA20"

if ema50 >= close and (na(resistanceLevel) or ema50 - close < resistanceLevel - close)
    resistanceLevel := ema50
    resistanceName := "EMA50"

if ma200 >= close and (na(resistanceLevel) or ma200 - close < resistanceLevel - close)
    resistanceLevel := ma200
    resistanceName := "MA200"

if recent20High >= close and (na(resistanceLevel) or recent20High - close < resistanceLevel - close)
    resistanceLevel := recent20High
    resistanceName := "20-bar high"

distSupportATR = na(supportLevel) ? 999.0 : math.abs(close - supportLevel) / math.max(atr, syminfo.mintick)
distResistanceATR = na(resistanceLevel) ? 999.0 : math.abs(resistanceLevel - close) / math.max(atr, syminfo.mintick)

nearSupport = distSupportATR <= nearATR
nearResistance = distResistanceATR <= nearATR
nearAny = math.min(distSupportATR, distResistanceATR) <= nearATR
middleNowhere = rangePos60 > 0.35 and rangePos60 < 0.65 and math.min(distSupportATR, distResistanceATR) > 0.95
extendedBull = biasScore > 15 and distSupportATR > extendedATR
extendedBear = biasScore < -15 and distResistanceATR > extendedATR
isExtended = extendedBull or extendedBear
bullRetest = low <= nz(supportLevel, low) + atr * 0.35
bearRetest = high >= nz(resistanceLevel, high) - atr * 0.35

breakout = close > baseHigh and baseWidthATR <= baseATRMax
breakdown = close < baseLow and baseWidthATR <= baseATRMax
trendPullback = (biasBull and nearSupport and bullRetest) or (biasBear and nearResistance and bearRetest)

structureText =
     breakout ? "Breakout" :
     breakdown ? "Breakdown" :
     trendPullback ? "Pullback" :
     bullSwingStructure or bearSwingStructure or bullMAContext or bearMAContext ? "Trend" :
     middleNowhere or chopScore > 70 ? "Chop" :
     "Range"

float keyLevel = na
string keyLevelName = "n/a"

if breakout
    keyLevel := baseHigh
    keyLevelName := "Consolidation high"
else if breakdown
    keyLevel := baseLow
    keyLevelName := "Consolidation low"
else if biasBull or (not biasBear and biasScore >= 0)
    keyLevel := na(supportLevel) ? resistanceLevel : supportLevel
    keyLevelName := na(supportLevel) ? resistanceName : supportName
else
    keyLevel := na(resistanceLevel) ? supportLevel : resistanceLevel
    keyLevelName := na(resistanceLevel) ? supportName : resistanceName

locationText =
     biasBull and nearSupport ? "At support" :
     biasBear and nearResistance ? "At resistance" :
     breakout ? "Near breakout" :
     breakdown ? "Near breakdown" :
     isExtended ? "Extended" :
     middleNowhere ? "Mid-range" :
     "Within range"

//=============================================================================
// CONFIRMATION / TOP-DOWN / ENTRY
//=============================================================================
confirmation =
     breakout and low > baseHigh - atr * 0.25 ? "Break and hold" :
     breakdown and high < baseLow + atr * 0.25 ? "Break and hold" :
     biasBull and nearSupport and close > open and bullRetest ? "Hold" :
     biasBear and nearResistance and close < open and bearRetest ? "Reject" :
     biasBear and high > nz(keyLevel, high) and close < nz(keyLevel, close) ? "Fail and reject" :
     biasBull and low < nz(keyLevel, low) and close > nz(keyLevel, close) ? "Fail and reject" :
     "No clear reaction"

minorHigh = ta.highest(high[1], 4)
minorLow = ta.lowest(low[1], 4)

structureConfirm =
     not na(lastSwingLow) and not na(prevSwingLow) and lastSwingLow > prevSwingLow ? "Higher low" :
     not na(lastSwingHigh) and not na(prevSwingHigh) and lastSwingHigh < prevSwingHigh ? "Lower high" :
     close > minorHigh ? "Minor high break" :
     close < minorLow ? "Minor low break" :
     breakout or breakdown or bullSwingStructure or bearSwingStructure ? "Continuation" :
     "Waiting"

volumeConfirm = ((breakout or breakdown) and rvol >= 1.20) or (((biasBull and close > open) or (biasBear and close < open)) and rvol >= 1.05)
weakVolume = rvol < 0.90
momentumContradicts = (biasBull and rsi < 48 and macdLine < macdSignal) or (biasBear and rsi > 52 and macdLine > macdSignal)
volumeMomentum =
     volumeConfirm and not momentumContradicts ? "Confirming" :
     momentumContradicts ? "Contradicting" :
     weakVolume ? "Weak" :
     "Mixed"

longBias = breakout ? true : breakdown ? false : biasBull ? true : biasBear ? false : biasScore >= 0
dailyAligned = longBias ? (dailyBullCtx or (dClose >= dEma20 and dRsi >= 50)) : (dailyBearCtx or (dClose <= dEma20 and dRsi <= 50))
h1Aligned = longBias ? h1BullCtx : h1BearCtx
h2Aligned = longBias ? h2BullCtx : h2BearCtx
midTfAligned = h1Aligned and h2Aligned
midTfNotAgainst = longBias ? ((h1BullCtx or h1Close >= h1Ema20) and (h2BullCtx or h2Close >= h2Ema20)) : ((h1BearCtx or h1Close <= h1Ema20) and (h2BearCtx or h2Close <= h2Ema20))

alignResult =
     is15m ? (not dailyAligned ? "Against daily" : midTfAligned ? "Daily + 1H/2H aligned" : midTfNotAgainst ? "Daily aligned; 1H/2H mixed" : "Wait for 1H/2H align") :
     is1h ? (not dailyAligned ? "Against daily" : h2Aligned ? "Daily + 2H aligned" : longBias ? (h2Close >= h2Ema20 ? "2H mixed, not against" : "Wait for 2H align") : (h2Close <= h2Ema20 ? "2H mixed, not against" : "Wait for 2H align")) :
     is4h ? (not dailyAligned ? "Against daily" : midTfAligned ? "Daily + 1H/2H aligned" : midTfNotAgainst ? "Daily aligned; 1H/2H mixed" : "Wait for 1H/2H align") :
     midTfAligned ? "1H + 2H aligned" : midTfNotAgainst ? "Mixed, not against" : "1H / 2H not aligned"

executionSupportive = is15m ? (dailyAligned and midTfAligned) : is1h ? (dailyAligned and h2Aligned) : is4h ? (dailyAligned and midTfAligned) : midTfAligned
executionNotAgainst = is15m ? (dailyAligned and midTfNotAgainst) : is1h ? (dailyAligned and (h2Aligned or (longBias ? h2Close >= h2Ema20 : h2Close <= h2Ema20))) : is4h ? (dailyAligned and midTfNotAgainst) : midTfNotAgainst

optionSide =
     longBias and executionNotAgainst ? "Calls" :
     not longBias and executionNotAgainst ? "Puts" :
     "Pass"

entrySetupText =
     breakout and confirmation == "Break and hold" ? "Above " + str.tostring(baseHigh, format.mintick) :
     breakdown and confirmation == "Break and hold" ? "Below " + str.tostring(baseLow, format.mintick) :
     longBias and (structureConfirm == "Minor high break" or structureConfirm == "Higher low") ? "On reclaim above " + str.tostring(minorHigh, format.mintick) :
     longBias and confirmation == "Hold" ? "On reclaim / hold" :
     not longBias and (structureConfirm == "Minor low break" or structureConfirm == "Lower high") ? "Below " + str.tostring(minorLow, format.mintick) :
     not longBias and (confirmation == "Reject" or confirmation == "Fail and reject") ? "On rejection" :
     "Wait"

entryText =
     entrySetupText == "Wait" ? entrySetupText :
     not executionNotAgainst ? entrySetupText + " | wait higher TF" :
     volumeMomentum == "Weak" ? entrySetupText + " | volume weak" :
     entrySetupText
