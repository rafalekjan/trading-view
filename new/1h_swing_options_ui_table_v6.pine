//@version=6
indicator("Stock 1H", overlay=true, max_labels_count=500, max_lines_count=500)

//------------------------------------------------------------------------------
// Inputs (all user-configurable)
//------------------------------------------------------------------------------
groupUI   = "UI"
uiShow    = input.bool(true, "Show table", group=groupUI)
uiOpacity = input.int(10, "Table visibility (0=solid, 100=invisible)", minval=0, maxval=100, group=groupUI)
uiShowDetails = input.bool(true, "Show DETAILS section", group=groupUI)
uiTextSize = input.string("small", "Text size", options=["tiny","small","normal","large"], group=groupUI)
uiShowHintWhenNot1H = input.bool(false, "Show hint when not on 1H", group=groupUI)

groupMode = "Mode"
modeShowBoth = input.bool(true, "Show both PUT & CALL", group=groupMode)
modeFocus = input.string("BOTH", "Focus", options=["BOTH","CALL","PUT"], group=groupMode)

groupTF = "Timeframe gating"
onlyOn1H = input.bool(true, "Render table only on 1H", group=groupTF)

groupBench = "Benchmark / HTF"
benchSymbol = input.symbol("SPY", "Benchmark symbol (Relative Strength)", group=groupBench)
htfForAlignment = input.timeframe("D", "HTF for alignment", group=groupBench)

groupStructure = "Structure detection"
pivLen = input.int(5, "Pivot length (swing points)", minval=2, maxval=20, group=groupStructure)
lookbackBars = input.int(80, "Lookback bars for structure checks", minval=20, maxval=500, group=groupStructure)

groupFilters = "Filters / Thresholds"
atrLen = input.int(14, "ATR length", minval=1, group=groupFilters)
atrLocMult = input.float(0.8, "Location: max distance to key level (x ATR)", minval=0.1, step=0.1, group=groupFilters)
minRR = input.float(2.0, "Target space: minimum R multiple", minval=0.5, step=0.25, group=groupFilters)
rrHardFloor = input.float(1.5, "RR hard floor (below = NO TRADE)", minval=0.5, step=0.25, group=groupFilters)
volLen = input.int(20, "Volume SMA length", minval=1, group=groupFilters)
volBreakMult = input.float(1.2, "Volume: impulse vol >= SMA *", minval=0.5, step=0.1, group=groupFilters)
rsiLen = input.int(14, "RSI length", minval=1, group=groupFilters)
rsiTrendLevel = input.float(50.0, "RSI trend level", minval=1, maxval=99, step=1, group=groupFilters)
bbLen = input.int(20, "BB length (compression/exhaustion)", minval=5, group=groupFilters)
bbMult = input.float(2.0, "BB stdev", minval=0.5, step=0.1, group=groupFilters)
chaosOverlapThresh = input.float(0.55, "Chaos: overlap ratio threshold", minval=0.1, maxval=0.9, step=0.05, group=groupFilters)
impulseAtrThresh = input.float(2.5, "DTE comfort: last impulse <= x ATR", minval=0.5, step=0.25, group=groupFilters)
extendedAtr = input.float(1.6, "Extended if |close-EMA20| > x ATR", minval=0.5, step=0.1, group=groupFilters)
wickRejectionMult = input.float(0.9, "Level reaction: wick >= x body", minval=0.1, step=0.1, group=groupFilters)
stopBufAtr = input.float(0.25, "Stop buffer (x ATR) beyond invalidation", minval=0.0, step=0.05, group=groupFilters)

groupGrading = "Grading"
gradeA = input.int(80, "Grade A threshold", minval=0, maxval=100, group=groupGrading)
gradeB = input.int(65, "Grade B threshold", minval=0, maxval=100, group=groupGrading)
gradeC = input.int(50, "Grade C threshold", minval=0, maxval=100, group=groupGrading)

//------------------------------------------------------------------------------
// Helpers
//------------------------------------------------------------------------------
is1H = timeframe.isminutes and timeframe.multiplier == 60

f_txtSize(_s) =>
    if _s == "tiny"
        size.tiny
    else if _s == "small"
        size.small
    else if _s == "normal"
        size.normal
    else
        size.large

txtSize = f_txtSize(uiTextSize)

f_c(_col) => color.new(_col, uiOpacity)

colOk  = f_c(color.lime)
colBad = f_c(color.red)
colNA  = f_c(color.gray)
colHdr = f_c(color.silver)
colBg  = f_c(color.black)
colSep = f_c(color.new(color.gray, math.min(100, uiOpacity + 40)))

f_statusColor(_ok, _na) =>
    _na ? colNA : (_ok ? colOk : colBad)

f_boolToText(_ok, _na) =>
    _na ? "-" : (_ok ? "YES" : "NO")

f_gateText(_ok, _na, _reason) =>
    _na ? "-" : (_ok ? "YES" : _reason)

f_grade(_score) =>
    if _score >= gradeA
        "A"
    else if _score >= gradeB
        "B"
    else if _score >= gradeC
        "C"
    else
        "D"

f_gradeRank(_g) =>
    _g == "A" ? 4 : _g == "B" ? 3 : _g == "C" ? 2 : 1

f_gradeFromRank(_r) =>
    _r >= 4 ? "A" : _r == 3 ? "B" : _r == 2 ? "C" : "D"

f_capGrade(_base, _cap) =>
    f_gradeFromRank(math.min(f_gradeRank(_base), f_gradeRank(_cap)))

f_confBand(_v) =>
    _v > 75 ? "HIGH" : (_v >= 55 ? "WATCH" : "LOW")

f_qualityBand(_v) =>
    _v >= 75 ? "HIGH" : (_v >= 55 ? "MEDIUM" : "LOW")

f_pickSupport(_last, _prev, _px) =>
    float _s = na
    if not na(_last) and _last <= _px
        _s := _last
    if not na(_prev) and _prev <= _px
        _s := na(_s) ? _prev : ((_px - _prev) < (_px - _s) ? _prev : _s)
    _s

f_pickResist(_last, _prev, _px) =>
    float _r = na
    if not na(_last) and _last >= _px
        _r := _last
    if not na(_prev) and _prev >= _px
        _r := na(_r) ? _prev : ((_prev - _px) < (_r - _px) ? _prev : _r)
    _r

//------------------------------------------------------------------------------
// Data
//------------------------------------------------------------------------------
atr = ta.atr(atrLen)
rsi = ta.rsi(close, rsiLen)
[macdLine, macdSignal, macdHist] = ta.macd(close, 12, 26, 9)

volSma = ta.sma(volume, volLen)
ema20 = ta.ema(close, 20)
symAtrPct = close > 0 ? atr / close : na
symVolCtxTxt = na(symAtrPct) ? "N/A" : (symAtrPct >= 0.04 ? "HIGH" : (symAtrPct >= 0.02 ? "NORMAL" : "LOW"))

// Bench relative strength (ratio slope on 1H)
benchClose = request.security(benchSymbol, timeframe.period, close)
benchEma50 = request.security(benchSymbol, timeframe.period, ta.ema(close, 50))
benchVwap = request.security(benchSymbol, timeframe.period, ta.vwap(hlc3))
rs = close / benchClose
rsSlope = ta.linreg(rs, 14, 0) - ta.linreg(rs, 14, 1)
benchBiasBull = benchClose > benchEma50
benchBiasBear = benchClose < benchEma50
benchBiasTxt = benchBiasBull ? "BULLISH" : (benchBiasBear ? "BEARISH" : "NEUTRAL")
benchVwapTxt = na(benchVwap) ? "N/A" : (benchClose >= benchVwap ? "ABOVE VWAP" : "BELOW VWAP")
riskRegimeTxt = na(benchVwap) ? "N/A" : (benchBiasBull and benchClose >= benchVwap ? "RISK-ON" : (benchBiasBear and benchClose < benchVwap ? "RISK-OFF" : "MIXED"))
benchSlope = ta.linreg(benchClose, 20, 0) - ta.linreg(benchClose, 20, 1)
benchAtrPct = request.security(benchSymbol, timeframe.period, close > 0 ? ta.atr(14) / close : na)
benchSlopePct = benchClose > 0 ? math.abs(benchSlope / benchClose) : na
marketRegimeTxt = not na(benchAtrPct) and benchAtrPct > 0.025 ? "VOLATILE" : (not na(benchSlopePct) and benchSlopePct > 0.0009 ? "TREND" : "CHOP")
benchStructureUp = benchClose > benchEma50 and benchSlope > 0
benchStructureDn = benchClose < benchEma50 and benchSlope < 0
benchStructureTxt = benchStructureUp ? "UP STRUCTURE" : (benchStructureDn ? "DOWN STRUCTURE" : "RANGE STRUCTURE")
benchRsi = request.security(benchSymbol, timeframe.period, ta.rsi(close, 14))
benchMomentumTxt = benchRsi >= 55 ? "BULL MOM" : (benchRsi <= 45 ? "BEAR MOM" : "NEUTRAL MOM")
symRet = close[1] > 0 ? math.log(close / close[1]) : na
benchRet = request.security(benchSymbol, timeframe.period, close[1] > 0 ? math.log(close / close[1]) : na)
corrLookback = 40
symBenchCorr = ta.correlation(symRet, benchRet, corrLookback)
corrBand = na(symBenchCorr) ? "N/A" : (symBenchCorr >= 0.70 ? "HIGH +" : (symBenchCorr >= 0.40 ? "MED +" : "LOW +"))
corrTxt = na(symBenchCorr) ? "N/A" : (corrBand + " (" + str.tostring(symBenchCorr, "#.##") + ")")
marketBullRegime = benchBiasBull and (na(benchVwap) or benchClose >= benchVwap)
marketBearRegime = benchBiasBear and (na(benchVwap) or benchClose <= benchVwap)
marketMixedRegime = not marketBullRegime and not marketBearRegime
callMarketSupport = marketBullRegime
putMarketSupport  = marketBearRegime
callMarketOk = callMarketSupport or marketMixedRegime
putMarketOk  = putMarketSupport  or marketMixedRegime

// HTF alignment: simple HTF trend based on HTF close vs EMA
htfClose = request.security(syminfo.tickerid, htfForAlignment, close)
htfEma = request.security(syminfo.tickerid, htfForAlignment, ta.ema(close, 50))
htfBull = htfClose > htfEma
htfBear = htfClose < htfEma

// Pivots for structure
ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low, pivLen, pivLen)

var float lastPH = na
var float prevPH = na
var float lastPL = na
var float prevPL = na

if not na(ph)
    prevPH := lastPH
    lastPH := ph

if not na(pl)
    prevPL := lastPL
    lastPL := pl

// Structure direction proxy
bullStructure = not na(lastPH) and not na(prevPH) and not na(lastPL) and not na(prevPL) and lastPH > prevPH and lastPL > prevPL
bearStructure = not na(lastPH) and not na(prevPH) and not na(lastPL) and not na(prevPL) and lastPH < prevPH and lastPL < prevPL

// Trend/range/breakout proxy using BB + structure
basis = ta.sma(close, bbLen)
dev = bbMult * ta.stdev(close, bbLen)
bbU = basis + dev
bbL = basis - dev
bbWidth = (bbU - bbL) / basis
bbWidthMA = ta.sma(bbWidth, bbLen)

isCompression = bbWidth < bbWidthMA
isExpansion = bbWidth > bbWidthMA

// Simple range proxy: low directional strength
[diPlus, diMinus, adx] = ta.dmi(14, 14)
isRange = adx < 18

// Overlap ratio (chaos filter): overlap of candle ranges vs total range
rng = high - low
prevRng = high[1] - low[1]
overlap = math.max(0.0, math.min(high, high[1]) - math.max(low, low[1]))
overlapRatio = (rng > 0 and prevRng > 0) ? (overlap / math.min(rng, prevRng)) : na
isChaos = not na(overlapRatio) and overlapRatio > chaosOverlapThresh and isRange

// Key levels with fallback when local pivots are missing: W -> M -> 12M -> ATR proxy.
pivotSupport = f_pickSupport(lastPL, prevPL, close)
pivotResist  = f_pickResist(lastPH, prevPH, close)

wkLow  = request.security(syminfo.tickerid, "W", low[1])
wkHigh = request.security(syminfo.tickerid, "W", high[1])
moLow  = request.security(syminfo.tickerid, "M", low[1])
moHigh = request.security(syminfo.tickerid, "M", high[1])
yrLow  = request.security(syminfo.tickerid, "12M", low[1])
yrHigh = request.security(syminfo.tickerid, "12M", high[1])

fallbackSupport = not na(wkLow) ? wkLow : (not na(moLow) ? moLow : (not na(yrLow) ? yrLow : na))
fallbackResist  = not na(wkHigh) ? wkHigh : (not na(moHigh) ? moHigh : (not na(yrHigh) ? yrHigh : na))

nearestSupport = not na(pivotSupport) ? pivotSupport : (not na(fallbackSupport) ? fallbackSupport : (not na(atr) ? close - 2.0 * atr : low))
nearestResist  = not na(pivotResist)  ? pivotResist  : (not na(fallbackResist)  ? fallbackResist  : (not na(atr) ? close + 2.0 * atr : high))
supportLevelType = not na(pivotSupport) ? "PIVOT S" : (not na(wkLow) ? "WEEK LOW" : (not na(moLow) ? "MONTH LOW" : (not na(yrLow) ? "12M LOW" : "FALLBACK ATR ZONE")))
resistLevelType  = not na(pivotResist)  ? "PIVOT R" : (not na(wkHigh) ? "WEEK HIGH" : (not na(moHigh) ? "MONTH HIGH" : (not na(yrHigh) ? "12M HIGH" : "FALLBACK ATR ZONE")))

distToSupport = not na(nearestSupport) ? math.abs(close - nearestSupport) : na
distToResist  = not na(nearestResist)  ? math.abs(close - nearestResist)  : na

nearSupport = not na(distToSupport) and distToSupport <= atrLocMult * atr
nearResist  = not na(distToResist)  and distToResist  <= atrLocMult * atr
nearEma20 = atr > 0 ? math.abs(close - ema20) <= atrLocMult * atr : false

// Rejection at level (wick/body)
body = math.abs(close - open)
upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low
bullRejection = body > 0 ? (lowerWick >= wickRejectionMult * body) : false
bearRejection = body > 0 ? (upperWick >= wickRejectionMult * body) : false

// Impulse + pullback volume proxy
isBullImpulse = close > open and volume >= volSma * volBreakMult
isBearImpulse = close < open and volume >= volSma * volBreakMult

// "DTE comfort": last N-bar impulse not too extended vs ATR
nImpulse = 8
impulseMove = math.abs(close - close[nImpulse])
distToEma = math.abs(close - ema20)
distEmaAtr = atr > 0 ? (distToEma / atr) : na
isExtended = not na(distEmaAtr) and distEmaAtr > extendedAtr
impulseOK = impulseMove <= impulseAtrThresh * atr and not isExtended

// Proposed invalidation levels and stops (structure-based)
callInvalid = nearestSupport
putInvalid  = nearestResist

callStop = not na(callInvalid) ? callInvalid - stopBufAtr * atr : na
putStop  = not na(putInvalid)  ? putInvalid  + stopBufAtr * atr : na

callRisk = not na(callStop) ? math.abs(close - callStop) : na
putRisk  = not na(putStop)  ? math.abs(putStop - close) : na

// Target space proxy: next pivot opposite side
callTarget = nearestResist
putTarget  = nearestSupport

callRewardSr = not na(callTarget) ? math.abs(callTarget - close) : na
putRewardSr  = not na(putTarget)  ? math.abs(close - putTarget) : na

callRewardAlt = not na(callRisk) ? (1.5 * callRisk) : na
putRewardAlt  = not na(putRisk)  ? (1.5 * putRisk)  : na

callReward = not na(callRewardSr) and not na(callRewardAlt) ? math.max(callRewardSr, callRewardAlt) : (not na(callRewardSr) ? callRewardSr : callRewardAlt)
putReward  = not na(putRewardSr) and not na(putRewardAlt)  ? math.max(putRewardSr, putRewardAlt)   : (not na(putRewardSr)  ? putRewardSr  : putRewardAlt)

callRR = (not na(callRisk) and callRisk > 0 and not na(callReward)) ? (callReward / callRisk) : na
putRR  = (not na(putRisk) and putRisk > 0 and not na(putReward))   ? (putReward / putRisk)  : na

rrHardFloorEff = math.min(rrHardFloor, minRR)
callRRHardOk = not na(callRR) and callRR >= rrHardFloorEff
putRRHardOk  = not na(putRR)  and putRR  >= rrHardFloorEff
callRrSoftBand = not na(callRR) and callRR >= rrHardFloorEff and callRR < minRR
putRrSoftBand  = not na(putRR)  and putRR  >= rrHardFloorEff and putRR  < minRR
callHasRR = not na(callRR) and callRR >= minRR
putHasRR  = not na(putRR)  and putRR  >= minRR

// Momentum health
callMomentumOk = (rsi >= rsiTrendLevel) and (macdHist >= 0)
putMomentumOk  = (rsi <= (100 - rsiTrendLevel)) and (macdHist <= 0)

// Alignment with HTF
callAligned = htfBull
putAligned  = htfBear

// Relative strength
rsNeutralBand = 0.00002
rsStronger = not na(rsSlope) and rsSlope > rsNeutralBand
rsWeaker   = not na(rsSlope) and rsSlope < -rsNeutralBand
rsNeutral  = not na(rsSlope) and not rsStronger and not rsWeaker
callRSOk = rsStronger
putRSOk  = rsWeaker

// Structure confirmation (minor breakout proxy): close > prior swing high / close < prior swing low
callConf = not na(prevPH) and close > prevPH
putConf  = not na(prevPL) and close < prevPL

// 1H state machine: pullback -> reversal -> continuation
callPullbackState = callAligned and close < ema20 and (rsi < rsiTrendLevel or macdHist < 0)
putPullbackState  = putAligned  and close > ema20 and (rsi > (100 - rsiTrendLevel) or macdHist > 0)

callReversalStructureOk = not na(lastPL) and (na(prevPL) or lastPL >= prevPL)
putReversalStructureOk  = not na(lastPH) and (na(prevPH) or lastPH <= prevPH)

// Require two closes back above/below EMA20 + basic structure sanity to reduce chop flips.
callReversalState = callAligned and close > ema20 and close[1] > ema20[1] and close[2] <= ema20[2] and (rsi >= rsiTrendLevel or macdHist > macdHist[1]) and callReversalStructureOk
putReversalState  = putAligned  and close < ema20 and close[1] < ema20[1] and close[2] >= ema20[2] and (rsi <= (100 - rsiTrendLevel) or macdHist < macdHist[1]) and putReversalStructureOk

callContinuationState = callAligned and close >= ema20 and (bullStructure or callConf)
putContinuationState  = putAligned  and close <= ema20 and (bearStructure or putConf)

callStateReady = callReversalState or callContinuationState
putStateReady  = putReversalState or putContinuationState

callStateTxt = callPullbackState ? "PULLBACK" : callReversalState ? "REVERSAL" : callContinuationState ? "CONTINUATION" : "NEUTRAL"
putStateTxt  = putPullbackState  ? "PULLBACK" : putReversalState  ? "REVERSAL" : putContinuationState  ? "CONTINUATION" : "NEUTRAL"

// Clean structure & clarity proxy
trendStructureClean = bullStructure or bearStructure
rangeStructureAcceptable = isRange and not isChaos
structureClear = trendStructureClean or rangeStructureAcceptable
callTrendClarityOk = bullStructure or callReversalStructureOk or rangeStructureAcceptable
putTrendClarityOk  = bearStructure or putReversalStructureOk or rangeStructureAcceptable
messyStructure = isChaos

// Directional thesis: aligned trends plus valid countertrend structures.
callCountertrendOk = (not callAligned) and (bullStructure or callReversalStructureOk or callConf)
putCountertrendOk  = (not putAligned)  and (bearStructure or putReversalStructureOk or putConf)
callDirectionalOk = callAligned or callCountertrendOk
putDirectionalOk  = putAligned  or putCountertrendOk

// Location logic (planning TF): structural S/R OR MA pullback zone OR compression base.
callStructuralLoc = nearSupport or nearResist
putStructuralLoc  = nearResist  or nearSupport
callMaPullbackLoc = nearEma20 and close <= ema20 + 0.25 * atr
putMaPullbackLoc  = nearEma20 and close >= ema20 - 0.25 * atr
callCompressionLoc = isCompression and close >= ema20 and callTrendClarityOk
putCompressionLoc  = isCompression and close <= ema20 and putTrendClarityOk
callLocationOk = callStructuralLoc or callMaPullbackLoc or callCompressionLoc
putLocationOk  = putStructuralLoc  or putMaPullbackLoc  or putCompressionLoc

// Level behavior: reaction near level + rejection wick
safeResist = na(nearestResist) ? (close + 10.0 * atr) : nearestResist
safeSupport = na(nearestSupport) ? (close - 10.0 * atr) : nearestSupport
crossUpResRaw = ta.crossover(close, safeResist)
crossDnSupRaw = ta.crossunder(close, safeSupport)
crossUpRes = not na(nearestResist) and crossUpResRaw
crossDnSup = not na(nearestSupport) and crossDnSupRaw
callLevelBehavior = (nearSupport and bullRejection) or (nearResist and crossUpRes)
putLevelBehavior  = (nearResist and bearRejection)  or (nearSupport and crossDnSup)

// Stop sync with options: avoid too tight vs ATR (risk >= 0.5 ATR) and not enormous (<= 4 ATR)
callStopSync = not na(callRisk) and callRisk >= 0.5 * atr and callRisk <= 4.0 * atr
putStopSync  = not na(putRisk)  and putRisk  >= 0.5 * atr and putRisk  <= 4.0 * atr

// Volume support (impulse with volume OR breakout with volume)
callVolOk = isBullImpulse or (callConf and volume >= volSma)
putVolOk  = isBearImpulse or (putConf  and volume >= volSma)

// Swing-friendly environment
swingFriendly = not isChaos

// Compression vs exhaustion: prefer compression before breakout OR expansion with follow-through
callCompressionOk = isCompression or (isExpansion and callConf)
putCompressionOk  = isCompression or (isExpansion and putConf)

// A/B clarity proxy: few conflicts
callAB = callAligned and (bullStructure or callConf) and callLocationOk and callStateReady
putAB  = putAligned  and (bearStructure or putConf)  and putLocationOk and putStateReady

//------------------------------------------------------------------------------
// Scoring weights (sum = 100) from the provided file
//------------------------------------------------------------------------------
w1  = 14 // structure clear
w2  = 12 // location
w3  = 12 // direction confirmation
w4  = 7  // volume
w5  = 13 // risk / invalidation
w6  = 5  // momentum
w7  = 6  // swing-friendly
w8  = 8  // target space
w9  = 6  // stop sync
w10 = 5  // A/B grading clarity
w11 = 4  // HTF alignment
w12 = 4  // compression vs exhaustion
w13 = 2  // DTE comfort
w14 = 1  // relative strength
w15 = 11 // level behavior

f_score(_ok, _w) => _ok ? _w : 0

// Conditions by direction
callQ1  = structureClear
putQ1   = structureClear

callQ2  = callLocationOk
putQ2   = putLocationOk

callQ3  = bullStructure or callConf
putQ3   = bearStructure or putConf

callQ4  = callVolOk
putQ4   = putVolOk

callQ5  = not na(callInvalid) and not na(callStop) and callRisk > 0
putQ5   = not na(putInvalid)  and not na(putStop)  and putRisk  > 0

callQ6  = callMomentumOk
putQ6   = putMomentumOk

callQ7  = swingFriendly
putQ7   = swingFriendly

callQ8  = callHasRR
putQ8   = putHasRR

callQ9  = callStopSync
putQ9   = putStopSync

callQ10 = callAB
putQ10  = putAB

callQ11 = callAligned
putQ11  = putAligned

callQ12 = callCompressionOk
putQ12  = putCompressionOk

callQ13 = impulseOK
putQ13  = impulseOK

callQ14 = callRSOk
putQ14  = putRSOk

callQ15 = callLevelBehavior
putQ15  = putLevelBehavior

callRawScore = f_score(callQ1, w1)
callRawScore := callRawScore + f_score(callQ2, w2)
callRawScore := callRawScore + f_score(callQ3, w3)
callRawScore := callRawScore + f_score(callQ4, w4)
callRawScore := callRawScore + f_score(callQ5, w5)
callRawScore := callRawScore + f_score(callQ6, w6)
callRawScore := callRawScore + f_score(callQ7, w7)
callRawScore := callRawScore + f_score(callQ8, w8)
callRawScore := callRawScore + f_score(callQ9, w9)
callRawScore := callRawScore + f_score(callQ10, w10)
callRawScore := callRawScore + f_score(callQ11, w11)
callRawScore := callRawScore + f_score(callQ12, w12)
callRawScore := callRawScore + f_score(callQ13, w13)
callRawScore := callRawScore + f_score(callQ14, w14)
callRawScore := callRawScore + f_score(callQ15, w15)

putRawScore = f_score(putQ1, w1)
putRawScore := putRawScore + f_score(putQ2, w2)
putRawScore := putRawScore + f_score(putQ3, w3)
putRawScore := putRawScore + f_score(putQ4, w4)
putRawScore := putRawScore + f_score(putQ5, w5)
putRawScore := putRawScore + f_score(putQ6, w6)
putRawScore := putRawScore + f_score(putQ7, w7)
putRawScore := putRawScore + f_score(putQ8, w8)
putRawScore := putRawScore + f_score(putQ9, w9)
putRawScore := putRawScore + f_score(putQ10, w10)
putRawScore := putRawScore + f_score(putQ11, w11)
putRawScore := putRawScore + f_score(putQ12, w12)
putRawScore := putRawScore + f_score(putQ13, w13)
putRawScore := putRawScore + f_score(putQ14, w14)
putRawScore := putRawScore + f_score(putQ15, w15)

trendW = w1 + w3 + w7 + w10 + w11 + w12 + w14
entryW = w2 + w4 + w5 + w8 + w9 + w13 + w15

callTrendRaw = f_score(callQ1, w1) + f_score(callQ3, w3) + f_score(callQ7, w7) + f_score(callQ10, w10) + f_score(callQ11, w11) + f_score(callQ12, w12) + f_score(callQ14, w14)
putTrendRaw  = f_score(putQ1, w1)  + f_score(putQ3, w3)  + f_score(putQ7, w7)  + f_score(putQ10, w10)  + f_score(putQ11, w11)  + f_score(putQ12, w12)  + f_score(putQ14, w14)

callEntryRaw = f_score(callQ2, w2) + f_score(callQ4, w4) + f_score(callQ5, w5) + f_score(callQ8, w8) + f_score(callQ9, w9) + f_score(callQ13, w13) + f_score(callQ15, w15)
putEntryRaw  = f_score(putQ2, w2)  + f_score(putQ4, w4)  + f_score(putQ5, w5)  + f_score(putQ8, w8)  + f_score(putQ9, w9)  + f_score(putQ13, w13)  + f_score(putQ15, w15)

callTrendScore = trendW > 0 ? 100.0 * callTrendRaw / trendW : 0.0
putTrendScore  = trendW > 0 ? 100.0 * putTrendRaw  / trendW : 0.0

callEntryScore = entryW > 0 ? 100.0 * callEntryRaw / entryW : 0.0
putEntryScore  = entryW > 0 ? 100.0 * putEntryRaw  / entryW : 0.0

callScore = math.min(callTrendScore, callEntryScore)
putScore  = math.min(putTrendScore, putEntryScore)

callConfidenceBase = math.max(0.0, math.min(100.0, callScore + (callTrendScore - callEntryScore) / 4.0))
putConfidenceBase  = math.max(0.0, math.min(100.0, putScore  + (putTrendScore  - putEntryScore)  / 4.0))
callIndicatorSoftPenalty = not callMomentumOk ? 4.0 : 0.0
putIndicatorSoftPenalty  = not putMomentumOk  ? 4.0 : 0.0
callConfidence = math.max(0.0, math.min(100.0, callConfidenceBase - callIndicatorSoftPenalty))
putConfidence  = math.max(0.0, math.min(100.0, putConfidenceBase  - putIndicatorSoftPenalty))
callConfTxt = str.tostring(callConfidence, "#.##") + " " + f_confBand(callConfidence)
putConfTxt  = str.tostring(putConfidence,  "#.##") + " " + f_confBand(putConfidence)

//------------------------------------------------------------------------------
// Table rendering
//------------------------------------------------------------------------------
var int COL_METRIC = 0
var int COL_PUT    = 1
var int COL_CALL   = 2

var table t = table.new(position.top_right, 3, 1, border_width=1)

f_setCell(_row, _col, _txt, _bg, _tc) =>
    table.cell(t, _col, _row, _txt, text_color=_tc, bgcolor=_bg, text_size=txtSize)

f_clearTable(_rows) =>
    for r = 0 to _rows - 1
        for c = 0 to 2
            f_setCell(r, c, "", color.new(color.black, 100), color.new(color.white, 100))

// Build table size dynamically (but table must be created with fixed rows)
// We create max rows and use only what we need.
maxRows = 64
if barstate.isfirst
    t := table.new(position.top_right, 3, maxRows, border_width=1)

f_hdrRow(_r, _title) =>
    f_setCell(_r, COL_METRIC, _title, colHdr, f_c(color.black))
    f_setCell(_r, COL_PUT,    "PUT",   colHdr, f_c(color.black))
    f_setCell(_r, COL_CALL,   "CALL",  colHdr, f_c(color.black))

f_sectionRow(_r, _title) =>
    f_setCell(_r, COL_METRIC, _title, colSep, f_c(color.white))
    f_setCell(_r, COL_PUT,    "",     colSep, f_c(color.white))
    f_setCell(_r, COL_CALL,   "",     colSep, f_c(color.white))

f_metricRow(_r, _name, _putTxt, _putCol, _callTxt, _callCol) =>
    f_setCell(_r, COL_METRIC, _name, colBg, f_c(color.white))
    f_setCell(_r, COL_PUT,    _putTxt,  _putCol, f_c(color.white))
    f_setCell(_r, COL_CALL,   _callTxt, _callCol, f_c(color.white))

f_valueRow(_r, _name, _putVal, _callVal) =>
    f_setCell(_r, COL_METRIC, _name, colBg, f_c(color.white))
    f_setCell(_r, COL_PUT,  _putVal, colBg, f_c(color.white))
    f_setCell(_r, COL_CALL, _callVal,colBg, f_c(color.white))

// Visibility filters for columns
showPut  = modeShowBoth ? true : (modeFocus == "PUT")
showCall = modeShowBoth ? true : (modeFocus == "CALL")

f_applyColVisibility(_r) =>
    // If one side is hidden, blank it with fully transparent colors.
    if not showPut
        f_setCell(_r, COL_PUT, "", color.new(color.black, 100), color.new(color.white, 100))
    if not showCall
        f_setCell(_r, COL_CALL, "", color.new(color.black, 100), color.new(color.white, 100))

f_failReason(_id, _isPut) =>
    if _id == 1
        "no clear structure"
    else if _id == 2
        _isPut ? (not nearResist and not nearSupport ? "not near S/R" : (nearSupport and not putConf ? "no breakdown" : "bad location")) : (not nearSupport and not nearResist ? "not near S/R" : (nearResist and not callConf ? "no breakout" : "bad location"))
    else if _id == 3
        _isPut ? "no bearish conf" : "no bullish conf"
    else if _id == 4
        _isPut ? (not isBearImpulse and not putConf ? "no impulse/conf" : "low volume") : (not isBullImpulse and not callConf ? "no impulse/conf" : "low volume")
    else if _id == 5
        _isPut ? (na(putInvalid) ? "no invalidation" : (na(putStop) ? "no stop" : "risk <= 0")) : (na(callInvalid) ? "no invalidation" : (na(callStop) ? "no stop" : "risk <= 0"))
    else if _id == 6
        _isPut ? (rsi > (100 - rsiTrendLevel) ? "RSI too high" : "MACD not bearish") : (rsi < rsiTrendLevel ? "RSI too low" : "MACD not bullish")
    else if _id == 7
        "chaotic regime"
    else if _id == 8
        _isPut ? (na(putRR) ? "RR n/a" : "RR below min") : (na(callRR) ? "RR n/a" : "RR below min")
    else if _id == 9
        _isPut ? (na(putRisk) ? "risk n/a" : (putRisk < 0.5 * atr ? "stop too tight" : "stop too wide")) : (na(callRisk) ? "risk n/a" : (callRisk < 0.5 * atr ? "stop too tight" : "stop too wide"))
    else if _id == 10
        _isPut ? (not putAligned ? "HTF misalign" : (not (bearStructure or putConf) ? "no dir conf" : (not putLocationOk ? "location bad" : (not putStateReady ? "state not ready" : "AB weak")))) : (not callAligned ? "HTF misalign" : (not (bullStructure or callConf) ? "no dir conf" : (not callLocationOk ? "location bad" : (not callStateReady ? "state not ready" : "AB weak"))))
    else if _id == 11
        _isPut ? "HTF not bearish" : "HTF not bullish"
    else if _id == 12
        _isPut ? (not isCompression and not isExpansion ? "flat regime" : "no downside follow" ) : (not isCompression and not isExpansion ? "flat regime" : "no upside follow")
    else if _id == 13
        "impulse overextended"
    else if _id == 14
        _isPut ? "RW not confirmed" : "RS not confirmed"
    else
        _isPut ? (not nearResist and not nearSupport ? "not at level" : (nearResist and not bearRejection ? "no reject at R" : "no break at S")) : (not nearSupport and not nearResist ? "not at level" : (nearSupport and not bullRejection ? "no reject at S" : "no break at R"))

f_checkRow(_r, _id, _name, _w, _putOk, _callOk, _putNa, _callNa) =>
    _putTxt = f_gateText(_putOk, _putNa, f_failReason(_id, true)) + " (" + str.tostring(_w) + ")"
    _calTxt = f_gateText(_callOk, _callNa, f_failReason(_id, false)) + " (" + str.tostring(_w) + ")"
    f_metricRow(_r, _name, _putTxt, f_statusColor(_putOk, _putNa), _calTxt, f_statusColor(_callOk, _callNa))
    f_applyColVisibility(_r)

f_updateSrLine(_ln, _y, _col) =>
    line _out = _ln
    if na(_y)
        if not na(_out)
            line.delete(_out)
            _out := na
    else
        _x1 = bar_index
        _x2 = bar_index + 3
        if na(_out)
            _out := line.new(_x1, _y, _x2, _y, xloc=xloc.bar_index, extend=extend.none, color=_col, width=1)
        else
            line.set_xy1(_out, _x1, _y)
            line.set_xy2(_out, _x2, _y)
            line.set_color(_out, _col)
            line.set_width(_out, 1)
    _out

var line srSupportLine = na
var line srResistLine = na

// Render condition (table only on 1H if enabled)
render = uiShow and (not onlyOn1H or is1H)

srSupportLine := f_updateSrLine(srSupportLine, render ? nearestSupport : na, f_c(color.teal))
srResistLine := f_updateSrLine(srResistLine, render ? nearestResist : na, f_c(color.orange))

if not render
    // Clear cells so nothing remains visible.
    f_clearTable(maxRows)
    if uiShowHintWhenNot1H and uiShow and onlyOn1H and not is1H
        // show a minimal hint in first row (still respects opacity)
        f_setCell(0, COL_METRIC, "Switch to 1H to view options table", colBg, f_c(color.orange))
else
    // Header
    row = 0
    f_hdrRow(row, "SWING OPTIONS 1H - TRADE PLAN")
    f_applyColVisibility(row)
    row += 1

    // 1H state engine
    callNoTradeState = (not callDirectionalOk) or (not callQ5) or (not callRRHardOk)
    putNoTradeState  = (not putDirectionalOk)  or (not putQ5)  or (not putRRHardOk)

    callWaitPullbackState = callDirectionalOk and isExtended
    putWaitPullbackState  = putDirectionalOk  and isExtended

    callPlanBaseOk = callDirectionalOk and callLocationOk and callQ5 and callRRHardOk and not isExtended
    putPlanBaseOk  = putDirectionalOk  and putLocationOk  and putQ5  and putRRHardOk  and not isExtended

    callReadyConfirmOk = callLevelBehavior or callConf
    putReadyConfirmOk  = putLevelBehavior  or putConf
    callReadyForLtfState = callPlanBaseOk and callTrendClarityOk and not messyStructure and callHasRR
    putReadyForLtfState  = putPlanBaseOk  and putTrendClarityOk  and not messyStructure and putHasRR

    callSetupDevelopingState = callPlanBaseOk and not callReadyForLtfState and (callRrSoftBand or callTrendClarityOk or callStructuralLoc or callPullbackState or callReversalStructureOk or bullStructure or callCompressionLoc or callMaPullbackLoc or callConf)
    putSetupDevelopingState  = putPlanBaseOk  and not putReadyForLtfState  and (putRrSoftBand  or putTrendClarityOk  or putStructuralLoc  or putPullbackState  or putReversalStructureOk  or bearStructure or putCompressionLoc  or putMaPullbackLoc  or putConf)
    callWaitReversalState = callPlanBaseOk and not callReadyForLtfState and not callSetupDevelopingState
    putWaitReversalState  = putPlanBaseOk  and not putReadyForLtfState  and not putSetupDevelopingState

    callNoTradeStatus = not callDirectionalOk ? "NO TRADE (NO THESIS)" : (not callQ5 ? "NO TRADE (NO STOP)" : "NO TRADE (RR)")
    putNoTradeStatus  = not putDirectionalOk  ? "NO TRADE (NO THESIS)" : (not putQ5  ? "NO TRADE (NO STOP)" : "NO TRADE (RR)")
    callStatus = callNoTradeState ? callNoTradeStatus : (callWaitPullbackState ? "WAIT PULLBACK" : (callWaitReversalState ? "WAIT REVERSAL" : (callSetupDevelopingState ? "SETUP DEVELOPING" : (callReadyForLtfState ? "READY FOR LTF CONFIRMATION" : "WAIT REVERSAL"))))
    putStatus  = putNoTradeState  ? putNoTradeStatus  : (putWaitPullbackState  ? "WAIT PULLBACK" : (putWaitReversalState  ? "WAIT REVERSAL" : (putSetupDevelopingState  ? "SETUP DEVELOPING" : (putReadyForLtfState  ? "READY FOR LTF CONFIRMATION" : "WAIT REVERSAL"))))
    callState = callNoTradeState ? "NO TRADE" : (callReadyForLtfState ? "SETUP READY" : (callSetupDevelopingState ? "SETUP DEVELOPING" : "WAIT 1H CONFIRMATION"))
    putState  = putNoTradeState  ? "NO TRADE" : (putReadyForLtfState  ? "SETUP READY" : (putSetupDevelopingState  ? "SETUP DEVELOPING" : "WAIT 1H CONFIRMATION"))
    callStateCol = callState == "SETUP READY" ? colOk : (callState == "NO TRADE" ? colBad : colBg)
    putStateCol = putState == "SETUP READY" ? colOk : (putState == "NO TRADE" ? colBad : colBg)
    callNextStep = callState == "SETUP READY" ? "DROP TO 15M" : (callState == "NO TRADE" ? "SKIP" : "WAIT REACTION")
    putNextStep  = putState == "SETUP READY" ? "DROP TO 15M" : (putState == "NO TRADE" ? "SKIP" : "WAIT REACTION")
    callNextStepCol = callState == "SETUP READY" ? colOk : (callState == "NO TRADE" ? colBad : colBg)
    putNextStepCol = putState == "SETUP READY" ? colOk : (putState == "NO TRADE" ? colBad : colBg)
    callGradeCap = callState == "NO TRADE" ? "D" : (callState == "SETUP READY" ? "A" : (callState == "SETUP DEVELOPING" ? "B" : "C"))
    putGradeCap  = putState == "NO TRADE" ? "D" : (putState == "SETUP READY" ? "A" : (putState == "SETUP DEVELOPING" ? "B" : "C"))
    callGrade = f_capGrade(f_grade(callScore), callGradeCap)
    putGrade  = f_capGrade(f_grade(putScore), putGradeCap)

    // Strict final decision gate for quick top-level answer.
    putFinalDecisionOk = putMarketOk and putTrendClarityOk and not messyStructure and putQ5 and putHasRR
    callFinalDecisionOk = callMarketOk and callTrendClarityOk and not messyStructure and callQ5 and callHasRR
    putFinalDecisionTxt = putFinalDecisionOk ? "TRADE" : "NO TRADE"
    callFinalDecisionTxt = callFinalDecisionOk ? "TRADE" : "NO TRADE"

    putDecisionReason = putFinalDecisionOk ? "ALL CORE FILTERS PASS" : (not putMarketOk ? (marketRegimeTxt == "CHOP" ? "MARKET CHOP" : "MARKET MISALIGNED") : (messyStructure or not putTrendClarityOk ? "STRUCTURE NOT CLEAN" : (not putRSOk ? "NO REL WEAKNESS" : (not putLocationOk ? "LOCATION INVALID" : (not putReadyConfirmOk ? "NO CONFIRMATION" : (not putVolOk ? "NO VOLUME CONFIRM" : (not putQ5 ? "RISK UNDEFINED" : (not putHasRR ? "RR BELOW FULL" : "FILTERS NOT ALIGNED"))))))))
    callDecisionReason = callFinalDecisionOk ? "ALL CORE FILTERS PASS" : (not callMarketOk ? (marketRegimeTxt == "CHOP" ? "MARKET CHOP" : "MARKET MISALIGNED") : (messyStructure or not callTrendClarityOk ? "STRUCTURE NOT CLEAN" : (not callRSOk ? "NO REL STRENGTH" : (not callLocationOk ? "LOCATION INVALID" : (not callReadyConfirmOk ? "NO CONFIRMATION" : (not callVolOk ? "NO VOLUME CONFIRM" : (not callQ5 ? "RISK UNDEFINED" : (not callHasRR ? "RR BELOW FULL" : "FILTERS NOT ALIGNED"))))))))

    putAlignCol = putAligned ? colOk : (putDirectionalOk ? colNA : colBad)
    callAlignCol = callAligned ? colOk : (callDirectionalOk ? colNA : colBad)
    putStructureQualityTxt = messyStructure ? "MESSY" : (putTrendClarityOk ? "CLEAN" : "MIXED")
    callStructureQualityTxt = messyStructure ? "MESSY" : (callTrendClarityOk ? "CLEAN" : "MIXED")
    putStructureQualityCol = messyStructure ? colBad : (putTrendClarityOk ? colOk : colNA)
    callStructureQualityCol = messyStructure ? colBad : (callTrendClarityOk ? colOk : colNA)

    putLevelTxt = nearResist and not na(nearestResist) ? (resistLevelType + " @" + str.tostring(nearestResist, "#.####")) : (nearSupport and putConf and not na(nearestSupport) ? (supportLevelType + " BD @" + str.tostring(nearestSupport, "#.####")) : (putMaPullbackLoc ? "EMA20 PULLBACK ZONE" : (putCompressionLoc ? "COMPRESSION BASE" : "NONE")))
    callLevelTxt = nearSupport and not na(nearestSupport) ? (supportLevelType + " @" + str.tostring(nearestSupport, "#.####")) : (nearResist and callConf and not na(nearestResist) ? (resistLevelType + " BO @" + str.tostring(nearestResist, "#.####")) : (callMaPullbackLoc ? "EMA20 PULLBACK ZONE" : (callCompressionLoc ? "COMPRESSION BASE" : "NONE")))
    atrExtTxt = not na(distEmaAtr) ? (str.tostring(distEmaAtr, "#.##") + " ATR from EMA20") : "-"
    atrExtCol = f_statusColor(not isExtended, false)
    volCtxTxt = na(symAtrPct) ? "N/A" : (str.tostring(symAtrPct * 100.0, "#.##") + "% ATR (" + symVolCtxTxt + ")")
    volCtxCol = na(symAtrPct) ? colNA : (symAtrPct >= 0.04 ? colNA : colBg)
    rsNa = na(rsSlope)
    rsStateTxt = rsNa ? "N/A" : (rsStronger ? "STRONGER" : (rsWeaker ? "WEAKER" : "NEUTRAL"))
    putRsTxt = rsStateTxt
    callRsTxt = rsStateTxt
    putRsCol = rsNa ? colNA : (rsWeaker ? colOk : (rsStronger ? colBad : colNA))
    callRsCol = rsNa ? colNA : (rsStronger ? colOk : (rsWeaker ? colBad : colNA))
    putVolConfirmTxt = putVolOk ? "YES" : "NO"
    callVolConfirmTxt = callVolOk ? "YES" : "NO"

    putInvalidTxt = not na(putInvalid) ? str.tostring(putInvalid, "#.####") : "-"
    callInvalidTxt = not na(callInvalid) ? str.tostring(callInvalid, "#.####") : "-"
    putStopTxt = not na(putStop) ? str.tostring(putStop, "#.####") : "-"
    callStopTxt = not na(callStop) ? str.tostring(callStop, "#.####") : "-"
    putTargetTxt = not na(putTarget) ? str.tostring(putTarget, "#.####") : "-"
    callTargetTxt = not na(callTarget) ? str.tostring(callTarget, "#.####") : "-"
    rrPutTxt  = not na(putRR)  ? str.tostring(putRR, "#.##")  : "-"
    rrCallTxt = not na(callRR) ? str.tostring(callRR, "#.##") : "-"
    putRrCol = na(putRR) ? colNA : (putHasRR ? colOk : (putRRHardOk ? colNA : colBad))
    callRrCol = na(callRR) ? colNA : (callHasRR ? colOk : (callRRHardOk ? colNA : colBad))

    // DECISION (top priority, 3-5 second read)
    f_sectionRow(row, "DECISION")
    f_applyColVisibility(row)
    row += 1

    f_metricRow(row, "State", putState, putStateCol, callState, callStateCol)
    f_applyColVisibility(row)
    row += 1

    f_metricRow(row, "Grade", putGrade, colBg, callGrade, colBg)
    f_applyColVisibility(row)
    row += 1

    f_metricRow(row, "Next step", putNextStep, putNextStepCol, callNextStep, callNextStepCol)
    f_applyColVisibility(row)
    row += 1

    // MARKET
    f_sectionRow(row, "MARKET")
    f_applyColVisibility(row)
    row += 1

    f_metricRow(row, "Regime", marketRegimeTxt, colBg, marketRegimeTxt, colBg)
    f_applyColVisibility(row)
    row += 1

    marketBiasTxt = benchSymbol + ": " + benchBiasTxt
    f_metricRow(row, "Bias", marketBiasTxt, colBg, marketBiasTxt, colBg)
    f_applyColVisibility(row)
    row += 1

    spyStructureTxt = benchSymbol + ": " + benchStructureTxt
    f_metricRow(row, "Structure", spyStructureTxt, colBg, spyStructureTxt, colBg)
    f_applyColVisibility(row)
    row += 1

    f_metricRow(row, "Volatility ctx", volCtxTxt, volCtxCol, volCtxTxt, volCtxCol)
    f_applyColVisibility(row)
    row += 1

    // STRUCTURE
    f_sectionRow(row, "STRUCTURE")
    f_applyColVisibility(row)
    row += 1

    f_metricRow(row, "HTF aligned (" + htfForAlignment + ")", putAligned ? "YES" : "NO", putAlignCol, callAligned ? "YES" : "NO", callAlignCol)
    f_applyColVisibility(row)
    row += 1

    f_metricRow(row, "Structure quality", putStructureQualityTxt, putStructureQualityCol, callStructureQualityTxt, callStructureQualityCol)
    f_applyColVisibility(row)
    row += 1

    f_metricRow(row, "Relative strength", putRsTxt, putRsCol, callRsTxt, callRsCol)
    f_applyColVisibility(row)
    row += 1

    // LOCATION
    f_sectionRow(row, "LOCATION")
    f_applyColVisibility(row)
    row += 1

    f_metricRow(row, "Key level", putLevelTxt, colBg, callLevelTxt, colBg)
    f_applyColVisibility(row)
    row += 1

    f_metricRow(row, "ATR extension", atrExtTxt, atrExtCol, atrExtTxt, atrExtCol)
    f_applyColVisibility(row)
    row += 1

    f_metricRow(row, "Reaction / confirm", putReadyConfirmOk ? "YES" : "NO", f_statusColor(putReadyConfirmOk, false), callReadyConfirmOk ? "YES" : "NO", f_statusColor(callReadyConfirmOk, false))
    f_applyColVisibility(row)
    row += 1

    f_metricRow(row, "Volume confirm", putVolConfirmTxt, f_statusColor(putVolOk, false), callVolConfirmTxt, f_statusColor(callVolOk, false))
    f_applyColVisibility(row)
    row += 1

    // RISK
    f_sectionRow(row, "RISK")
    f_applyColVisibility(row)
    row += 1

    f_metricRow(row, "Invalidation", putInvalidTxt, colBg, callInvalidTxt, colBg)
    f_applyColVisibility(row)
    row += 1

    f_metricRow(row, "Stop", putStopTxt, colBg, callStopTxt, colBg)
    f_applyColVisibility(row)
    row += 1

    // REWARD
    f_sectionRow(row, "REWARD")
    f_applyColVisibility(row)
    row += 1

    f_metricRow(row, "Next target", putTargetTxt, colBg, callTargetTxt, colBg)
    f_applyColVisibility(row)
    row += 1

    f_metricRow(row, "RR (hard/full)", rrPutTxt, putRrCol, rrCallTxt, callRrCol)
    f_applyColVisibility(row)
    row += 1

    // DETAILS: compact checklist (no duplicate value table)
    if uiShowDetails
        row += 1
        f_sectionRow(row, "TRADE PLAN CHECKS")
        f_applyColVisibility(row)
        row += 1

        f_metricRow(row, "Decision reason", putDecisionReason, colBg, callDecisionReason, colBg)
        f_applyColVisibility(row)
        row += 1

        f_metricRow(row, "1) Market aligned", putMarketOk ? "YES" : "NO", f_statusColor(putMarketOk, false), callMarketOk ? "YES" : "NO", f_statusColor(callMarketOk, false))
        f_applyColVisibility(row)
        row += 1

        putStructureCheckOk = putTrendClarityOk and not messyStructure
        callStructureCheckOk = callTrendClarityOk and not messyStructure
        f_metricRow(row, "2) Structure clean", putStructureCheckOk ? "YES" : "NO", f_statusColor(putStructureCheckOk, false), callStructureCheckOk ? "YES" : "NO", f_statusColor(callStructureCheckOk, false))
        f_applyColVisibility(row)
        row += 1

        f_metricRow(row, "3) Location valid", putLocationOk ? "YES" : "NO", f_statusColor(putLocationOk, false), callLocationOk ? "YES" : "NO", f_statusColor(callLocationOk, false))
        f_applyColVisibility(row)
        row += 1

        putRewardCheckTxt = na(putRR) ? "-" : (putHasRR ? "FULL" : (putRRHardOk ? "SOFT" : "NO"))
        callRewardCheckTxt = na(callRR) ? "-" : (callHasRR ? "FULL" : (callRRHardOk ? "SOFT" : "NO"))
        putRewardCheckCol = na(putRR) ? colNA : (putHasRR ? colOk : (putRRHardOk ? colNA : colBad))
        callRewardCheckCol = na(callRR) ? colNA : (callHasRR ? colOk : (callRRHardOk ? colNA : colBad))
        f_metricRow(row, "4) RR acceptable", putRewardCheckTxt, putRewardCheckCol, callRewardCheckTxt, callRewardCheckCol)
        f_applyColVisibility(row)
        row += 1

    // Clear remaining unused rows
    if row < maxRows
        for r = row to maxRows - 1
            for c = 0 to 2
                f_setCell(r, c, "", color.new(color.black, 100), color.new(color.white, 100))
