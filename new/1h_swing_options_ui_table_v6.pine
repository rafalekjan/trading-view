//@version=6
indicator("Stock 1H", overlay=true, max_labels_count=500, max_lines_count=500)

//------------------------------------------------------------------------------
// Inputs (all user-configurable)
//------------------------------------------------------------------------------
groupUI   = "UI"
uiShow    = input.bool(true, "Show table", group=groupUI)
uiOpacity = input.int(10, "Table visibility (0=solid, 100=invisible)", minval=0, maxval=100, group=groupUI)
uiShowDetails = input.bool(true, "Show DETAILS section", group=groupUI)
uiTextSize = input.string("small", "Text size", options=["tiny","small","normal","large"], group=groupUI)
uiShowHintWhenNot1H = input.bool(false, "Show hint when not on 1H", group=groupUI)

groupMode = "Mode"
modeShowBoth = input.bool(true, "Show both PUT & CALL", group=groupMode)
modeFocus = input.string("BOTH", "Focus", options=["BOTH","CALL","PUT"], group=groupMode)

groupTF = "Timeframe gating"
onlyOn1H = input.bool(true, "Render table only on 1H", group=groupTF)

groupBench = "Benchmark / HTF"
benchSymbol = input.symbol("SPY", "Benchmark symbol (Relative Strength)", group=groupBench)
htfForAlignment = input.timeframe("D", "HTF for alignment", group=groupBench)

groupStructure = "Structure detection"
pivLen = input.int(5, "Pivot length (swing points)", minval=2, maxval=20, group=groupStructure)
lookbackBars = input.int(80, "Lookback bars for structure checks", minval=20, maxval=500, group=groupStructure)

groupFilters = "Filters / Thresholds"
atrLen = input.int(14, "ATR length", minval=1, group=groupFilters)
atrLocMult = input.float(0.8, "Location: max distance to key level (x ATR)", minval=0.1, step=0.1, group=groupFilters)
minRR = input.float(2.0, "Target space: minimum R multiple", minval=0.5, step=0.25, group=groupFilters)
volLen = input.int(20, "Volume SMA length", minval=1, group=groupFilters)
volBreakMult = input.float(1.2, "Volume: impulse vol >= SMA *", minval=0.5, step=0.1, group=groupFilters)
rsiLen = input.int(14, "RSI length", minval=1, group=groupFilters)
rsiTrendLevel = input.float(50.0, "RSI trend level", minval=1, maxval=99, step=1, group=groupFilters)
bbLen = input.int(20, "BB length (compression/exhaustion)", minval=5, group=groupFilters)
bbMult = input.float(2.0, "BB stdev", minval=0.5, step=0.1, group=groupFilters)
chaosOverlapThresh = input.float(0.55, "Chaos: overlap ratio threshold", minval=0.1, maxval=0.9, step=0.05, group=groupFilters)
impulseAtrThresh = input.float(2.5, "DTE comfort: last impulse <= x ATR", minval=0.5, step=0.25, group=groupFilters)
extendedAtr = input.float(1.6, "Extended if |close-EMA20| > x ATR", minval=0.5, step=0.1, group=groupFilters)
wickRejectionMult = input.float(0.9, "Level reaction: wick >= x body", minval=0.1, step=0.1, group=groupFilters)
stopBufAtr = input.float(0.25, "Stop buffer (x ATR) beyond invalidation", minval=0.0, step=0.05, group=groupFilters)

groupGrading = "Grading"
gradeA = input.int(80, "Grade A threshold", minval=0, maxval=100, group=groupGrading)
gradeB = input.int(65, "Grade B threshold", minval=0, maxval=100, group=groupGrading)
gradeC = input.int(50, "Grade C threshold", minval=0, maxval=100, group=groupGrading)

//------------------------------------------------------------------------------
// Helpers
//------------------------------------------------------------------------------
is1H = timeframe.isminutes and timeframe.multiplier == 60

f_txtSize(_s) =>
    if _s == "tiny"
        size.tiny
    else if _s == "small"
        size.small
    else if _s == "normal"
        size.normal
    else
        size.large

txtSize = f_txtSize(uiTextSize)

f_c(_col) => color.new(_col, uiOpacity)

colOk  = f_c(color.lime)
colBad = f_c(color.red)
colNA  = f_c(color.gray)
colHdr = f_c(color.silver)
colBg  = f_c(color.black)
colSep = f_c(color.new(color.gray, math.min(100, uiOpacity + 40)))

f_statusColor(_ok, _na) =>
    _na ? colNA : (_ok ? colOk : colBad)

f_boolToText(_ok, _na) =>
    _na ? "-" : (_ok ? "YES" : "NO")

f_gateText(_ok, _na, _reason) =>
    _na ? "-" : (_ok ? "YES" : _reason)

f_grade(_score) =>
    if _score >= gradeA
        "A"
    else if _score >= gradeB
        "B"
    else if _score >= gradeC
        "C"
    else
        "D"

f_gradeRank(_g) =>
    _g == "A" ? 4 : _g == "B" ? 3 : _g == "C" ? 2 : 1

f_gradeFromRank(_r) =>
    _r >= 4 ? "A" : _r == 3 ? "B" : _r == 2 ? "C" : "D"

f_capGrade(_base, _cap) =>
    f_gradeFromRank(math.min(f_gradeRank(_base), f_gradeRank(_cap)))

f_confBand(_v) =>
    _v > 75 ? "HIGH" : (_v >= 55 ? "WATCH" : "LOW")

f_pickSupport(_last, _prev, _px) =>
    float _s = na
    if not na(_last) and _last <= _px
        _s := _last
    if not na(_prev) and _prev <= _px
        _s := na(_s) ? _prev : ((_px - _prev) < (_px - _s) ? _prev : _s)
    _s

f_pickResist(_last, _prev, _px) =>
    float _r = na
    if not na(_last) and _last >= _px
        _r := _last
    if not na(_prev) and _prev >= _px
        _r := na(_r) ? _prev : ((_prev - _px) < (_r - _px) ? _prev : _r)
    _r

//------------------------------------------------------------------------------
// Data
//------------------------------------------------------------------------------
atr = ta.atr(atrLen)
rsi = ta.rsi(close, rsiLen)
[macdLine, macdSignal, macdHist] = ta.macd(close, 12, 26, 9)

volSma = ta.sma(volume, volLen)
ema20 = ta.ema(close, 20)

// Bench relative strength (ratio slope on 1H)
benchClose = request.security(benchSymbol, timeframe.period, close)
rs = close / benchClose
rsSlope = ta.linreg(rs, 14, 0) - ta.linreg(rs, 14, 1)

// HTF alignment: simple HTF trend based on HTF close vs EMA
htfClose = request.security(syminfo.tickerid, htfForAlignment, close)
htfEma = request.security(syminfo.tickerid, htfForAlignment, ta.ema(close, 50))
htfBull = htfClose > htfEma
htfBear = htfClose < htfEma

// Pivots for structure
ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low, pivLen, pivLen)

var float lastPH = na
var float prevPH = na
var float lastPL = na
var float prevPL = na

if not na(ph)
    prevPH := lastPH
    lastPH := ph

if not na(pl)
    prevPL := lastPL
    lastPL := pl

// Structure direction proxy
bullStructure = not na(lastPH) and not na(prevPH) and not na(lastPL) and not na(prevPL) and lastPH > prevPH and lastPL > prevPL
bearStructure = not na(lastPH) and not na(prevPH) and not na(lastPL) and not na(prevPL) and lastPH < prevPH and lastPL < prevPL

// Trend/range/breakout proxy using BB + structure
basis = ta.sma(close, bbLen)
dev = bbMult * ta.stdev(close, bbLen)
bbU = basis + dev
bbL = basis - dev
bbWidth = (bbU - bbL) / basis
bbWidthMA = ta.sma(bbWidth, bbLen)

isCompression = bbWidth < bbWidthMA
isExpansion = bbWidth > bbWidthMA

// Simple range proxy: low directional strength
[diPlus, diMinus, adx] = ta.dmi(14, 14)
isRange = adx < 18

// Overlap ratio (chaos filter): overlap of candle ranges vs total range
rng = high - low
prevRng = high[1] - low[1]
overlap = math.max(0.0, math.min(high, high[1]) - math.max(low, low[1]))
overlapRatio = (rng > 0 and prevRng > 0) ? (overlap / math.min(rng, prevRng)) : na
isChaos = not na(overlapRatio) and overlapRatio > chaosOverlapThresh and isRange

// Key levels: use last pivot for nearest "structure level"
nearestSupport = f_pickSupport(lastPL, prevPL, close)
nearestResist  = f_pickResist(lastPH, prevPH, close)

distToSupport = not na(nearestSupport) ? math.abs(close - nearestSupport) : na
distToResist  = not na(nearestResist)  ? math.abs(close - nearestResist)  : na

nearSupport = not na(distToSupport) and distToSupport <= atrLocMult * atr
nearResist  = not na(distToResist)  and distToResist  <= atrLocMult * atr

// Rejection at level (wick/body)
body = math.abs(close - open)
upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low
bullRejection = body > 0 ? (lowerWick >= wickRejectionMult * body) : false
bearRejection = body > 0 ? (upperWick >= wickRejectionMult * body) : false

// Impulse + pullback volume proxy
isBullImpulse = close > open and volume >= volSma * volBreakMult
isBearImpulse = close < open and volume >= volSma * volBreakMult

// "DTE comfort": last N-bar impulse not too extended vs ATR
nImpulse = 8
impulseMove = math.abs(close - close[nImpulse])
distEmaAtr = atr > 0 ? (math.abs(close - ema20) / atr) : na
isExtended = not na(distEmaAtr) and distEmaAtr > extendedAtr
impulseOK = impulseMove <= impulseAtrThresh * atr and not isExtended

// Proposed invalidation levels and stops (structure-based)
callInvalid = nearestSupport
putInvalid  = nearestResist

callStop = not na(callInvalid) ? callInvalid - stopBufAtr * atr : na
putStop  = not na(putInvalid)  ? putInvalid  + stopBufAtr * atr : na

callRisk = not na(callStop) ? math.abs(close - callStop) : na
putRisk  = not na(putStop)  ? math.abs(putStop - close) : na

// Target space proxy: next pivot opposite side
callTarget = nearestResist
putTarget  = nearestSupport

callRewardSr = not na(callTarget) ? math.abs(callTarget - close) : na
putRewardSr  = not na(putTarget)  ? math.abs(close - putTarget) : na

callRewardAlt = not na(callRisk) ? (1.5 * callRisk) : na
putRewardAlt  = not na(putRisk)  ? (1.5 * putRisk)  : na

callReward = not na(callRewardSr) and not na(callRewardAlt) ? math.max(callRewardSr, callRewardAlt) : (not na(callRewardSr) ? callRewardSr : callRewardAlt)
putReward  = not na(putRewardSr) and not na(putRewardAlt)  ? math.max(putRewardSr, putRewardAlt)   : (not na(putRewardSr)  ? putRewardSr  : putRewardAlt)

callRR = (not na(callRisk) and callRisk > 0 and not na(callReward)) ? (callReward / callRisk) : na
putRR  = (not na(putRisk) and putRisk > 0 and not na(putReward))   ? (putReward / putRisk)  : na

callHasRR = not na(callRR) and callRR >= minRR
putHasRR  = not na(putRR)  and putRR  >= minRR

// Momentum health
callMomentumOk = (rsi >= rsiTrendLevel) and (macdHist >= 0)
putMomentumOk  = (rsi <= (100 - rsiTrendLevel)) and (macdHist <= 0)

// Alignment with HTF
callAligned = htfBull
putAligned  = htfBear

// Relative strength
callRSOk = rsSlope > 0
putRSOk  = rsSlope < 0

// Structure confirmation (minor breakout proxy): close > prior swing high / close < prior swing low
callConf = not na(prevPH) and close > prevPH
putConf  = not na(prevPL) and close < prevPL

// 1H state machine: pullback -> reversal -> continuation
callPullbackState = callAligned and close < ema20 and (rsi < rsiTrendLevel or macdHist < 0)
putPullbackState  = putAligned  and close > ema20 and (rsi > (100 - rsiTrendLevel) or macdHist > 0)

callReversalStructureOk = not na(lastPL) and (na(prevPL) or lastPL >= prevPL)
putReversalStructureOk  = not na(lastPH) and (na(prevPH) or lastPH <= prevPH)

// Require two closes back above/below EMA20 + basic structure sanity to reduce chop flips.
callReversalState = callAligned and close > ema20 and close[1] > ema20[1] and close[2] <= ema20[2] and (rsi >= rsiTrendLevel or macdHist > macdHist[1]) and callReversalStructureOk
putReversalState  = putAligned  and close < ema20 and close[1] < ema20[1] and close[2] >= ema20[2] and (rsi <= (100 - rsiTrendLevel) or macdHist < macdHist[1]) and putReversalStructureOk

callContinuationState = callAligned and close >= ema20 and (bullStructure or callConf)
putContinuationState  = putAligned  and close <= ema20 and (bearStructure or putConf)

callStateReady = callReversalState or callContinuationState
putStateReady  = putReversalState or putContinuationState

callStateTxt = callPullbackState ? "PULLBACK" : callReversalState ? "REVERSAL" : callContinuationState ? "CONTINUATION" : "NEUTRAL"
putStateTxt  = putPullbackState  ? "PULLBACK" : putReversalState  ? "REVERSAL" : putContinuationState  ? "CONTINUATION" : "NEUTRAL"

// Clean structure & clarity proxy
structureClear = bullStructure or bearStructure or isRange

// Location logic
callLocationOk = nearSupport or (nearResist and callConf)  // pullback long or breakout
putLocationOk  = nearResist  or (nearSupport and putConf)  // pullback short or breakdown

// Level behavior: reaction near level + rejection wick
safeResist = na(nearestResist) ? (close + 10.0 * atr) : nearestResist
safeSupport = na(nearestSupport) ? (close - 10.0 * atr) : nearestSupport
crossUpResRaw = ta.crossover(close, safeResist)
crossDnSupRaw = ta.crossunder(close, safeSupport)
crossUpRes = not na(nearestResist) and crossUpResRaw
crossDnSup = not na(nearestSupport) and crossDnSupRaw
callLevelBehavior = (nearSupport and bullRejection) or (nearResist and crossUpRes)
putLevelBehavior  = (nearResist and bearRejection)  or (nearSupport and crossDnSup)

// Stop sync with options: avoid too tight vs ATR (risk >= 0.5 ATR) and not enormous (<= 4 ATR)
callStopSync = not na(callRisk) and callRisk >= 0.5 * atr and callRisk <= 4.0 * atr
putStopSync  = not na(putRisk)  and putRisk  >= 0.5 * atr and putRisk  <= 4.0 * atr

// Volume support (impulse with volume OR breakout with volume)
callVolOk = isBullImpulse or (callConf and volume >= volSma)
putVolOk  = isBearImpulse or (putConf  and volume >= volSma)

// Swing-friendly environment
swingFriendly = not isChaos

// Compression vs exhaustion: prefer compression before breakout OR expansion with follow-through
callCompressionOk = isCompression or (isExpansion and callConf)
putCompressionOk  = isCompression or (isExpansion and putConf)

// A/B clarity proxy: few conflicts
callAB = callAligned and (bullStructure or callConf) and callLocationOk and callStateReady
putAB  = putAligned  and (bearStructure or putConf)  and putLocationOk and putStateReady

//------------------------------------------------------------------------------
// Scoring weights (sum = 100) from the provided file
//------------------------------------------------------------------------------
w1  = 14 // structure clear
w2  = 12 // location
w3  = 12 // direction confirmation
w4  = 7  // volume
w5  = 13 // risk / invalidation
w6  = 5  // momentum
w7  = 6  // swing-friendly
w8  = 8  // target space
w9  = 6  // stop sync
w10 = 5  // A/B grading clarity
w11 = 4  // HTF alignment
w12 = 4  // compression vs exhaustion
w13 = 2  // DTE comfort
w14 = 1  // relative strength
w15 = 11 // level behavior

f_score(_ok, _w) => _ok ? _w : 0

// Conditions by direction
callQ1  = structureClear
putQ1   = structureClear

callQ2  = callLocationOk
putQ2   = putLocationOk

callQ3  = bullStructure or callConf
putQ3   = bearStructure or putConf

callQ4  = callVolOk
putQ4   = putVolOk

callQ5  = not na(callInvalid) and not na(callStop) and callRisk > 0
putQ5   = not na(putInvalid)  and not na(putStop)  and putRisk  > 0

callQ6  = callMomentumOk
putQ6   = putMomentumOk

callQ7  = swingFriendly
putQ7   = swingFriendly

callQ8  = callHasRR
putQ8   = putHasRR

callQ9  = callStopSync
putQ9   = putStopSync

callQ10 = callAB
putQ10  = putAB

callQ11 = callAligned
putQ11  = putAligned

callQ12 = callCompressionOk
putQ12  = putCompressionOk

callQ13 = impulseOK
putQ13  = impulseOK

callQ14 = callRSOk
putQ14  = putRSOk

callQ15 = callLevelBehavior
putQ15  = putLevelBehavior

callRawScore = f_score(callQ1, w1)
callRawScore := callRawScore + f_score(callQ2, w2)
callRawScore := callRawScore + f_score(callQ3, w3)
callRawScore := callRawScore + f_score(callQ4, w4)
callRawScore := callRawScore + f_score(callQ5, w5)
callRawScore := callRawScore + f_score(callQ6, w6)
callRawScore := callRawScore + f_score(callQ7, w7)
callRawScore := callRawScore + f_score(callQ8, w8)
callRawScore := callRawScore + f_score(callQ9, w9)
callRawScore := callRawScore + f_score(callQ10, w10)
callRawScore := callRawScore + f_score(callQ11, w11)
callRawScore := callRawScore + f_score(callQ12, w12)
callRawScore := callRawScore + f_score(callQ13, w13)
callRawScore := callRawScore + f_score(callQ14, w14)
callRawScore := callRawScore + f_score(callQ15, w15)

putRawScore = f_score(putQ1, w1)
putRawScore := putRawScore + f_score(putQ2, w2)
putRawScore := putRawScore + f_score(putQ3, w3)
putRawScore := putRawScore + f_score(putQ4, w4)
putRawScore := putRawScore + f_score(putQ5, w5)
putRawScore := putRawScore + f_score(putQ6, w6)
putRawScore := putRawScore + f_score(putQ7, w7)
putRawScore := putRawScore + f_score(putQ8, w8)
putRawScore := putRawScore + f_score(putQ9, w9)
putRawScore := putRawScore + f_score(putQ10, w10)
putRawScore := putRawScore + f_score(putQ11, w11)
putRawScore := putRawScore + f_score(putQ12, w12)
putRawScore := putRawScore + f_score(putQ13, w13)
putRawScore := putRawScore + f_score(putQ14, w14)
putRawScore := putRawScore + f_score(putQ15, w15)

trendW = w1 + w3 + w7 + w10 + w11 + w12 + w14
entryW = w2 + w4 + w5 + w6 + w8 + w9 + w13 + w15

callTrendRaw = f_score(callQ1, w1) + f_score(callQ3, w3) + f_score(callQ7, w7) + f_score(callQ10, w10) + f_score(callQ11, w11) + f_score(callQ12, w12) + f_score(callQ14, w14)
putTrendRaw  = f_score(putQ1, w1)  + f_score(putQ3, w3)  + f_score(putQ7, w7)  + f_score(putQ10, w10)  + f_score(putQ11, w11)  + f_score(putQ12, w12)  + f_score(putQ14, w14)

callEntryRaw = f_score(callQ2, w2) + f_score(callQ4, w4) + f_score(callQ5, w5) + f_score(callQ6, w6) + f_score(callQ8, w8) + f_score(callQ9, w9) + f_score(callQ13, w13) + f_score(callQ15, w15)
putEntryRaw  = f_score(putQ2, w2)  + f_score(putQ4, w4)  + f_score(putQ5, w5)  + f_score(putQ6, w6)  + f_score(putQ8, w8)  + f_score(putQ9, w9)  + f_score(putQ13, w13)  + f_score(putQ15, w15)

callTrendScore = trendW > 0 ? 100.0 * callTrendRaw / trendW : 0.0
putTrendScore  = trendW > 0 ? 100.0 * putTrendRaw  / trendW : 0.0

callEntryScore = entryW > 0 ? 100.0 * callEntryRaw / entryW : 0.0
putEntryScore  = entryW > 0 ? 100.0 * putEntryRaw  / entryW : 0.0

callScore = math.min(callTrendScore, callEntryScore)
putScore  = math.min(putTrendScore, putEntryScore)

callConfidence = math.max(0.0, math.min(100.0, callScore + (callTrendScore - callEntryScore) / 4.0))
putConfidence  = math.max(0.0, math.min(100.0, putScore  + (putTrendScore  - putEntryScore)  / 4.0))
callConfTxt = str.tostring(callConfidence, "#.##") + " " + f_confBand(callConfidence)
putConfTxt  = str.tostring(putConfidence,  "#.##") + " " + f_confBand(putConfidence)

//------------------------------------------------------------------------------
// Table rendering
//------------------------------------------------------------------------------
var int COL_METRIC = 0
var int COL_PUT    = 1
var int COL_CALL   = 2

var table t = table.new(position.top_right, 3, 1, border_width=1)

f_setCell(_row, _col, _txt, _bg, _tc) =>
    table.cell(t, _col, _row, _txt, text_color=_tc, bgcolor=_bg, text_size=txtSize)

f_clearTable(_rows) =>
    for r = 0 to _rows - 1
        for c = 0 to 2
            f_setCell(r, c, "", color.new(color.black, 100), color.new(color.white, 100))

// Build table size dynamically (but table must be created with fixed rows)
// We create max rows and use only what we need.
maxRows = 40
if barstate.isfirst
    t := table.new(position.top_right, 3, maxRows, border_width=1)

f_hdrRow(_r, _title) =>
    f_setCell(_r, COL_METRIC, _title, colHdr, f_c(color.black))
    f_setCell(_r, COL_PUT,    "PUT",   colHdr, f_c(color.black))
    f_setCell(_r, COL_CALL,   "CALL",  colHdr, f_c(color.black))

f_sectionRow(_r, _title) =>
    f_setCell(_r, COL_METRIC, _title, colSep, f_c(color.white))
    f_setCell(_r, COL_PUT,    "",     colSep, f_c(color.white))
    f_setCell(_r, COL_CALL,   "",     colSep, f_c(color.white))

f_metricRow(_r, _name, _putTxt, _putCol, _callTxt, _callCol) =>
    f_setCell(_r, COL_METRIC, _name, colBg, f_c(color.white))
    f_setCell(_r, COL_PUT,    _putTxt,  _putCol, f_c(color.white))
    f_setCell(_r, COL_CALL,   _callTxt, _callCol, f_c(color.white))

f_valueRow(_r, _name, _putVal, _callVal) =>
    f_setCell(_r, COL_METRIC, _name, colBg, f_c(color.white))
    f_setCell(_r, COL_PUT,  _putVal, colBg, f_c(color.white))
    f_setCell(_r, COL_CALL, _callVal,colBg, f_c(color.white))

// Visibility filters for columns
showPut  = modeShowBoth ? true : (modeFocus == "PUT")
showCall = modeShowBoth ? true : (modeFocus == "CALL")

f_applyColVisibility(_r) =>
    // If one side is hidden, blank it with fully transparent colors.
    if not showPut
        f_setCell(_r, COL_PUT, "", color.new(color.black, 100), color.new(color.white, 100))
    if not showCall
        f_setCell(_r, COL_CALL, "", color.new(color.black, 100), color.new(color.white, 100))

f_failReason(_id, _isPut) =>
    if _id == 1
        "no clear structure"
    else if _id == 2
        _isPut ? (not nearResist and not nearSupport ? "not near S/R" : (nearSupport and not putConf ? "no breakdown" : "bad location")) : (not nearSupport and not nearResist ? "not near S/R" : (nearResist and not callConf ? "no breakout" : "bad location"))
    else if _id == 3
        _isPut ? "no bearish conf" : "no bullish conf"
    else if _id == 4
        _isPut ? (not isBearImpulse and not putConf ? "no impulse/conf" : "low volume") : (not isBullImpulse and not callConf ? "no impulse/conf" : "low volume")
    else if _id == 5
        _isPut ? (na(putInvalid) ? "no invalidation" : (na(putStop) ? "no stop" : "risk <= 0")) : (na(callInvalid) ? "no invalidation" : (na(callStop) ? "no stop" : "risk <= 0"))
    else if _id == 6
        _isPut ? (rsi > (100 - rsiTrendLevel) ? "RSI too high" : "MACD not bearish") : (rsi < rsiTrendLevel ? "RSI too low" : "MACD not bullish")
    else if _id == 7
        "chaotic regime"
    else if _id == 8
        _isPut ? (na(putRR) ? "RR n/a" : "RR below min") : (na(callRR) ? "RR n/a" : "RR below min")
    else if _id == 9
        _isPut ? (na(putRisk) ? "risk n/a" : (putRisk < 0.5 * atr ? "stop too tight" : "stop too wide")) : (na(callRisk) ? "risk n/a" : (callRisk < 0.5 * atr ? "stop too tight" : "stop too wide"))
    else if _id == 10
        _isPut ? (not putAligned ? "HTF misalign" : (not (bearStructure or putConf) ? "no dir conf" : (not putLocationOk ? "location bad" : (not putStateReady ? "state not ready" : "AB weak")))) : (not callAligned ? "HTF misalign" : (not (bullStructure or callConf) ? "no dir conf" : (not callLocationOk ? "location bad" : (not callStateReady ? "state not ready" : "AB weak"))))
    else if _id == 11
        _isPut ? "HTF not bearish" : "HTF not bullish"
    else if _id == 12
        _isPut ? (not isCompression and not isExpansion ? "flat regime" : "no downside follow" ) : (not isCompression and not isExpansion ? "flat regime" : "no upside follow")
    else if _id == 13
        "impulse overextended"
    else if _id == 14
        _isPut ? "RW not confirmed" : "RS not confirmed"
    else
        _isPut ? (not nearResist and not nearSupport ? "not at level" : (nearResist and not bearRejection ? "no reject at R" : "no break at S")) : (not nearSupport and not nearResist ? "not at level" : (nearSupport and not bullRejection ? "no reject at S" : "no break at R"))

f_checkRow(_r, _id, _name, _w, _putOk, _callOk, _putNa, _callNa) =>
    _putTxt = f_gateText(_putOk, _putNa, f_failReason(_id, true)) + " (" + str.tostring(_w) + ")"
    _calTxt = f_gateText(_callOk, _callNa, f_failReason(_id, false)) + " (" + str.tostring(_w) + ")"
    f_metricRow(_r, _name, _putTxt, f_statusColor(_putOk, _putNa), _calTxt, f_statusColor(_callOk, _callNa))
    f_applyColVisibility(_r)

f_updateSrLine(_ln, _y, _col) =>
    line _out = _ln
    if na(_y)
        if not na(_out)
            line.delete(_out)
            _out := na
    else
        _x1 = bar_index
        _x2 = bar_index + 3
        if na(_out)
            _out := line.new(_x1, _y, _x2, _y, xloc=xloc.bar_index, extend=extend.none, color=_col, width=1)
        else
            line.set_xy1(_out, _x1, _y)
            line.set_xy2(_out, _x2, _y)
            line.set_color(_out, _col)
            line.set_width(_out, 1)
    _out

var line srSupportLine = na
var line srResistLine = na

// Render condition (table only on 1H if enabled)
render = uiShow and (not onlyOn1H or is1H)

srSupportLine := f_updateSrLine(srSupportLine, render ? nearestSupport : na, f_c(color.teal))
srResistLine := f_updateSrLine(srResistLine, render ? nearestResist : na, f_c(color.orange))

if not render
    // Clear cells so nothing remains visible.
    f_clearTable(maxRows)
    if uiShowHintWhenNot1H and uiShow and onlyOn1H and not is1H
        // show a minimal hint in first row (still respects opacity)
        f_setCell(0, COL_METRIC, "Switch to 1H to view options table", colBg, f_c(color.orange))
else
    // Header
    row = 0
    f_hdrRow(row, "SWING OPTIONS 1H - UI")
    f_applyColVisibility(row)
    row += 1

    // SUMMARY
    f_sectionRow(row, "SUMMARY")
    row += 1

    // Score + grade + status (trend context vs entry timing)
    putBaseGrade  = f_grade(putScore)
    callBaseGrade = f_grade(callScore)

    putCapGrade  = (not putHasRR and isExtended) ? "D" : ((not putHasRR or isExtended or not putStateReady) ? "C" : "A")
    callCapGrade = (not callHasRR and isExtended) ? "D" : ((not callHasRR or isExtended or not callStateReady) ? "C" : "A")

    putGrade  = f_capGrade(putBaseGrade, putCapGrade)
    callGrade = f_capGrade(callBaseGrade, callCapGrade)

    putStatus = not swingFriendly ? "NO TRADE (REGIME)" : (not putHasRR ? "NO TRADE (RR)" : (putPullbackState or not putStateReady ? "WAIT REVERSAL" : (isExtended ? "WAIT PULLBACK" : (f_gradeRank(putGrade) >= 3 ? "ENTRY NOW" : "WAIT PULLBACK"))))
    callStatus = not swingFriendly ? "NO TRADE (REGIME)" : (not callHasRR ? "NO TRADE (RR)" : (callPullbackState or not callStateReady ? "WAIT REVERSAL" : (isExtended ? "WAIT PULLBACK" : (f_gradeRank(callGrade) >= 3 ? "ENTRY NOW" : "WAIT PULLBACK"))))

    f_metricRow(row, "Trend score (0-100)", str.tostring(putTrendScore, "#.##"), colBg, str.tostring(callTrendScore, "#.##"), colBg)
    f_applyColVisibility(row)
    row += 1

    f_metricRow(row, "Entry score (0-100)", str.tostring(putEntryScore, "#.##"), colBg, str.tostring(callEntryScore, "#.##"), colBg)
    f_applyColVisibility(row)
    row += 1

    f_metricRow(row, "Final score (0-100)", str.tostring(putScore, "#.##"), colBg, str.tostring(callScore, "#.##"), colBg)
    f_applyColVisibility(row)
    row += 1

    f_metricRow(row, "Confidence", putConfTxt, colBg, callConfTxt, colBg)
    f_applyColVisibility(row)
    row += 1

    f_metricRow(row, "Grade", putGrade, colBg, callGrade, colBg)
    f_applyColVisibility(row)
    row += 1

    f_metricRow(row, "Status", putStatus, colBg, callStatus, colBg)
    f_applyColVisibility(row)
    row += 1

    // Quick context (no details)
    structTxt = bullStructure ? "TREND UP" : bearStructure ? "TREND DOWN" : isRange ? "RANGE" : "MIXED"

    locPut  = putLocationOk  ? "OK" : "NO"
    locCall = callLocationOk ? "OK" : "NO"

    f_metricRow(row, "Structure (proxy)", structTxt, colBg, structTxt, colBg)
    f_applyColVisibility(row)
    row += 1

    f_metricRow(row, "1H state", putStateTxt, colBg, callStateTxt, colBg)
    f_applyColVisibility(row)
    row += 1

    f_metricRow(row, "Location", locPut, f_statusColor(putLocationOk, false), locCall, f_statusColor(callLocationOk, false))
    f_applyColVisibility(row)
    row += 1

    // Risk & RR quick
    rrPutTxt  = not na(putRR)  ? str.tostring(putRR, "#.##")  : "-"
    rrCallTxt = not na(callRR) ? str.tostring(callRR,"#.##") : "-"

    f_metricRow(row, "RR (SR or 1.5R)", rrPutTxt, f_statusColor(putHasRR, na(putRR)), rrCallTxt, f_statusColor(callHasRR, na(callRR)))
    f_applyColVisibility(row)
    row += 1

    // DETAILS
    if uiShowDetails
        row += 1
        f_sectionRow(row, "DETAILS (15 checks)")
        row += 1

        // Q1..Q15
        f_checkRow(row, 1, "1) Structure clear", w1, putQ1, callQ1, false, false)
        row += 1
        f_checkRow(row, 2, "2) Logical location", w2, putQ2, callQ2, false, false)
        row += 1
        f_checkRow(row, 3, "3) Direction confirmed", w3, putQ3, callQ3, false, false)
        row += 1
        f_checkRow(row, 4, "4) Volume supports move", w4, putQ4, callQ4, false, false)
        row += 1
        f_checkRow(row, 5, "5) Risk / invalidation clear", w5, putQ5, callQ5, na(putInvalid) or na(putStop), na(callInvalid) or na(callStop))
        row += 1
        f_checkRow(row, 6, "6) Momentum healthy (RSI/MACD)", w6, putQ6, callQ6, false, false)
        row += 1
        f_checkRow(row, 7, "7) Swing-friendly environment", w7, putQ7, callQ7, false, false)
        row += 1
        f_checkRow(row, 8, "8) Target space (>= min RR)", w8, putQ8, callQ8, na(putRR), na(callRR))
        row += 1
        f_checkRow(row, 9, "9) Stop sync vs ATR", w9, putQ9, callQ9, na(putRisk), na(callRisk))
        row += 1
        f_checkRow(row, 10, "10) A/B setup clarity", w10, putQ10, callQ10, false, false)
        row += 1
        f_checkRow(row, 11, "11) HTF aligned (" + htfForAlignment + ")", w11, putQ11, callQ11, false, false)
        row += 1
        f_checkRow(row, 12, "12) Compression/expansion OK", w12, putQ12, callQ12, false, false)
        row += 1
        f_checkRow(row, 13, "13) DTE comfort (impulse not extended)", w13, putQ13, callQ13, false, false)
        row += 1
        f_checkRow(row, 14, "14) RelStrength vs " + benchSymbol, w14, putQ14, callQ14, false, false)
        row += 1
        f_checkRow(row, 15, "15) Price behavior at level", w15, putQ15, callQ15, false, false)
        row += 1

        // Extra numeric values for user verification
        row += 1
        f_sectionRow(row, "DETAILS: values")
        row += 1

        f_valueRow(row, "ATR", str.tostring(atr, "#.####"), str.tostring(atr, "#.####"))
        f_applyColVisibility(row)
        row += 1

        f_valueRow(row, "RSI", str.tostring(rsi, "#.##"), str.tostring(rsi, "#.##"))
        f_applyColVisibility(row)
        row += 1

        f_valueRow(row, "MACD hist", str.tostring(macdHist, "#.####"), str.tostring(macdHist, "#.####"))
        f_applyColVisibility(row)
        row += 1

        f_valueRow(row, "Vol / VolSMA", str.tostring(volume, "#") + " / " + str.tostring(volSma, "#"), str.tostring(volume, "#") + " / " + str.tostring(volSma, "#"))
        f_applyColVisibility(row)
        row += 1

        srTxt = (na(nearestSupport) ? "-" : str.tostring(nearestSupport, "#.####")) + " / " + (na(nearestResist) ? "-" : str.tostring(nearestResist, "#.####"))
        f_valueRow(row, "Nearest S / R", srTxt, srTxt)
        f_applyColVisibility(row)
        row += 1

        f_valueRow(row, "Stop (PUT/CALL)", na(putStop) ? "-" : str.tostring(putStop, "#.####"), na(callStop) ? "-" : str.tostring(callStop, "#.####"))
        f_applyColVisibility(row)
        row += 1

        f_valueRow(row, "RR (PUT/CALL)", rrPutTxt, rrCallTxt)
        f_applyColVisibility(row)
        row += 1

    // Clear remaining unused rows
    if row < maxRows
        for r = row to maxRows - 1
            for c = 0 to 2
                f_setCell(r, c, "", color.new(color.black, 100), color.new(color.white, 100))
