//@version=6
indicator("Stock 1D", overlay=true, max_labels_count=500, max_lines_count=500)

//------------------------------------------------------------------------------
// Inputs (all user-configurable)
//------------------------------------------------------------------------------
groupUI   = "UI"
uiShow    = input.bool(true, "Show table", group=groupUI)
uiOpacity = input.int(10, "Table visibility (0=solid, 100=invisible)", minval=0, maxval=100, group=groupUI)
uiShowDetails = input.bool(true, "Show DETAILS section", group=groupUI)
uiShowSoftContext = input.bool(false, "Show soft context in DETAILS (debug)", group=groupUI)
uiTextSize = input.string("small", "Text size", options=["tiny","small","normal","large"], group=groupUI)
uiShowHintWhenNot1D = input.bool(false, "Show hint when not on 1D / excluded ticker", group=groupUI)

groupMode = "Mode"
modeShowBoth = input.bool(true, "Show both PUT & CALL", group=groupMode)
modeFocus = input.string("BOTH", "Focus", options=["BOTH","CALL","PUT"], group=groupMode)

groupTF = "Timeframe gating"
onlyOn1D = input.bool(true, "Render table only on 1D", group=groupTF)
excludeSPY = input.bool(true, "Hide on SPY", group=groupTF)
excludeQQQ = input.bool(true, "Hide on QQQ", group=groupTF)

groupBench = "Benchmark / RS-RW"
benchSymbol = input.symbol("SPY", "Benchmark symbol (Relative Strength)", group=groupBench)
rsLen = input.int(20, "RS slope length", minval=5, group=groupBench)

groupStructure = "Structure detection"
pivLen = input.int(5, "Pivot length (swing points)", minval=2, maxval=20, group=groupStructure)

groupFilters = "Filters / Thresholds"
atrLen = input.int(14, "ATR length", minval=1, group=groupFilters)
stopBufAtr = input.float(0.25, "Stop buffer (x ATR) beyond invalidation", minval=0.0, step=0.05, group=groupFilters)
locAtAtr = input.float(0.5, "Location: AT level <= x ATR", minval=0.1, step=0.1, group=groupFilters)
atrLocMult = input.float(1.0, "Location: NEAR level <= x ATR", minval=0.2, step=0.1, group=groupFilters)
locExtendedAtr = input.float(1.8, "Location: EXTENDED above x ATR", minval=1.0, step=0.1, group=groupFilters)
minRR = input.float(2.0, "Minimum RR", minval=0.5, step=0.25, group=groupFilters)
minSpaceAtr = input.float(2.0, "Space: next obstacle distance >= x ATR", minval=0.5, step=0.25, group=groupFilters)
adxLen = input.int(14, "ADX length", minval=3, group=groupFilters)
adxTrend = input.float(20.0, "ADX trend threshold", minval=5, step=1, group=groupFilters)
unstableTrAtr = input.float(2.2, "Unstable: TR spike >= x ATR", minval=1.0, step=0.1, group=groupFilters)
chaosOverlapThresh = input.float(0.55, "Chaos: overlap ratio threshold", minval=0.1, maxval=0.9, step=0.05, group=groupFilters)
ma20Len = input.int(20, "EMA length (fast)", minval=1, group=groupFilters)
ma50Len = input.int(50, "SMA length (mid)", minval=1, group=groupFilters)
ma200Len = input.int(200, "SMA length (slow)", minval=1, group=groupFilters)

groupGrading = "Grading"
gradeA = input.int(80, "Grade A threshold", minval=0, maxval=100, group=groupGrading)
gradeB = input.int(65, "Grade B threshold", minval=0, maxval=100, group=groupGrading)
gradeC = input.int(50, "Grade C threshold", minval=0, maxval=100, group=groupGrading)

//------------------------------------------------------------------------------
// Helpers
//------------------------------------------------------------------------------
is1D = timeframe.isdaily

f_txtSize(_s) =>
    if _s == "tiny"
        size.tiny
    else if _s == "small"
        size.small
    else if _s == "normal"
        size.normal
    else
        size.large

txtSize = f_txtSize(uiTextSize)

f_c(_col) => color.new(_col, uiOpacity)

colOk  = f_c(color.lime)
colBad = f_c(color.red)
colNA  = f_c(color.gray)
colHdr = f_c(color.silver)
colBg  = f_c(color.black)
colSep = f_c(color.new(color.gray, math.min(100, uiOpacity + 40)))

f_statusColor(_ok, _na) =>
    _na ? colNA : (_ok ? colOk : colBad)

f_boolToText(_ok, _na) =>
    _na ? "-" : (_ok ? "YES" : "NO")

f_gateText(_ok, _na, _reason) =>
    _na ? "-" : (_ok ? "YES" : _reason)

f_grade(_score) =>
    if _score >= gradeA
        "A"
    else if _score >= gradeB
        "B"
    else if _score >= gradeC
        "C"
    else
        "D"

f_gradeRank(_g) =>
    _g == "A" ? 4 : _g == "B" ? 3 : _g == "C" ? 2 : 1

f_gradeFromRank(_r) =>
    _r >= 4 ? "A" : _r == 3 ? "B" : _r == 2 ? "C" : "D"

f_capGrade(_base, _cap) =>
    f_gradeFromRank(math.min(f_gradeRank(_base), f_gradeRank(_cap)))

f_capScoreByGrade(_score, _cap) =>
    if _cap == "A"
        _score
    else if _cap == "B"
        math.min(_score, gradeA - 0.01)
    else if _cap == "C"
        math.min(_score, gradeB - 0.01)
    else
        math.min(_score, gradeC - 0.01)

f_score(_ok, _w) => _ok ? _w : 0

f_pickSupport(_last, _prev, _px) =>
    float _s = na
    if not na(_last) and _last <= _px
        _s := _last
    if not na(_prev) and _prev <= _px
        _s := na(_s) ? _prev : ((_px - _prev) < (_px - _s) ? _prev : _s)
    _s

f_pickResist(_last, _prev, _px) =>
    float _r = na
    if not na(_last) and _last >= _px
        _r := _last
    if not na(_prev) and _prev >= _px
        _r := na(_r) ? _prev : ((_prev - _px) < (_r - _px) ? _prev : _r)
    _r

f_locState(_distAtr) =>
    if na(_distAtr)
        "MID"
    else if _distAtr <= locAtAtr
        "AT LEVEL"
    else if _distAtr <= atrLocMult
        "NEAR LEVEL"
    else if _distAtr <= locExtendedAtr
        "MID"
    else
        "EXTENDED"

f_locValid(_state) =>
    _state == "AT LEVEL" or _state == "NEAR LEVEL"

f_locDisplay(_state) =>
    (_state == "AT LEVEL" or _state == "NEAR LEVEL") ? _state : "MID / EXTENDED"

//------------------------------------------------------------------------------
// Symbol gating (Stock 1D only; exclude SPY/QQQ)
//------------------------------------------------------------------------------
ticker = syminfo.ticker
isExcluded = (excludeSPY and ticker == "SPY") or (excludeQQQ and ticker == "QQQ")

//------------------------------------------------------------------------------
// Data (Daily)
//------------------------------------------------------------------------------
atr = ta.atr(atrLen)
[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)
tr  = ta.tr(true)

ema20  = ta.ema(close, ma20Len)
sma50  = ta.sma(close, ma50Len)
sma200 = ta.sma(close, ma200Len)

// Benchmark relative strength (ratio slope on 1D)
benchClose = request.security(benchSymbol, timeframe.period, close)
rs = benchClose > 0 ? close / benchClose : na
rsSlope = ta.linreg(rs, rsLen, 0) - ta.linreg(rs, rsLen, 1)
benchEma20 = request.security(benchSymbol, timeframe.period, ta.ema(close, 20))
benchEma50 = request.security(benchSymbol, timeframe.period, ta.ema(close, 50))
marketBull = benchEma20 > benchEma50
marketBear = benchEma20 < benchEma50

// Pivots for structure
ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low, pivLen, pivLen)

var float lastPH = na
var float prevPH = na
var float lastPL = na
var float prevPL = na

if not na(ph)
    prevPH := lastPH
    lastPH := ph

if not na(pl)
    prevPL := lastPL
    lastPL := pl

bullStructure = not na(lastPH) and not na(prevPH) and not na(lastPL) and not na(prevPL) and lastPH > prevPH and lastPL > prevPL
bearStructure = not na(lastPH) and not na(prevPH) and not na(lastPL) and not na(prevPL) and lastPH < prevPH and lastPL < prevPL
isRange = adx < (adxTrend - 2)
structureTrendUp = bullStructure
structureTrendDown = bearStructure
structureDirectional = structureTrendUp or structureTrendDown
structureRange = isRange and not structureDirectional

// Chaos / cleanliness proxies
rng = high - low
prevRng = high[1] - low[1]
overlap = math.max(0.0, math.min(high, high[1]) - math.max(low, low[1]))
overlapRatio = (rng > 0 and prevRng > 0) ? (overlap / math.min(rng, prevRng)) : na
isChaos = not na(overlapRatio) and overlapRatio > chaosOverlapThresh and adx < (adxTrend - 2)

trSpike = tr >= unstableTrAtr * atr
structureChaos = isChaos or trSpike
cleanChart = not structureChaos
structureClear = structureDirectional and not structureChaos
structureUsable = (structureDirectional or structureRange) and not structureChaos

// Nearest structure levels with fallback: W -> M -> 12M -> ATR proxy.
pivotSupport = f_pickSupport(lastPL, prevPL, close)
pivotResist  = f_pickResist(lastPH, prevPH, close)

wkLow  = request.security(syminfo.tickerid, "W", low[1])
wkHigh = request.security(syminfo.tickerid, "W", high[1])
moLow  = request.security(syminfo.tickerid, "M", low[1])
moHigh = request.security(syminfo.tickerid, "M", high[1])
yrLow  = request.security(syminfo.tickerid, "12M", low[1])
yrHigh = request.security(syminfo.tickerid, "12M", high[1])

fallbackSupport = not na(wkLow) ? wkLow : (not na(moLow) ? moLow : (not na(yrLow) ? yrLow : na))
fallbackResist  = not na(wkHigh) ? wkHigh : (not na(moHigh) ? moHigh : (not na(yrHigh) ? yrHigh : na))

nearestSupport = not na(pivotSupport) ? pivotSupport : (not na(fallbackSupport) ? fallbackSupport : (not na(atr) ? close - 2.0 * atr : low))
nearestResist  = not na(pivotResist)  ? pivotResist  : (not na(fallbackResist)  ? fallbackResist  : (not na(atr) ? close + 2.0 * atr : high))

distToSupport = not na(nearestSupport) ? math.abs(close - nearestSupport) : na
distToResist  = not na(nearestResist)  ? math.abs(close - nearestResist)  : na

nearSupport = not na(distToSupport) and distToSupport <= atrLocMult * atr
nearResist  = not na(distToResist)  and distToResist  <= atrLocMult * atr

// Also consider MAs as structural context
distTo20  = math.abs(close - ema20)
distTo50  = math.abs(close - sma50)
distTo200 = math.abs(close - sma200)
distTo20Atr  = atr > 0 ? (distTo20 / atr) : na
distTo50Atr  = atr > 0 ? (distTo50 / atr) : na
distTo200Atr = atr > 0 ? (distTo200 / atr) : na

// Side-specific location anchor (Daily context), priority-based (not nearest-only):
// support/resistance -> EMA20/SMA50 -> SMA200.
callDistSupportAtr = atr > 0 and not na(distToSupport) ? (distToSupport / atr) : na
putDistResistAtr   = atr > 0 and not na(distToResist)  ? (distToResist  / atr) : na

callNearSupport = not na(callDistSupportAtr) and callDistSupportAtr <= atrLocMult
callNearEMA20 = bullStructure and not na(distTo20Atr) and distTo20Atr <= atrLocMult
callNearSMA50 = bullStructure and not na(distTo50Atr) and distTo50Atr <= atrLocMult
callNearSMA200 = not na(distTo200Atr) and distTo200Atr <= atrLocMult

callLocationAnchor = "NONE"
float callAnchorDistAtr = na
if callNearSupport
    callLocationAnchor := "SUPPORT"
    callAnchorDistAtr := callDistSupportAtr
else if callNearEMA20
    callLocationAnchor := "EMA20"
    callAnchorDistAtr := distTo20Atr
else if callNearSMA50
    callLocationAnchor := "SMA50"
    callAnchorDistAtr := distTo50Atr
else if callNearSMA200
    callLocationAnchor := "SMA200"
    callAnchorDistAtr := distTo200Atr
else if not na(callDistSupportAtr)
    callLocationAnchor := "SUPPORT"
    callAnchorDistAtr := callDistSupportAtr
else if bullStructure and not na(distTo20Atr)
    callLocationAnchor := "EMA20"
    callAnchorDistAtr := distTo20Atr
else if bullStructure and not na(distTo50Atr)
    callLocationAnchor := "SMA50"
    callAnchorDistAtr := distTo50Atr
else if not na(distTo200Atr)
    callLocationAnchor := "SMA200"
    callAnchorDistAtr := distTo200Atr

putNearResist = not na(putDistResistAtr) and putDistResistAtr <= atrLocMult
putNearEMA20 = bearStructure and not na(distTo20Atr) and distTo20Atr <= atrLocMult
putNearSMA50 = bearStructure and not na(distTo50Atr) and distTo50Atr <= atrLocMult
putNearSMA200 = not na(distTo200Atr) and distTo200Atr <= atrLocMult

putLocationAnchor = "NONE"
float putAnchorDistAtr = na
if putNearResist
    putLocationAnchor := "RESISTANCE"
    putAnchorDistAtr := putDistResistAtr
else if putNearEMA20
    putLocationAnchor := "EMA20"
    putAnchorDistAtr := distTo20Atr
else if putNearSMA50
    putLocationAnchor := "SMA50"
    putAnchorDistAtr := distTo50Atr
else if putNearSMA200
    putLocationAnchor := "SMA200"
    putAnchorDistAtr := distTo200Atr
else if not na(putDistResistAtr)
    putLocationAnchor := "RESISTANCE"
    putAnchorDistAtr := putDistResistAtr
else if bearStructure and not na(distTo20Atr)
    putLocationAnchor := "EMA20"
    putAnchorDistAtr := distTo20Atr
else if bearStructure and not na(distTo50Atr)
    putLocationAnchor := "SMA50"
    putAnchorDistAtr := distTo50Atr
else if not na(distTo200Atr)
    putLocationAnchor := "SMA200"
    putAnchorDistAtr := distTo200Atr

callLocationState = f_locState(callAnchorDistAtr)
putLocationState = f_locState(putAnchorDistAtr)

isMiddle = callLocationState == "MID" and putLocationState == "MID"

// Invalidation (structural)
callInvalid = nearestSupport
putInvalid  = nearestResist

callStop = not na(callInvalid) ? callInvalid - stopBufAtr * atr : na
putStop  = not na(putInvalid)  ? putInvalid  + stopBufAtr * atr : na

callRisk = not na(callStop) ? math.abs(close - callStop) : na
putRisk  = not na(putStop)  ? math.abs(putStop - close) : na

riskRealisticCall = not na(callRisk) and callRisk > 0 and callRisk <= 6.0 * atr
riskRealisticPut  = not na(putRisk)  and putRisk  > 0 and putRisk  <= 6.0 * atr

// Reward / obstacle space: next pivot opposite side
callObstacle = nearestResist
putObstacle  = nearestSupport

callSpaceSr = not na(callObstacle) ? math.abs(callObstacle - close) : na
putSpaceSr  = not na(putObstacle)  ? math.abs(close - putObstacle) : na

callSpaceAlt = not na(callRisk) ? (1.5 * callRisk) : na
putSpaceAlt  = not na(putRisk)  ? (1.5 * putRisk)  : na

callSpace = not na(callSpaceSr) and not na(callSpaceAlt) ? math.max(callSpaceSr, callSpaceAlt) : (not na(callSpaceSr) ? callSpaceSr : callSpaceAlt)
putSpace  = not na(putSpaceSr) and not na(putSpaceAlt)  ? math.max(putSpaceSr, putSpaceAlt)   : (not na(putSpaceSr)  ? putSpaceSr  : putSpaceAlt)

callSpaceOK = not na(callSpace) and callSpace >= minSpaceAtr * atr
putSpaceOK  = not na(putSpace)  and putSpace  >= minSpaceAtr * atr

callRR = (not na(callRisk) and callRisk > 0 and not na(callSpace)) ? (callSpace / callRisk) : na
putRR  = (not na(putRisk)  and putRisk  > 0 and not na(putSpace))  ? (putSpace / putRisk)  : na

callHasRR = not na(callRR) and callRR >= minRR
putHasRR  = not na(putRR)  and putRR  >= minRR

// Follow-through potential proxy: trend regime + price above/below key MAs + not chaotic
trendRegime = adx >= adxTrend and cleanChart
callFollow = trendRegime and (close >= sma50) and (ema20 >= ema20[5])
putFollow  = trendRegime and (close <= sma50) and (ema20 <= ema20[5])

// "One sentence" proxy: structure usable + clean + not middle-of-nowhere
oneSentence = structureUsable and cleanChart and not isMiddle

// Execution / tradeable look proxy: not chaotic + not TR spike + volume exists
tradeable = cleanChart and volume > 0

// Location validity for Daily: entry-side anchor + distance class.
callLocationOk = f_locValid(callLocationState) and not nearResist
putLocationOk  = f_locValid(putLocationState) and not nearSupport

// RS/RW for direction
callRSOk = rsSlope > 0
putRSOk  = rsSlope < 0

// Overall A/B proxy (for the small 2pt weight)
callAB = callLocationOk and riskRealisticCall and callHasRR and cleanChart
putAB  = putLocationOk  and riskRealisticPut  and putHasRR  and cleanChart

// Daily bias/context engine (ModMark-style): direction + market + edge.
callMarketAligned = marketBull
putMarketAligned  = marketBear

callDirectionOk = structureClear and bullStructure and callRSOk and callMarketAligned
putDirectionOk  = structureClear and bearStructure and putRSOk and putMarketAligned

callRiskDefined = not na(callInvalid) and not na(callStop) and riskRealisticCall
putRiskDefined  = not na(putInvalid)  and not na(putStop)  and riskRealisticPut

callRewardDefined = callHasRR and callSpaceOK
putRewardDefined  = putHasRR  and putSpaceOK

callDailyCandidate = callDirectionOk and callLocationOk and callRiskDefined and callRewardDefined
putDailyCandidate  = putDirectionOk  and putLocationOk  and putRiskDefined  and putRewardDefined

callNoTradeDaily = structureChaos or (structureDirectional and not callDirectionOk) or (not callRiskDefined) or (not callHasRR)
putNoTradeDaily  = structureChaos or (structureDirectional and not putDirectionOk) or (not putRiskDefined) or (not putHasRR)

//------------------------------------------------------------------------------
// Core Daily scoring weights (sum = 100).
// Daily stays bias/context-first; follow-through/clarity/A-B remain soft context.
// 1 Structure usable 24
// 2 Clean chart 12
// 3 Location acceptable 18
// 4 Invalidation exists 16
// 5 Space to obstacle 15
// 6 RR >= min 10
// 7 RS/RW vs benchmark 5
//------------------------------------------------------------------------------
w1=24, w2=12, w3=18, w4=16, w5=15, w6=10, w7=5, w8=0, w9=0, w10=0

// Conditions by direction
callQ1 = structureUsable
putQ1  = structureUsable

callQ2 = cleanChart
putQ2  = cleanChart

callQ3 = callLocationOk
putQ3  = putLocationOk

callQ4 = not na(callInvalid) and riskRealisticCall
putQ4  = not na(putInvalid)  and riskRealisticPut

callQ5 = callSpaceOK
putQ5  = putSpaceOK

callQ6 = callHasRR
putQ6  = putHasRR

callQ7 = callRSOk
putQ7  = putRSOk

callQ8 = callFollow
putQ8  = putFollow

callQ9 = oneSentence
putQ9  = oneSentence

callQ10 = callAB
putQ10  = putAB

callScore = f_score(callQ1, w1)
callScore := callScore + f_score(callQ2, w2)
callScore := callScore + f_score(callQ3, w3)
callScore := callScore + f_score(callQ4, w4)
callScore := callScore + f_score(callQ5, w5)
callScore := callScore + f_score(callQ6, w6)
callScore := callScore + f_score(callQ7, w7)

putScore = f_score(putQ1, w1)
putScore := putScore + f_score(putQ2, w2)
putScore := putScore + f_score(putQ3, w3)
putScore := putScore + f_score(putQ4, w4)
putScore := putScore + f_score(putQ5, w5)
putScore := putScore + f_score(putQ6, w6)
putScore := putScore + f_score(putQ7, w7)

//------------------------------------------------------------------------------
// Table rendering (Top Right)
//------------------------------------------------------------------------------
var int COL_METRIC = 0
var int COL_PUT    = 1
var int COL_CALL   = 2

var table t = table.new(position.top_right, 3, 1, border_width=1)

f_setCell(_row, _col, _txt, _bg, _tc) =>
    table.cell(t, _col, _row, _txt, text_color=_tc, bgcolor=_bg, text_size=txtSize)

f_clearTable(_rows) =>
    for r = 0 to _rows - 1
        for c = 0 to 2
            f_setCell(r, c, "", color.new(color.black, 100), color.new(color.white, 100))

maxRows = 56
if barstate.isfirst
    t := table.new(position.top_right, 3, maxRows, border_width=1)

f_hdrRow(_r, _title) =>
    f_setCell(_r, COL_METRIC, _title, colHdr, f_c(color.black))
    f_setCell(_r, COL_PUT,    "PUT",   colHdr, f_c(color.black))
    f_setCell(_r, COL_CALL,   "CALL",  colHdr, f_c(color.black))

f_sectionRow(_r, _title) =>
    f_setCell(_r, COL_METRIC, _title, colSep, f_c(color.white))
    f_setCell(_r, COL_PUT,    "",     colSep, f_c(color.white))
    f_setCell(_r, COL_CALL,   "",     colSep, f_c(color.white))

f_metricRow(_r, _name, _putTxt, _putCol, _callTxt, _callCol) =>
    f_setCell(_r, COL_METRIC, _name, colBg, f_c(color.white))
    f_setCell(_r, COL_PUT,    _putTxt,  _putCol, f_c(color.white))
    f_setCell(_r, COL_CALL,   _callTxt, _callCol, f_c(color.white))

f_valueRow(_r, _name, _putVal, _callVal) =>
    f_setCell(_r, COL_METRIC, _name, colBg, f_c(color.white))
    f_setCell(_r, COL_PUT,  _putVal, colBg, f_c(color.white))
    f_setCell(_r, COL_CALL, _callVal,colBg, f_c(color.white))

showPut  = modeShowBoth ? true : (modeFocus == "PUT")
showCall = modeShowBoth ? true : (modeFocus == "CALL")

f_applyColVisibility(_r) =>
    if not showPut
        f_setCell(_r, COL_PUT, "", color.new(color.black, 100), color.new(color.white, 100))
    if not showCall
        f_setCell(_r, COL_CALL, "", color.new(color.black, 100), color.new(color.white, 100))

f_failReason(_id, _isPut) =>
    if _id == 1
        "structure not usable"
    else if _id == 2
        isChaos ? "chaos overlap" : (trSpike ? "TR spike" : "chart noisy")
    else if _id == 3
        _isPut ? (f_locDisplay(putLocationState) + " @ " + putLocationAnchor) : (f_locDisplay(callLocationState) + " @ " + callLocationAnchor)
    else if _id == 4
        _isPut ? (na(putInvalid) ? "no invalidation" : (not riskRealisticPut ? "risk unrealistic" : "risk invalid")) : (na(callInvalid) ? "no invalidation" : (not riskRealisticCall ? "risk unrealistic" : "risk invalid"))
    else if _id == 5
        _isPut ? (na(putSpace) ? "no obstacle data" : "space too small") : (na(callSpace) ? "no obstacle data" : "space too small")
    else if _id == 6
        _isPut ? (na(putRR) ? "RR n/a" : "RR below min") : (na(callRR) ? "RR n/a" : "RR below min")
    else if _id == 7
        _isPut ? "RW not confirmed" : "RS not confirmed"
    else if _id == 8
        _isPut ? (not trendRegime ? "no trend regime" : (close > sma50 ? "above SMA50" : (ema20 > ema20[5] ? "EMA20 rising" : "follow weak"))) : (not trendRegime ? "no trend regime" : (close < sma50 ? "below SMA50" : (ema20 < ema20[5] ? "EMA20 falling" : "follow weak")))
    else if _id == 9
        not structureUsable ? "structure not usable" : (not cleanChart ? "chart noisy" : (isMiddle ? "middle zone" : "clarity low"))
    else
        _isPut ? (not putLocationOk ? "location bad" : (not riskRealisticPut ? "risk unrealistic" : (not putHasRR ? "RR below min" : (not cleanChart ? "chart noisy" : "AB weak")))) : (not callLocationOk ? "location bad" : (not riskRealisticCall ? "risk unrealistic" : (not callHasRR ? "RR below min" : (not cleanChart ? "chart noisy" : "AB weak"))))

f_checkRow(_r, _id, _name, _w, _putOk, _callOk, _putNa, _callNa) =>
    _putTxt = f_gateText(_putOk, _putNa, f_failReason(_id, true)) + " (" + str.tostring(_w) + ")"
    _calTxt = f_gateText(_callOk, _callNa, f_failReason(_id, false)) + " (" + str.tostring(_w) + ")"
    f_metricRow(_r, _name, _putTxt, f_statusColor(_putOk, _putNa), _calTxt, f_statusColor(_callOk, _callNa))
    f_applyColVisibility(_r)

f_updateSrLine(_ln, _y, _col) =>
    line _out = _ln
    if na(_y)
        if not na(_out)
            line.delete(_out)
            _out := na
    else
        _x1 = bar_index
        _x2 = bar_index + 3
        if na(_out)
            _out := line.new(_x1, _y, _x2, _y, xloc=xloc.bar_index, extend=extend.none, color=_col, width=1)
        else
            line.set_xy1(_out, _x1, _y)
            line.set_xy2(_out, _x2, _y)
            line.set_color(_out, _col)
            line.set_width(_out, 1)
    _out

var line srSupportLine = na
var line srResistLine = na

render = uiShow and (not onlyOn1D or is1D) and not isExcluded

srSupportLine := f_updateSrLine(srSupportLine, render ? nearestSupport : na, f_c(color.teal))
srResistLine := f_updateSrLine(srResistLine, render ? nearestResist : na, f_c(color.orange))

if not render
    f_clearTable(maxRows)
    if uiShowHintWhenNot1D and uiShow
        hint = isExcluded ? "Hidden on SPY/QQQ (Stock 1D only)" : "Switch to 1D to view stock table"
        f_setCell(0, COL_METRIC, hint, colBg, f_c(color.orange))
else
    row = 0
    f_hdrRow(row, "STOCK 1D - SWING OPTIONS UI")
    f_applyColVisibility(row)
    row += 1

    rrPutTxt  = not na(putRR)  ? str.tostring(putRR, "#.##")  : "-"
    rrCallTxt = not na(callRR) ? str.tostring(callRR, "#.##") : "-"
    putBaseGrade  = f_grade(putScore)
    callBaseGrade = f_grade(callScore)
    // Keep grade consistent with Daily decision: no A when blocked by hard filters.
    putCapGrade = putNoTradeDaily ? "D" : (putDailyCandidate ? "A" : "C")
    callCapGrade = callNoTradeDaily ? "D" : (callDailyCandidate ? "A" : "C")
    putGrade  = f_capGrade(putBaseGrade, putCapGrade)
    callGrade = f_capGrade(callBaseGrade, callCapGrade)
    putScoreCapped = f_capScoreByGrade(putScore, putCapGrade)
    callScoreCapped = f_capScoreByGrade(callScore, callCapGrade)

    // DIRECTION
    f_sectionRow(row, "DIRECTION")
    f_applyColVisibility(row)
    row += 1

    putStructTxt = structureChaos ? "CHAOS" : (bearStructure ? "BEAR TREND" : (bullStructure ? "BULL TREND" : (structureRange ? "RANGE" : "UNDEFINED")))
    callStructTxt = structureChaos ? "CHAOS" : (bullStructure ? "BULL TREND" : (bearStructure ? "BEAR TREND" : (structureRange ? "RANGE" : "UNDEFINED")))
    putStructCol = structureChaos ? colBad : (bearStructure ? colOk : (bullStructure ? colBad : colNA))
    callStructCol = structureChaos ? colBad : (bullStructure ? colOk : (bearStructure ? colBad : colNA))
    f_metricRow(row, "Daily structure", putStructTxt, putStructCol, callStructTxt, callStructCol)
    f_applyColVisibility(row)
    row += 1

    structureUsableTxt = structureUsable ? "YES" : "NO"
    f_metricRow(row, "Structure usable", structureUsableTxt, f_statusColor(structureUsable, false), structureUsableTxt, f_statusColor(structureUsable, false))
    f_applyColVisibility(row)
    row += 1

    putMarketTxt = putMarketAligned ? "SUPPORTIVE" : (marketBull ? "HEADWIND" : "NEUTRAL")
    callMarketTxt = callMarketAligned ? "SUPPORTIVE" : (marketBear ? "HEADWIND" : "NEUTRAL")
    putMarketCol = putMarketAligned ? colOk : ((marketBull and not putMarketAligned) ? colBad : colNA)
    callMarketCol = callMarketAligned ? colOk : ((marketBear and not callMarketAligned) ? colBad : colNA)
    f_metricRow(row, "Market alignment", putMarketTxt, putMarketCol, callMarketTxt, callMarketCol)
    f_applyColVisibility(row)
    row += 1

    rsPutTxt  = putRSOk  ? "RW" : f_failReason(7, true)
    rsCallTxt = callRSOk ? "RS" : f_failReason(7, false)
    f_metricRow(row, "RS/RW vs " + benchSymbol, rsPutTxt, f_statusColor(putRSOk, false), rsCallTxt, f_statusColor(callRSOk, false))
    f_applyColVisibility(row)
    row += 1

    // LOCATION
    f_sectionRow(row, "LOCATION")
    f_applyColVisibility(row)
    row += 1

    f_metricRow(row, "Location state", f_locDisplay(putLocationState), f_statusColor(putLocationOk, false), f_locDisplay(callLocationState), f_statusColor(callLocationOk, false))
    f_applyColVisibility(row)
    row += 1

    f_metricRow(row, "Location anchor", putLocationAnchor, colBg, callLocationAnchor, colBg)
    f_applyColVisibility(row)
    row += 1

    // RISK
    f_sectionRow(row, "RISK")
    f_applyColVisibility(row)
    row += 1

    putRiskTxt = putRiskDefined ? "DEFINED" : "UNCLEAR"
    callRiskTxt = callRiskDefined ? "DEFINED" : "UNCLEAR"
    f_metricRow(row, "Invalidation defined", putRiskTxt, f_statusColor(putRiskDefined, false), callRiskTxt, f_statusColor(callRiskDefined, false))
    f_applyColVisibility(row)
    row += 1

    putStopTxt = not na(putStop) ? str.tostring(putStop, "#.####") : "-"
    callStopTxt = not na(callStop) ? str.tostring(callStop, "#.####") : "-"
    f_metricRow(row, "Stop level", putStopTxt, colBg, callStopTxt, colBg)
    f_applyColVisibility(row)
    row += 1

    // REWARD
    f_sectionRow(row, "REWARD")
    f_applyColVisibility(row)
    row += 1

    putObstacleTxt = not na(putObstacle) ? str.tostring(putObstacle, "#.####") : "-"
    callObstacleTxt = not na(callObstacle) ? str.tostring(callObstacle, "#.####") : "-"
    f_metricRow(row, "Next obstacle", putObstacleTxt, colBg, callObstacleTxt, colBg)
    f_applyColVisibility(row)
    row += 1

    f_metricRow(row, "RR to next obstacle", rrPutTxt, f_statusColor(putHasRR, na(putRR)), rrCallTxt, f_statusColor(callHasRR, na(callRR)))
    f_applyColVisibility(row)
    row += 1

    // DECISION
    f_sectionRow(row, "DECISION")
    f_applyColVisibility(row)
    row += 1

    putBiasTxt = putDirectionOk ? "SHORT BIAS" : "NEUTRAL"
    callBiasTxt = callDirectionOk ? "LONG BIAS" : "NEUTRAL"
    putBiasCol = putDirectionOk ? colOk : colNA
    callBiasCol = callDirectionOk ? colOk : colNA
    f_metricRow(row, "Bias", putBiasTxt, putBiasCol, callBiasTxt, callBiasCol)
    f_applyColVisibility(row)
    row += 1

    putDecisionTxt = putDailyCandidate ? "VALID DAILY CANDIDATE" : (putNoTradeDaily ? "NO TRADE" : "WATCHLIST")
    callDecisionTxt = callDailyCandidate ? "VALID DAILY CANDIDATE" : (callNoTradeDaily ? "NO TRADE" : "WATCHLIST")
    putDecisionCol = putDailyCandidate ? colOk : (putNoTradeDaily ? colBad : colBg)
    callDecisionCol = callDailyCandidate ? colOk : (callNoTradeDaily ? colBad : colBg)
    f_metricRow(row, "Daily decision", putDecisionTxt, putDecisionCol, callDecisionTxt, callDecisionCol)
    f_applyColVisibility(row)
    row += 1

    // DETAILS
    if uiShowDetails
        row += 1
        f_sectionRow(row, "DETAILS (core checks)")
        row += 1

        f_metricRow(row, "Core score (decision-capped)", str.tostring(putScoreCapped, "#.##"), colBg, str.tostring(callScoreCapped, "#.##"), colBg)
        f_applyColVisibility(row)
        row += 1

        f_metricRow(row, "Grade (decision-capped)", putGrade, colBg, callGrade, colBg)
        f_applyColVisibility(row)
        row += 1

        f_checkRow(row, 1, "1) Structure usable", w1, putQ1, callQ1, false, false)
        row += 1
        f_checkRow(row, 2, "2) Clean chart (no chaos)", w2, putQ2, callQ2, false, false)
        row += 1
        f_checkRow(row, 3, "3) Location acceptable", w3, putQ3, callQ3, false, false)
        row += 1
        f_checkRow(row, 4, "4) Invalidation exists", w4, putQ4, callQ4, na(putInvalid), na(callInvalid))
        row += 1
        f_checkRow(row, 5, "5) Space to next obstacle", w5, putQ5, callQ5, na(putSpace), na(callSpace))
        row += 1
        f_checkRow(row, 6, "6) RR >= min", w6, putQ6, callQ6, na(putRR), na(callRR))
        row += 1
        f_checkRow(row, 7, "7) RS/RW vs benchmark", w7, putQ7, callQ7, false, false)
        row += 1

        if uiShowSoftContext
            row += 1
            f_sectionRow(row, "DETAILS: soft context / values")
            row += 1

            f_metricRow(row, "Soft: follow-through", putQ8 ? "YES" : "NO", f_statusColor(putQ8, false), callQ8 ? "YES" : "NO", f_statusColor(callQ8, false))
            f_applyColVisibility(row)
            row += 1

            f_metricRow(row, "Soft: one-sentence clarity", putQ9 ? "YES" : "NO", f_statusColor(putQ9, false), callQ9 ? "YES" : "NO", f_statusColor(callQ9, false))
            f_applyColVisibility(row)
            row += 1

            f_metricRow(row, "Soft: A/B proxy", putQ10 ? "YES" : "NO", f_statusColor(putQ10, false), callQ10 ? "YES" : "NO", f_statusColor(callQ10, false))
            f_applyColVisibility(row)
            row += 1

            f_valueRow(row, "ATR / ADX", str.tostring(atr, "#.####") + " / " + str.tostring(adx, "#.##"), str.tostring(atr, "#.####") + " / " + str.tostring(adx, "#.##"))
            f_applyColVisibility(row)
            row += 1

            f_valueRow(row, "RS slope", str.tostring(rsSlope, "#.######"), str.tostring(rsSlope, "#.######"))
            f_applyColVisibility(row)
            row += 1

            f_valueRow(row, "20/50/200 MA", str.tostring(ema20, "#.####") + " / " + str.tostring(sma50, "#.####") + " / " + str.tostring(sma200, "#.####"),
                               str.tostring(ema20, "#.####") + " / " + str.tostring(sma50, "#.####") + " / " + str.tostring(sma200, "#.####"))
            f_applyColVisibility(row)
            row += 1

            srTxt = (na(nearestSupport) ? "-" : str.tostring(nearestSupport, "#.####")) + " / " + (na(nearestResist) ? "-" : str.tostring(nearestResist, "#.####"))
            f_valueRow(row, "Nearest S / R", srTxt, srTxt)
            f_applyColVisibility(row)
            row += 1

            f_valueRow(row, "Stop (PUT/CALL)", na(putStop) ? "-" : str.tostring(putStop, "#.####"), na(callStop) ? "-" : str.tostring(callStop, "#.####"))
            f_applyColVisibility(row)
            row += 1

            f_valueRow(row, "Space (PUT/CALL)", (na(putSpace) ? "-" : str.tostring(putSpace, "#.####")) + " (" + str.tostring(minSpaceAtr) + "xATR)",
                                         (na(callSpace) ? "-" : str.tostring(callSpace, "#.####")) + " (" + str.tostring(minSpaceAtr) + "xATR)")
            f_applyColVisibility(row)
            row += 1

            f_valueRow(row, "RR (PUT/CALL)", rrPutTxt, rrCallTxt)
            f_applyColVisibility(row)
            row += 1

    // Clear remaining unused rows
    if row < maxRows
        for r = row to maxRows - 1
            for c = 0 to 2
                f_setCell(r, c, "", color.new(color.black, 100), color.new(color.white, 100))
