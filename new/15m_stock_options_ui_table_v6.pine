//@version=6
indicator("Stock 15m", overlay=true, max_labels_count=500, max_lines_count=500)

//------------------------------------------------------------------------------
// Inputs (all user-configurable)
//------------------------------------------------------------------------------
groupUI   = "UI"
uiShow    = input.bool(true, "Show table", group=groupUI)
uiOpacity = input.int(10, "Table visibility (0=solid, 100=invisible)", minval=0, maxval=100, group=groupUI)
uiShowDetails = input.bool(true, "Show CHECKS section", group=groupUI)
uiShowDebug = input.bool(false, "Show DEBUG metrics", group=groupUI)
uiTextSize = input.string("small", "Text size", options=["tiny","small","normal","large"], group=groupUI)
uiShowHintWhenNot15m = input.bool(false, "Show hint when not on 15m", group=groupUI)
uiShowEMarks = input.bool(true, "Show E marks", group=groupUI)
uiShowMarket1DMarks = input.bool(true, "Show Market 1D marks", group=groupUI)
uiShow1HMarks = input.bool(true, "Show 1H marks", group=groupUI)
uiShow4HMarks = input.bool(true, "Show 4H marks", group=groupUI)
uiShow1DMarks = input.bool(true, "Show 1D marks", group=groupUI)
uiLaneOpacity = input.int(0, "Lane/marker visibility (0=solid, 100=invisible)", minval=0, maxval=100, group=groupUI)
uiShowMarkSummary = input.bool(false, "Show mark summary", group=groupUI)
markSummaryDays = input.int(30, "Mark summary lookback (days)", minval=1, maxval=365, group=groupUI)

groupMode = "Mode"
modeShowBoth = input.bool(true, "Show both PUT & CALL", group=groupMode)
modeFocus = input.string("BOTH", "Focus", options=["BOTH","CALL","PUT"], group=groupMode)

groupTF = "Timeframe gating"
onlyOn15m = input.bool(true, "Render table only on 15m", group=groupTF)

groupBench = "HTF context (light)"
benchSymbol = input.symbol("SPY", "Benchmark / market symbol", group=groupBench)
htfTF = input.timeframe("60", "HTF for risk-compression compare", group=groupBench)
dailyTF = input.timeframe("D", "Daily context TF (week type proxy)", group=groupBench)

groupStructure = "Structure / levels"
pivLen = input.int(5, "Pivot length (micro swings)", minval=2, maxval=20, group=groupStructure)
maFastLen = input.int(20, "EMA fast", minval=1, group=groupStructure)
maMidLen  = input.int(50, "SMA mid", minval=1, group=groupStructure)

groupFilters = "Filters / Thresholds"
atrLen = input.int(14, "ATR length", minval=1, group=groupFilters)
volLen = input.int(20, "Volume SMA length", minval=1, group=groupFilters)
nearLevelAtr = input.float(0.9, "Near level within x ATR", minval=0.1, step=0.1, group=groupFilters)
volImpulseMult = input.float(1.2, "Impulse vol >= SMA *", minval=0.5, step=0.1, group=groupFilters)
wickBodyMult = input.float(0.8, "Reaction wick >= x body", minval=0.1, step=0.1, group=groupFilters)
closePosPct = input.float(0.6, "Reaction close position (0..1)", minval=0.1, maxval=0.9, step=0.05, group=groupFilters)
reactionWindowBars = input.int(2, "Reaction validity window (bars)", minval=0, maxval=5, group=groupFilters)

extendedAtr = input.float(1.8, "Extended if |close-EMA| > x ATR", minval=0.5, step=0.25, group=groupFilters)
softExtendedBandAtr = input.float(0.4, "Soft extension band (x ATR)", minval=0.1, step=0.1, group=groupFilters)
impulseBars = input.int(4, "Overextension: impulse bars window", minval=2, maxval=10, group=groupFilters)
impulseBodyPct = input.float(0.55, "Impulse: body/range >= ", minval=0.1, maxval=0.95, step=0.05, group=groupFilters)

pullbackWin = input.int(12, "Pullback health window (bars)", minval=5, maxval=50, group=groupFilters)
aggrRetracePct = input.float(0.65, "Aggressive pullback if retrace >= ", minval=0.2, maxval=0.9, step=0.05, group=groupFilters)

stopBufAtr = input.float(0.20, "Stop buffer (x ATR)", minval=0.0, step=0.05, group=groupFilters)
riskAtrMax = input.float(2.0, "Max risk (x ATR) for 15m entry", minval=0.5, step=0.25, group=groupFilters)
minRR = input.float(1.5, "Minimum RR", minval=0.5, step=0.25, group=groupFilters)

rsiLen = input.int(14, "RSI length", minval=1, group=groupFilters)
rsiMid = input.float(50.0, "RSI mid", minval=1, maxval=99, step=1, group=groupFilters)

groupEntry = "Entry calibration (15m)"
entryTrendMin = input.float(58.0, "ENTRY: min Trend score", minval=0, maxval=100, step=1, group=groupEntry)
entryScoreMin = input.float(62.0, "ENTRY: min Entry score", minval=0, maxval=100, step=1, group=groupEntry)
h1MacdNearZeroPct = input.float(0.0005, "1H gate: MACD near zero (% price)", minval=0.0, step=0.0001, group=groupEntry)
entryHoldAtr = input.float(0.30, "ENTRY: break-hold tolerance (x ATR)", minval=0.0, step=0.05, group=groupEntry)
entryBreakLookback = input.int(6, "ENTRY: minor break lookback (bars)", minval=3, maxval=50, group=groupEntry)

groupGrading = "Grading"
gradeA = input.int(75, "Grade A threshold", minval=0, maxval=100, group=groupGrading)
gradeB = input.int(60, "Grade B threshold", minval=0, maxval=100, group=groupGrading)
gradeC = input.int(50, "Grade C threshold", minval=0, maxval=100, group=groupGrading)

//------------------------------------------------------------------------------
// Helpers
//------------------------------------------------------------------------------
is15m = timeframe.isminutes and timeframe.multiplier == 15

f_txtSize(_s) =>
    if _s == "tiny"
        size.tiny
    else if _s == "small"
        size.small
    else if _s == "normal"
        size.normal
    else
        size.large

txtSize = f_txtSize(uiTextSize)

f_c(_col) => color.new(_col, uiOpacity)
f_laneC(_col) => color.new(_col, uiLaneOpacity)

colOk  = f_c(color.lime)
colWarn = f_c(color.orange)
colBad = f_c(color.red)
colNA  = f_c(color.gray)
colHdr = f_c(color.silver)
colBg  = f_c(color.black)
colSep = f_c(color.new(color.gray, math.min(100, uiOpacity + 40)))

f_statusColor(_ok, _na) =>
    _na ? colNA : (_ok ? colOk : colBad)

f_boolToText(_ok, _na) =>
    _na ? "-" : (_ok ? "YES" : "NO")

f_gateText(_ok, _na, _reason) =>
    _na ? "-" : (_ok ? "YES" : _reason)

f_grade(_score) =>
    if _score >= gradeA
        "A"
    else if _score >= gradeB
        "B"
    else if _score >= gradeC
        "C"
    else
        "D"

f_gradeRank(_g) =>
    _g == "A" ? 4 : _g == "B" ? 3 : _g == "C" ? 2 : 1

f_gradeFromRank(_r) =>
    _r >= 4 ? "A" : _r == 3 ? "B" : _r == 2 ? "C" : "D"

f_capGrade(_base, _cap) =>
    f_gradeFromRank(math.min(f_gradeRank(_base), f_gradeRank(_cap)))

f_confBand(_v) =>
    _v > 75 ? "HIGH" : (_v >= 55 ? "WATCH" : "LOW")

f_score(_ok, _w) => _ok ? _w : 0

f_rollSum(_src, _len) =>
    float _sum = 0.0
    for i = 0 to _len - 1
        _sum += nz(_src[i], 0.0)
    _sum

f_macdHist() =>
    [_m, _s, _h] = ta.macd(close, 12, 26, 9)
    _h

f_pickSupport(_last, _prev, _px) =>
    float _s = na
    if not na(_last) and _last <= _px
        _s := _last
    if not na(_prev) and _prev <= _px
        _s := na(_s) ? _prev : ((_px - _prev) < (_px - _s) ? _prev : _s)
    _s

f_pickResist(_last, _prev, _px) =>
    float _r = na
    if not na(_last) and _last >= _px
        _r := _last
    if not na(_prev) and _prev >= _px
        _r := na(_r) ? _prev : ((_prev - _px) < (_r - _px) ? _prev : _r)
    _r

f_h1MirrorBlockerText(_directionalOk, _q5, _rrHardOk, _isExtended, _locationOk, _trendClarityOk, _isChaos, _hasRR) =>
    if not _directionalOk
        "NO THESIS"
    else if not _q5
        "NO STOP"
    else if not _rrHardOk
        "RR TOO LOW"
    else if _isExtended
        "WAIT PULLBACK"
    else if not _locationOk
        "WAIT LOCATION"
    else if not _trendClarityOk
        "WAIT STRUCTURE"
    else if _isChaos
        "MESSY STRUCTURE"
    else if not _hasRR
        "RR BELOW FULL"
    else
        "SETUP READY"

f_h1MirrorBlockerPass(_directionalOk, _q5, _rrHardOk, _isExtended, _locationOk, _trendClarityOk, _isChaos, _hasRR) =>
    if not _directionalOk
        0
    else if not _q5
        1
    else if not _rrHardOk
        2
    else if _isExtended
        3
    else if not _locationOk
        4
    else if not _trendClarityOk
        5
    else if _isChaos
        6
    else if not _hasRR
        7
    else
        8

f_h1MirrorStateColor(_txt) =>
    _txt == "SETUP READY" ? colOk : ((_txt == "NO THESIS" or _txt == "NO STOP" or _txt == "RR TOO LOW") ? colBad : colWarn)

f_d1MirrorStateColor(_txt) =>
    (_txt == "LONG CANDIDATE" or _txt == "SHORT CANDIDATE") ? colOk : ((_txt == "STRUCTURE CHAOS" or _txt == "OPPOSITE STRUCTURE" or _txt == "NO STOP" or _txt == "RISK TOO WIDE" or _txt == "RR TOO LOW" or _txt == "SPACE TOO TIGHT") ? colBad : colWarn)

f_lookbackBarsFromDays(_days) =>
    if timeframe.isminutes
        math.max(1, int(math.ceil(_days * 1440.0 / timeframe.multiplier)))
    else if timeframe.isdaily
        math.max(1, int(math.ceil(_days / timeframe.multiplier)))
    else if timeframe.isweekly
        math.max(1, int(math.ceil(_days / (7.0 * timeframe.multiplier))))
    else if timeframe.ismonthly
        math.max(1, int(math.ceil(_days / (30.0 * timeframe.multiplier))))
    else
        math.max(1, int(math.ceil(_days * 1440.0 / 15.0)))

f_lookbackDaysFromBars(_bars) =>
    if timeframe.isminutes
        _bars * timeframe.multiplier / 1440.0
    else if timeframe.isdaily
        _bars * timeframe.multiplier
    else if timeframe.isweekly
        _bars * timeframe.multiplier * 7.0
    else if timeframe.ismonthly
        _bars * timeframe.multiplier * 30.0
    else
        _bars * 15.0 / 1440.0

f_m1dMirrorStateColor(_txt) =>
    (_txt == "BEARISH" or _txt == "BULLISH") ? colOk : (_txt == "SUPPORTIVE" ? colWarn : (_txt == "UNSTABLE" ? colBad : colBg))

f_m1dMirrorReason(_unstableState, _isUnstable, _hasClimax, _lost20, _adxWeak, _momFlip, _regimeTxt, _biasOk, _crossOk, _structureSoft, _locationSoft, _hasRR) =>
    if _unstableState and _isUnstable
        "VOL"
    else if not _biasOk
        "BIAS"
    else if not _crossOk
        "CROSS"
    else if not _structureSoft
        "STRUCTURE"
    else if _regimeTxt == "RANGE"
        "RANGE"
    else if _regimeTxt != "TREND"
        "TRANSITION"
    else if _hasClimax
        "CLIMAX"
    else if _lost20
        "EMA20"
    else if _adxWeak
        "ADX"
    else if _momFlip
        "MACD"
    else if not _locationSoft
        "LOCATION"
    else if not _hasRR
        "RR"
    else
        "OK"

f_m1dMirrorCorePass(_unstableState, _biasCore, _structureSoft, _regimeTxt) =>
    if _unstableState
        0
    else if not _biasCore
        0
    else if not _structureSoft
        1
    else if _regimeTxt != "TREND"
        2
    else
        3

f_m1dMirrorQualityPass(_unstableState, _locationSoft, _hasRR) =>
    if _unstableState
        0
    else if not _locationSoft
        0
    else if not _hasRR
        1
    else
        2

// Mirror of the Market 1D panel's state engine, using the source script defaults.
m1dMirrorCrossCheckEnabled = true
m1dMirrorRsLen = 20
m1dMirrorPivLen = 5
m1dMirrorAtrLen = 14
m1dMirrorAdxLen = 14
m1dMirrorAdxTrend = 18.0
m1dMirrorChaosOverlapThresh = 0.55
m1dMirrorUnstableTrAtr = 2.5
m1dMirrorMa20Len = 20
m1dMirrorMa50Len = 50
m1dMirrorMa200Len = 200
m1dMirrorBbLen = 20
m1dMirrorBbMult = 2.0
m1dMirrorMinRR = 1.75
m1dMirrorRrSupportFloor = 1.5
m1dMirrorStopBufAtr = 0.25
m1dMirrorExtendedAtr = 2.0
m1dMirrorClimaxBars = 4
m1dMirrorClimaxTrAtr = 2.0

f_m1dMirrorState() =>
    _atr = ta.atr(m1dMirrorAtrLen)
    _tr = ta.tr(true)
    [_diPlus, _diMinus, _adx] = ta.dmi(m1dMirrorAdxLen, m1dMirrorAdxLen)
    _ema20 = ta.ema(close, m1dMirrorMa20Len)
    _sma50 = ta.sma(close, m1dMirrorMa50Len)
    _sma200 = ta.sma(close, m1dMirrorMa200Len)
    _macdHist = f_macdHist()

    _basis = ta.sma(close, m1dMirrorBbLen)
    _dev = m1dMirrorBbMult * ta.stdev(close, m1dMirrorBbLen)
    _bbU = _basis + _dev
    _bbL = _basis - _dev
    _bbWidth = (_bbU - _bbL) / math.max(1e-10, _basis)
    _bbWidthMA = ta.sma(_bbWidth, m1dMirrorBbLen)
    _isCompression = _bbWidth < _bbWidthMA
    _isExpansion = _bbWidth > _bbWidthMA
    _wasCompression = bar_index > 0 ? (_isCompression[1] == true) : false

    _ph = ta.pivothigh(high, m1dMirrorPivLen, m1dMirrorPivLen)
    _pl = ta.pivotlow(low, m1dMirrorPivLen, m1dMirrorPivLen)
    _lastPH = ta.valuewhen(not na(_ph), _ph, 0)
    _prevPH = ta.valuewhen(not na(_ph), _ph, 1)
    _lastPL = ta.valuewhen(not na(_pl), _pl, 0)
    _prevPL = ta.valuewhen(not na(_pl), _pl, 1)
    _bullStructure = not na(_lastPH) and not na(_prevPH) and not na(_lastPL) and not na(_prevPL) and _lastPH > _prevPH and _lastPL > _prevPL
    _bearStructure = not na(_lastPH) and not na(_prevPH) and not na(_lastPL) and not na(_prevPL) and _lastPH < _prevPH and _lastPL < _prevPL

    _rng = high - low
    _prevRng = high[1] - low[1]
    _overlap = math.max(0.0, math.min(high, high[1]) - math.max(low, low[1]))
    _overlapRatio = (_rng > 0 and _prevRng > 0) ? (_overlap / math.min(_rng, _prevRng)) : na
    _isChop = (_adx < (m1dMirrorAdxTrend - 2)) and not na(_overlapRatio) and _overlapRatio > m1dMirrorChaosOverlapThresh

    _trSpike = _tr >= m1dMirrorUnstableTrAtr * _atr
    _stdev10 = ta.stdev(close, 10)
    _stdev50 = ta.stdev(close, 50)
    _isUnstable = _trSpike or (_stdev10 > 1.5 * _stdev50)

    _climaxSpikeSrc = ta.tr(true) >= m1dMirrorClimaxTrAtr * _atr ? 1.0 : 0.0
    _climaxCount = f_rollSum(_climaxSpikeSrc, m1dMirrorClimaxBars)
    _hasClimax = _climaxCount >= 3

    _bullBias = close > _sma200 and (_ema20 > _ema20[5] or _sma50 >= _sma50[5])
    _bearBias = close < _sma200 and (_ema20 < _ema20[5] or _sma50 <= _sma50[5])

    _isTrend = _adx >= m1dMirrorAdxTrend and not _isChop and not _isUnstable
    _isRange = (_adx < m1dMirrorAdxTrend) and _isChop
    _regimeTxt = _isTrend ? "TREND" : (_isRange ? "RANGE" : "TRANSITION")

    _pivotSupport = f_pickSupport(_lastPL, _prevPL, close)
    _pivotResist = f_pickResist(_lastPH, _prevPH, close)
    _wkLow = request.security(syminfo.tickerid, "W", low[1])
    _wkHigh = request.security(syminfo.tickerid, "W", high[1])
    _moLow = request.security(syminfo.tickerid, "M", low[1])
    _moHigh = request.security(syminfo.tickerid, "M", high[1])
    _yrLow = request.security(syminfo.tickerid, "12M", low[1])
    _yrHigh = request.security(syminfo.tickerid, "12M", high[1])
    _fallbackSupport = not na(_wkLow) ? _wkLow : (not na(_moLow) ? _moLow : (not na(_yrLow) ? _yrLow : na))
    _fallbackResist = not na(_wkHigh) ? _wkHigh : (not na(_moHigh) ? _moHigh : (not na(_yrHigh) ? _yrHigh : na))
    _nearestSupport = not na(_pivotSupport) ? _pivotSupport : (not na(_fallbackSupport) ? _fallbackSupport : (not na(_atr) ? close - 2.0 * _atr : low))
    _nearestResist = not na(_pivotResist) ? _pivotResist : (not na(_fallbackResist) ? _fallbackResist : (not na(_atr) ? close + 2.0 * _atr : high))

    _distTo20 = math.abs(close - _ema20)
    _distTo50 = math.abs(close - _sma50)
    _distTo200 = math.abs(close - _sma200)
    _nearEMA20 = _distTo20 <= _atr
    _nearSMA50 = _distTo50 <= _atr
    _nearSMA200 = _distTo200 <= _atr
    _nearMA = _nearEMA20 or _nearSMA50 or _nearSMA200

    _distToSupport = not na(_nearestSupport) ? math.abs(close - _nearestSupport) : na
    _distToResist = not na(_nearestResist) ? math.abs(close - _nearestResist) : na
    _nearSupport = not na(_distToSupport) and _distToSupport <= _atr
    _nearResist = not na(_distToResist) and _distToResist <= _atr
    _distSupportSafe = na(_distToSupport) ? 1e10 : _distToSupport
    _distResistSafe = na(_distToResist) ? 1e10 : _distToResist
    _nearestStructureDist = math.min(_distSupportSafe, _distResistSafe)
    _extended = _atr > 0 ? _nearestStructureDist > m1dMirrorExtendedAtr * _atr : false

    _structureSupportsMoveBull = _bullStructure and (_isTrend or (_wasCompression and _isExpansion))
    _structureSupportsMoveBear = _bearStructure and (_isTrend or (_wasCompression and _isExpansion))

    _callInvalid = _nearestSupport
    _putInvalid = _nearestResist
    _callStop = not na(_callInvalid) ? _callInvalid - m1dMirrorStopBufAtr * _atr : na
    _putStop = not na(_putInvalid) ? _putInvalid + m1dMirrorStopBufAtr * _atr : na
    _callRisk = not na(_callStop) ? math.abs(close - _callStop) : na
    _putRisk = not na(_putStop) ? math.abs(_putStop - close) : na
    _callRewardSr = not na(_nearestResist) ? math.max(0.0, _nearestResist - close) : na
    _putRewardSr = not na(_nearestSupport) ? math.max(0.0, close - _nearestSupport) : na
    _callRewardAlt = not na(_callRisk) ? 1.5 * _callRisk : na
    _putRewardAlt = not na(_putRisk) ? 1.5 * _putRisk : na
    _callReward = not na(_callRewardSr) and not na(_callRewardAlt) ? math.max(_callRewardSr, _callRewardAlt) : (not na(_callRewardSr) ? _callRewardSr : _callRewardAlt)
    _putReward = not na(_putRewardSr) and not na(_putRewardAlt) ? math.max(_putRewardSr, _putRewardAlt) : (not na(_putRewardSr) ? _putRewardSr : _putRewardAlt)
    _callRR = not na(_callRisk) and _callRisk > 0 and not na(_callReward) ? (_callReward / _callRisk) : na
    _putRR = not na(_putRisk) and _putRisk > 0 and not na(_putReward) ? (_putReward / _putRisk) : na
    _callHasRR = not na(_callRR) and _callRR >= m1dMirrorMinRR
    _putHasRR = not na(_putRR) and _putRR >= m1dMirrorMinRR
    _callRrSupportive = not na(_callRR) and _callRR >= math.min(m1dMirrorRrSupportFloor, m1dMirrorMinRR)
    _putRrSupportive = not na(_putRR) and _putRR >= math.min(m1dMirrorRrSupportFloor, m1dMirrorMinRR)

    _crossDnEma20 = ta.crossunder(close, _ema20)
    _crossUpEma20 = ta.crossover(close, _ema20)
    _crossDnMacd0 = ta.crossunder(_macdHist, 0)
    _crossUpMacd0 = ta.crossover(_macdHist, 0)
    _lost20Bull = _crossDnEma20 and _bullBias
    _lost20Bear = _crossUpEma20 and _bearBias
    _momFlip = _crossDnMacd0 or _crossUpMacd0
    _adxWeak = _adx < (m1dMirrorAdxTrend - 3) and _isTrend[10]
    _regimeChangeRisk = (_lost20Bull or _lost20Bear) or _adxWeak or (_momFlip and (_isTrend == false))

    _ticker = syminfo.ticker
    _isSpyOrQqq = _ticker == "SPY" or _ticker == "QQQ"
    _otherSymbol = _ticker == "QQQ" ? "SPY" : (_ticker == "SPY" ? "QQQ" : _ticker)
    _otherClose = request.security(_otherSymbol, dailyTF, close)
    _crossRatio = not na(_otherClose) and _otherClose != 0 ? (close / _otherClose) : na
    _crossSlope = ta.linreg(_crossRatio, m1dMirrorRsLen, 0) - ta.linreg(_crossRatio, m1dMirrorRsLen, 1)
    _crossCheckActive = m1dMirrorCrossCheckEnabled and _isSpyOrQqq
    _crossOkBull = not _crossCheckActive or _crossSlope >= 0
    _crossOkBear = not _crossCheckActive or _crossSlope <= 0

    _callBiasStrong = _bullBias and _crossOkBull
    _putBiasStrong = _bearBias and _crossOkBear
    _callBiasSupportive = _bullBias
    _putBiasSupportive = _bearBias
    _callBiasCore = _callBiasSupportive
    _putBiasCore = _putBiasSupportive
    _callStructureSoft = _bullStructure or _structureSupportsMoveBull
    _putStructureSoft = _bearStructure or _structureSupportsMoveBear
    _callLocationSoft = (not _extended) and (_nearMA or _nearSupport or _isCompression or (_bullBias and close >= _sma50))
    _putLocationSoft = (not _extended) and (_nearMA or _nearResist or _isCompression or (_bearBias and close <= _sma50))
    _unstableState = _isUnstable
    _warningState = _hasClimax or _regimeChangeRisk
    _callStrong = _callBiasStrong and _callStructureSoft and _callLocationSoft and _callHasRR and _regimeTxt == "TREND" and not _warningState
    _putStrong = _putBiasStrong and _putStructureSoft and _putLocationSoft and _putHasRR and _regimeTxt == "TREND" and not _warningState
    _callSupportive = _callBiasSupportive and _callStructureSoft and _callRrSupportive and (_regimeTxt == "TREND" or _regimeTxt == "TRANSITION") and _callLocationSoft
    _putSupportive = _putBiasSupportive and _putStructureSoft and _putRrSupportive and (_regimeTxt == "TREND" or _regimeTxt == "TRANSITION") and _putLocationSoft

    _putState = _unstableState ? "UNSTABLE" : (_putStrong ? "BEARISH" : (_putSupportive ? "SUPPORTIVE" : "NEUTRAL"))
    _callState = _unstableState ? "UNSTABLE" : (_callStrong ? "BULLISH" : (_callSupportive ? "SUPPORTIVE" : "NEUTRAL"))

    _putReason = f_m1dMirrorReason(_unstableState, _isUnstable, _hasClimax, _lost20Bear or _lost20Bull, _adxWeak, _momFlip, _regimeTxt, _bearBias, _crossOkBear, _putStructureSoft, _putLocationSoft, _putHasRR)
    _callReason = f_m1dMirrorReason(_unstableState, _isUnstable, _hasClimax, _lost20Bull or _lost20Bear, _adxWeak, _momFlip, _regimeTxt, _bullBias, _crossOkBull, _callStructureSoft, _callLocationSoft, _callHasRR)
    _putCorePass = f_m1dMirrorCorePass(_unstableState, _putBiasCore, _putStructureSoft, _regimeTxt)
    _callCorePass = f_m1dMirrorCorePass(_unstableState, _callBiasCore, _callStructureSoft, _regimeTxt)
    _putQualityPass = f_m1dMirrorQualityPass(_unstableState, _putLocationSoft, _putHasRR)
    _callQualityPass = f_m1dMirrorQualityPass(_unstableState, _callLocationSoft, _callHasRR)

    [_putState, _callState, _putReason, _callReason, _putCorePass, _callCorePass, _putQualityPass, _callQualityPass]

// Mirror of the 1H panel's READY FOR LTF state, using the 1H script's core defaults.
h1MirrorHtfAlignTf = "D"
h1MirrorAtrLocMult = 1.0
h1MirrorMinRR = 1.75
h1MirrorRrHardFloor = 1.5
h1MirrorBbLen = 20
h1MirrorBbMult = 2.0
h1MirrorChaosOverlapThresh = 0.55
h1MirrorExtendedAtr = 1.6
h1MirrorStopBufAtr = 0.25
h1MirrorMaPullbackAtr = 0.25

f_h1ReadyForLtfClosed() =>
    _atr = ta.atr(atrLen)
    _ema20 = ta.ema(close, 20)

    _htfClose = request.security(syminfo.tickerid, h1MirrorHtfAlignTf, close)
    _htfEma = request.security(syminfo.tickerid, h1MirrorHtfAlignTf, ta.ema(close, 50))
    _htfBull = _htfClose > _htfEma
    _htfBear = _htfClose < _htfEma

    _ph = ta.pivothigh(high, pivLen, pivLen)
    _pl = ta.pivotlow(low, pivLen, pivLen)
    _lastPH = ta.valuewhen(not na(_ph), _ph, 0)
    _prevPH = ta.valuewhen(not na(_ph), _ph, 1)
    _lastPL = ta.valuewhen(not na(_pl), _pl, 0)
    _prevPL = ta.valuewhen(not na(_pl), _pl, 1)

    _bullStructure = not na(_lastPH) and not na(_prevPH) and not na(_lastPL) and not na(_prevPL) and _lastPH > _prevPH and _lastPL > _prevPL
    _bearStructure = not na(_lastPH) and not na(_prevPH) and not na(_lastPL) and not na(_prevPL) and _lastPH < _prevPH and _lastPL < _prevPL

    _basis = ta.sma(close, h1MirrorBbLen)
    _dev = h1MirrorBbMult * ta.stdev(close, h1MirrorBbLen)
    _bbU = _basis + _dev
    _bbL = _basis - _dev
    _bbWidth = (_bbU - _bbL) / _basis
    _bbWidthMA = ta.sma(_bbWidth, h1MirrorBbLen)
    _isCompression = _bbWidth < _bbWidthMA

    [_diPlus, _diMinus, _adx] = ta.dmi(14, 14)
    _isRange = _adx < 18
    _rng = high - low
    _prevRng = high[1] - low[1]
    _overlap = math.max(0.0, math.min(high, high[1]) - math.max(low, low[1]))
    _overlapRatio = (_rng > 0 and _prevRng > 0) ? (_overlap / math.min(_rng, _prevRng)) : na
    _isChaos = not na(_overlapRatio) and _overlapRatio > h1MirrorChaosOverlapThresh and _isRange

    _pivotSupport = f_pickSupport(_lastPL, _prevPL, close)
    _pivotResist = f_pickResist(_lastPH, _prevPH, close)
    _wkLow = request.security(syminfo.tickerid, "W", low[1])
    _wkHigh = request.security(syminfo.tickerid, "W", high[1])
    _moLow = request.security(syminfo.tickerid, "M", low[1])
    _moHigh = request.security(syminfo.tickerid, "M", high[1])
    _yrLow = request.security(syminfo.tickerid, "12M", low[1])
    _yrHigh = request.security(syminfo.tickerid, "12M", high[1])
    _fallbackSupport = not na(_wkLow) ? _wkLow : (not na(_moLow) ? _moLow : (not na(_yrLow) ? _yrLow : na))
    _fallbackResist = not na(_wkHigh) ? _wkHigh : (not na(_moHigh) ? _moHigh : (not na(_yrHigh) ? _yrHigh : na))
    _nearestSupport = not na(_pivotSupport) ? _pivotSupport : (not na(_fallbackSupport) ? _fallbackSupport : (not na(_atr) ? close - 2.0 * _atr : low))
    _nearestResist = not na(_pivotResist) ? _pivotResist : (not na(_fallbackResist) ? _fallbackResist : (not na(_atr) ? close + 2.0 * _atr : high))

    _distToSupport = not na(_nearestSupport) ? math.abs(close - _nearestSupport) : na
    _distToResist = not na(_nearestResist) ? math.abs(close - _nearestResist) : na
    _nearSupport = not na(_distToSupport) and _distToSupport <= h1MirrorAtrLocMult * _atr
    _nearResist = not na(_distToResist) and _distToResist <= h1MirrorAtrLocMult * _atr
    _nearEma20 = _atr > 0 ? math.abs(close - _ema20) <= h1MirrorAtrLocMult * _atr : false

    _distToEma = math.abs(close - _ema20)
    _distEmaAtr = _atr > 0 ? (_distToEma / _atr) : na
    _isExtended = not na(_distEmaAtr) and _distEmaAtr > h1MirrorExtendedAtr

    _callInvalid = _nearestSupport
    _putInvalid = _nearestResist
    _callStop = not na(_callInvalid) ? _callInvalid - h1MirrorStopBufAtr * _atr : na
    _putStop = not na(_putInvalid) ? _putInvalid + h1MirrorStopBufAtr * _atr : na
    _callRisk = not na(_callStop) ? math.abs(close - _callStop) : na
    _putRisk = not na(_putStop) ? math.abs(_putStop - close) : na
    _callTarget = _nearestResist
    _putTarget = _nearestSupport
    _callRewardSr = not na(_callTarget) ? math.abs(_callTarget - close) : na
    _putRewardSr = not na(_putTarget) ? math.abs(close - _putTarget) : na
    _callRewardAlt = not na(_callRisk) ? 1.5 * _callRisk : na
    _putRewardAlt = not na(_putRisk) ? 1.5 * _putRisk : na
    _callReward = not na(_callRewardSr) and not na(_callRewardAlt) ? math.max(_callRewardSr, _callRewardAlt) : (not na(_callRewardSr) ? _callRewardSr : _callRewardAlt)
    _putReward = not na(_putRewardSr) and not na(_putRewardAlt) ? math.max(_putRewardSr, _putRewardAlt) : (not na(_putRewardSr) ? _putRewardSr : _putRewardAlt)
    _callRR = not na(_callRisk) and _callRisk > 0 and not na(_callReward) ? (_callReward / _callRisk) : na
    _putRR = not na(_putRisk) and _putRisk > 0 and not na(_putReward) ? (_putReward / _putRisk) : na
    _rrHardFloorEff = math.min(h1MirrorRrHardFloor, h1MirrorMinRR)
    _callRRHardOk = not na(_callRR) and _callRR >= _rrHardFloorEff
    _putRRHardOk = not na(_putRR) and _putRR >= _rrHardFloorEff
    _callHasRR = not na(_callRR) and _callRR >= h1MirrorMinRR
    _putHasRR = not na(_putRR) and _putRR >= h1MirrorMinRR

    _callReversalStructureOk = not na(_lastPL) and (na(_prevPL) or _lastPL >= _prevPL)
    _putReversalStructureOk = not na(_lastPH) and (na(_prevPH) or _lastPH <= _prevPH)
    _rangeStructureAcceptable = _isRange and not _isChaos
    _callTrendClarityOk = _bullStructure or _callReversalStructureOk or _rangeStructureAcceptable
    _putTrendClarityOk = _bearStructure or _putReversalStructureOk or _rangeStructureAcceptable

    _callAligned = _htfBull
    _putAligned = _htfBear
    _callConf = not na(_prevPH) and close > _prevPH
    _putConf = not na(_prevPL) and close < _prevPL
    _callCountertrendOk = (not _callAligned) and (_bullStructure or _callReversalStructureOk or _callConf)
    _putCountertrendOk = (not _putAligned) and (_bearStructure or _putReversalStructureOk or _putConf)
    _callDirectionalOk = _callAligned or _callCountertrendOk
    _putDirectionalOk = _putAligned or _putCountertrendOk

    _callStructuralLoc = _nearSupport or _nearResist
    _putStructuralLoc = _nearResist or _nearSupport
    _callMaPullbackLoc = _nearEma20 and close <= _ema20 + h1MirrorMaPullbackAtr * _atr
    _putMaPullbackLoc = _nearEma20 and close >= _ema20 - h1MirrorMaPullbackAtr * _atr
    _callCompressionLoc = _isCompression and close >= _ema20 and _callTrendClarityOk
    _putCompressionLoc = _isCompression and close <= _ema20 and _putTrendClarityOk
    _callLocationOk = _callStructuralLoc or _callMaPullbackLoc or _callCompressionLoc
    _putLocationOk = _putStructuralLoc or _putMaPullbackLoc or _putCompressionLoc

    _callQ5 = not na(_callInvalid) and not na(_callStop) and _callRisk > 0
    _putQ5 = not na(_putInvalid) and not na(_putStop) and _putRisk > 0
    _callNoTradeState = (not _callDirectionalOk) or (not _callQ5) or (not _callRRHardOk)
    _putNoTradeState = (not _putDirectionalOk) or (not _putQ5) or (not _putRRHardOk)
    _callPlanBaseOk = _callDirectionalOk and _callLocationOk and _callQ5 and _callRRHardOk and not _isExtended
    _putPlanBaseOk = _putDirectionalOk and _putLocationOk and _putQ5 and _putRRHardOk and not _isExtended
    _callReadyForLtf = _callPlanBaseOk and _callTrendClarityOk and not _isChaos and _callHasRR
    _putReadyForLtf = _putPlanBaseOk and _putTrendClarityOk and not _isChaos and _putHasRR
    _callBlockerTxt = f_h1MirrorBlockerText(_callDirectionalOk, _callQ5, _callRRHardOk, _isExtended, _callLocationOk, _callTrendClarityOk, _isChaos, _callHasRR)
    _putBlockerTxt = f_h1MirrorBlockerText(_putDirectionalOk, _putQ5, _putRRHardOk, _isExtended, _putLocationOk, _putTrendClarityOk, _isChaos, _putHasRR)
    _callPass = f_h1MirrorBlockerPass(_callDirectionalOk, _callQ5, _callRRHardOk, _isExtended, _callLocationOk, _callTrendClarityOk, _isChaos, _callHasRR)
    _putPass = f_h1MirrorBlockerPass(_putDirectionalOk, _putQ5, _putRRHardOk, _isExtended, _putLocationOk, _putTrendClarityOk, _isChaos, _putHasRR)

    [_putReadyForLtf, _callReadyForLtf, _putBlockerTxt, _callBlockerTxt, _putPass, _callPass]

// Mirror of the 1D panel's SCAN 4H state, using the 1D script's core defaults.
d1MirrorTf = "D"
d1MirrorRsLen = 20
d1MirrorPivLen = 5
d1MirrorAtrLen = 14
d1MirrorStopBufAtr = 0.25
d1MirrorLocAtAtr = 0.5
d1MirrorAtrLocMult = 1.35
d1MirrorLocExtendedAtr = 2.0
d1MirrorMinRR = 1.75
d1MirrorRrWatchFloor = 1.5
d1MirrorMinSpaceAtr = 1.15
d1MirrorAdxLen = 14
d1MirrorAdxTrend = 18.0
d1MirrorUnstableTrAtr = 2.8
d1MirrorChaosOverlapThresh = 0.55
d1MirrorMa20Len = 20
d1MirrorMa50Len = 50
d1MirrorMa200Len = 200
d1MirrorRiskAtrMax = 6.0

f_d1MirrorLocState(_distAtr) =>
    if na(_distAtr)
        "MID"
    else if _distAtr <= d1MirrorLocAtAtr
        "AT LEVEL"
    else if _distAtr <= d1MirrorAtrLocMult
        "NEAR LEVEL"
    else if _distAtr <= d1MirrorLocExtendedAtr
        "MID"
    else
        "EXTENDED"

f_d1MirrorLocValid(_state) =>
    _state == "AT LEVEL" or _state == "NEAR LEVEL"

f_d1MirrorState() =>
    _atr = ta.atr(d1MirrorAtrLen)
    [_diPlus, _diMinus, _adx] = ta.dmi(d1MirrorAdxLen, d1MirrorAdxLen)
    _tr = ta.tr(true)
    _ema20 = ta.ema(close, d1MirrorMa20Len)
    _sma50 = ta.sma(close, d1MirrorMa50Len)
    _sma200 = ta.sma(close, d1MirrorMa200Len)

    [_benchClose, _benchEma20, _benchEma50] = request.security(benchSymbol, d1MirrorTf, [close, ta.ema(close, 20), ta.ema(close, 50)])
    _rs = _benchClose > 0 ? close / _benchClose : na
    _rsSlope = ta.linreg(_rs, d1MirrorRsLen, 0) - ta.linreg(_rs, d1MirrorRsLen, 1)
    _marketBull = _benchEma20 > _benchEma50
    _marketBear = _benchEma20 < _benchEma50

    _ph = ta.pivothigh(high, d1MirrorPivLen, d1MirrorPivLen)
    _pl = ta.pivotlow(low, d1MirrorPivLen, d1MirrorPivLen)
    _lastPH = ta.valuewhen(not na(_ph), _ph, 0)
    _prevPH = ta.valuewhen(not na(_ph), _ph, 1)
    _lastPL = ta.valuewhen(not na(_pl), _pl, 0)
    _prevPL = ta.valuewhen(not na(_pl), _pl, 1)

    _bullStructure = not na(_lastPH) and not na(_prevPH) and not na(_lastPL) and not na(_prevPL) and _lastPH > _prevPH and _lastPL > _prevPL
    _bearStructure = not na(_lastPH) and not na(_prevPH) and not na(_lastPL) and not na(_prevPL) and _lastPH < _prevPH and _lastPL < _prevPL
    _bullSoftStructure = close >= _ema20 and _ema20 >= _sma50 and _sma50 >= _sma50[5] and (na(_lastPL) or low >= _lastPL - 0.5 * _atr)
    _bearSoftStructure = close <= _ema20 and _ema20 <= _sma50 and _sma50 <= _sma50[5] and (na(_lastPH) or high <= _lastPH + 0.5 * _atr)
    _structureDirectional = _bullStructure or _bearStructure or _bullSoftStructure or _bearSoftStructure

    _rng = high - low
    _prevRng = high[1] - low[1]
    _overlap = math.max(0.0, math.min(high, high[1]) - math.max(low, low[1]))
    _overlapRatio = (_rng > 0 and _prevRng > 0) ? (_overlap / math.min(_rng, _prevRng)) : na
    _isChaos = not na(_overlapRatio) and _overlapRatio > d1MirrorChaosOverlapThresh and _adx < (d1MirrorAdxTrend - 2)
    _trSpike = _tr >= d1MirrorUnstableTrAtr * _atr
    _structureChaos = _isChaos or _trSpike
    _structureClear = _structureDirectional and not _structureChaos

    _pivotSupport = f_pickSupport(_lastPL, _prevPL, close)
    _pivotResist = f_pickResist(_lastPH, _prevPH, close)
    [_wkLow, _wkHigh] = request.security(syminfo.tickerid, "W", [low[1], high[1]])
    [_moLow, _moHigh] = request.security(syminfo.tickerid, "M", [low[1], high[1]])
    [_yrLow, _yrHigh] = request.security(syminfo.tickerid, "12M", [low[1], high[1]])
    _fallbackSupport = not na(_wkLow) ? _wkLow : (not na(_moLow) ? _moLow : (not na(_yrLow) ? _yrLow : na))
    _fallbackResist = not na(_wkHigh) ? _wkHigh : (not na(_moHigh) ? _moHigh : (not na(_yrHigh) ? _yrHigh : na))
    _nearestSupport = not na(_pivotSupport) ? _pivotSupport : (not na(_fallbackSupport) ? _fallbackSupport : (not na(_atr) ? close - 2.0 * _atr : low))
    _nearestResist = not na(_pivotResist) ? _pivotResist : (not na(_fallbackResist) ? _fallbackResist : (not na(_atr) ? close + 2.0 * _atr : high))

    _distToSupport = not na(_nearestSupport) ? math.abs(close - _nearestSupport) : na
    _distToResist = not na(_nearestResist) ? math.abs(close - _nearestResist) : na
    _nearSupport = not na(_distToSupport) and _distToSupport <= d1MirrorAtrLocMult * _atr
    _nearResist = not na(_distToResist) and _distToResist <= d1MirrorAtrLocMult * _atr

    _distTo20 = math.abs(close - _ema20)
    _distTo50 = math.abs(close - _sma50)
    _distTo200 = math.abs(close - _sma200)
    _distTo20Atr = _atr > 0 ? (_distTo20 / _atr) : na
    _distTo50Atr = _atr > 0 ? (_distTo50 / _atr) : na
    _distTo200Atr = _atr > 0 ? (_distTo200 / _atr) : na

    _callDistSupportAtr = _atr > 0 and not na(_distToSupport) ? (_distToSupport / _atr) : na
    _putDistResistAtr = _atr > 0 and not na(_distToResist) ? (_distToResist / _atr) : na

    _callNearSupport = not na(_callDistSupportAtr) and _callDistSupportAtr <= d1MirrorAtrLocMult
    _callNearEMA20 = _bullStructure and not na(_distTo20Atr) and _distTo20Atr <= d1MirrorAtrLocMult
    _callNearSMA50 = _bullStructure and not na(_distTo50Atr) and _distTo50Atr <= d1MirrorAtrLocMult
    _callNearSMA200 = not na(_distTo200Atr) and _distTo200Atr <= d1MirrorAtrLocMult

    float _callAnchorDistAtr = na
    if _callNearSupport
        _callAnchorDistAtr := _callDistSupportAtr
    else if _callNearEMA20
        _callAnchorDistAtr := _distTo20Atr
    else if _callNearSMA50
        _callAnchorDistAtr := _distTo50Atr
    else if _callNearSMA200
        _callAnchorDistAtr := _distTo200Atr
    else if not na(_callDistSupportAtr)
        _callAnchorDistAtr := _callDistSupportAtr
    else if _bullStructure and not na(_distTo20Atr)
        _callAnchorDistAtr := _distTo20Atr
    else if _bullStructure and not na(_distTo50Atr)
        _callAnchorDistAtr := _distTo50Atr
    else if not na(_distTo200Atr)
        _callAnchorDistAtr := _distTo200Atr

    _putNearResist = not na(_putDistResistAtr) and _putDistResistAtr <= d1MirrorAtrLocMult
    _putNearEMA20 = _bearStructure and not na(_distTo20Atr) and _distTo20Atr <= d1MirrorAtrLocMult
    _putNearSMA50 = _bearStructure and not na(_distTo50Atr) and _distTo50Atr <= d1MirrorAtrLocMult
    _putNearSMA200 = not na(_distTo200Atr) and _distTo200Atr <= d1MirrorAtrLocMult

    float _putAnchorDistAtr = na
    if _putNearResist
        _putAnchorDistAtr := _putDistResistAtr
    else if _putNearEMA20
        _putAnchorDistAtr := _distTo20Atr
    else if _putNearSMA50
        _putAnchorDistAtr := _distTo50Atr
    else if _putNearSMA200
        _putAnchorDistAtr := _distTo200Atr
    else if not na(_putDistResistAtr)
        _putAnchorDistAtr := _putDistResistAtr
    else if _bearStructure and not na(_distTo20Atr)
        _putAnchorDistAtr := _distTo20Atr
    else if _bearStructure and not na(_distTo50Atr)
        _putAnchorDistAtr := _distTo50Atr
    else if not na(_distTo200Atr)
        _putAnchorDistAtr := _distTo200Atr

    _callLocationState = f_d1MirrorLocState(_callAnchorDistAtr)
    _putLocationState = f_d1MirrorLocState(_putAnchorDistAtr)

    _callInvalid = _nearestSupport
    _putInvalid = _nearestResist
    _callStop = not na(_callInvalid) ? _callInvalid - d1MirrorStopBufAtr * _atr : na
    _putStop = not na(_putInvalid) ? _putInvalid + d1MirrorStopBufAtr * _atr : na
    _callRisk = not na(_callStop) ? math.abs(close - _callStop) : na
    _putRisk = not na(_putStop) ? math.abs(_putStop - close) : na
    _riskRealisticCall = not na(_callRisk) and _callRisk > 0 and _callRisk <= d1MirrorRiskAtrMax * _atr
    _riskRealisticPut = not na(_putRisk) and _putRisk > 0 and _putRisk <= d1MirrorRiskAtrMax * _atr

    _callObstacle = _nearestResist
    _putObstacle = _nearestSupport
    _callSpaceSr = not na(_callObstacle) ? math.abs(_callObstacle - close) : na
    _putSpaceSr = not na(_putObstacle) ? math.abs(close - _putObstacle) : na
    _callSpaceAlt = not na(_callRisk) ? 1.5 * _callRisk : na
    _putSpaceAlt = not na(_putRisk) ? 1.5 * _putRisk : na
    _callSpace = not na(_callSpaceSr) and not na(_callSpaceAlt) ? math.max(_callSpaceSr, _callSpaceAlt) : (not na(_callSpaceSr) ? _callSpaceSr : _callSpaceAlt)
    _putSpace = not na(_putSpaceSr) and not na(_putSpaceAlt) ? math.max(_putSpaceSr, _putSpaceAlt) : (not na(_putSpaceSr) ? _putSpaceSr : _putSpaceAlt)
    _callSpaceOkSoft = not na(_callSpace) and _callSpace >= 0.8 * _atr
    _putSpaceOkSoft = not na(_putSpace) and _putSpace >= 0.8 * _atr
    _callSpaceOkStrong = not na(_callSpace) and _callSpace >= d1MirrorMinSpaceAtr * _atr
    _putSpaceOkStrong = not na(_putSpace) and _putSpace >= d1MirrorMinSpaceAtr * _atr
    _callRR = not na(_callRisk) and _callRisk > 0 and not na(_callSpace) ? (_callSpace / _callRisk) : na
    _putRR = not na(_putRisk) and _putRisk > 0 and not na(_putSpace) ? (_putSpace / _putRisk) : na
    _callRrWatch = not na(_callRR) and _callRR >= math.min(d1MirrorRrWatchFloor, d1MirrorMinRR)
    _putRrWatch = not na(_putRR) and _putRR >= math.min(d1MirrorRrWatchFloor, d1MirrorMinRR)
    _callHasRR = not na(_callRR) and _callRR >= d1MirrorMinRR
    _putHasRR = not na(_putRR) and _putRR >= d1MirrorMinRR

    _callTrendPullback = not _structureChaos and close >= _sma50 and close <= _ema20 + 1.0 * _atr and _ema20 >= _sma50
    _putTrendPullback = not _structureChaos and close <= _sma50 and close >= _ema20 - 1.0 * _atr and _ema20 <= _sma50
    _callLocationOkWatchBase = f_d1MirrorLocValid(_callLocationState) or _callTrendPullback
    _putLocationOkWatchBase = f_d1MirrorLocValid(_putLocationState) or _putTrendPullback
    _callMidWatch = _callLocationState == "MID" and not _structureChaos and close >= _sma50 and close <= _ema20 + 1.5 * _atr and _ema20 >= _sma50
    _putMidWatch = _putLocationState == "MID" and not _structureChaos and close <= _sma50 and close >= _ema20 - 1.5 * _atr and _ema20 <= _sma50
    _callTrendContextWatch = (_bullStructure or _bullSoftStructure) and _marketBull and close >= _sma50 and close <= _ema20 + 1.75 * _atr and not _trSpike
    _putTrendContextWatch = (_bearStructure or _bearSoftStructure) and _marketBear and close <= _sma50 and close >= _ema20 - 1.75 * _atr and not _trSpike
    _callLocationOkWatch = _callLocationOkWatchBase or _callMidWatch or _callTrendContextWatch
    _putLocationOkWatch = _putLocationOkWatchBase or _putMidWatch or _putTrendContextWatch
    _callLocationOkCandidate = _callLocationOkWatchBase and not _nearResist
    _putLocationOkCandidate = _putLocationOkWatchBase and not _nearSupport
    _rsNeutralBand = 0.00005
    _callRSStrong = not na(_rsSlope) and _rsSlope > _rsNeutralBand
    _putRSStrong = not na(_rsSlope) and _rsSlope < -_rsNeutralBand
    _callRSOk = not na(_rsSlope) and _rsSlope > -_rsNeutralBand
    _putRSOk = not na(_rsSlope) and _rsSlope < _rsNeutralBand
    _callRSWatch = not na(_rsSlope) and _rsSlope > -2.0 * _rsNeutralBand
    _putRSWatch = not na(_rsSlope) and _rsSlope < 2.0 * _rsNeutralBand
    _callMarketAligned = _marketBull
    _putMarketAligned = _marketBear
    _callDirectionStrong = _structureClear and _callMarketAligned and ((_bullStructure and _callRSOk) or (_bullSoftStructure and _callRSStrong))
    _putDirectionStrong = _structureClear and _putMarketAligned and ((_bearStructure and _putRSOk) or (_bearSoftStructure and _putRSStrong))
    _callDirectionOk =        (_bullStructure or _bullSoftStructure) and        ((_callRSWatch and (_callMarketAligned or _callRSStrong) and not _structureChaos) or (_bullStructure and _callRSStrong) or (_bullSoftStructure and _callMarketAligned and not _trSpike) or (_bullStructure and _callMarketAligned and not _structureChaos))
    _putDirectionOk =        (_bearStructure or _bearSoftStructure) and        ((_putRSWatch and (_putMarketAligned or _putRSStrong) and not _structureChaos) or (_bearStructure and _putRSStrong) or (_bearSoftStructure and _putMarketAligned and not _trSpike) or (_bearStructure and _putMarketAligned and not _structureChaos))
    _callRiskDefined = not na(_callInvalid) and not na(_callStop) and _riskRealisticCall
    _putRiskDefined = not na(_putInvalid) and not na(_putStop) and _riskRealisticPut
    _callRewardDefined = _callHasRR and _callSpaceOkStrong
    _putRewardDefined = _putHasRR and _putSpaceOkStrong
    _callRewardWatch = _callRrWatch and _callSpaceOkSoft
    _putRewardWatch = _putRrWatch and _putSpaceOkSoft
    _callDailyConfirmed = _callDirectionOk and _callLocationOkWatch and _callRiskDefined and _callRewardWatch
    _putDailyConfirmed = _putDirectionOk and _putLocationOkWatch and _putRiskDefined and _putRewardWatch
    _callDailyCandidate = _callDirectionStrong and _callLocationOkCandidate and _callRiskDefined and _callRewardDefined
    _putDailyCandidate = _putDirectionStrong and _putLocationOkCandidate and _putRiskDefined and _putRewardDefined
    _callPass = not _callDirectionOk ? 0 : (not _callLocationOkWatch ? 1 : (not _callRiskDefined ? 2 : (_callDailyCandidate ? 4 : (_callDailyConfirmed ? 3 : 2))))
    _putPass = not _putDirectionOk ? 0 : (not _putLocationOkWatch ? 1 : (not _putRiskDefined ? 2 : (_putDailyCandidate ? 4 : (_putDailyConfirmed ? 3 : 2))))

    _callState = _callDailyCandidate ? "LONG CANDIDATE" : (_structureChaos ? "STRUCTURE CHAOS" : ((na(_callInvalid) or na(_callStop)) ? "NO STOP" : (not _riskRealisticCall ? "RISK TOO WIDE" : (not _callRrWatch ? "RR TOO LOW" : (not _callDirectionOk ? (not _structureDirectional ? "WAIT STRUCTURE" : (not (_bullStructure or _bullSoftStructure) ? "OPPOSITE STRUCTURE" : (not _callRSOk ? "WAIT RS" : "WAIT MARKET"))) : (not _callLocationOkWatch ? "WAIT LOCATION" : (_callDailyConfirmed ? "WATCH" : "SPACE TOO TIGHT")))))))
    _putState = _putDailyCandidate ? "SHORT CANDIDATE" : (_structureChaos ? "STRUCTURE CHAOS" : ((na(_putInvalid) or na(_putStop)) ? "NO STOP" : (not _riskRealisticPut ? "RISK TOO WIDE" : (not _putRrWatch ? "RR TOO LOW" : (not _putDirectionOk ? (not _structureDirectional ? "WAIT STRUCTURE" : (not (_bearStructure or _bearSoftStructure) ? "OPPOSITE STRUCTURE" : (not _putRSOk ? "WAIT RS" : "WAIT MARKET"))) : (not _putLocationOkWatch ? "WAIT LOCATION" : (_putDailyConfirmed ? "WATCH" : "SPACE TOO TIGHT")))))))

    [_putDailyConfirmed, _callDailyConfirmed, _putDailyCandidate, _callDailyCandidate, _putState, _callState, _putPass, _callPass]

// Mirror of the 4H panel's state engine, using the 4H script's core defaults.
h4MirrorAtrLen = 14
h4MirrorPivLen = 4
h4MirrorAtrLocMult = 1.25
h4MirrorMinRR = 1.75
h4MirrorRrWatchFloor = 1.5
h4MirrorVolLen = 20
h4MirrorVolBreakMult = 1.2
h4MirrorRsiLen = 14
h4MirrorAdxLen = 14
h4MirrorAdxTrend = 18.0
h4MirrorUnstableTrAtr = 2.5
h4MirrorWickRejectionMult = 0.9
h4MirrorStopBufAtr = 0.25
h4MirrorRiskAtrMin = 0.6
h4MirrorRiskAtrMax = 4.5
h4MirrorExtendedAtr = 1.6
h4MirrorMa20Len = 20
h4MirrorMa50Len = 50
h4MirrorMa200Len = 200
h4MirrorBbLen = 20
h4MirrorBbMult = 2.0
h4MirrorPbWindow = 20
h4MirrorChaosOverlapThresh = 0.55

f_h4MirrorState() =>
    _atr = ta.atr(h4MirrorAtrLen)
    _tr = ta.tr(true)
    _volSma = ta.sma(volume, h4MirrorVolLen)
    _rsi = ta.rsi(close, h4MirrorRsiLen)
    _macdHist = f_macdHist()
    [_diPlus, _diMinus, _adx] = ta.dmi(h4MirrorAdxLen, h4MirrorAdxLen)

    _basis = ta.sma(close, h4MirrorBbLen)
    _dev = h4MirrorBbMult * ta.stdev(close, h4MirrorBbLen)
    _bbU = _basis + _dev
    _bbL = _basis - _dev
    _bbWidth = (_bbU - _bbL) / math.max(1e-10, _basis)
    _bbWidthMA = ta.sma(_bbWidth, h4MirrorBbLen)
    _isCompression = _bbWidth < _bbWidthMA

    _ema20 = ta.ema(close, h4MirrorMa20Len)
    _sma50 = ta.sma(close, h4MirrorMa50Len)
    _sma200 = ta.sma(close, h4MirrorMa200Len)
    _emaTrend50 = ta.ema(close, 50)

    [_benchClose, _benchEma20, _benchEma50] = request.security(benchSymbol, "240", [close, ta.ema(close, 20), ta.ema(close, 50)])
    _rs = _benchClose > 0 ? close / _benchClose : na
    _rsSlope = ta.linreg(_rs, 14, 0) - ta.linreg(_rs, 14, 1)
    _marketBull = _benchEma20 > _benchEma50
    _marketBear = _benchEma20 < _benchEma50
    _callMarketHeadwind = _marketBear
    _putMarketHeadwind = _marketBull

    _ph = ta.pivothigh(high, h4MirrorPivLen, h4MirrorPivLen)
    _pl = ta.pivotlow(low, h4MirrorPivLen, h4MirrorPivLen)
    _lastPH = ta.valuewhen(not na(_ph), _ph, 0)
    _prevPH = ta.valuewhen(not na(_ph), _ph, 1)
    _lastPL = ta.valuewhen(not na(_pl), _pl, 0)
    _prevPL = ta.valuewhen(not na(_pl), _pl, 1)

    _rng = high - low
    _overlap = math.max(0.0, math.min(high, high[1]) - math.max(low, low[1]))
    _overlapRatio = (_rng > 0 and (high[1] - low[1]) > 0) ? (_overlap / math.min(_rng, (high[1] - low[1]))) : na
    _isRange = _adx < (h4MirrorAdxTrend - 2)
    _isChaos = not na(_overlapRatio) and _overlapRatio > h4MirrorChaosOverlapThresh and _isRange

    _trSpike = _tr >= h4MirrorUnstableTrAtr * _atr
    _stdev10 = ta.stdev(close, 10)
    _stdev50 = ta.stdev(close, 50)
    _volatilitySpike = _stdev10 > 1.5 * _stdev50
    _unstableNow = _trSpike or _volatilitySpike

    _pivotSupport = f_pickSupport(_lastPL, _prevPL, close)
    _pivotResist = f_pickResist(_lastPH, _prevPH, close)
    [_wkLow, _wkHigh] = request.security(syminfo.tickerid, "W", [low[1], high[1]])
    [_moLow, _moHigh] = request.security(syminfo.tickerid, "M", [low[1], high[1]])
    [_yrLow, _yrHigh] = request.security(syminfo.tickerid, "12M", [low[1], high[1]])
    _fallbackSupport = not na(_wkLow) ? _wkLow : (not na(_moLow) ? _moLow : (not na(_yrLow) ? _yrLow : na))
    _fallbackResist = not na(_wkHigh) ? _wkHigh : (not na(_moHigh) ? _moHigh : (not na(_yrHigh) ? _yrHigh : na))
    _nearestSupport = not na(_pivotSupport) ? _pivotSupport : (not na(_fallbackSupport) ? _fallbackSupport : (not na(_atr) ? close - 2.0 * _atr : low))
    _nearestResist = not na(_pivotResist) ? _pivotResist : (not na(_fallbackResist) ? _fallbackResist : (not na(_atr) ? close + 2.0 * _atr : high))

    _distToSupport = not na(_nearestSupport) ? math.abs(close - _nearestSupport) : na
    _distToResist = not na(_nearestResist) ? math.abs(close - _nearestResist) : na
    _nearSupport = not na(_distToSupport) and _distToSupport <= h4MirrorAtrLocMult * _atr
    _nearResist = not na(_distToResist) and _distToResist <= h4MirrorAtrLocMult * _atr
    _nearMA = math.abs(close - _ema20) <= h4MirrorAtrLocMult * _atr or math.abs(close - _sma50) <= h4MirrorAtrLocMult * _atr or math.abs(close - _sma200) <= h4MirrorAtrLocMult * _atr

    _trendStrength = _atr > 0 ? math.abs(_ema20 - _emaTrend50) / _atr : na
    _structureChop = _isChaos or (not na(_trendStrength) and _trendStrength < 0.25)

    _body = math.abs(close - open)
    _upperWick = high - math.max(open, close)
    _lowerWick = math.min(open, close) - low
    _bullRejection = _body > 0 ? (_lowerWick >= h4MirrorWickRejectionMult * _body) : false
    _bearRejection = _body > 0 ? (_upperWick >= h4MirrorWickRejectionMult * _body) : false

    _volRatio = _volSma > 0 ? volume / _volSma : na
    _volWeak = not na(_volRatio) and _volRatio < 0.8

    _locDistAtr = _atr > 0 ? (math.abs(close - _ema20) / _atr) : na
    _locAtStructure = not na(_locDistAtr) and _locDistAtr <= 0.9
    _locNearStructure = not na(_locDistAtr) and _locDistAtr > 0.9 and _locDistAtr <= 1.5
    _locExtended = not na(_locDistAtr) and _locDistAtr > 1.5

    _extended = not na(_locDistAtr) and _locDistAtr > h4MirrorExtendedAtr

    _callInvalid = _nearestSupport
    _putInvalid = _nearestResist
    _callStop = not na(_callInvalid) ? _callInvalid - h4MirrorStopBufAtr * _atr : na
    _putStop = not na(_putInvalid) ? _putInvalid + h4MirrorStopBufAtr * _atr : na
    _callRisk = not na(_callStop) ? math.abs(close - _callStop) : na
    _putRisk = not na(_putStop) ? math.abs(_putStop - close) : na
    _riskRealisticCall = not na(_callRisk) and _callRisk >= h4MirrorRiskAtrMin * _atr and _callRisk <= h4MirrorRiskAtrMax * _atr
    _riskRealisticPut = not na(_putRisk) and _putRisk >= h4MirrorRiskAtrMin * _atr and _putRisk <= h4MirrorRiskAtrMax * _atr

    _htfTargetResist = not na(_fallbackResist) and _fallbackResist > close ? _fallbackResist : _nearestResist
    _htfTargetSupport = not na(_fallbackSupport) and _fallbackSupport < close ? _fallbackSupport : _nearestSupport
    _callRewardSr = not na(_htfTargetResist) ? math.abs(_htfTargetResist - close) : na
    _putRewardSr = not na(_htfTargetSupport) ? math.abs(close - _htfTargetSupport) : na
    _callRewardAlt = not na(_callRisk) ? (1.5 * _callRisk) : na
    _putRewardAlt = not na(_putRisk) ? (1.5 * _putRisk) : na
    _callReward = not na(_callRewardSr) and not na(_callRewardAlt) ? math.max(_callRewardSr, _callRewardAlt) : (not na(_callRewardSr) ? _callRewardSr : _callRewardAlt)
    _putReward = not na(_putRewardSr) and not na(_putRewardAlt) ? math.max(_putRewardSr, _putRewardAlt) : (not na(_putRewardSr) ? _putRewardSr : _putRewardAlt)
    _callRR = not na(_callRisk) and _callRisk > 0 and not na(_callReward) ? (_callReward / _callRisk) : na
    _putRR = not na(_putRisk) and _putRisk > 0 and not na(_putReward) ? (_putReward / _putRisk) : na
    _callRrWatch = not na(_callRR) and _callRR >= math.min(h4MirrorRrWatchFloor, h4MirrorMinRR)
    _putRrWatch = not na(_putRR) and _putRR >= math.min(h4MirrorRrWatchFloor, h4MirrorMinRR)
    _callHasRR = not na(_callRR) and _callRR >= h4MirrorMinRR
    _putHasRR = not na(_putRR) and _putRR >= h4MirrorMinRR
    _callOppositeTooClose = _nearResist and not _nearMA and not _callRrWatch
    _putOppositeTooClose = _nearSupport and not _nearMA and not _putRrWatch
    _callLocationOk = (_nearSupport or _nearMA or _locAtStructure or _locNearStructure) and not _callOppositeTooClose and not _locExtended
    _putLocationOk = (_nearResist or _nearMA or _locAtStructure or _locNearStructure) and not _putOppositeTooClose and not _locExtended

    _isTrend = _adx >= h4MirrorAdxTrend and not _isChaos
    _regimeTxt = _unstableNow ? "UNSTABLE" : (_isTrend ? "TREND" : (_isRange ? "RANGE" : "MIXED"))

    _crossUpEma20 = ta.crossover(close, _ema20)
    _crossDnEma20 = ta.crossunder(close, _ema20)
    _callHoldAboveEma20 = _nearMA and close >= _ema20 and close[1] >= _ema20[1]
    _putHoldBelowEma20 = _nearMA and close <= _ema20 and close[1] <= _ema20[1]
    _callBaseBreak = _isCompression and close > high[1] and close >= _ema20
    _putBaseBreak = _isCompression and close < low[1] and close <= _ema20
    _callLevelReaction = (_nearSupport and (_bullRejection or close > open or close > close[1])) or (_nearMA and (_crossUpEma20 or _callHoldAboveEma20)) or _callBaseBreak
    _putLevelReaction = (_nearResist and (_bearRejection or close < open or close < close[1])) or (_nearMA and (_crossDnEma20 or _putHoldBelowEma20)) or _putBaseBreak
    _callRsiOk = _rsi >= 45.0
    _putRsiOk = _rsi <= 55.0
    _callMacdOk = _macdHist >= 0 and _macdHist >= _macdHist[1]
    _putMacdOk = _macdHist <= 0 and _macdHist <= _macdHist[1]
    _callVolAtrOk = not _volWeak and _riskRealisticCall
    _putVolAtrOk = not _volWeak and _riskRealisticPut
    _callKeyLvlsOk = close >= _sma200 and (close >= _sma50 or _nearMA) and (close >= _ema20 or _nearMA)
    _putKeyLvlsOk = close <= _sma200 and (close <= _sma50 or _nearMA) and (close <= _ema20 or _nearMA)
    _rsNeutralBand = 0.00005
    _callRSStrong = not na(_rsSlope) and _rsSlope > _rsNeutralBand
    _putRSStrong = not na(_rsSlope) and _rsSlope < -_rsNeutralBand
    _callRSOk = not na(_rsSlope) and _rsSlope > -_rsNeutralBand
    _putRSOk = not na(_rsSlope) and _rsSlope < _rsNeutralBand
    _callMarketOk = not _callMarketHeadwind or _callRSOk or (not na(_trendStrength) and _trendStrength > 0.6)
    _putMarketOk = not _putMarketHeadwind or _putRSOk or (not na(_trendStrength) and _trendStrength > 0.6)
    _callInvalidOk = not na(_callInvalid) and _riskRealisticCall
    _putInvalidOk = not na(_putInvalid) and _riskRealisticPut
    _tradeable = not _unstableNow and volume > 0 and (volume >= 0.5 * _volSma)

    _bullImpulseVolSrc = (close > open and volume > _volSma) ? volume : 0.0
    _bearImpulseVolSrc = (close < open and volume > _volSma) ? volume : 0.0
    _bullPullbackVolSrc = close < open ? volume : 0.0
    _bearPullbackVolSrc = close > open ? volume : 0.0
    _impulseVolBull = f_rollSum(_bullImpulseVolSrc, h4MirrorPbWindow)
    _impulseVolBear = f_rollSum(_bearImpulseVolSrc, h4MirrorPbWindow)
    _pullbackVolBull = f_rollSum(_bullPullbackVolSrc, h4MirrorPbWindow)
    _pullbackVolBear = f_rollSum(_bearPullbackVolSrc, h4MirrorPbWindow)
    _callPBVolOk = _impulseVolBull > _pullbackVolBull
    _putPBVolOk = _impulseVolBear > _pullbackVolBear
    _callConfirmOk = _callLevelReaction or (_callRsiOk and _callMacdOk) or (_callPBVolOk and _callKeyLvlsOk)
    _putConfirmOk = _putLevelReaction or (_putRsiOk and _putMacdOk) or (_putPBVolOk and _putKeyLvlsOk)

    _callQ6 = (_regimeTxt != "UNSTABLE") and _callMarketOk
    _putQ6 = (_regimeTxt != "UNSTABLE") and _putMarketOk
    _callQ7 = not _structureChop
    _putQ7 = not _structureChop
    _callQ9 = _callInvalidOk
    _putQ9 = _putInvalidOk

    _putStatus = _regimeTxt == "UNSTABLE" ? "NO TRADE (REGIME)" : (not _putRrWatch ? "NO TRADE (RR)" : (not _putQ9 ? "NO TRADE (RISK)" : (not _putQ6 ? "WAIT MARKET" : (not _putQ7 ? "WAIT STRUCTURE" : (_extended ? "WAIT PULLBACK" : (not _putLocationOk ? "WAIT LOCATION" : (not _putHasRR ? "WAIT RR" : (not (_putRSOk or _putConfirmOk) ? "WAIT EDGE" : "ENTRY NOW"))))))))
    _callStatus = _regimeTxt == "UNSTABLE" ? "NO TRADE (REGIME)" : (not _callRrWatch ? "NO TRADE (RR)" : (not _callQ9 ? "NO TRADE (RISK)" : (not _callQ6 ? "WAIT MARKET" : (not _callQ7 ? "WAIT STRUCTURE" : (_extended ? "WAIT PULLBACK" : (not _callLocationOk ? "WAIT LOCATION" : (not _callHasRR ? "WAIT RR" : (not (_callRSOk or _callConfirmOk) ? "WAIT EDGE" : "ENTRY NOW"))))))))

    _putState = str.contains(_putStatus, "NO TRADE") ? "NO TRADE" : (_putStatus == "ENTRY NOW" ? "READY" : (_putStatus == "WAIT PULLBACK" ? "WAIT PULLBACK" : (_putStatus == "WAIT MARKET" ? "WAIT MARKET" : (_putStatus == "WAIT EDGE" ? "WAIT EDGE" : (_putStatus == "WAIT RR" ? "WAIT RR" : (_putStatus == "WAIT LOCATION" ? "WAIT LEVEL" : "WAIT STRUCTURE"))))))
    _callState = str.contains(_callStatus, "NO TRADE") ? "NO TRADE" : (_callStatus == "ENTRY NOW" ? "READY" : (_callStatus == "WAIT PULLBACK" ? "WAIT PULLBACK" : (_callStatus == "WAIT MARKET" ? "WAIT MARKET" : (_callStatus == "WAIT EDGE" ? "WAIT EDGE" : (_callStatus == "WAIT RR" ? "WAIT RR" : (_callStatus == "WAIT LOCATION" ? "WAIT LEVEL" : "WAIT STRUCTURE"))))))

    _putPass = _regimeTxt == "UNSTABLE" ? 0 : (not _putRrWatch ? 1 : (not _putQ9 ? 2 : (not _putQ6 ? 3 : (not _putQ7 ? 4 : ((_extended or not _putLocationOk) ? 5 : (not _putHasRR ? 6 : 7))))))
    _callPass = _regimeTxt == "UNSTABLE" ? 0 : (not _callRrWatch ? 1 : (not _callQ9 ? 2 : (not _callQ6 ? 3 : (not _callQ7 ? 4 : ((_extended or not _callLocationOk) ? 5 : (not _callHasRR ? 6 : 7))))))

    [_putState, _callState, _putPass, _callPass]

//------------------------------------------------------------------------------
// Data (15m)
//------------------------------------------------------------------------------
atr = ta.atr(atrLen)
volSma = ta.sma(volume, volLen)
rsi = ta.rsi(close, rsiLen)
[macdLine, macdSignal, macdHist] = ta.macd(close, 12, 26, 9)

emaFast = ta.ema(close, maFastLen)
smaMid  = ta.sma(close, maMidLen)

// Micro-structure pivots
ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low, pivLen, pivLen)

var float lastPH = na
var float prevPH = na
var float lastPL = na
var float prevPL = na

if not na(ph)
    prevPH := lastPH
    lastPH := ph

if not na(pl)
    prevPL := lastPL
    lastPL := pl

bullMicro = not na(lastPH) and not na(prevPH) and not na(lastPL) and not na(prevPL) and lastPH > prevPH and lastPL > prevPL
bearMicro = not na(lastPH) and not na(prevPH) and not na(lastPL) and not na(prevPL) and lastPH < prevPH and lastPL < prevPL

// Multi-horizon fallback when local pivots are missing: W -> M -> 12M -> ATR proxy.
pivotSupport = f_pickSupport(lastPL, prevPL, close)
pivotResist  = f_pickResist(lastPH, prevPH, close)

[wkLow, wkHigh] = request.security(syminfo.tickerid, "W", [low[1], high[1]])
[moLow, moHigh] = request.security(syminfo.tickerid, "M", [low[1], high[1]])
[yrLow, yrHigh] = request.security(syminfo.tickerid, "12M", [low[1], high[1]])

fallbackSupport = not na(wkLow) ? wkLow : (not na(moLow) ? moLow : (not na(yrLow) ? yrLow : na))
fallbackResist  = not na(wkHigh) ? wkHigh : (not na(moHigh) ? moHigh : (not na(yrHigh) ? yrHigh : na))

nearestSupport = not na(pivotSupport) ? pivotSupport : (not na(fallbackSupport) ? fallbackSupport : (not na(atr) ? close - 2.0 * atr : low))
nearestResist  = not na(pivotResist)  ? pivotResist  : (not na(fallbackResist)  ? fallbackResist  : (not na(atr) ? close + 2.0 * atr : high))

distS = not na(nearestSupport) ? math.abs(close - nearestSupport) : na
distR = not na(nearestResist)  ? math.abs(close - nearestResist)  : na
nearSupport = not na(distS) and distS <= nearLevelAtr * atr
nearResist  = not na(distR) and distR <= nearLevelAtr * atr

// Day levels (intraday execution context): prior day high/low.
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]])
distPDH = not na(pdh) ? math.abs(close - pdh) : na
distPDL = not na(pdl) ? math.abs(close - pdl) : na
nearPDH = not na(distPDH) and distPDH <= nearLevelAtr * atr
nearPDL = not na(distPDL) and distPDL <= nearLevelAtr * atr

vwap = ta.vwap(hlc3)
distVWAP = not na(vwap) ? math.abs(close - vwap) : na
nearVWAP = not na(distVWAP) and distVWAP <= nearLevelAtr * atr

nearMA = math.abs(close - emaFast) <= nearLevelAtr * atr or math.abs(close - smaMid) <= nearLevelAtr * atr
nearSupportZone = nearSupport or nearMA or nearPDL or nearVWAP
nearResistZone  = nearResist  or nearMA or nearPDH or nearVWAP

trendStrength = atr > 0 ? math.abs(emaFast - smaMid) / atr : 0.0
trendOK = trendStrength > 0.2
trendBiasBull = emaFast >= smaMid
trendBiasBear = emaFast <= smaMid
trendAlignBull = trendBiasBull and close >= emaFast
trendAlignBear = trendBiasBear and close <= emaFast

// Candle anatomy
rng = high - low
body = math.abs(close - open)
upperW = high - math.max(open, close)
lowerW = math.min(open, close) - low

closePos = rng > 0 ? (close - low) / rng : na  // 0 bottom, 1 top

// Reaction definition (execution-friendly): wick rejection OR body-close strength.
wickRejectLong = (lowerW >= wickBodyMult * body) and (not na(closePos) and closePos >= closePosPct)
wickRejectShort = (upperW >= wickBodyMult * body) and (not na(closePos) and closePos <= (1 - closePosPct))
bodyConfirmLong = close > open and (not na(closePos) and closePos >= 0.5)
bodyConfirmShort = close < open and (not na(closePos) and closePos <= 0.5)
reactionLong  = wickRejectLong or bodyConfirmLong
reactionShort = wickRejectShort or bodyConfirmShort
callReactionBarsAgo = ta.barssince(nearSupportZone and reactionLong)
putReactionBarsAgo = ta.barssince(nearResistZone and reactionShort)
callRecentReaction = not na(callReactionBarsAgo) and callReactionBarsAgo <= reactionWindowBars
putRecentReaction = not na(putReactionBarsAgo) and putReactionBarsAgo <= reactionWindowBars

// Impulse definition
bodyPct = rng > 0 ? (body / rng) : 0.0
impulseBull = close > open and bodyPct >= impulseBodyPct and volume >= volSma * volImpulseMult
impulseBear = close < open and bodyPct >= impulseBodyPct and volume >= volSma * volImpulseMult

// Overextension
distToEma = math.abs(close - emaFast)
distEmaAtr = atr > 0 ? (distToEma / atr) : na
extended = not na(distEmaAtr) and distEmaAtr > extendedAtr
softExtended = extended and distEmaAtr <= (extendedAtr + softExtendedBandAtr)
hardExtended = not na(distEmaAtr) and distEmaAtr > (extendedAtr + softExtendedBandAtr)
impulseSpikeSrc = (impulseBull or impulseBear) ? 1.0 : 0.0
impulseCount = f_rollSum(impulseSpikeSrc, impulseBars)
impulseHeat = impulseCount >= math.max(3, impulseBars - 1)
isOverextended = hardExtended

// Pullback health (measurable proxies)
impulseRange = ta.sma((impulseBull or impulseBear) ? rng : 0.0, pullbackWin)
counterRangeBull = ta.sma(close < open ? rng : 0.0, pullbackWin)
counterRangeBear = ta.sma(close > open ? rng : 0.0, pullbackWin)

impulseVol = ta.sma((impulseBull or impulseBear) ? volume : 0.0, pullbackWin)
counterVolBull = ta.sma(close < open ? volume : 0.0, pullbackWin)
counterVolBear = ta.sma(close > open ? volume : 0.0, pullbackWin)

healthyPullbackBull = counterRangeBull <= 1.0 * impulseRange and counterVolBull <= impulseVol
healthyPullbackBear = counterRangeBear <= 1.0 * impulseRange and counterVolBear <= impulseVol

lastImpulseMove = math.abs(close - close[pullbackWin])
retraceMove = math.abs(close - close[math.floor(pullbackWin / 2)])
aggressiveRetrace = lastImpulseMove > 0 ? (retraceMove / lastImpulseMove) >= aggrRetracePct : false

// Invalidation
callInvalid = nearestSupport
putInvalid  = nearestResist

callStop = not na(callInvalid) ? callInvalid - stopBufAtr * atr : na
putStop  = not na(putInvalid)  ? putInvalid  + stopBufAtr * atr : na

callRisk = not na(callStop) ? math.abs(close - callStop) : na
putRisk  = not na(putStop)  ? math.abs(putStop - close) : na

callRiskOK = not na(callRisk) and callRisk > 0 and callRisk <= riskAtrMax * atr
putRiskOK  = not na(putRisk)  and putRisk  > 0 and putRisk  <= riskAtrMax * atr

callTarget = nearestResist
putTarget  = nearestSupport

callRewardSr = not na(callTarget) ? math.max(0.0, callTarget - close) : na
putRewardSr  = not na(putTarget)  ? math.max(0.0, close - putTarget) : na

callRewardAlt = not na(callRisk) ? (1.5 * callRisk) : na
putRewardAlt  = not na(putRisk)  ? (1.5 * putRisk)  : na

callReward = not na(callRewardSr) and not na(callRewardAlt) ? math.max(callRewardSr, callRewardAlt) : (not na(callRewardSr) ? callRewardSr : callRewardAlt)
putReward  = not na(putRewardSr) and not na(putRewardAlt)  ? math.max(putRewardSr, putRewardAlt)   : (not na(putRewardSr)  ? putRewardSr  : putRewardAlt)

callRR = (not na(callRisk) and callRisk > 0 and not na(callReward)) ? (callReward / callRisk) : na
putRR  = (not na(putRisk)  and putRisk  > 0 and not na(putReward))  ? (putReward  / putRisk)  : na

callHasRR = not na(callRR) and callRR >= minRR
putHasRR  = not na(putRR)  and putRR  >= minRR

// Entry reduces risk (risk compression): compare to HTF pivot-based risk
[htfATR, htfPL, htfPH] = request.security(syminfo.tickerid, htfTF, [ta.atr(atrLen), ta.pivotlow(low, pivLen, pivLen), ta.pivothigh(high, pivLen, pivLen)])

var float htfLastPL = na
var float htfLastPH = na
if not na(htfPL)
    htfLastPL := htfPL
if not na(htfPH)
    htfLastPH := htfPH

htfCallInvalid = htfLastPL
htfPutInvalid  = htfLastPH

htfCallStop = not na(htfCallInvalid) ? htfCallInvalid - stopBufAtr * htfATR : na
htfPutStop  = not na(htfPutInvalid)  ? htfPutInvalid  + stopBufAtr * htfATR : na

htfCallRisk = not na(htfCallStop) ? math.abs(close - htfCallStop) : na
htfPutRisk  = not na(htfPutStop)  ? math.abs(htfPutStop - close) : na

callRiskCompression = callRiskOK and (na(htfCallRisk) or (not na(callRisk) and callRisk < htfCallRisk))
putRiskCompression  = putRiskOK  and (na(htfPutRisk)  or (not na(putRisk)  and putRisk  < htfPutRisk))

// Volume confirms move
callVolOk = impulseBull or (healthyPullbackBull and volume >= 0.7 * volSma)
putVolOk  = impulseBear or (healthyPullbackBear and volume >= 0.7 * volSma)

// Momentum not weakening
callMomOk = (rsi >= rsiMid) and (macdHist >= 0) and (macdHist >= macdHist[1])
putMomOk  = (rsi <= rsiMid) and (macdHist <= 0) and (macdHist <= macdHist[1])

// Daily context (week-type proxy): avoid high-vol days; align with daily EMA50
[dATR, dATRsma20] = request.security(syminfo.tickerid, dailyTF, [ta.atr(14), ta.sma(ta.atr(14), 20)])
dHighVol = dATR > dATRsma20 * 1.2

callWeekOk = not dHighVol
putWeekOk  = not dHighVol

// 1H gate: 15m is trigger only when the current 1H context is ready.
[h1Close, h1Ema20, h1Rsi, h1MacdHist, h1MacdHistPrev, h1BullCtx, h1BearCtx] = request.security(syminfo.tickerid, "60", [close, ta.ema(close, 20), ta.rsi(close, rsiLen), f_macdHist(), f_macdHist()[1], close > ta.ema(close, 50), close < ta.ema(close, 50)])

h1MacdNearZeroAbs = h1Close * h1MacdNearZeroPct
h1MacdNearZero = math.abs(h1MacdHist) <= h1MacdNearZeroAbs
h1CallMomentumOk = (h1Rsi >= rsiMid) or (h1MacdHist >= h1MacdHistPrev) or h1MacdNearZero
h1PutMomentumOk  = (h1Rsi <= rsiMid) or (h1MacdHist <= h1MacdHistPrev) or h1MacdNearZero

h1CallReady = h1BullCtx and h1Close >= h1Ema20 and h1CallMomentumOk
h1PutReady  = h1BearCtx and h1Close <= h1Ema20 and h1PutMomentumOk

h1CallStateTxt = h1CallReady ? "READY" : (h1BullCtx ? "PULLBACK" : "NEUTRAL")
h1PutStateTxt  = h1PutReady  ? "READY" : (h1BearCtx ? "PULLBACK" : "NEUTRAL")
[h1PutReadyForLtfState, h1CallReadyForLtfState, h1PutBlockerTxt, h1CallBlockerTxt, h1PutReadyForLtfPass, h1CallReadyForLtfPass] = request.security(syminfo.tickerid, "60", f_h1ReadyForLtfClosed())

// HTF CONTEXT mirrors the higher-timeframe state engines used by the source panels.
[m1dPutStateTxt, m1dCallStateTxt, m1dPutReason, m1dCallReason, m1dPutCorePass, m1dCallCorePass, m1dPutQualityPass, m1dCallQualityPass] = request.security(benchSymbol, dailyTF, f_m1dMirrorState())
m1dPutStateDisplay = (m1dPutReason == "OK" ? m1dPutStateTxt : (m1dPutStateTxt + " " + m1dPutReason)) + " (" + str.tostring(m1dPutCorePass) + "/3 | " + str.tostring(m1dPutQualityPass) + "/2)"
m1dCallStateDisplay = (m1dCallReason == "OK" ? m1dCallStateTxt : (m1dCallStateTxt + " " + m1dCallReason)) + " (" + str.tostring(m1dCallCorePass) + "/3 | " + str.tostring(m1dCallQualityPass) + "/2)"
m1dPutStateCol = f_m1dMirrorStateColor(m1dPutStateTxt)
m1dCallStateCol = f_m1dMirrorStateColor(m1dCallStateTxt)

// Stock 1D context mirrors the native 1D panel's SCAN 4H pipeline (watch + candidate), plus a first-blocker label and pass count.
[d1PutConfirmed, d1CallConfirmed, d1PutCandidate, d1CallCandidate, d1PutStateTxt, d1CallStateTxt, d1PutPass, d1CallPass] = request.security(syminfo.tickerid, d1MirrorTf, f_d1MirrorState())
d1PutStateDisplay = d1PutStateTxt + " (" + str.tostring(d1PutPass) + "/4)"
d1CallStateDisplay = d1CallStateTxt + " (" + str.tostring(d1CallPass) + "/4)"
d1PutStateCol = f_d1MirrorStateColor(d1PutStateTxt)
d1CallStateCol = f_d1MirrorStateColor(d1CallStateTxt)

// 4H context mirrors the native 4H panel's state pipeline.
[h4PutStateTxt, h4CallStateTxt, h4PutPass, h4CallPass] = request.security(syminfo.tickerid, "240", f_h4MirrorState())
h4PutStateDisplay = h4PutStateTxt + " (" + str.tostring(h4PutPass) + "/7)"
h4CallStateDisplay = h4CallStateTxt + " (" + str.tostring(h4CallPass) + "/7)"
h4PutStateCol = h4PutStateTxt == "READY" ? colOk : (h4PutStateTxt == "NO TRADE" ? colBad : colBg)
h4CallStateCol = h4CallStateTxt == "READY" ? colOk : (h4CallStateTxt == "NO TRADE" ? colBad : colBg)

// 1H context shows the highest-priority blocker from the mirrored READY FOR LTF pipeline.
h1PutSetupStateTxt = h1PutBlockerTxt
h1CallSetupStateTxt = h1CallBlockerTxt
h1PutPass = h1PutReadyForLtfPass
h1CallPass = h1CallReadyForLtfPass
h1PutSetupStateDisplay = h1PutSetupStateTxt + " (" + str.tostring(h1PutPass) + "/8)"
h1CallSetupStateDisplay = h1CallSetupStateTxt + " (" + str.tostring(h1CallPass) + "/8)"
h1PutSetupStateCol = f_h1MirrorStateColor(h1PutSetupStateTxt)
h1CallSetupStateCol = f_h1MirrorStateColor(h1CallSetupStateTxt)
h1PutHardReady = h1PutReadyForLtfState
h1CallHardReady = h1CallReadyForLtfState
h1PutSoftReady = h1PutHardReady or h1PutPass >= 7
h1CallSoftReady = h1CallHardReady or h1CallPass >= 7
h1PutSoftBlocker = h1PutSetupStateTxt == "RR BELOW FULL" or h1PutSetupStateTxt == "WAIT LOCATION"
h1CallSoftBlocker = h1CallSetupStateTxt == "RR BELOW FULL" or h1CallSetupStateTxt == "WAIT LOCATION"
h1PutContextReady = h1PutSoftReady or h1PutSoftBlocker
h1CallContextReady = h1CallSoftReady or h1CallSoftBlocker

//------------------------------------------------------------------------------
// 15m Questions & Weights (sum = 100 for checklist)
// Core ENTRY score uses execution subset; Q4/Q9 act as soft caps only.
//------------------------------------------------------------------------------
w1=20, w2=18, w3=15, w4=12, w5=10, w6=9, w7=7, w8=6, w9=3

// Directional checks (CALL bullish, PUT bearish)
callQ1 = callRecentReaction
putQ1  = putRecentReaction

callQ2 = bullMicro or trendAlignBull
putQ2  = bearMicro or trendAlignBear

callQ3 = not na(callInvalid) and not na(callStop) and callRiskOK
putQ3  = not na(putInvalid)  and not na(putStop)  and putRiskOK

callQ4 = callRiskCompression
putQ4  = putRiskCompression

callQ5 = not isOverextended
putQ5  = not isOverextended

callQ6 = healthyPullbackBull and not aggressiveRetrace
putQ6  = healthyPullbackBear and not aggressiveRetrace

callQ7 = callVolOk
putQ7  = putVolOk

callQ8 = callMomOk
putQ8  = putMomOk

callQ9 = callWeekOk
putQ9  = putWeekOk

// 15m execution trigger (Blueprint style): break&hold OR reject&continue (price-first trigger).
// Break uses minor structure lookback (no pivot-confirm lag).
entryHoldTol = entryHoldAtr * atr
minorBreakHigh = ta.highest(high[1], entryBreakLookback)
minorBreakLow  = ta.lowest(low[1], entryBreakLookback)
callBreakHold = not na(minorBreakHigh) and close > minorBreakHigh and close >= (minorBreakHigh - entryHoldTol)
putBreakHold  = not na(minorBreakLow)  and close < minorBreakLow  and close <= (minorBreakLow + entryHoldTol)

callRejectContinue = callRecentReaction and (close >= emaFast or (not na(closePos) and closePos >= 0.55))
putRejectContinue  = putRecentReaction  and (close <= emaFast or (not na(closePos) and closePos <= 0.45))

// Price trigger is independent; volume remains in quality scoring (Q7) and confidence/grade soft caps.
callEntryPattern = callBreakHold or callRejectContinue
putEntryPattern  = putBreakHold  or putRejectContinue

callEntryPatternTxt = callBreakHold ? "break&hold" : (callRejectContinue ? "reject&continue" : "no trigger")
putEntryPatternTxt  = putBreakHold  ? "break&hold" : (putRejectContinue  ? "reject&continue" : "no trigger")

// Core execution-quality score (without daily-vol and HTF compression as hard blockers).
// Trend core is inherited from 1H readiness to keep 15m as execution/timing TF.
trendCoreW = w2 + w8
entryCoreW = w1 + w3 + w5 + w6 + w7
callTrendCoreRaw = f_score(h1CallContextReady, trendCoreW)
putTrendCoreRaw  = f_score(h1PutContextReady, trendCoreW)
callEntryCoreRaw = f_score(callQ1, w1) + f_score(callQ3, w3) + f_score(callQ5, w5) + f_score(callQ6, w6) + f_score(callQ7, w7)
putEntryCoreRaw  = f_score(putQ1, w1)  + f_score(putQ3, w3)  + f_score(putQ5, w5)  + f_score(putQ6, w6)  + f_score(putQ7, w7)
callTrendCoreScore = trendCoreW > 0 ? 100.0 * callTrendCoreRaw / trendCoreW : 0.0
putTrendCoreScore  = trendCoreW > 0 ? 100.0 * putTrendCoreRaw  / trendCoreW : 0.0
callEntryCoreScore = entryCoreW > 0 ? 100.0 * callEntryCoreRaw / entryCoreW : 0.0
putEntryCoreScore  = entryCoreW > 0 ? 100.0 * putEntryCoreRaw  / entryCoreW : 0.0

callTrendScore = callTrendCoreScore
putTrendScore  = putTrendCoreScore
callEntryScore = callEntryCoreScore
putEntryScore  = putEntryCoreScore

callSetupQualityOk = callEntryCoreScore >= entryScoreMin and callTrendCoreScore >= entryTrendMin
putSetupQualityOk  = putEntryCoreScore  >= entryScoreMin and putTrendCoreScore  >= entryTrendMin

// Process-state flags (ModMark-style): bias -> level -> reaction -> trigger.
callBiasOk = h1BullCtx
putBiasOk  = h1BearCtx
callLevelOk = nearSupportZone or callRecentReaction
putLevelOk  = nearResistZone or putRecentReaction
callReactionOk = callRecentReaction
putReactionOk  = putRecentReaction
callLtfReversalOk = callQ2 or (close >= emaFast and (rsi >= rsiMid or macdHist >= macdHist[1]))
putLtfReversalOk  = putQ2  or (close <= emaFast and (rsi <= rsiMid or macdHist <= macdHist[1]))
callContextConfirmedState = h1CallContextReady and callQ3 and callHasRR and not hardExtended
putContextConfirmedState  = h1PutContextReady  and putQ3  and putHasRR  and not hardExtended

callNoTradeState = (not callBiasOk) or (not callHasRR) or na(callInvalid) or na(callStop)
putNoTradeState  = (not putBiasOk)  or (not putHasRR)  or na(putInvalid)  or na(putStop)

callWaitLevelState = not callLevelOk
putWaitLevelState  = not putLevelOk
callWaitPullbackState = hardExtended
putWaitPullbackState  = hardExtended

callWaitReversalState = (not h1CallContextReady) or (not callLtfReversalOk) or (not callReactionOk)
putWaitReversalState  = (not h1PutContextReady)  or (not putLtfReversalOk)  or (not putReactionOk)

callSetupDevelopingState = callContextConfirmedState and callLevelOk and callReactionOk and (not callEntryPattern)
putSetupDevelopingState  = putContextConfirmedState  and putLevelOk  and putReactionOk  and (not putEntryPattern)
callEntryNowState = h1CallHardReady and not hardExtended and callLevelOk and callReactionOk and callEntryPattern
putEntryNowState  = h1PutHardReady  and not hardExtended and putLevelOk  and putReactionOk  and putEntryPattern
callConfirmedContextState = callContextConfirmedState and not callEntryNowState and not callSetupDevelopingState
putConfirmedContextState  = putContextConfirmedState  and not putEntryNowState  and not putSetupDevelopingState
callEntryReadyState = callEntryNowState and not callNoTradeState
putEntryReadyState  = putEntryNowState  and not putNoTradeState

callNoTradeStatus = not callBiasOk ? "NO TRADE (NO BIAS)" : ((na(callInvalid) or na(callStop)) ? "NO TRADE (NO STOP)" : "NO TRADE (RR)")
putNoTradeStatus  = not putBiasOk  ? "NO TRADE (NO BIAS)" : ((na(putInvalid)  or na(putStop))  ? "NO TRADE (NO STOP)" : "NO TRADE (RR)")

callScore = math.min(callTrendScore, callEntryScore)
putScore  = math.min(putTrendScore, putEntryScore)

callConfidenceBase = math.max(0.0, math.min(100.0, callScore + (callTrendScore - callEntryScore) / 4.0))
putConfidenceBase  = math.max(0.0, math.min(100.0, putScore  + (putTrendScore  - putEntryScore)  / 4.0))
callSoftPenalty = (dHighVol ? 8.0 : 0.0) + (not callRiskCompression ? 6.0 : 0.0) + (impulseHeat ? 4.0 : 0.0) + (not callMomOk ? 5.0 : 0.0) + (not trendOK ? 3.0 : 0.0)
putSoftPenalty  = (dHighVol ? 8.0 : 0.0) + (not putRiskCompression  ? 6.0 : 0.0) + (impulseHeat ? 4.0 : 0.0) + (not putMomOk  ? 5.0 : 0.0) + (not trendOK ? 3.0 : 0.0)
callConfidence = math.max(0.0, math.min(100.0, callConfidenceBase - callSoftPenalty))
putConfidence  = math.max(0.0, math.min(100.0, putConfidenceBase  - putSoftPenalty))
callConfTxt = str.tostring(callConfidence, "#.##") + " " + f_confBand(callConfidence)
putConfTxt  = str.tostring(putConfidence,  "#.##") + " " + f_confBand(putConfidence)

//------------------------------------------------------------------------------
// Table rendering (Top Right)
//------------------------------------------------------------------------------
var int COL_METRIC = 0
var int COL_PUT    = 1
var int COL_CALL   = 2

var table t = table.new(position.top_right, 3, 1, border_width=1)

f_setCell(_row, _col, _txt, _bg, _tc) =>
    table.cell(t, _col, _row, _txt, text_color=_tc, bgcolor=_bg, text_size=txtSize)

f_clearTable(_rows) =>
    for r = 0 to _rows - 1
        for c = 0 to 2
            f_setCell(r, c, "", color.new(color.black, 100), color.new(color.white, 100))

maxRows = 60
if barstate.isfirst
    t := table.new(position.top_right, 3, maxRows, border_width=1)

f_hdrRow(_r, _title) =>
    f_setCell(_r, COL_METRIC, _title, colHdr, f_c(color.black))
    f_setCell(_r, COL_PUT,    "PUT",   colHdr, f_c(color.black))
    f_setCell(_r, COL_CALL,   "CALL",  colHdr, f_c(color.black))

f_sectionRow(_r, _title) =>
    f_setCell(_r, COL_METRIC, _title, colSep, f_c(color.white))
    f_setCell(_r, COL_PUT,    "",     colSep, f_c(color.white))
    f_setCell(_r, COL_CALL,   "",     colSep, f_c(color.white))

f_metricRow(_r, _name, _putTxt, _putCol, _callTxt, _callCol) =>
    f_setCell(_r, COL_METRIC, _name, colBg, f_c(color.white))
    f_setCell(_r, COL_PUT,    _putTxt,  _putCol, f_c(color.white))
    f_setCell(_r, COL_CALL,   _callTxt, _callCol, f_c(color.white))

f_valueRow(_r, _name, _putVal, _callVal) =>
    f_setCell(_r, COL_METRIC, _name, colBg, f_c(color.white))
    f_setCell(_r, COL_PUT,  _putVal, colBg, f_c(color.white))
    f_setCell(_r, COL_CALL, _callVal,colBg, f_c(color.white))

showPut  = modeShowBoth ? true : (modeFocus == "PUT")
showCall = modeShowBoth ? true : (modeFocus == "CALL")

f_applyColVisibility(_r) =>
    if not showPut
        f_setCell(_r, COL_PUT, "", color.new(color.black, 100), color.new(color.white, 100))
    if not showCall
        f_setCell(_r, COL_CALL, "", color.new(color.black, 100), color.new(color.white, 100))

f_failReason(_id, _isPut) =>
    if _id == 1
        _isPut ? (not putLevelOk ? "not near level" : (not putRecentReaction ? "no recent reaction" : "reaction stale")) : (not callLevelOk ? "not near level" : (not callRecentReaction ? "no recent reaction" : "reaction stale"))
    else if _id == 2
        "no structure align"
    else if _id == 3
        _isPut ? (na(putInvalid) ? "no invalidation" : (na(putStop) ? "no stop" : "risk too high")) : (na(callInvalid) ? "no invalidation" : (na(callStop) ? "no stop" : "risk too high"))
    else if _id == 4
        _isPut ? (not putRiskOK ? "risk invalid" : "no HTF compression") : (not callRiskOK ? "risk invalid" : "no HTF compression")
    else if _id == 5
        "distance > limit"
    else if _id == 6
        _isPut ? (not healthyPullbackBear ? "pullback too strong" : "retrace too deep") : (not healthyPullbackBull ? "pullback too strong" : "retrace too deep")
    else if _id == 7
        _isPut ? (not impulseBear and not healthyPullbackBear ? "no impulse/pb" : "low volume") : (not impulseBull and not healthyPullbackBull ? "no impulse/pb" : "low volume")
    else if _id == 8
        _isPut ? (rsi > rsiMid ? "RSI too high" : (macdHist > 0 ? "MACD > 0" : "MACD weakening")) : (rsi < rsiMid ? "RSI too low" : (macdHist < 0 ? "MACD < 0" : "MACD weakening"))
    else
        "daily high vol"

f_checkRow(_r, _id, _name, _w, _putOk, _callOk, _putNa, _callNa) =>
    _putTxt = f_gateText(_putOk, _putNa, f_failReason(_id, true)) + " (" + str.tostring(_w) + ")"
    _calTxt = f_gateText(_callOk, _callNa, f_failReason(_id, false)) + " (" + str.tostring(_w) + ")"
    f_metricRow(_r, _name, _putTxt, f_statusColor(_putOk, _putNa), _calTxt, f_statusColor(_callOk, _callNa))
    f_applyColVisibility(_r)

f_updateSrLine(_ln, _y, _col) =>
    line _out = _ln
    if na(_y)
        if not na(_out)
            line.delete(_out)
            _out := na
    else
        _x1 = bar_index
        _x2 = bar_index + 3
        if na(_out)
            _out := line.new(_x1, _y, _x2, _y, xloc=xloc.bar_index, extend=extend.none, color=_col, width=1)
        else
            line.set_xy1(_out, _x1, _y)
            line.set_xy2(_out, _x2, _y)
            line.set_color(_out, _col)
            line.set_width(_out, 1)
    _out

f_laneSideText(_tf, _callActive, _putActive) =>
    _callActive and _putActive ? _tf + " (c/p)" : (_callActive ? _tf + " (c)" : (_putActive ? _tf + " (p)" : _tf))

var line srSupportLine = na
var line srResistLine = na
var line spyLaneExtLine = na
var line d1LaneExtLine = na
var line h4LaneExtLine = na
var line h1LaneExtLine = na
var line m15LaneExtLine = na
var label spyLaneLabel = na
var label d1LaneLabel = na
var label h4LaneLabel = na
var label h1LaneLabel = na
var label m15LaneLabel = na

render = uiShow and (not onlyOn15m or is15m)
showEMarks = uiShowEMarks and (not onlyOn15m or is15m)
showMarket1DMarks = uiShowMarket1DMarks and (not onlyOn15m or is15m)
show1HMarks = uiShow1HMarks and (not onlyOn15m or is15m)
show4HMarks = uiShow4HMarks and (not onlyOn15m or is15m)
show1DMarks = uiShow1DMarks and (not onlyOn15m or is15m)
laneRightShiftBars = 4
laneLabelGapBars = 1

srSupportLine := f_updateSrLine(srSupportLine, render ? nearestSupport : na, f_c(color.teal))
srResistLine := f_updateSrLine(srResistLine, render ? nearestResist : na, f_c(color.orange))

// HTF summary counts one hit per closed bar of the source timeframe while state is true.
m1dPutSoftActive = m1dPutStateTxt == "BEARISH" or m1dPutStateTxt == "SUPPORTIVE"
m1dCallSoftActive = m1dCallStateTxt == "BULLISH" or m1dCallStateTxt == "SUPPORTIVE"
newMarket1DBar = ta.change(time(dailyTF)) != 0
newStock1DBar = ta.change(time(d1MirrorTf)) != 0
newStock4HBar = ta.change(time("240")) != 0
newStock1HBar = ta.change(time("60")) != 0
newStock15mBar = ta.change(time("15")) != 0

m1dPutBarHit = newMarket1DBar and m1dPutSoftActive[1] == true
m1dCallBarHit = newMarket1DBar and m1dCallSoftActive[1] == true
d1PutBarHit = newStock1DBar and d1PutConfirmed[1] == true
d1CallBarHit = newStock1DBar and d1CallConfirmed[1] == true
h4PutBarHit = newStock4HBar and h4PutStateTxt[1] == "READY"
h4CallBarHit = newStock4HBar and h4CallStateTxt[1] == "READY"
h1PutBarHit = newStock1HBar and h1PutReadyForLtfState[1] == true
h1CallBarHit = newStock1HBar and h1CallReadyForLtfState[1] == true
m15PutBarHit = newStock15mBar and putEntryReadyState[1] == true
m15CallBarHit = newStock15mBar and callEntryReadyState[1] == true

var float putSpyAccum = 0.0
var float callSpyAccum = 0.0
var float putEAccum = 0.0
var float callEAccum = 0.0
var float put1Accum = 0.0
var float call1Accum = 0.0
var float put4Accum = 0.0
var float call4Accum = 0.0
var float putDAccum = 0.0
var float callDAccum = 0.0

putSpyAccum := nz(putSpyAccum[1]) + (m1dPutBarHit ? 1.0 : 0.0)
callSpyAccum := nz(callSpyAccum[1]) + (m1dCallBarHit ? 1.0 : 0.0)
putEAccum := nz(putEAccum[1]) + (m15PutBarHit ? 1.0 : 0.0)
callEAccum := nz(callEAccum[1]) + (m15CallBarHit ? 1.0 : 0.0)
put1Accum := nz(put1Accum[1]) + (h1PutBarHit ? 1.0 : 0.0)
call1Accum := nz(call1Accum[1]) + (h1CallBarHit ? 1.0 : 0.0)
put4Accum := nz(put4Accum[1]) + (h4PutBarHit ? 1.0 : 0.0)
call4Accum := nz(call4Accum[1]) + (h4CallBarHit ? 1.0 : 0.0)
putDAccum := nz(putDAccum[1]) + (d1PutBarHit ? 1.0 : 0.0)
callDAccum := nz(callDAccum[1]) + (d1CallBarHit ? 1.0 : 0.0)

maxDynamicHistoryBars = 5000
markSummaryBarsRaw = f_lookbackBarsFromDays(markSummaryDays)
// Pine limits dynamic history indexing to 5000 bars.
markSummaryBars = math.min(markSummaryBarsRaw, maxDynamicHistoryBars)
markSummaryLabel = markSummaryBarsRaw > markSummaryBars ? str.tostring(f_lookbackDaysFromBars(markSummaryBars), "#.##") + "D eff." : str.tostring(markSummaryDays) + "D"
putSpyCount = putSpyAccum - nz(putSpyAccum[markSummaryBars], 0.0)
callSpyCount = callSpyAccum - nz(callSpyAccum[markSummaryBars], 0.0)
putECount = putEAccum - nz(putEAccum[markSummaryBars], 0.0)
callECount = callEAccum - nz(callEAccum[markSummaryBars], 0.0)
put1Count = put1Accum - nz(put1Accum[markSummaryBars], 0.0)
call1Count = call1Accum - nz(call1Accum[markSummaryBars], 0.0)
put4Count = put4Accum - nz(put4Accum[markSummaryBars], 0.0)
call4Count = call4Accum - nz(call4Accum[markSummaryBars], 0.0)
putDCount = putDAccum - nz(putDAccum[markSummaryBars], 0.0)
callDCount = callDAccum - nz(callDAccum[markSummaryBars], 0.0)

// Readiness lanes (state duration, not trigger events):
// top -> bottom: SPY, 1D, 4H, 1H, 15m
laneLookback = 300
laneTop = ta.highest(high, laneLookback)
laneBottom = ta.lowest(low, laneLookback)
laneStepBase = math.max(nz(atr, 0.0), laneTop - laneBottom)
laneStep = math.max(syminfo.mintick * 20.0, laneStepBase * 0.04)

spyLaneY = laneTop + 5.0 * laneStep
d1LaneY = laneTop + 4.0 * laneStep
h4LaneY = laneTop + 3.0 * laneStep
h1LaneY = laneTop + 2.0 * laneStep
m15LaneY = laneTop + 1.0 * laneStep

spyLaneCol = f_laneC(color.silver)
d1LaneCol = f_laneC(color.yellow)
h4LaneCol = f_laneC(color.aqua)
h1LaneCol = f_laneC(color.orange)
m15LaneCol = f_laneC(color.lime)

spyReadyLine = showMarket1DMarks and (m1dPutSoftActive or m1dCallSoftActive)
d1ReadyLine = show1DMarks and (d1PutConfirmed or d1CallConfirmed)
h4ReadyLine = show4HMarks and (h4PutStateTxt == "READY" or h4CallStateTxt == "READY")
h1ReadyLine = show1HMarks and (h1PutReadyForLtfState or h1CallReadyForLtfState)
m15ReadyLine = showEMarks and (putEntryReadyState or callEntryReadyState)

plot(spyReadyLine ? spyLaneY : na, title="SPY readiness line", style=plot.style_linebr, color=spyLaneCol, linewidth=2)
plot(d1ReadyLine ? d1LaneY : na, title="1D readiness line", style=plot.style_linebr, color=d1LaneCol, linewidth=2)
plot(h4ReadyLine ? h4LaneY : na, title="4H readiness line", style=plot.style_linebr, color=h4LaneCol, linewidth=2)
plot(h1ReadyLine ? h1LaneY : na, title="1H readiness line", style=plot.style_linebr, color=h1LaneCol, linewidth=2)
plot(m15ReadyLine ? m15LaneY : na, title="15m readiness line", style=plot.style_linebr, color=m15LaneCol, linewidth=2)

spyLaneTxt = f_laneSideText("SPY", m1dCallSoftActive and not m1dPutSoftActive, m1dPutSoftActive and not m1dCallSoftActive)
d1LaneTxt = f_laneSideText("1D", d1CallConfirmed and not d1PutConfirmed, d1PutConfirmed and not d1CallConfirmed)
h4LaneTxt = f_laneSideText("4H", h4CallStateTxt == "READY" and h4PutStateTxt != "READY", h4PutStateTxt == "READY" and h4CallStateTxt != "READY")
h1LaneTxt = f_laneSideText("1H", h1CallReadyForLtfState and not h1PutReadyForLtfState, h1PutReadyForLtfState and not h1CallReadyForLtfState)
m15LaneTxt = f_laneSideText("15m", callEntryReadyState and not putEntryReadyState, putEntryReadyState and not callEntryReadyState)

if not spyReadyLine or na(spyLaneY)
    if not na(spyLaneExtLine)
        line.delete(spyLaneExtLine)
        spyLaneExtLine := na
    if not na(spyLaneLabel)
        label.delete(spyLaneLabel)
        spyLaneLabel := na
else
    if na(spyLaneExtLine)
        spyLaneExtLine := line.new(bar_index, spyLaneY, bar_index + laneRightShiftBars, spyLaneY, xloc=xloc.bar_index, extend=extend.none, color=spyLaneCol, width=2)
    else
        line.set_xy1(spyLaneExtLine, bar_index, spyLaneY)
        line.set_xy2(spyLaneExtLine, bar_index + laneRightShiftBars, spyLaneY)
        line.set_color(spyLaneExtLine, spyLaneCol)
        line.set_width(spyLaneExtLine, 2)
    if na(spyLaneLabel)
        spyLaneLabel := label.new(bar_index + laneRightShiftBars + laneLabelGapBars, spyLaneY, spyLaneTxt, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, textcolor=spyLaneCol, size=size.small)
    else
        label.set_xy(spyLaneLabel, bar_index + laneRightShiftBars + laneLabelGapBars, spyLaneY)
        label.set_text(spyLaneLabel, spyLaneTxt)
        label.set_textcolor(spyLaneLabel, spyLaneCol)
        label.set_size(spyLaneLabel, size.tiny)
        label.set_style(spyLaneLabel, label.style_none)

if not d1ReadyLine or na(d1LaneY)
    if not na(d1LaneExtLine)
        line.delete(d1LaneExtLine)
        d1LaneExtLine := na
    if not na(d1LaneLabel)
        label.delete(d1LaneLabel)
        d1LaneLabel := na
else
    if na(d1LaneExtLine)
        d1LaneExtLine := line.new(bar_index, d1LaneY, bar_index + laneRightShiftBars, d1LaneY, xloc=xloc.bar_index, extend=extend.none, color=d1LaneCol, width=2)
    else
        line.set_xy1(d1LaneExtLine, bar_index, d1LaneY)
        line.set_xy2(d1LaneExtLine, bar_index + laneRightShiftBars, d1LaneY)
        line.set_color(d1LaneExtLine, d1LaneCol)
        line.set_width(d1LaneExtLine, 2)
    if na(d1LaneLabel)
        d1LaneLabel := label.new(bar_index + laneRightShiftBars + laneLabelGapBars, d1LaneY, d1LaneTxt, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, textcolor=d1LaneCol, size=size.small)
    else
        label.set_xy(d1LaneLabel, bar_index + laneRightShiftBars + laneLabelGapBars, d1LaneY)
        label.set_text(d1LaneLabel, d1LaneTxt)
        label.set_textcolor(d1LaneLabel, d1LaneCol)
        label.set_size(d1LaneLabel, size.tiny)
        label.set_style(d1LaneLabel, label.style_none)

if not h4ReadyLine or na(h4LaneY)
    if not na(h4LaneExtLine)
        line.delete(h4LaneExtLine)
        h4LaneExtLine := na
    if not na(h4LaneLabel)
        label.delete(h4LaneLabel)
        h4LaneLabel := na
else
    if na(h4LaneExtLine)
        h4LaneExtLine := line.new(bar_index, h4LaneY, bar_index + laneRightShiftBars, h4LaneY, xloc=xloc.bar_index, extend=extend.none, color=h4LaneCol, width=2)
    else
        line.set_xy1(h4LaneExtLine, bar_index, h4LaneY)
        line.set_xy2(h4LaneExtLine, bar_index + laneRightShiftBars, h4LaneY)
        line.set_color(h4LaneExtLine, h4LaneCol)
        line.set_width(h4LaneExtLine, 2)
    if na(h4LaneLabel)
        h4LaneLabel := label.new(bar_index + laneRightShiftBars + laneLabelGapBars, h4LaneY, h4LaneTxt, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, textcolor=h4LaneCol, size=size.small)
    else
        label.set_xy(h4LaneLabel, bar_index + laneRightShiftBars + laneLabelGapBars, h4LaneY)
        label.set_text(h4LaneLabel, h4LaneTxt)
        label.set_textcolor(h4LaneLabel, h4LaneCol)
        label.set_size(h4LaneLabel, size.tiny)
        label.set_style(h4LaneLabel, label.style_none)

if not h1ReadyLine or na(h1LaneY)
    if not na(h1LaneExtLine)
        line.delete(h1LaneExtLine)
        h1LaneExtLine := na
    if not na(h1LaneLabel)
        label.delete(h1LaneLabel)
        h1LaneLabel := na
else
    if na(h1LaneExtLine)
        h1LaneExtLine := line.new(bar_index, h1LaneY, bar_index + laneRightShiftBars, h1LaneY, xloc=xloc.bar_index, extend=extend.none, color=h1LaneCol, width=2)
    else
        line.set_xy1(h1LaneExtLine, bar_index, h1LaneY)
        line.set_xy2(h1LaneExtLine, bar_index + laneRightShiftBars, h1LaneY)
        line.set_color(h1LaneExtLine, h1LaneCol)
        line.set_width(h1LaneExtLine, 2)
    if na(h1LaneLabel)
        h1LaneLabel := label.new(bar_index + laneRightShiftBars + laneLabelGapBars, h1LaneY, h1LaneTxt, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, textcolor=h1LaneCol, size=size.small)
    else
        label.set_xy(h1LaneLabel, bar_index + laneRightShiftBars + laneLabelGapBars, h1LaneY)
        label.set_text(h1LaneLabel, h1LaneTxt)
        label.set_textcolor(h1LaneLabel, h1LaneCol)
        label.set_size(h1LaneLabel, size.tiny)
        label.set_style(h1LaneLabel, label.style_none)

if not m15ReadyLine or na(m15LaneY)
    if not na(m15LaneExtLine)
        line.delete(m15LaneExtLine)
        m15LaneExtLine := na
    if not na(m15LaneLabel)
        label.delete(m15LaneLabel)
        m15LaneLabel := na
else
    if na(m15LaneExtLine)
        m15LaneExtLine := line.new(bar_index, m15LaneY, bar_index + laneRightShiftBars, m15LaneY, xloc=xloc.bar_index, extend=extend.none, color=m15LaneCol, width=2)
    else
        line.set_xy1(m15LaneExtLine, bar_index, m15LaneY)
        line.set_xy2(m15LaneExtLine, bar_index + laneRightShiftBars, m15LaneY)
        line.set_color(m15LaneExtLine, m15LaneCol)
        line.set_width(m15LaneExtLine, 2)
    if na(m15LaneLabel)
        m15LaneLabel := label.new(bar_index + laneRightShiftBars + laneLabelGapBars, m15LaneY, m15LaneTxt, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, textcolor=m15LaneCol, size=size.small)
    else
        label.set_xy(m15LaneLabel, bar_index + laneRightShiftBars + laneLabelGapBars, m15LaneY)
        label.set_text(m15LaneLabel, m15LaneTxt)
        label.set_textcolor(m15LaneLabel, m15LaneCol)
        label.set_size(m15LaneLabel, size.tiny)
        label.set_style(m15LaneLabel, label.style_none)

if not render
    f_clearTable(maxRows)
    if uiShowHintWhenNot15m and uiShow
        hint = "Switch to 15m to view stock table"
        f_setCell(0, COL_METRIC, hint, colBg, f_c(color.orange))
else
    row = 0
    f_hdrRow(row, "STOCK 15m - OPTIONS UI")
    f_applyColVisibility(row)
    row += 1

    putBaseGrade  = f_grade(putScore)
    callBaseGrade = f_grade(callScore)
    putCapGradeHard  = (not putHasRR and hardExtended) ? "D" : ((not putHasRR or hardExtended or not h1PutContextReady) ? "C" : ((softExtended or not h1PutHardReady) ? "B" : "A"))
    callCapGradeHard = (not callHasRR and hardExtended) ? "D" : ((not callHasRR or hardExtended or not h1CallContextReady) ? "C" : ((softExtended or not h1CallHardReady) ? "B" : "A"))
    putSoftCapHits = (dHighVol ? 1 : 0) + (not putRiskCompression ? 1 : 0) + (impulseHeat ? 1 : 0) + (not putMomOk ? 1 : 0) + (not trendOK ? 1 : 0)
    callSoftCapHits = (dHighVol ? 1 : 0) + (not callRiskCompression ? 1 : 0) + (impulseHeat ? 1 : 0) + (not callMomOk ? 1 : 0) + (not trendOK ? 1 : 0)
    putCapGradeSoft  = putSoftCapHits >= 2 ? "C" : (putSoftCapHits == 1 ? "B" : "A")
    callCapGradeSoft = callSoftCapHits >= 2 ? "C" : (callSoftCapHits == 1 ? "B" : "A")
    putCapGrade  = f_capGrade(putCapGradeHard, putCapGradeSoft)
    callCapGrade = f_capGrade(callCapGradeHard, callCapGradeSoft)
    putGrade  = f_capGrade(putBaseGrade, putCapGrade)
    callGrade = f_capGrade(callBaseGrade, callCapGrade)

    putStatus = putNoTradeState ? putNoTradeStatus : (putWaitPullbackState ? "WAIT PULLBACK" : (putWaitLevelState ? "WAIT LEVEL" : (putEntryNowState ? "ENTRY NOW" : (putSetupDevelopingState ? "SETUP DEVELOPING" : (putConfirmedContextState ? "CONFIRMED CONTEXT" : (putWaitReversalState ? "WAIT REVERSAL" : "WAIT TRIGGER"))))))
    callStatus = callNoTradeState ? callNoTradeStatus : (callWaitPullbackState ? "WAIT PULLBACK" : (callWaitLevelState ? "WAIT LEVEL" : (callEntryNowState ? "ENTRY NOW" : (callSetupDevelopingState ? "SETUP DEVELOPING" : (callConfirmedContextState ? "CONFIRMED CONTEXT" : (callWaitReversalState ? "WAIT REVERSAL" : "WAIT TRIGGER"))))))
    putState = putNoTradeState ? "NO TRADE" : (putWaitPullbackState ? "WAIT PULLBACK" : (putWaitLevelState ? "WAIT LEVEL" : (putEntryNowState ? "ENTRY READY" : (putSetupDevelopingState ? "SETUP DEVELOPING" : (putConfirmedContextState ? "CONFIRMED CONTEXT" : "WAIT TRIGGER")))))
    callState = callNoTradeState ? "NO TRADE" : (callWaitPullbackState ? "WAIT PULLBACK" : (callWaitLevelState ? "WAIT LEVEL" : (callEntryNowState ? "ENTRY READY" : (callSetupDevelopingState ? "SETUP DEVELOPING" : (callConfirmedContextState ? "CONFIRMED CONTEXT" : "WAIT TRIGGER")))))
    putStateCol = putState == "ENTRY READY" ? colOk : (putState == "NO TRADE" ? colBad : colBg)
    callStateCol = callState == "ENTRY READY" ? colOk : (callState == "NO TRADE" ? colBad : colBg)
    putPipeline = putNoTradeState ? "BLOCKED" : (putEntryReadyState ? "ENTRY" : (putSetupDevelopingState ? "DEVELOPING" : (putConfirmedContextState ? "CONTEXT" : "WAIT")))
    callPipeline = callNoTradeState ? "BLOCKED" : (callEntryReadyState ? "ENTRY" : (callSetupDevelopingState ? "DEVELOPING" : (callConfirmedContextState ? "CONTEXT" : "WAIT")))
    putPipelineCol = putPipeline == "ENTRY" ? colOk : (putPipeline == "BLOCKED" ? colBad : (putPipeline == "WAIT" ? colBg : colWarn))
    callPipelineCol = callPipeline == "ENTRY" ? colOk : (callPipeline == "BLOCKED" ? colBad : (callPipeline == "WAIT" ? colBg : colWarn))
    putNextStep = putState == "ENTRY READY" ? "EXECUTE" : (putState == "NO TRADE" ? "SKIP" : (putState == "WAIT LEVEL" ? "WAIT LEVEL RETEST" : (putState == "CONFIRMED CONTEXT" ? "WAIT REACTION/TRIGGER" : "WAIT REACTION")))
    callNextStep = callState == "ENTRY READY" ? "EXECUTE" : (callState == "NO TRADE" ? "SKIP" : (callState == "WAIT LEVEL" ? "WAIT LEVEL RETEST" : (callState == "CONFIRMED CONTEXT" ? "WAIT REACTION/TRIGGER" : "WAIT REACTION")))
    putNextStepCol = putState == "ENTRY READY" ? colOk : (putState == "NO TRADE" ? colBad : colBg)
    callNextStepCol = callState == "ENTRY READY" ? colOk : (callState == "NO TRADE" ? colBad : colBg)

    // HTF CONTEXT
    f_sectionRow(row, "HTF CONTEXT")
    f_applyColVisibility(row)
    row += 1

    f_metricRow(row, "Market 1D", m1dPutStateDisplay, m1dPutStateCol, m1dCallStateDisplay, m1dCallStateCol)
    f_applyColVisibility(row)
    row += 1

    f_metricRow(row, "Stock 1D", d1PutStateDisplay, d1PutStateCol, d1CallStateDisplay, d1CallStateCol)
    f_applyColVisibility(row)
    row += 1

    f_metricRow(row, "4H", h4PutStateDisplay, h4PutStateCol, h4CallStateDisplay, h4CallStateCol)
    f_applyColVisibility(row)
    row += 1

    f_metricRow(row, "1H", h1PutSetupStateDisplay, h1PutSetupStateCol, h1CallSetupStateDisplay, h1CallSetupStateCol)
    f_applyColVisibility(row)
    row += 1

    if uiShowMarkSummary
        f_sectionRow(row, "MARK SUMMARY (" + markSummaryLabel + ")")
        f_applyColVisibility(row)
        row += 1

        if markSummaryDays <= 7
            f_valueRow(row, "7D note", "1D counts can be sparse", "1D counts can be sparse")
            f_applyColVisibility(row)
            row += 1

        f_metricRow(row, "SPY/QQQ 1D", str.tostring(int(math.round(putSpyCount))), colBg, str.tostring(int(math.round(callSpyCount))), colBg)
        f_applyColVisibility(row)
        row += 1

        f_metricRow(row, "Stock 1D", str.tostring(int(math.round(putDCount))), colBg, str.tostring(int(math.round(callDCount))), colBg)
        f_applyColVisibility(row)
        row += 1

        f_metricRow(row, "Stock 4H", str.tostring(int(math.round(put4Count))), colBg, str.tostring(int(math.round(call4Count))), colBg)
        f_applyColVisibility(row)
        row += 1

        f_metricRow(row, "Stock 1H", str.tostring(int(math.round(put1Count))), colBg, str.tostring(int(math.round(call1Count))), colBg)
        f_applyColVisibility(row)
        row += 1

        f_metricRow(row, "Stock 15m", str.tostring(int(math.round(putECount))), colBg, str.tostring(int(math.round(callECount))), colBg)
        f_applyColVisibility(row)
        row += 1

    // DECISION
    f_sectionRow(row, "DECISION")
    f_applyColVisibility(row)
    row += 1

    f_metricRow(row, "State", putState, putStateCol, callState, callStateCol)
    f_applyColVisibility(row)
    row += 1

    f_metricRow(row, "Pipeline", putPipeline, putPipelineCol, callPipeline, callPipelineCol)
    f_applyColVisibility(row)
    row += 1

    f_metricRow(row, "Grade", putGrade, colBg, callGrade, colBg)
    f_applyColVisibility(row)
    row += 1

    f_metricRow(row, "Next step", putNextStep, putNextStepCol, callNextStep, callNextStepCol)
    f_applyColVisibility(row)
    row += 1

    // ENTRY CHECK (reaction -> structure -> trigger)
    f_sectionRow(row, "ENTRY CHECK")
    f_applyColVisibility(row)
    row += 1

    putReactionTxt = putReactionOk ? (putReactionBarsAgo == 0 ? "CONFIRMED NOW" : ("CONFIRMED " + str.tostring(putReactionBarsAgo) + "B AGO")) : (putLevelOk ? "NO REACTION" : "NOT AT LEVEL")
    callReactionTxt = callReactionOk ? (callReactionBarsAgo == 0 ? "CONFIRMED NOW" : ("CONFIRMED " + str.tostring(callReactionBarsAgo) + "B AGO")) : (callLevelOk ? "NO REACTION" : "NOT AT LEVEL")
    f_metricRow(row, "Reaction @ level", putReactionTxt, f_statusColor(putReactionOk, false), callReactionTxt, f_statusColor(callReactionOk, false))
    f_applyColVisibility(row)
    row += 1

    putStructureTxt = putQ2 ? "YES" : "NO"
    callStructureTxt = callQ2 ? "YES" : "NO"
    f_metricRow(row, "Structure align", putStructureTxt, f_statusColor(putQ2, false), callStructureTxt, f_statusColor(callQ2, false))
    f_applyColVisibility(row)
    row += 1

    putEntryTrigTxt = putEntryPattern ? (putBreakHold ? "STRUCTURE BREAK" : (wickRejectShort ? "REJECTION CANDLE" : "RECLAIM LEVEL")) : (not putReactionOk ? "NO REACTION" : "NO TRIGGER")
    callEntryTrigTxt = callEntryPattern ? (callBreakHold ? "STRUCTURE BREAK" : (wickRejectLong ? "REJECTION CANDLE" : "RECLAIM LEVEL")) : (not callReactionOk ? "NO REACTION" : "NO TRIGGER")
    f_metricRow(row, "Entry trigger", putEntryTrigTxt, f_statusColor(putEntryPattern, false), callEntryTrigTxt, f_statusColor(callEntryPattern, false))
    f_applyColVisibility(row)
    row += 1

    putVolTxt = putQ7 ? "CONFIRMED" : "WEAK"
    callVolTxt = callQ7 ? "CONFIRMED" : "WEAK"
    f_metricRow(row, "Volume", putVolTxt, f_statusColor(putQ7, false), callVolTxt, f_statusColor(callQ7, false))
    f_applyColVisibility(row)
    row += 1

    // RISK
    f_sectionRow(row, "RISK")
    f_applyColVisibility(row)
    row += 1

    putInvalidTxt = not na(putInvalid) ? str.tostring(putInvalid, "#.####") : "-"
    callInvalidTxt = not na(callInvalid) ? str.tostring(callInvalid, "#.####") : "-"
    f_metricRow(row, "Invalidation", putInvalidTxt, colBg, callInvalidTxt, colBg)
    f_applyColVisibility(row)
    row += 1

    putStopTxt = not na(putStop) ? str.tostring(putStop, "#.####") : "-"
    callStopTxt = not na(callStop) ? str.tostring(callStop, "#.####") : "-"
    f_metricRow(row, "Stop", putStopTxt, colBg, callStopTxt, colBg)
    f_applyColVisibility(row)
    row += 1

    rrPutTxt  = not na(putRR)  ? str.tostring(putRR, "#.##")  : "-"
    rrCallTxt = not na(callRR) ? str.tostring(callRR, "#.##") : "-"
    f_metricRow(row, "RR (SR or 1.5R)", rrPutTxt, f_statusColor(putHasRR, na(putRR)), rrCallTxt, f_statusColor(callHasRR, na(callRR)))
    f_applyColVisibility(row)
    row += 1

    // CHECKS (compact)
    if uiShowDetails
        row += 1
        f_sectionRow(row, "CHECKS")
        f_applyColVisibility(row)
        row += 1

        f_metricRow(row, "Entry score (0-100)", str.tostring(putScore, "#.##"), colBg, str.tostring(callScore, "#.##"), colBg)
        f_applyColVisibility(row)
        row += 1

        f_metricRow(row, "1) Reaction at level", putReactionOk ? "YES" : "NO", f_statusColor(putReactionOk, false), callReactionOk ? "YES" : "NO", f_statusColor(callReactionOk, false))
        f_applyColVisibility(row)
        row += 1

        f_metricRow(row, "2) Structure align", putQ2 ? "YES" : "NO", f_statusColor(putQ2, false), callQ2 ? "YES" : "NO", f_statusColor(callQ2, false))
        f_applyColVisibility(row)
        row += 1

        f_metricRow(row, "3) Trigger active", putEntryPattern ? "YES" : "NO", f_statusColor(putEntryPattern, false), callEntryPattern ? "YES" : "NO", f_statusColor(callEntryPattern, false))
        f_applyColVisibility(row)
        row += 1

        f_metricRow(row, "4) RR acceptable", putHasRR ? "YES" : "NO", f_statusColor(putHasRR, na(putRR)), callHasRR ? "YES" : "NO", f_statusColor(callHasRR, na(callRR)))
        f_applyColVisibility(row)
        row += 1

    // OPTIONAL DEBUG (collapsed by default)
    if uiShowDebug
        row += 1
        f_sectionRow(row, "OPTIONAL DEBUG")
        f_applyColVisibility(row)
        row += 1

        f_valueRow(row, "ATR / VolSMA", str.tostring(atr, "#.####") + " / " + str.tostring(volSma, "#"),
                             str.tostring(atr, "#.####") + " / " + str.tostring(volSma, "#"))
        f_applyColVisibility(row)
        row += 1

        f_valueRow(row, "EMA20 / SMA50", str.tostring(emaFast, "#.####") + " / " + str.tostring(smaMid, "#.####"),
                              str.tostring(emaFast, "#.####") + " / " + str.tostring(smaMid, "#.####"))
        f_applyColVisibility(row)
        row += 1

        f_valueRow(row, "VWAP", na(vwap) ? "-" : str.tostring(vwap, "#.####"), na(vwap) ? "-" : str.tostring(vwap, "#.####"))
        f_applyColVisibility(row)
        row += 1

        srTxt = (na(nearestSupport) ? "-" : str.tostring(nearestSupport, "#.####")) + " / " + (na(nearestResist) ? "-" : str.tostring(nearestResist, "#.####"))
        f_valueRow(row, "Nearest S / R", srTxt, srTxt)
        f_applyColVisibility(row)
        row += 1

        f_valueRow(row, "RSI / MACD hist", str.tostring(rsi, "#.##") + " / " + str.tostring(macdHist, "#.####"),
                                  str.tostring(rsi, "#.##") + " / " + str.tostring(macdHist, "#.####"))
        f_applyColVisibility(row)
        row += 1

    // Clear remaining unused rows
    if row < maxRows
        for r = row to maxRows - 1
            for c = 0 to 2
                f_setCell(r, c, "", color.new(color.black, 100), color.new(color.white, 100))
