//@version=6
indicator("Options Helper", overlay=true, max_labels_count=500)

//===================== INPUTS =====================
// General
tf              = input.timeframe("D", "Base TF for options suitability (recommended: D)")
spySymbol       = input.symbol("AMEX:SPY", "SPY symbol (for beta proxy)")
useLogReturns   = input.bool(true, "Use log returns for RV", inline="rv")
rvLen           = input.int(20, "RV lookback", minval=10, inline="rv")
ivLookback      = input.int(252, "IV proxy rank lookback (bars of selected TF)", minval=50)
betaLen         = input.int(60, "Beta lookback", minval=20)
iv1Mult         = input.float(0.8, "IV Proxy1 multiplier", step=0.05)

// Options planning inputs (manual because options-chain not accessible in Pine)
dte             = input.int(30, "DTE (days to expiration)", minval=1)
contractType    = input.string("Long Call/Put", "Planned contract type",
                   options=["Long Call/Put","Debit Spread","Credit Spread","Calendar/Diagonal"])

// Target comparison
useTargetPrice  = input.bool(false, "Use target price for EM comparison")
targetPriceIn   = input.float(0.0, "Target price (used when enabled)", step=0.01)
targetPrice     = useTargetPrice ? targetPriceIn : na
nearEMPct       = input.float(15.0, "Near-EM band (%)", step=1.0) // within ±15% of EM treated as "Near EM"

// Room-to-move
rangeN          = input.int(50, "HTF range lookback for room-to-move", minval=20)
pivL            = input.int(3, "Pivot left", minval=1)
pivR            = input.int(3, "Pivot right", minval=1)
roomATRMultLow  = input.float(1.0, "Room threshold Low (ATR multiples)", step=0.25)
roomATRMultHigh = input.float(2.0, "Room threshold High (ATR multiples)", step=0.25)

// ATR / Vol
atrLen          = input.int(14, "ATR length", minval=5)

// Catalyst (manual, because earnings feed is unreliable in Pine)
earningsDays    = input.int(-1, "Earnings in N days (manual). Use -1 if unknown", minval=-1)
majorEventDays  = input.int(-1, "Major event in N days (manual). Use -1 if unknown", minval=-1)

//===================== HELPERS =====================
f_pack3(a, b, c) => "M1: " + a + "\nM2: " + b + "\nM3: " + c

f_pos(p) =>
    switch p
        "Top Right" => position.top_right
        "Top Left" => position.top_left
        "Bottom Right" => position.bottom_right
        => position.bottom_left

// Percentile rank helper (0..1)
f_rank(x, len) =>
    lo = ta.lowest(x, len)
    hi = ta.highest(x, len)
    hi == lo ? na : (x - lo) / (hi - lo)

f_ret(useLog) =>
    c0 = close
    c1 = close[1]
    na(c0) or na(c1) or c1 == 0 ? na : (useLog ? math.log(c0 / c1) : (c0 - c1) / c1)

// Classification helpers
f_ivLevelFromRank(r) =>
    if na(r)
        "Unknown"
    else if r < 0.25
        "Low"
    else if r > 0.75
        "High"
    else
        "Mid"

f_ivVsRv(iv, rv) =>
    // Compare annualized percent vol (both in % terms)
    if na(iv) or na(rv)
        "Unknown"
    else if iv < rv * 0.9
        "IV < RV"
    else if iv > rv * 1.1
        "IV > RV"
    else
        "IV ~ RV"

f_trend3(x) =>
    // simple slope sign using linreg delta
    s = ta.linreg(x, 10, 0) - ta.linreg(x, 10, 1)
    na(s) ? "Unknown" : s > 0 ? "Rising" : s < 0 ? "Falling" : "Stable"

f_expectedMove(price, ivPct, dteDays) =>
    // EM ? price * (IVannual) * sqrt(DTE/365)
    na(price) or na(ivPct) ? na : price * (ivPct/100.0) * math.sqrt(dteDays/365.0)

f_emVsTarget(emAbs, price, target) =>
    if na(emAbs) or na(price) or na(target)
        "Unknown"
    else
        dist = math.abs(target - price)
        // "Near EM" if within +-nearEMPct% of EM
        if dist <= emAbs * (1.0 - nearEMPct / 100.0)
            "Inside EM"
        else if dist <= emAbs * (1.0 + nearEMPct / 100.0)
            "Near EM"
        else
            "Beyond EM"

f_roomToMove(price, dir, nextLevel, atr) =>
    // dir: "Bullish" => room to resistance, "Bearish" => room to support
    if na(nextLevel) or na(atr) or atr == 0
        "Unknown"
    else
        dist = math.abs(nextLevel - price)
        mult = dist / atr
        if mult >= roomATRMultHigh
            "Plenty of room"
        else if mult >= roomATRMultLow
            "Some room"
        else
            "Limited room"

f_catalystText(earnDays, eventDays) =>
    if earnDays == -1 and eventDays == -1
        "Unknown"
    else if earnDays >= 0 and earnDays <= 14
        "Earnings soon (<14 dni)"
    else if eventDays >= 0 and eventDays <= 14
        "Major event (<=14 dni)"
    else
        "No major catalyst"

f_ivCrushText(earnDays, eventDays) =>
    if earnDays >= 0 and earnDays <= 14
        "High"
    else if eventDays >= 0 and eventDays <= 14
        "Medium"
    else if earnDays == -1 and eventDays == -1
        "Unknown"
    else
        "Low"

f_roomTextFromDir(direction, price, resistanceLevel, supportLevel, atrValue) =>
    if direction == "Bullish"
        f_roomToMove(price, direction, resistanceLevel, atrValue)
    else if direction == "Bearish"
        f_roomToMove(price, direction, supportLevel, atrValue)
    else
        "Unknown"

f_dteBucketText(d) =>
    if d <= 7
        "0-7 DTE"
    else if d <= 21
        "8-21 DTE"
    else if d <= 45
        "22-45 DTE"
    else
        "45+ DTE"

//===================== SERIES (HTF) =====================
c = request.security(syminfo.tickerid, tf, close)
o = request.security(syminfo.tickerid, tf, open)
h = request.security(syminfo.tickerid, tf, high)
l = request.security(syminfo.tickerid, tf, low)

atr = request.security(syminfo.tickerid, tf, ta.atr(atrLen))

// Returns for RV
ret = request.security(syminfo.tickerid, tf, f_ret(useLogReturns))
rv = request.security(syminfo.tickerid, tf, ta.stdev(ret, rvLen) * math.sqrt(252.0) * 100.0) // annualized %

//===================== IV PROXY (3 METHODS) =====================
// M1: ATR% annualized proxy (very rough)
atrPct = (na(c) or c == 0 or na(atr)) ? na : (atr / c) * 100.0
ivProxy1 = na(atrPct) ? na : atrPct * math.sqrt(252.0) * iv1Mult // approximate annualization

// M2: Realized vol (RV) itself as proxy baseline
ivProxy2 = rv

// M3: SPY-based proxy: VIX not always available in Pine; use SPY RV * "beta-ish" sensitivity
spyC   = request.security(spySymbol, tf, close)
spyRet = request.security(spySymbol, tf, f_ret(useLogReturns))
spyRv  = request.security(spySymbol, tf, ta.stdev(spyRet, rvLen) * math.sqrt(252.0) * 100.0)

cov = ta.sma(ret * spyRet, betaLen) - (ta.sma(ret, betaLen) * ta.sma(spyRet, betaLen))
vspy = ta.variance(spyRet, betaLen)
betaEst = (na(cov) or na(vspy) or vspy == 0) ? na : cov / vspy
betaTxt = na(betaEst) ? "Unknown" : (betaEst >= 1.2 ? "High beta" : betaEst <= 0.8 ? "Defensive" : "Neutral")
betaSignTxt = na(betaEst) ? "Unknown" : (betaEst < 0 ? "Negative" : "Positive")

ivProxy3 = (na(spyRv) or na(betaEst)) ? na : spyRv * math.max(0.3, math.min(2.0, betaEst))

//===================== IV LEVEL / TREND / IV vs RV =====================
rank1 = f_rank(ivProxy1, ivLookback)
rank2 = f_rank(ivProxy2, ivLookback)
rank3 = f_rank(ivProxy3, ivLookback)

ivLevelM1 = f_ivLevelFromRank(rank1)
ivLevelM2 = f_ivLevelFromRank(rank2)
ivLevelM3 = f_ivLevelFromRank(rank3)

ivVsRvM1 = f_ivVsRv(ivProxy1, rv)
ivVsRvM2 = f_ivVsRv(ivProxy2, rv)
ivVsRvM3 = f_ivVsRv(ivProxy3, rv)

ivTrendM1 = f_trend3(ivProxy1)
ivTrendM2 = f_trend3(ivProxy2)
ivTrendM3 = f_trend3(ivProxy3)

//===================== EXPECTED MOVE vs TARGET =====================
em1 = f_expectedMove(c, ivProxy1, dte)
em2 = f_expectedMove(c, ivProxy2, dte)
em3 = f_expectedMove(c, ivProxy3, dte)

emVsTargetM1 = f_emVsTarget(em1, c, targetPrice)
emVsTargetM2 = f_emVsTarget(em2, c, targetPrice)
emVsTargetM3 = f_emVsTarget(em3, c, targetPrice)

//===================== CATALYST / IV CRUSH RISK (manual) =====================
catalystTxt = f_catalystText(earningsDays, majorEventDays)
ivCrushRisk = f_ivCrushText(earningsDays, majorEventDays)

//===================== SPREAD / OI / VOLUME ON OPTIONS (not available) =====================
spreadQuality = "---"
oiQuality = "---"

//===================== ROOM TO MOVE (HTF pivots / range) =====================
// We need a direction input to know which "room" matters.
// Use a simple price-vs-EMA20 proxy direction (you can switch later)
ema20 = request.security(syminfo.tickerid, tf, ta.ema(close, 20))
dir = na(c) or na(ema20) ? "Unknown" : c >= ema20 ? "Bullish" : "Bearish"

// Next pivot-based level
ph = request.security(syminfo.tickerid, tf, ta.pivothigh(high, pivL, pivR))
pl = request.security(syminfo.tickerid, tf, ta.pivotlow(low, pivL, pivR))
lastPH = ta.valuewhen(not na(ph), ph, 0)
lastPL = ta.valuewhen(not na(pl), pl, 0)

// Fallback range edges
rangeHi = request.security(syminfo.tickerid, tf, ta.highest(high, rangeN))
rangeLo = request.security(syminfo.tickerid, tf, ta.lowest(low, rangeN))

rawRes = not na(lastPH) ? lastPH : rangeHi
rawSup = not na(lastPL) ? lastPL : rangeLo
nextRes = (not na(rawRes) and rawRes > c) ? rawRes : rangeHi
nextSup = (not na(rawSup) and rawSup < c) ? rawSup : rangeLo

roomTxt = f_roomTextFromDir(dir, c, nextRes, nextSup, atr)
catalystInputStatus = "earningsDays=" + str.tostring(earningsDays) + " | eventDays=" + str.tostring(majorEventDays)

//===================== CONTRACT TYPE + DTE OUTPUT =====================
dteTxt = f_dteBucketText(dte)

//===================== TABLE =====================
showDash = input.bool(true, "Show dashboard")
pos      = input.string("Top Right", "Table position", options=["Top Right","Top Left","Bottom Right","Bottom Left"])
vis      = input.int(25, "Table transparency (0-90)", minval=0, maxval=90)

bg   = color.new(color.black, vis)
kbg  = color.new(color.silver, vis)
txt  = color.new(color.white, vis)

var table t = table.new(f_pos(pos), 2, 16, border_width=1, frame_color=color.new(color.white, vis))

f_row(r, k, v) =>
    table.cell(t, 0, r, k, bgcolor=kbg, text_color=txt, text_halign=text.align_left)
    table.cell(t, 1, r, v, bgcolor=bg,  text_color=txt, text_halign=text.align_left)

if barstate.islast
    if showDash
        f_row(0,  "Contract type", contractType)
        f_row(1,  "DTE bucket", dteTxt)
        f_row(2,  "IV Level", f_pack3(ivLevelM1, ivLevelM2, ivLevelM3))
        f_row(3,  "IV vs RV", f_pack3(ivVsRvM1, ivVsRvM2, ivVsRvM3))
        f_row(4,  "IV Trend", f_pack3(ivTrendM1, ivTrendM2, ivTrendM3))
        f_row(5,  "RV (ann %) ", na(rv) ? "---" : str.tostring(rv, "#.##") + "%")
        f_row(6,  "IV Proxy (ann %)", "M1 ATR%: " + (na(ivProxy1) ? "---" : str.tostring(ivProxy1, "#.##") + "%") +
                          "\nM2 RV: " + (na(ivProxy2) ? "---" : str.tostring(ivProxy2, "#.##") + "%") +
                          "\nM3 SPY*beta: " + (na(ivProxy3) ? "---" : str.tostring(ivProxy3, "#.##") + "%"))
        f_row(7,  "Beta (proxy)", betaTxt)
        f_row(8,  "Beta sign", betaSignTxt)
        f_row(9,  "Expected Move vs Target (proxy)", f_pack3(emVsTargetM1, emVsTargetM2, emVsTargetM3))
        f_row(10, "Room to move (ATR proxy)", roomTxt)
        f_row(11, "Catalyst proximity", catalystTxt)
        f_row(12, "IV crush risk", ivCrushRisk)
        f_row(13, "Spread quality (options)", spreadQuality)
        f_row(14, "OI/Volume (options)", oiQuality)
        f_row(15, "Catalyst input status", catalystInputStatus)
    else
        table.clear(t, 0, 0, 1, 15)

