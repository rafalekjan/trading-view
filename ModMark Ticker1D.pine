//@version=6
indicator("ModMark Stock 1D", overlay=true, max_labels_count=50)

//â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”
// Inputs
//â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”
showTable   = input.bool(true, "Show table (visibility toggle)", group="Table")
showText    = input.bool(true, "Show table text", group="Table")
showNumbers = input.bool(false, "Show numbers (debug)", group="Table")
visibilityPct = input.int(100, "Visibility 0-100", minval=0, maxval=100, group="Table")
fontSizeOpt = input.string("Tiny", "Font size", options=["Tiny","Small","Normal"], group="Table")
tablePos    = input.string("Top Right", "Table position", options=["Top Right","Top Left","Bottom Right","Bottom Left"], group="Table")
tableMode   = input.string("Full", "Table mode", options=["Summary","Compact","Full"], group="Table")
showFrame   = input.bool(true, "Show table frame", group="Table")
showBorders = input.bool(true, "Show cell borders", group="Table")
frameWidthInp = input.int(1, "Frame width", minval=0, maxval=5, group="Table")
borderWidthInp = input.int(1, "Cell border width", minval=0, maxval=5, group="Table")
frameColorInp = input.color(color.new(color.white, 0), "Frame color", group="Table")
borderColorInp = input.color(color.new(color.white, 0), "Cell border color", group="Table")
summaryCaseOpt = input.string("Original", "Summary text case", options=["Original","UPPER","lower"], group="Table")
summaryGoodInp = input.color(color.new(color.green, 0), "Summary GOOD bg", group="Table")
summaryWarnInp = input.color(color.new(color.orange, 0), "Summary WARN bg", group="Table")
summaryBadInp  = input.color(color.new(color.red, 0), "Summary BAD bg", group="Table")

// Structure / pivots
pivotLR     = input.int(3, "Swing pivot L/R", minval=1, maxval=20, group="Structure")
pivotTolAtr = input.float(0.15, "Swing tolerance (ATR, wick filter)", minval=0.0, step=0.05, group="Structure")
majorPivotLR= input.int(10, "Major pivot L/R (key levels)", minval=3, maxval=50, group="Structure")
lookKeyLvls = input.int(252, "Key levels lookback (e.g., 52w)", minval=50, maxval=1000, group="Structure")

// MAs
slopeLen    = input.int(10, "MA slope lookback", minval=2, maxval=100, group="Moving Averages")
flatSlopePct= input.float(0.08, "MA flat slope threshold (%)", minval=0.0, step=0.01, group="Moving Averages")

// Volatility / ATR
atrLen          = input.int(14, "ATR length", minval=2, group="Volatility")
atrPctHigh      = input.float(3.0, "ATR% high", minval=0.1, step=0.1, group="Volatility")
atrPctExtreme   = input.float(5.0, "ATR% extreme", minval=0.1, step=0.1, group="Volatility")
atrJumpMult     = input.float(1.6, "ATR jump multiplier (unstable)", minval=1.0, step=0.1, group="Volatility")

// Location / Extended
nearLevelAtr    = input.float(1.0, "Near structure if within ATR *", minval=0.1, step=0.1, group="Location")
extATR_20       = input.float(2.0, "Extended if |price-20EMA| â‰Ą ATR *", minval=0.5, step=0.1, group="Location")
extATR_50       = input.float(2.5, "Extended if |price-50SMA| â‰Ą ATR *", minval=0.5, step=0.1, group="Location")

// Bench / Relative Strength
benchTicker     = input.string("SPY", "Benchmark ticker (RS)", group="Relative Strength")
rsLen           = input.int(20, "RS lookback bars", minval=5, maxval=200, group="Relative Strength")
rsPullbackBars  = input.int(5, "Benchmark pullback bars", minval=2, maxval=30, group="Relative Strength")

// RSI / MACD
rsiLen          = input.int(14, "RSI length", minval=2, group="Momentum")
rsiPivotLR      = input.int(3, "RSI pivot L/R", minval=1, maxval=20, group="Momentum")
macdFast        = input.int(12, "MACD fast", minval=1, group="Momentum")
macdSlow        = input.int(26, "MACD slow", minval=2, group="Momentum")
macdSig         = input.int(9,  "MACD signal", minval=1, group="Momentum")
macdFlipLookback= input.int(60, "MACD flip lookback", minval=10, maxval=300, group="Momentum")
macdFlipWarn    = input.int(10, "MACD flips warn if â‰Ą", minval=1, maxval=50, group="Momentum")

// Volume
volMaLen        = input.int(20, "Volume MA length", minval=5, group="Volume")
breakVolMult    = input.float(1.2, "Breakout volume confirms if â‰Ą volMA *", minval=0.5, step=0.1, group="Volume")

// Clean vs Sloppy behavior
wickWarnPct     = input.float(55, "Sloppy if wick% â‰Ą", minval=0, maxval=100, step=1, group="Behavior")
sloppyLookback  = input.int(30, "Sloppy lookback", minval=10, maxval=200, group="Behavior")
sloppyWarnCount = input.int(10, "Sloppy if count â‰Ą", minval=1, maxval=100, group="Behavior")

// Risk / Reward
maxStopAtr      = input.float(2.0, "Risk definable if stop distance â‰¤ ATR *", minval=0.5, step=0.1, group="Risk/Reward")
minRR_Accept    = input.float(2.0, "RR acceptable â‰Ą", minval=1.0, step=0.1, group="Risk/Reward")
minRR_Strong    = input.float(3.0, "RR strong â‰Ą", minval=1.0, step=0.1, group="Risk/Reward")

// Overnight (gaps)
gapLookback     = input.int(60, "Gap lookback", minval=20, maxval=400, group="Overnight")
gapPctWarn      = input.float(1.0, "Gap% warning if >", minval=0.1, step=0.1, group="Overnight")
gapCountWarn    = input.int(6, "Overnight unfriendly if gap-count â‰Ą", minval=1, maxval=50, group="Overnight")

//â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”
// Eligibility: ONLY non-SPY/QQQ on 1D
//â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”
is1D      = timeframe.period == "D" or timeframe.period == "1D" or (timeframe.isdaily and timeframe.multiplier == 1)
tkr       = syminfo.ticker
isSpyQqq  = (tkr == "SPY") or (tkr == "QQQ")
ctxEligible = is1D and (not isSpyQqq)

//â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”
// Helpers
//â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”
pos = tablePos == "Top Left" ? position.top_left : tablePos == "Bottom Left" ? position.bottom_left : tablePos == "Bottom Right" ? position.bottom_right : position.top_right

slopePct(src, len) => nz(100.0 * (src - src[len]) / src[len])
isFlat(v) => math.abs(v) < flatSlopePct

//â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”
// Backend calculations
//â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”
// MAs
ema20  = ta.ema(close, 20)
sma50  = ta.sma(close, 50)
sma200 = ta.sma(close, 200)

ema20Slope  = slopePct(ema20, slopeLen)
sma50Slope  = slopePct(sma50, slopeLen)
sma200Slope = slopePct(sma200, slopeLen)

ema20Flat = isFlat(ema20Slope)
sma50Flat = isFlat(sma50Slope)
sma200Flat= isFlat(sma200Slope)

// ATR
atr    = ta.atr(atrLen)
atrPct = 100.0 * atr / close
atrMA  = ta.sma(atr, 20)
atrJump= (not na(atrMA) and atrMA > 0) ? (atr / atrMA) : na

volTxt = atrPct >= atrPctExtreme ? "EXTREME volatility" : atrPct >= atrPctHigh ? "HIGH volatility" : "Controlled volatility"

unstableTxt = na(atrJump) ? "ATR stability N/A" : atrJump >= atrJumpMult ? "ATR unstable (spiking)" : "ATR stable"

// Swings (structure)
ph = ta.pivothigh(high, pivotLR, pivotLR)
pl = ta.pivotlow(low,  pivotLR, pivotLR)

var float lastPH = na
var float prevPH = na
var float lastPL = na
var float prevPL = na

if not na(ph)
    prevPH := lastPH
    lastPH := ph
if not na(pl)
    prevPL := lastPL
    lastPL := pl

haveSwings = not na(lastPH) and not na(prevPH) and not na(lastPL) and not na(prevPL)
pivotTol = atr * pivotTolAtr

hh = haveSwings and (lastPH > prevPH + pivotTol)
lh = haveSwings and (lastPH < prevPH - pivotTol)
hl = haveSwings and (lastPL > prevPL + pivotTol)
ll = haveSwings and (lastPL < prevPL - pivotTol)
hEq = haveSwings and not hh and not lh
lEq = haveSwings and not hl and not ll
bullStruct = haveSwings and hh and (hl or lEq)
bearStruct = haveSwings and ll and (lh or hEq)

structureTxt = not haveSwings ? "Structure N/A (waiting for swings)" : bullStruct ? "Bull structure (HH+HL)" : bearStruct ? "Bear structure (LH+LL)" : "Overlapping / unclear (chop)"

// Direction clarity (non-negotiable)
dirTxt = not haveSwings ? "Direction N/A" : bullStruct ? "Direction = BULL" : bearStruct ? "Direction = BEAR" : "Direction unclear (no-trade bias)"

// Structure integrity (is trend thesis still valid?)
// Bull thesis invalid if break last swing low; bear thesis invalid if break last swing high.
structIntact = bullStruct ? (close > lastPL) : bearStruct ? (close < lastPH) : false

integrityTxt = not haveSwings ? "Integrity N/A" : structIntact ? "Structure intact" : "Structure broken (thesis invalid)"

// Key levels (major + 52w)
mph = ta.pivothigh(high, majorPivotLR, majorPivotLR)
mpl = ta.pivotlow(low,  majorPivotLR, majorPivotLR)

var float lastMajorH = na
var float lastMajorL = na
if not na(mph)
    lastMajorH := mph
if not na(mpl)
    lastMajorL := mpl

hi52 = ta.highest(high, lookKeyLvls)
lo52 = ta.lowest(low,  lookKeyLvls)

nearestLevelDist = na(atr) or atr == 0 ? na : math.min(math.min(math.abs(close - nz(lastPH, close)), math.abs(close - nz(lastPL, close))), math.min(math.abs(close - nz(lastMajorH, close)), math.abs(close - nz(lastMajorL, close)))) / atr

nearStructure = not na(nearestLevelDist) and nearestLevelDist <= nearLevelAtr

locationTxt = not haveSwings ? "Location N/A" : nearStructure ? "Near structure / key level" : "Middle of nowhere (far from structure)"

// MA regime / roles
bias200Txt = na(sma200) ? "200MA N/A" : close > sma200 ? "Above 200MA (long bias)" : close < sma200 ? "Below 200MA (short bias)" : "At 200MA (caution)"

maShapeTxt = (ema20Flat and sma50Flat) ? "20/50 flat (range/chop risk)" : (ema20Slope > 0 and sma50Slope > 0) ? "20/50 sloped up" : (ema20Slope < 0 and sma50Slope < 0) ? "20/50 sloped down" : "20/50 mixed (transition)"

// â€śRespect 20EMAâ€ť in pullback (simple deterministic check)
pullbackRespect20 = not na(ema20) and (low <= ema20) and (close >= ema20) // tagged EMA and reclaimed same bar
pullbackTxt = pullbackRespect20 ? "Pullback respects 20EMA (tag+reclaim)" : "No clear 20EMA respect event"

// Extended
dist20ATR = (atr > 0) ? math.abs(close - ema20) / atr : na
dist50ATR = (atr > 0) ? math.abs(close - sma50) / atr : na

extended20 = not na(dist20ATR) and dist20ATR >= extATR_20
extended50 = not na(dist50ATR) and dist50ATR >= extATR_50

extendedTxt = (extended20 and extended50) ? "EXTENDED vs 20EMA & 50MA" : extended20 ? "Extended vs 20EMA" : extended50 ? "Extended vs 50MA" : "Not extended (ok)"

// RSI (momentum, swings, recover)
rsi = ta.rsi(close, rsiLen)

rsiPH = ta.pivothigh(rsi, rsiPivotLR, rsiPivotLR)
rsiPL = ta.pivotlow(rsi,  rsiPivotLR, rsiPivotLR)

var float lastRsiPH = na
var float prevRsiPH = na
var float lastRsiPL = na
var float prevRsiPL = na

if not na(rsiPH)
    prevRsiPH := lastRsiPH
    lastRsiPH := rsiPH
if not na(rsiPL)
    prevRsiPL := lastRsiPL
    lastRsiPL := rsiPL

haveRsiSwings = not na(lastRsiPH) and not na(prevRsiPH) and not na(lastRsiPL) and not na(prevRsiPL)

rsiLevelTxt = rsi > 50 ? "RSI > 50 (bull regime)" : rsi < 50 ? "RSI < 50 (bear regime)" : "RSI ~ 50 (neutral)"

rsiSwingsTxt = not haveRsiSwings ? "RSI swings N/A" : (lastRsiPL > prevRsiPL and lastRsiPH > prevRsiPH) ? "RSI HH+HL (supports bull)" : (lastRsiPL < prevRsiPL and lastRsiPH < prevRsiPH) ? "RSI LH+LL (supports bear)" : "RSI swings mixed (caution)"

// RSI â€śrecover after pullbackâ€ť (deterministic heuristic)
rsiRecover = (rsi[3] < 50 and rsi > 50) or (rsi[3] < 55 and rsi > 55)
rsiRecoverTxt = rsiRecover ? "RSI recovered quickly (pullback digestion)" : "No strong RSI recover flag"

// Divergence warning (heads-up only)
bullDiv = haveSwings and haveRsiSwings and (lastPL < prevPL) and (lastRsiPL > prevRsiPL)
bearDiv = haveSwings and haveRsiSwings and (lastPH > prevPH) and (lastRsiPH < prevRsiPH)
divTxt = not (haveSwings and haveRsiSwings) ? "Divergence N/A" : bullDiv ? "Bull divergence warning" : bearDiv ? "Bear divergence warning" : "No divergence warning"

// RSI vs structure conflict
rsiConflict = (bullStruct and rsi < 50) or (bearStruct and rsi > 50)
rsiConflictTxt = rsiConflict ? "RSI contradicts structure â†’ caution" : "RSI aligned (no conflict flag)"

// MACD momentum + flipiness (chop)
[macdLine, macdSignal, macdHist] = ta.macd(close, macdFast, macdSlow, macdSig)
macdTxt = macdLine > macdSignal and macdHist > 0 ? "MACD bullish momentum" : macdLine < macdSignal and macdHist < 0 ? "MACD bearish momentum" : "MACD mixed/flat"

macdFlip = ta.cross(macdLine, macdSignal)
macdFlipCount = math.sum(macdFlip ? 1.0 : 0.0, macdFlipLookback)
macdFlipTxt = macdFlipCount >= macdFlipWarn ? "MACD flips often (chop risk)" : "MACD flips not elevated"

// Volume confirmation
volMA = ta.sma(volume, volMaLen)
priceUp = close > close[1]
volUp   = volume > volMA

volumeTxt = priceUp and volUp ? "Rising price + rising volume" : priceUp and not volUp ? "Rising price + weak volume (caution)" : (not priceUp) and volUp ? "Down day + strong volume (pressure)" : "Volume neutral"

// Breakout volume (vs last swing)
breakAbove = haveSwings and close > lastPH
breakBelow = haveSwings and close < lastPL

breakVolTxt = not haveSwings ? "Breakout N/A" : breakAbove ? (volume >= volMA * breakVolMult ? "Breakout up + volume confirms" : "Breakout up BUT weak volume") : breakBelow ? (volume >= volMA * breakVolMult ? "Breakdown + volume confirms" : "Breakdown BUT weak volume") : "No active swing breakout"

// Pullback volume quality (volume dries up on pullback = healthier trend)
pullbackBarBull = bullStruct and close < close[1] and close >= ema20
pullbackBarBear = bearStruct and close > close[1] and close <= ema20
pullbackBar = pullbackBarBull or pullbackBarBear
pullbackVolLookback = 10
pullbackBarsCount = math.sum(pullbackBar ? 1.0 : 0.0, pullbackVolLookback)
pullbackLowVolCount = math.sum((pullbackBar and volume < volMA) ? 1.0 : 0.0, pullbackVolLookback)
pullbackVolRatio = pullbackBarsCount > 0 ? pullbackLowVolCount / pullbackBarsCount : 0.0
pullbackVolHealthy = pullbackBarsCount >= 2 and pullbackVolRatio >= 0.6
pullbackVolTxt = pullbackBarsCount == 0 ? "Pullback volume N/A" : pullbackVolHealthy ? "Pullback volume healthy (drying up)" : "Pullback volume not healthy"

// Clean vs sloppy behavior (wickiness + outside bars)
rng = high - low
body = math.abs(close - open)
wickPct = (rng > 0) ? (100.0 * (rng - body) / rng) : 0.0
outsideBar = high > high[1] and low < low[1]
sloppyCandle = wickPct >= wickWarnPct

sloppyCount = math.sum(sloppyCandle ? 1.0 : 0.0, sloppyLookback)
outsideCount= math.sum(outsideBar ? 1.0 : 0.0, sloppyLookback)

behaviorTxt = (sloppyCount >= sloppyWarnCount or outsideCount >= math.ceil(sloppyWarnCount/2)) ? "Sloppy / erratic behavior" : "Clean/controlled behavior"

// Consolidation health (range compression)
consLen = 20
consRange = ta.highest(high, consLen) - ta.lowest(low, consLen)
consAtr = (atr > 0) ? consRange / atr : na
isConsolidating = not na(consAtr) and consAtr <= 6.0
consTxt = isConsolidating ? "Consolidation present (range compressed)" : "No clear consolidation flag"

// Overnight friendliness (gaps)
gapPct = 100.0 * math.abs(open - close[1]) / close[1]
gapEvent = gapPct > gapPctWarn
gapCount = math.sum(gapEvent ? 1.0 : 0.0, gapLookback)

overnightTxt = gapCount >= gapCountWarn ? "Overnight unfriendly (frequent gaps)" : "Overnight acceptable (gaps not elevated)"

// Relative strength vs benchmark (ratio trend + during benchmark pullback)
benchClose = request.security(benchTicker, "D", close, barmerge.gaps_off, barmerge.lookahead_off)
rsRatio = close / benchClose

rsSlope = slopePct(rsRatio, rsLen)
benchPullback = benchClose < benchClose[rsPullbackBars]
stockHeld = close >= close[rsPullbackBars] // simple â€śholdsâ€ť during benchmark pullback

rsTxt = na(benchClose) ? "RS N/A (benchmark unavailable)" : (rsSlope > 0 and benchPullback and stockHeld) ? "Relative strength vs benchmark (holding during pullback)" : (rsSlope > 0) ? "Relative strength improving" : (rsSlope < 0) ? "Relative weakness (underperforming)" : "RS flat / market-like (quality down)"

// Risk definition (invalidation level) + reward target + RR (backend only)
invalLong = lastPL
invalShort= lastPH

riskLong = (atr > 0 and not na(invalLong))  ? (close - invalLong) : na
riskShort= (atr > 0 and not na(invalShort)) ? (invalShort - close) : na

riskDefLong  = not na(riskLong)  and riskLong > 0 and (riskLong/atr <= maxStopAtr)
riskDefShort = not na(riskShort) and riskShort > 0 and (riskShort/atr <= maxStopAtr)

riskDefTxt = not haveSwings ? "Risk definition N/A" : bullStruct ? (riskDefLong ? "Risk definable (invalidation at last swing low)" : "Risk NOT clean (stop too wide/unclear)") : bearStruct ? (riskDefShort ? "Risk definable (invalidation at last swing high)" : "Risk NOT clean (stop too wide/unclear)") : "Risk definition weak (no clear direction)"

// Reward target: next level (52w or major pivot) in trend direction
longLvl1 = (not na(lastPH) and lastPH > close) ? lastPH : na
longLvl2 = (not na(lastMajorH) and lastMajorH > close) ? lastMajorH : na
longLvl3 = hi52 > close ? hi52 : na
longTmp = na(longLvl1) ? longLvl2 : na(longLvl2) ? longLvl1 : math.min(longLvl1, longLvl2)
targetLong = na(longTmp) ? longLvl3 : na(longLvl3) ? longTmp : math.min(longTmp, longLvl3)

shortLvl1 = (not na(lastPL) and lastPL < close) ? lastPL : na
shortLvl2 = (not na(lastMajorL) and lastMajorL < close) ? lastMajorL : na
shortLvl3 = lo52 < close ? lo52 : na
shortTmp = na(shortLvl1) ? shortLvl2 : na(shortLvl2) ? shortLvl1 : math.max(shortLvl1, shortLvl2)
targetShort= na(shortTmp) ? shortLvl3 : na(shortLvl3) ? shortTmp : math.max(shortTmp, shortLvl3)

rewardLong  = (not na(targetLong))  ? (targetLong - close) : na
rewardShort = (not na(targetShort)) ? (close - targetShort) : na

rrLong  = (not na(riskLong)  and riskLong  > 0 and not na(rewardLong))  ? (rewardLong / riskLong) : na
rrShort = (not na(riskShort) and riskShort > 0 and not na(rewardShort)) ? (rewardShort / riskShort) : na

rrTxt = not haveSwings ? "Reward N/A" : bullStruct ? (na(rrLong) ? "RR N/A" : rrLong >= minRR_Strong ? "Reward strong (3:1+)" : rrLong >= minRR_Accept ? "Reward acceptable (2:1+)" : "Reward weak (<2:1)") : bearStruct ? (na(rrShort) ? "RR N/A" : rrShort >= minRR_Strong ? "Reward strong (3:1+)" : rrShort >= minRR_Accept ? "Reward acceptable (2:1+)" : "Reward weak (<2:1)") : "Reward unclear (no direction)"

// Final â€śtrade qualityâ€ť label (text-only)
volHardStop = atrPct >= atrPctExtreme or (not na(atrJump) and atrJump >= atrJumpMult)
noDir = (not haveSwings) or (structureTxt == "Overlapping / unclear (chop)")
badLocation = not nearStructure
badExtended = extended20 or extended50
badMomentum = rsiConflict or (macdFlipCount >= macdFlipWarn)
badOvernight = gapCount >= gapCountWarn

doNothing = noDir or volHardStop or badOvernight or (badLocation and badExtended)

qualityTxt = doNothing ? "DO NOTHING (cash valid)" : (not structIntact) ? "C/D (structure broken)" : (badExtended or badLocation) ? "B/C (location/extended caution)" : (badMomentum) ? "B/C (momentum caution)" : "A/B (supportive daily context)"

riskDefOk = (bullStruct and riskDefLong) or (bearStruct and riskDefShort)
rrWeak = (bullStruct and (na(rrLong) or rrLong < minRR_Accept)) or (bearStruct and (na(rrShort) or rrShort < minRR_Accept))

hardNoDir = noDir
hardStruct = haveSwings and not structIntact
hardVol = volHardStop
hardOvernight = badOvernight
hardStopActive = hardNoDir or hardStruct or hardVol or hardOvernight

warnChop = (structureTxt == "Overlapping / unclear (chop)") or (ema20Flat and sma50Flat) or (macdFlipCount >= macdFlipWarn)
warnLocation = badLocation
warnExtended = badExtended
warnMomentum = badMomentum
warnRiskDef = not riskDefOk
warnRR = rrWeak
warnUnstable = not na(atrJump) and atrJump >= atrJumpMult
warnWeakVolume = (bullStruct and priceUp and not volUp) or (bearStruct and (not priceUp) and not volUp)
warnPullback = (bullStruct and not pullbackVolHealthy) or (bearStruct and not pullbackVolHealthy)
warnChaos = (sloppyCount >= sloppyWarnCount or outsideCount >= math.ceil(sloppyWarnCount / 2))

// Score model aligned with SPY 1D: subscore buckets A-E summed to 0..100.
isTrendUp = bullStruct
isTrendDown = bearStruct
trendAlignedMAs = (isTrendUp and ema20Slope > 0 and sma50Slope > 0) or (isTrendDown and ema20Slope < 0 and sma50Slope < 0)
scoreA = ((isTrendUp or isTrendDown) ? 15.0 : 0.0) +
     (trendAlignedMAs ? 10.0 : 0.0) +
     ((structIntact and not warnChop) ? 10.0 : structIntact ? 5.0 : 0.0) -
     (warnChop ? 15.0 : 0.0) -
     (badLocation ? 8.0 : 0.0)
scoreA := math.max(0.0, math.min(35.0, scoreA))

rsiStructBull = haveRsiSwings and lastRsiPL > prevRsiPL
rsiStructBear = haveRsiSwings and lastRsiPH < prevRsiPH
rsiDirOk = (isTrendUp and rsi > 50) or (isTrendDown and rsi < 50)
rsiStructOk = (isTrendUp and (rsiStructBull or rsiRecover)) or (isTrendDown and (rsiStructBear or rsiRecover))
macdDirOk = (isTrendUp and macdLine > macdSignal and macdHist > 0) or (isTrendDown and macdLine < macdSignal and macdHist < 0)
scoreB = (rsiDirOk ? 8.0 : 0.0) + (rsiStructOk ? 6.0 : 0.0) + (macdDirOk ? 6.0 : 0.0) - ((macdFlipCount >= macdFlipWarn) ? 6.0 : 0.0)
scoreB := math.max(0.0, math.min(20.0, scoreB))

volTrendOk = (isTrendUp and priceUp and volUp) or (isTrendDown and (not priceUp) and volUp)
breakoutVolPenalty = (breakAbove and volume < volMA * breakVolMult) or (breakBelow and volume < volMA * breakVolMult)
breakoutVolOk = (not breakAbove and not breakBelow) or (breakAbove and volume >= volMA * breakVolMult) or (breakBelow and volume >= volMA * breakVolMult)
scoreC = (volTrendOk ? 5.0 : 0.0) + (breakoutVolOk ? 5.0 : 0.0) - (breakoutVolPenalty ? 5.0 : 0.0)
scoreC := math.max(0.0, math.min(10.0, scoreC))

isVolatile = atrPct >= atrPctHigh
scoreD = (atrPct < atrPctHigh ? 10.0 : atrPct < atrPctExtreme ? 4.0 : 0.0) +
     ((not hardOvernight and not warnUnstable) ? 10.0 : not hardOvernight ? 4.0 : 0.0) -
     ((isVolatile and atrPct < atrPctExtreme) ? 8.0 : 0.0) -
     ((hardVol or hardOvernight) ? 15.0 : 0.0)
scoreD := math.max(0.0, math.min(20.0, scoreD))

scoreE = (pullbackVolHealthy ? 8.0 : 0.0) +
     ((not warnChaos and not warnPullback) ? 7.0 : (not warnChaos or not warnPullback) ? 3.0 : 0.0) -
     ((warnChaos or warnPullback) ? 10.0 : 0.0)
scoreE := math.max(0.0, math.min(15.0, scoreE))

overallScore = math.max(0.0, math.min(100.0, scoreA + scoreB + scoreC + scoreD + scoreE))

overallRank = hardStopActive ? 1 : overallScore >= 80 ? 4 : overallScore >= 60 ? 3 : overallScore >= 40 ? 2 : 1
overallTxt = overallRank == 4 ? "A TRADEABLE" : overallRank == 3 ? "B SELECTIVE" : overallRank == 2 ? "C DEFENSIVE" : "D NO-TRADE"
overallDisplayTxt = showNumbers ? overallTxt + " (" + str.tostring(overallScore, "#.##") + "/100)" : overallTxt

riskModeTxt = overallRank == 4 ? "NORMAL" : overallRank == 3 ? "REDUCED" : "DEFENSIVE"
goNoGo = not hardStopActive and overallRank >= 3
canProceed4H = not hardStopActive and overallRank >= 3
decisionTxt = goNoGo ? "GO" : "NO-GO"
proceedTxt = not canProceed4H ? "NO (wait for unlock)" : overallRank == 4 ? "YES" : "YES (reduced/selective)"
riskPlanTxt = riskModeTxt == "NORMAL" ? "FULL" : riskModeTxt == "REDUCED" ? "HALF" : "NO TRADE"
riskPlanSev = riskPlanTxt == "FULL" ? 2 : riskPlanTxt == "HALF" ? 1 : 0
riskModePlanTxt = riskModeTxt + " / " + riskPlanTxt

topBlockerTxt =
     hardVol ? "Volatility EXTREME" :
     hardOvernight ? "Overnight risk elevated" :
     warnChop ? "CHOP conditions" :
     hardNoDir ? "Structure unclear / no trend" :
     warnMomentum ? "Momentum conflict" :
     (warnChaos or warnPullback) ? "Chaos high / pullbacks not controlled" :
     warnExtended ? "Price extended" :
     "None"

secondaryBlockerTxt =
     topBlockerTxt != "Overnight risk elevated" and hardOvernight ? "Overnight risk elevated" :
     topBlockerTxt != "CHOP conditions" and warnChop ? "CHOP conditions" :
     topBlockerTxt != "Structure unclear / no trend" and hardNoDir ? "Structure unclear / no trend" :
     topBlockerTxt != "Momentum conflict" and warnMomentum ? "Momentum conflict" :
     topBlockerTxt != "Chaos high / pullbacks not controlled" and (warnChaos or warnPullback) ? "Chaos high / pullbacks not controlled" :
     topBlockerTxt != "Price extended" and warnExtended ? "Price extended" :
     "None"

blockersTxt = topBlockerTxt == "None" ? "None" : secondaryBlockerTxt == "None" ? topBlockerTxt : topBlockerTxt + " | " + secondaryBlockerTxt

warning1Txt =
     warnMomentum ? "Momentum conflict" :
     (warnChaos or warnPullback) ? "Pullback/chaos caution" :
     warnExtended ? "Price extended" :
     warnLocation ? "Far from structure" :
     warnRiskDef ? "Risk definition weak" :
     warnRR ? "Reward/RR weak" :
     warnUnstable ? "ATR unstable" :
     warnWeakVolume ? "Weak volume confirmation" :
     "None"

warning2Txt =
     warning1Txt != "Pullback/chaos caution" and (warnChaos or warnPullback) ? "Pullback/chaos caution" :
     warning1Txt != "Momentum conflict" and warnMomentum ? "Momentum conflict" :
     warning1Txt != "Price extended" and warnExtended ? "Price extended" :
     warning1Txt != "Far from structure" and warnLocation ? "Far from structure" :
     warning1Txt != "Risk definition weak" and warnRiskDef ? "Risk definition weak" :
     warning1Txt != "Reward/RR weak" and warnRR ? "Reward/RR weak" :
     warning1Txt != "ATR unstable" and warnUnstable ? "ATR unstable" :
     warning1Txt != "Weak volume confirmation" and warnWeakVolume ? "Weak volume confirmation" :
     "None"

warningsTxt = warning1Txt == "None" ? "None" : warning2Txt == "None" ? warning1Txt : warning1Txt + " | " + warning2Txt

waitForTxt =
     topBlockerTxt == "Volatility EXTREME" ? "Wait: ATR/volatility cools down" :
     topBlockerTxt == "Overnight risk elevated" ? "Wait: fewer gaps and wide-range days normalize" :
     topBlockerTxt == "CHOP conditions" ? (close > sma200 ? "Wait: MA slope improves and follow-through appears" : "Wait: reclaim/lose 200MA and move away from zone") :
     topBlockerTxt == "Structure unclear / no trend" ? "Wait: clear HH/HL or LH/LL structure" :
     topBlockerTxt == "Momentum conflict" ? "Wait: RSI and MACD align with structure" :
     topBlockerTxt == "Chaos high / pullbacks not controlled" ? "Wait: cleaner candles and controlled pullbacks" :
     topBlockerTxt == "Price extended" ? "Wait: pullback toward 20EMA/50SMA or base" :
     "No unlock condition needed"

rrValue = bullStruct ? rrLong : bearStruct ? rrShort : na
rrDisplayTxt = showNumbers and not na(rrValue) ? rrTxt + " (" + str.tostring(rrValue, "#.##") + "x)" : rrTxt

decisionSev = goNoGo ? 2 : 0
overallSev = overallRank == 4 ? 2 : overallRank == 3 ? 1 : 0
riskModeSev = riskModeTxt == "NORMAL" ? 2 : riskModeTxt == "REDUCED" ? 1 : 0
proceedSev = not goNoGo ? 0 : riskModeTxt == "NORMAL" ? 2 : 1
riskModePlanSev = math.min(riskModeSev, riskPlanSev)
blockersSev = topBlockerTxt == "None" ? 2 : 0
warningsSev = warning1Txt == "None" ? 2 : 1
waitForSev = topBlockerTxt == "None" and warning1Txt == "None" ? 2 : 1
qualitySev = str.contains(qualityTxt, "A/B") ? 2 : str.contains(qualityTxt, "B/C") ? 1 : 0
overallQualitySev = math.min(overallSev, qualitySev)
overallQualityTxt = overallDisplayTxt + " | " + qualityTxt
nextStepSev = not canProceed4H ? 0 : overallRank == 4 ? 2 : 1
volSev = hardVol ? 0 : atrPct >= atrPctHigh ? 1 : 2
overnightSev = hardOvernight ? 0 : gapCount >= math.max(1, gapCountWarn - 2) ? 1 : 2
riskDefSev = not haveSwings ? 1 : riskDefOk ? 2 : 0
rrSev = not haveSwings ? 1 : warnRR ? 0 : 2
nextStepTxt = not canProceed4H ? "Do not proceed to 4H yet" : overallRank == 4 ? "Proceed to 4H planning" : "Proceed to 4H (reduced/selective)"
scoreSummaryTxt = str.tostring(overallScore, "#.##") + "/100"
directionSev = not haveSwings ? 1 : (bullStruct or bearStruct) ? 2 : 0
rsSev = na(benchClose) ? 1 : rsSlope > 0 ? 2 : rsSlope < 0 ? 0 : 1
locationSev = not haveSwings ? 1 : (extended20 or extended50) ? 1 : nearStructure ? 2 : 1
topIssueSev = topBlockerTxt == "None" ? 2 : (topBlockerTxt == "Momentum conflict" or topBlockerTxt == "Chaos high / pullbacks not controlled" or topBlockerTxt == "Price extended") ? 1 : 0
locationSummaryTxt = (extended20 or extended50) ? locationTxt + " | " + extendedTxt : locationTxt

//â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”
// Table lifecycle (create ONLY when eligible)
var table t = na
var int rowsActive = 0

isSummaryMode = tableMode == "Summary"
isFullMode = tableMode == "Full"

rowsSummary = 12
rowsCompactExtra = 16
rowsFullExtra = 19
rowsTarget = isSummaryMode ? rowsSummary : (isFullMode ? rowsSummary + rowsCompactExtra + rowsFullExtra : rowsSummary + rowsCompactExtra)
panelEnabled = showTable and ctxEligible and rowsTarget > 0

visPctNow = float(math.max(0, math.min(100, visibilityPct)))
visAlphaNow = int(math.round(100.0 - visPctNow))
textColorNow = showText ? color.new(chart.fg_color, visAlphaNow) : color.new(chart.fg_color, 100)
rowBgAlphaNow = int(math.round(100.0 - visPctNow * 0.30))
sectionBgAlphaNow = int(math.round(100.0 - visPctNow * 0.45))
rowBgColorNow = color.new(color.black, rowBgAlphaNow)
sectionBgColorNow = color.new(color.gray, sectionBgAlphaNow)
frameColorNow = color.new(frameColorInp, visAlphaNow)
borderColorNow = color.new(borderColorInp, visAlphaNow)
textSizeNow = fontSizeOpt == "Tiny" ? size.tiny : fontSizeOpt == "Small" ? size.small : size.normal
emphTextColorNow = showText ? color.new(color.white, visAlphaNow) : color.new(color.white, 100)
statusAlphaNow = int(math.min(95, visAlphaNow + 35))
goodBgColorNow = color.new(color.green, statusAlphaNow)
warnBgColorNow = color.new(color.orange, statusAlphaNow)
badBgColorNow = color.new(color.red, statusAlphaNow)
summaryGoodBgColorNow = color.new(summaryGoodInp, statusAlphaNow)
summaryWarnBgColorNow = color.new(summaryWarnInp, statusAlphaNow)
summaryBadBgColorNow = color.new(summaryBadInp, statusAlphaNow)
decisionBgColorNow = goNoGo ? goodBgColorNow : badBgColorNow
overallBgColorNow = overallRank == 4 ? goodBgColorNow : overallRank == 3 ? warnBgColorNow : overallRank == 2 ? warnBgColorNow : badBgColorNow
blockersBgColorNow = blockersSev == 2 ? goodBgColorNow : blockersSev == 1 ? warnBgColorNow : badBgColorNow
warningsBgColorNow = warningsSev == 2 ? goodBgColorNow : warningsSev == 1 ? warnBgColorNow : badBgColorNow
waitForBgColorNow = waitForSev == 2 ? goodBgColorNow : waitForSev == 1 ? warnBgColorNow : badBgColorNow
riskModePlanBgColorNow = riskModePlanSev == 2 ? goodBgColorNow : riskModePlanSev == 1 ? warnBgColorNow : badBgColorNow
overallQualityBgColorNow = overallQualitySev == 2 ? goodBgColorNow : overallQualitySev == 1 ? warnBgColorNow : badBgColorNow

bgFromSev(_sev) =>
    _sev == 2 ? goodBgColorNow : _sev == 1 ? warnBgColorNow : badBgColorNow

bgFromSummarySev(_sev) =>
    _sev == 2 ? summaryGoodBgColorNow : _sev == 1 ? summaryWarnBgColorNow : summaryBadBgColorNow

summaryCase(_txt) =>
    summaryCaseOpt == "UPPER" ? str.upper(_txt) : summaryCaseOpt == "lower" ? str.lower(_txt) : _txt

setRow(_r, _k, _v) =>
    table.cell(t, 0, _r, _k, text_halign=text.align_left, text_color=textColorNow, bgcolor=rowBgColorNow, text_size=textSizeNow)
    table.cell(t, 1, _r, _v, text_halign=text.align_left, text_color=textColorNow, bgcolor=rowBgColorNow, text_size=textSizeNow)

setHeader(_r, _txt) =>
    table.cell(t, 0, _r, _txt, text_halign=text.align_left, text_color=textColorNow, bgcolor=sectionBgColorNow, text_size=textSizeNow)
    table.cell(t, 1, _r, "", text_halign=text.align_left, text_color=textColorNow, bgcolor=sectionBgColorNow, text_size=textSizeNow)
    table.merge_cells(t, 0, _r, 1, _r)

setRowStatus(_r, _k, _v, _bg) =>
    table.cell(t, 0, _r, _k, text_halign=text.align_left, text_color=emphTextColorNow, bgcolor=_bg, text_size=textSizeNow)
    table.cell(t, 1, _r, _v, text_halign=text.align_left, text_color=emphTextColorNow, bgcolor=_bg, text_size=textSizeNow)

if barstate.islast
    if not panelEnabled
        if not na(t)
            table.delete(t)
            t := na
            rowsActive := 0
    else
        if na(t) or rowsActive != rowsTarget
            if not na(t)
                table.delete(t)
            t := table.new(pos, 2, rowsTarget, frame_width=1, border_width=1, frame_color=frameColorInp, border_color=borderColorInp)
            rowsActive := rowsTarget

        table.set_position(t, pos)
        table.set_frame_color(t, frameColorNow)
        table.set_border_color(t, borderColorNow)
        table.set_frame_width(t, showFrame and visibilityPct > 0 ? frameWidthInp : 0)
        table.set_border_width(t, showBorders and visibilityPct > 0 ? borderWidthInp : 0)

        atrStatsTxt = showNumbers ? ("ATR% " + str.tostring(atrPct, "#.##") + " | jump x" + str.tostring(atrJump, "#.##")) : (volTxt + " | " + unstableTxt)
        overnightDetailsTxt = showNumbers ? ("Gap count " + str.tostring(gapCount, "#") + " / " + str.tostring(gapLookback)) : overnightTxt
        benchmarkDisplayTxt = showNumbers ? (benchTicker + " | RS slope " + str.tostring(rsSlope, "#.##") + "%") : rsTxt

        r = 0
        setRow(r, "Stock -> Daily", tkr + " | " + timeframe.period)
        r += 1
        setHeader(r, "--- SUMMARY ---")
        r += 1
        setRowStatus(r, summaryCase("Edge?"), summaryCase(overallDisplayTxt), bgFromSummarySev(overallRank == 4 ? 2 : overallRank >= 2 ? 1 : 0))
        r += 1
        setRowStatus(r, summaryCase("Direction"), summaryCase(dirTxt), bgFromSummarySev(directionSev))
        r += 1
        setRowStatus(r, summaryCase("RS vs Market"), summaryCase(rsTxt), bgFromSummarySev(rsSev))
        r += 1
        setRowStatus(r, summaryCase("Location"), summaryCase(locationSummaryTxt), bgFromSummarySev(locationSev))
        r += 1
        setRowStatus(r, summaryCase("Risk Definition"), summaryCase(riskDefTxt), bgFromSummarySev(riskDefSev))
        r += 1
        setRowStatus(r, summaryCase("Reward / RR"), summaryCase(rrDisplayTxt), bgFromSummarySev(rrSev))
        r += 1
        setRowStatus(r, summaryCase("Top Issue"), summaryCase(topBlockerTxt), bgFromSummarySev(topIssueSev))
        r += 1
        setRowStatus(r, summaryCase("Wait For"), summaryCase(waitForTxt), bgFromSummarySev(waitForSev))
        r += 1
        setRowStatus(r, summaryCase("Next Step"), summaryCase(nextStepTxt), bgFromSummarySev(nextStepSev))
        r += 1
        setRowStatus(r, summaryCase("Score"), summaryCase(scoreSummaryTxt), bgFromSummarySev(overallRank == 4 ? 2 : overallRank >= 2 ? 1 : 0))
        r += 1

        if not isSummaryMode
            setHeader(r, "--- STRUCTURE ---")
            r += 1
            setRow(r, "Direction", dirTxt)
            r += 1
            setRow(r, "Structure", structureTxt)
            r += 1
            setRow(r, "Integrity", integrityTxt)
            r += 1
            setRow(r, "Location", locationTxt)
            r += 1
            setRow(r, "Extended", extendedTxt)
            r += 1
            setRow(r, "200MA Bias", bias200Txt)
            r += 1

            setHeader(r, "--- MOMENTUM ---")
            r += 1
            setRow(r, "Relative Strength", rsTxt)
            r += 1
            setRow(r, "RSI", rsiLevelTxt)
            r += 1
            setRow(r, "MACD", macdTxt)
            r += 1

            setHeader(r, "--- RISK / OVERNIGHT ---")
            r += 1
            setRow(r, "Volatility", volTxt)
            r += 1
            setRow(r, "Overnight", overnightTxt)
            r += 1
            setRow(r, "Risk Definition", riskDefTxt)
            r += 1
            setRow(r, "Reward / RR", rrDisplayTxt)
            r += 1

            if isFullMode
                setHeader(r, "--- VALIDATION ---")
                r += 1
                setRow(r, "Volume", volumeTxt)
                r += 1
                setRow(r, "Breakout Volume", breakVolTxt)
                r += 1
                setRow(r, "Pullback Volume", pullbackVolTxt)
                r += 1
                setRow(r, "ATR Stability", unstableTxt)
                r += 1

                setHeader(r, "--- BEHAVIOR ---")
                r += 1
                setRow(r, "Behavior", behaviorTxt)
                r += 1
                setRow(r, "Consolidation", consTxt)
                r += 1

                setHeader(r, "--- DETAILS ---")
                r += 1
                setRow(r, "MA Shape", maShapeTxt)
                r += 1
                setRow(r, "20EMA Pullback", pullbackTxt)
                r += 1
                setRow(r, "RSI Swings", rsiSwingsTxt)
                r += 1
                setRow(r, "RSI Recover", rsiRecoverTxt)
                r += 1
                setRow(r, "RSI Divergence", divTxt)
                r += 1
                setRow(r, "MACD Flips", macdFlipTxt)
                r += 1
                setRow(r, "Key Levels", "Swings + major pivots + 52w levels")
                r += 1
                setRow(r, "ATR Stats", atrStatsTxt)
                r += 1
                setRow(r, "Overnight Details", overnightDetailsTxt)
                r += 1
                setRow(r, "Benchmark", benchmarkDisplayTxt)
                r += 1
