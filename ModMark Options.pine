//@version=6
indicator("ModMark Blueprint Context Reader", overlay=true)

// This script is a direct checklist/scoring framework implementation from ModMark Blueprint.
// It is not a buy/sell signal script.

groupCore = "Core (Blueprint)"
maFastLen = input.int(20, "EMA fast (20)", minval=1, group=groupCore)
maMidLen = input.int(50, "SMA mid (50)", minval=1, group=groupCore)
maLongLen = input.int(200, "SMA long (200)", minval=1, group=groupCore)
rsiLen = input.int(14, "RSI length (TV default)", minval=2, group=groupCore)
atrLen = input.int(14, "ATR length (TV default)", minval=1, group=groupCore)
macdFast = input.int(12, "MACD fast (TV default)", minval=1, group=groupCore)
macdSlow = input.int(26, "MACD slow (TV default)", minval=1, group=groupCore)
macdSignalLen = input.int(9, "MACD signal (TV default)", minval=1, group=groupCore)
structLen = input.int(10, "Structure window", minval=3, group=groupCore)
pivotLen = input.int(5, "Pivot window", minval=2, group=groupCore)
slopeBars = input.int(5, "Slope bars", minval=1, group=groupCore)
volLen = input.int(20, "Volume/ATR baseline", minval=5, group=groupCore)
rsLookback = input.int(20, "RS lookback", minval=5, group=groupCore)
rewardLookback = input.int(20, "Reward lookback", minval=5, group=groupCore)

groupProxy = "Proxy Thresholds (for automating Blueprint checks)"
nearAtrMult = input.float(0.75, "Near key level (xATR)", minval=0.1, step=0.05, group=groupProxy)
extendAtrMult = input.float(2.0, "Extended from EMA20 (xATR)", minval=0.5, step=0.1, group=groupProxy)
volEnterMult = input.float(1.30, "Volatility enter (ATR x baseline)", minval=1.0, step=0.05, group=groupProxy)
volExitMult = input.float(1.15, "Volatility exit (ATR x baseline)", minval=1.0, step=0.05, group=groupProxy)
volMinRatio = input.float(1.0, "Volume healthy (x baseline)", minval=0.1, step=0.05, group=groupProxy)
maFlatAtrMult = input.float(0.08, "MA50 flatness (ATR x)", minval=0.01, step=0.01, group=groupProxy)
chopCrossMinRate = input.float(0.20, "Chop cross rate threshold", minval=0.01, maxval=1.0, step=0.01, group=groupProxy)
erMin = input.float(0.30, "Trend strength min (ER)", minval=0.01, maxval=1.0, step=0.01, group=groupProxy)
erExitMult = input.float(0.90, "Trend strength exit mult", minval=0.1, maxval=1.0, step=0.01, group=groupProxy)
maStackEnterAtr = input.float(0.10, "MA stack enter (x ATRBase)", minval=0.01, step=0.01, group=groupProxy)
maStackExitMult = input.float(0.60, "MA stack exit mult", minval=0.05, maxval=0.99, step=0.01, group=groupProxy)
maPriceEnterAtr = input.float(0.10, "MA stack price enter band (x ATRBase)", minval=0.01, step=0.01, group=groupProxy)
maPriceExitMult = input.float(0.60, "MA stack price exit mult", minval=0.05, maxval=0.99, step=0.01, group=groupProxy)
maCrossThrAtr = input.float(0.04, "MA mixed cross threshold (x ATRBase)", minval=0.005, step=0.005, group=groupProxy)
rsiEnterBand = input.float(2.0, "RSI enter band (+/- around 50)", minval=0.1, step=0.1, group=groupProxy)
rsiExitMult = input.float(0.60, "RSI exit mult", minval=0.05, maxval=0.99, step=0.01, group=groupProxy)
macdEnterAtr = input.float(0.10, "MACD hist enter (x ATRBase)", minval=0.01, step=0.01, group=groupProxy)
macdExitMult = input.float(0.60, "MACD hist exit mult", minval=0.05, maxval=0.99, step=0.01, group=groupProxy)
rsDeltaMin = input.float(0.01, "RS delta min (abs, e.g. 0.01 = 1%)", minval=0.0, step=0.005, group=groupProxy)
rsSlopeMin = input.float(0.0002, "RS slope min (abs, ~%/bar)", minval=0.0, step=0.0001, group=groupProxy)
minMarketScore1D = input.float(13.0, "Min market score 1D", minval=0.0, maxval=20.0, step=0.5, group=groupProxy)
minMarketScore4H = input.float(11.5, "Min market score 4H", minval=0.0, maxval=20.0, step=0.5, group=groupProxy)
minMarketScore1H = input.float(10.5, "Min market score 1H", minval=0.0, maxval=20.0, step=0.5, group=groupProxy)
mtfAllowWeak = input.bool(true, "MTF allow weak alignment (4H/1H)", group=groupProxy)
showMarketDebug = input.bool(false, "Show market debug row", group=groupProxy)
useConfirmedSecurity = input.bool(false, "Use confirmed security data (less realtime flicker)", group=groupProxy)
// Ensure hysteresis order even if user sets invalid values in inputs.
volEnterEff = math.max(volEnterMult, volExitMult + 0.01)
volExitEff = math.min(volExitMult, volEnterEff - 0.01)
erEnterEff = erMin
erExitEff = math.min(erMin * erExitMult, erEnterEff - 0.001)
maStackEnterEff = maStackEnterAtr
maStackExitEff = math.min(maStackEnterAtr * maStackExitMult, maStackEnterEff - 0.001)
// Keep MIXED/CROSS text classification tighter than stack-exit logic.
maCrossThrEff = math.min(maCrossThrAtr, maStackExitEff)
maPriceEnterEff = maPriceEnterAtr
maPriceExitEff = math.min(maPriceEnterAtr * maPriceExitMult, maPriceEnterEff - 0.001)
rsiEnterEff = rsiEnterBand
rsiExitEff = math.min(rsiEnterBand * rsiExitMult, rsiEnterEff - 0.1)
macdEnterEff = macdEnterAtr
macdExitEff = math.min(macdEnterAtr * macdExitMult, macdEnterEff - 0.001)

f_b2i(bool b) =>
    b ? 1 : 0

f_clamp01(float x) =>
    math.max(0.0, math.min(1.0, x))

f_size_from_grade(string grade) =>
    grade == "A" ? "FULL" : grade == "B" ? "HALF" : grade == "C" ? "LIGHT" : "NO TRADE"

f_reduce_size(string s) =>
    s == "FULL" ? "HALF" : s == "HALF" ? "LIGHT" : s == "LIGHT" ? "NO TRADE" : "NO TRADE"

f_macd_hist(float src, int fastLen, int slowLen, int signalLen) =>
    [macdLineTmp, signalLineTmp, h] = ta.macd(src, fastLen, slowLen, signalLen)
    h

// Avoid short-circuit warnings by computing highest/lowest components first.
f_up_struct(int len) =>
    hNow = ta.highest(high, len)
    hPrev = ta.highest(high[len], len)
    lNow = ta.lowest(low, len)
    lPrev = ta.lowest(low[len], len)
    hNow > hPrev and lNow > lPrev

f_down_struct(int len) =>
    hNow = ta.highest(high, len)
    hPrev = ta.highest(high[len], len)
    lNow = ta.lowest(low, len)
    lPrev = ta.lowest(low[len], len)
    hNow < hPrev and lNow < lPrev

f_cross_count(float src, float ma, int len) =>
    math.sum(ta.cross(src, ma) ? 1.0 : 0.0, len)

f_sma_slope_norm(int maLen, int slopeLen) =>
    ma = ta.sma(close, maLen)
    close != 0 ? ((ma - ma[slopeLen]) / slopeLen) / close : 0.0

f_er(series float src, int len) =>
    ch = math.abs(src - src[len])
    vol = math.sum(math.abs(src - src[1]), len)
    vol == 0.0 ? 0.0 : ch / vol

f_sec_f(string sym, string tf, series float expr) =>
    request.security(sym, tf, useConfirmedSecurity ? (barstate.isconfirmed ? expr : expr[1]) : expr, barmerge.gaps_off, barmerge.lookahead_off)

f_sec_b(string sym, string tf, series bool expr) =>
    request.security(sym, tf, useConfirmedSecurity ? (barstate.isconfirmed ? expr : expr[1]) : expr, barmerge.gaps_off, barmerge.lookahead_off)

f_add_row(table t, int row, string item, string status, bool pass, bool manual) =>
    color statusBg = manual ? color.new(color.gray, 80) : pass ? color.new(color.green, 82) : color.new(color.red, 82)
    table.cell(t, 0, row, item, text_color=color.white, text_halign=text.align_left, bgcolor=color.new(color.black, 0))
    table.cell(t, 1, row, status, text_color=color.white, text_halign=text.align_left, bgcolor=statusBg)

f_add_header(table t, int row, string left, string mid) =>
    color hb = color.new(color.blue, 75)
    table.cell(t, 0, row, left, text_color=color.white, text_halign=text.align_left, bgcolor=hb)
    table.cell(t, 1, row, mid, text_color=color.white, text_halign=text.align_left, bgcolor=hb)

// ---------- Context detection ----------
sym = str.upper(syminfo.ticker)
isSPY = sym == "SPY"
isQQQ = sym == "QQQ"
isBenchmark = isSPY or isQQQ

tfSec = timeframe.in_seconds()
is1D = timeframe.isdaily or tfSec == 86400
is4H = timeframe.isintraday and tfSec == 14400
is1H = timeframe.isintraday and tfSec == 3600
isSupportedTf = is1D or is4H or is1H

// Keep ctxSpy1D name for backward compatibility with downstream logic.
ctxSpy1D = isBenchmark and is1D
ctxStock1D = not isBenchmark and is1D
ctxStock4H = not isBenchmark and is4H
ctxStock1H = not isBenchmark and is1H
ctxSupported = ctxSpy1D or ctxStock1D or ctxStock4H or ctxStock1H

ctxLabel = ctxSpy1D ? (isSPY ? "SPY 1D" : "QQQ 1D") : ctxStock1D ? "STOCK 1D" : ctxStock4H ? "STOCK 4H" : ctxStock1H ? "STOCK 1H" : "UNSUPPORTED"

// ---------- Local symbol calculations ----------
ema20 = ta.ema(close, maFastLen)
sma50 = ta.sma(close, maMidLen)
sma200 = ta.sma(close, maLongLen)
rsi = ta.rsi(close, rsiLen)
[macdLine, macdSignal, macdHist] = ta.macd(close, macdFast, macdSlow, macdSignalLen)
atr = ta.atr(atrLen)
atrBase = ta.sma(atr, volLen)
volBase = ta.sma(volume, volLen)
vwapSession = ta.vwap(hlc3)

hh = ta.highest(high, structLen)
hhPrev = ta.highest(high[structLen], structLen)
ll = ta.lowest(low, structLen)
llPrev = ta.lowest(low[structLen], structLen)
upStruct = hh > hhPrev and ll > llPrev
downStruct = hh < hhPrev and ll < llPrev

maSlope50Norm = close != 0 ? ((sma50 - sma50[slopeBars]) / slopeBars) / close : 0.0
crossCount = int(f_cross_count(close, ema20, structLen))
localUp = upStruct == true
localDown = downStruct == true
localEr = nz(f_er(close, structLen), 0.0)
localSlope = nz(maSlope50Norm, 0.0)
localCross = nz(float(crossCount), 0.0)
localCrossRate = structLen > 0 ? localCross / float(structLen) : 0.0
localAtrBaseNorm = (not na(atrBase) and close != 0.0) ? atrBase / close : 0.0
localFlat = localAtrBaseNorm > 0.0 ? math.abs(localSlope) <= localAtrBaseNorm * maFlatAtrMult : false
localCrossy = localCrossRate >= chopCrossMinRate
enterLocalTrend = (localUp or localDown) and (localEr >= erEnterEff)
exitLocalTrend = (not (localUp or localDown)) or (localEr < erExitEff)
var bool localTrendStrongState = false
localTrendStrongState := localTrendStrongState ? not (exitLocalTrend == true) : (enterLocalTrend == true)
localTrendStrong = localTrendStrongState
localChop = not localTrendStrong and localCrossy and localFlat
localEnterVol = (not na(atr) and not na(atrBase)) and (atr > atrBase * volEnterEff)
localExitVol = (not na(atr) and not na(atrBase)) and (atr < atrBase * volExitEff)
var bool localVolatileState = false
localVolatileState := localVolatileState ? not (localExitVol == true) : (localEnterVol == true)
localVolatile = localVolatileState
localRegime = localChop ? "CHOP" : (not localTrendStrong and localVolatile) ? "VOLATILE" : localTrendStrong ? "TREND" : "RANGE"

pH = ta.pivothigh(high, pivotLen, pivotLen)
pL = ta.pivotlow(low, pivotLen, pivotLen)
pivotHigh = ta.valuewhen(not na(pH), pH, 0)
pivotLow = ta.valuewhen(not na(pL), pL, 0)
hasKeyLevels = not na(pivotHigh) and not na(pivotLow)

nearDist = hasKeyLevels ? math.min(math.abs(close - pivotHigh), math.abs(close - pivotLow)) : na
nearKeyLevel = hasKeyLevels and nearDist <= atr * nearAtrMult
notExtended = atr > 0 ? math.abs(close - ema20) <= atr * extendAtrMult : false

// ---------- SPY calculations (same TF) ----------
spyClose = f_sec_f("SPY", timeframe.period, close)
spyEma20 = f_sec_f("SPY", timeframe.period, ta.ema(close, maFastLen))
spySma50 = f_sec_f("SPY", timeframe.period, ta.sma(close, maMidLen))
spySma200 = f_sec_f("SPY", timeframe.period, ta.sma(close, maLongLen))
spyRsi = f_sec_f("SPY", timeframe.period, ta.rsi(close, rsiLen))
spyMacdHist = f_sec_f("SPY", timeframe.period, f_macd_hist(close, macdFast, macdSlow, macdSignalLen))
spyAtr = f_sec_f("SPY", timeframe.period, ta.atr(atrLen))
spyAtrBase = f_sec_f("SPY", timeframe.period, ta.sma(ta.atr(atrLen), volLen))

spyUpStruct = f_sec_b("SPY", timeframe.period, f_up_struct(structLen))
spyDownStruct = f_sec_b("SPY", timeframe.period, f_down_struct(structLen))
spySlope50Norm = f_sec_f("SPY", timeframe.period, f_sma_slope_norm(maMidLen, slopeBars))
spyCrossCount = int(f_sec_f("SPY", timeframe.period, f_cross_count(close, ta.ema(close, maFastLen), structLen)))
spyEr = f_sec_f("SPY", timeframe.period, f_er(close, structLen))

// ---------- Daily alignment for 4H/1H execution layers ----------
dClose = f_sec_f(syminfo.tickerid, "D", close)
dEma20 = f_sec_f(syminfo.tickerid, "D", ta.ema(close, maFastLen))
dSma50 = f_sec_f(syminfo.tickerid, "D", ta.sma(close, maMidLen))
dSma200 = f_sec_f(syminfo.tickerid, "D", ta.sma(close, maLongLen))
dUpStruct = f_sec_b(syminfo.tickerid, "D", f_up_struct(structLen))
dDownStruct = f_sec_b(syminfo.tickerid, "D", f_down_struct(structLen))
dailyBiasBull = dClose > dSma200 and dEma20 > dSma50
dailyBiasBear = dClose < dSma200 and dEma20 < dSma50
dailyBull = dailyBiasBull and dUpStruct
dailyBear = dailyBiasBear and dDownStruct

// ---------- Market Alignment block ----------
marketClose = ctxSpy1D ? close : spyClose
marketEma20 = ctxSpy1D ? ema20 : spyEma20
marketSma50 = ctxSpy1D ? sma50 : spySma50
marketSma200 = ctxSpy1D ? sma200 : spySma200
marketRsi = ctxSpy1D ? rsi : spyRsi
marketMacdHist = ctxSpy1D ? macdHist : spyMacdHist
marketAtr = ctxSpy1D ? atr : spyAtr
marketAtrBase = ctxSpy1D ? atrBase : spyAtrBase
marketUp = ctxSpy1D ? upStruct : spyUpStruct
marketDown = ctxSpy1D ? downStruct : spyDownStruct
marketSlopeNorm = ctxSpy1D ? maSlope50Norm : spySlope50Norm
marketCross = ctxSpy1D ? crossCount : spyCrossCount
marketEr = ctxSpy1D ? localEr : spyEr

mUp = marketUp == true
mDown = marketDown == true
mEr = nz(marketEr, 0.0)
mSlope = nz(marketSlopeNorm, 0.0)
mCross = nz(float(marketCross), 0.0)
marketCrossRate = structLen > 0 ? mCross / float(structLen) : 0.0
marketAtrBaseNorm = (not na(marketAtrBase) and not na(marketClose) and marketClose != 0.0) ? marketAtrBase / marketClose : 0.0
marketFlat = marketAtrBaseNorm > 0.0 ? math.abs(mSlope) <= marketAtrBaseNorm * maFlatAtrMult : false
marketCrossy = marketCrossRate >= chopCrossMinRate
hasStruct = mUp or mDown
enterTrend = hasStruct and (mEr >= erEnterEff)
exitTrend = (not hasStruct) or (mEr < erExitEff)
var bool trendStrongState = false
trendStrongState := trendStrongState ? not (exitTrend == true) : (enterTrend == true)
trendStrong = trendStrongState
marketChop = not trendStrong and marketCrossy and marketFlat
marketEnterVol = (not na(marketAtr) and not na(marketAtrBase)) and (marketAtr > marketAtrBase * volEnterEff)
marketExitVol = (not na(marketAtr) and not na(marketAtrBase)) and (marketAtr < marketAtrBase * volExitEff)
var bool marketVolatileState = false
marketVolatileState := marketVolatileState ? not (marketExitVol == true) : (marketEnterVol == true)
marketVolatile = marketVolatileState
marketRegime = marketChop ? "CHOP" : (not trendStrong and marketVolatile) ? "VOLATILE" : trendStrong ? "TREND" : "RANGE"
dirWeak = hasStruct and not trendStrong
// Macro bias from MA order only.
maOrderReady = not na(marketEma20) and not na(marketSma50) and not na(marketSma200)
macroBull = maOrderReady and marketEma20 > marketSma50 and marketSma50 > marketSma200
macroBear = maOrderReady and marketEma20 < marketSma50 and marketSma50 < marketSma200

// Micro-structure vs macro-bias conflict (only when direction is WEAK).
pullback = dirWeak and macroBull and mDown
rally = dirWeak and macroBear and mUp

marketDirection = trendStrong ? (mUp ? "BULLISH" : "BEARISH") : pullback ? "BULLISH (PULLBACK)" : rally ? "BEARISH (RALLY)" : dirWeak ? (mUp ? "BULLISH (WEAK)" : "BEARISH (WEAK)") : "RANGE"
marketRegimeTxt = marketVolatile and marketRegime != "VOLATILE" ? marketRegime + " + VOL" : marketRegime

// ----- MA stack (strong/weak) with hysteresis -----
maReady = not na(marketClose) and not na(marketEma20) and not na(marketSma50) and not na(marketSma200) and not na(marketAtrBase) and marketAtrBase != 0.0
bullOrder = maReady and marketEma20 > marketSma50 and marketSma50 > marketSma200
bearOrder = maReady and marketEma20 < marketSma50 and marketSma50 < marketSma200

// ATRBase-normalized separations (x ATRBase)
sep2050 = maReady ? (marketEma20 - marketSma50) / marketAtrBase : 0.0
sep50200 = maReady ? (marketSma50 - marketSma200) / marketAtrBase : 0.0
stackStrength = bullOrder ? math.min(sep2050, sep50200) : bearOrder ? math.min(-sep2050, -sep50200) : 0.0
strengthTxt = str.tostring(stackStrength, "#.##") + "x"

// Price-vs-EMA20 sanity check with ATRBase bands + hysteresis.
priceBandEnter = maReady ? maPriceEnterEff * marketAtrBase : 0.0
priceBandExit = maReady ? maPriceExitEff * marketAtrBase : 0.0
bullPriceEnter = maReady and marketClose > marketEma20 + priceBandEnter
bullPriceExit = maReady and marketClose < marketEma20 - priceBandExit
bearPriceEnter = maReady and marketClose < marketEma20 - priceBandEnter
bearPriceExit = maReady and marketClose > marketEma20 + priceBandExit

enterBullStack = bullOrder and sep2050 >= maStackEnterEff and sep50200 >= maStackEnterEff and bullPriceEnter
exitBullStack = (not bullOrder) or na(marketClose) or (sep2050 <= maStackExitEff) or (sep50200 <= maStackExitEff) or bullPriceExit
enterBearStack = bearOrder and (-sep2050 >= maStackEnterEff) and (-sep50200 >= maStackEnterEff) and bearPriceEnter
exitBearStack = (not bearOrder) or na(marketClose) or (-sep2050 <= maStackExitEff) or (-sep50200 <= maStackExitEff) or bearPriceExit

var bool bullStackState = false
var bool bearStackState = false
bullStackState := bullStackState ? not (exitBullStack == true) : (enterBullStack == true)
bearStackState := bearStackState ? not (exitBearStack == true) : (enterBearStack == true)

// Enforce exclusivity
if bullStackState
    bearStackState := false
if bearStackState
    bullStackState := false

marketMaBullStrong = bullStackState
marketMaBearStrong = bearStackState
marketMaBullWeak = bullOrder and not marketMaBullStrong
marketMaBearWeak = bearOrder and not marketMaBearStrong
marketMAAlignedStrong = marketMaBullStrong or marketMaBearStrong
marketMAAlignedWeak = marketMaBullWeak or marketMaBearWeak
maStrengthNorm = maStackEnterEff > 0.0 ? f_clamp01(stackStrength / maStackEnterEff) : 0.0
marketMAAlignScore = 5.0 * maStrengthNorm

// ----- MIXED breakdown (based on sep signs + near-zero threshold) -----
crossThr = maCrossThrEff
cross2050 = maReady and math.abs(sep2050) <= crossThr
cross50200 = maReady and math.abs(sep50200) <= crossThr
compressed = cross2050 and cross50200
eps = crossThr * 0.20
cross2050Side = math.abs(sep2050) <= eps ? "20~=50" : (sep2050 > 0 ? "20>50" : "20<50")
cross50200Side = math.abs(sep50200) <= eps ? "50~=200" : (sep50200 > 0 ? "50>200" : "50<200")

tightness = maReady ? math.min(math.abs(sep2050), math.abs(sep50200)) : na
tightTxt = not na(tightness) ? str.tostring(tightness, "#.##") + "x" : "na"

mixTag = not maReady ? "N/A" : compressed ? "COMPRESSED" : cross2050 ? "20~50 CROSS (" + cross2050Side + ")" : cross50200 ? "50~200 CROSS (" + cross50200Side + ")" : (sep2050 > 0 and sep50200 < 0) ? "ST BULL / LT BEAR" : (sep2050 < 0 and sep50200 > 0) ? "ST BEAR / LT BULL" : "NO ORDER"

marketMaTxt = marketMaBullStrong ? "BULL STACK (" + strengthTxt + ")" : marketMaBearStrong ? "BEAR STACK (" + strengthTxt + ")" : marketMaBullWeak ? "BULL STACK (WEAK " + strengthTxt + ")" : marketMaBearWeak ? "BEAR STACK (WEAK " + strengthTxt + ")" : (mixTag == "N/A" ? "N/A" : "MIXED (" + mixTag + " " + tightTxt + ")")

// ----- RSI + MACD confirmation (direction-bias aware, strong/weak + hysteresis) -----
// Bias side we want to confirm (matches Market direction semantics).
dirBullBias = trendStrong ? mUp : pullback ? true : rally ? false : (dirWeak and mUp)
dirBearBias = trendStrong ? mDown : rally ? true : pullback ? false : (dirWeak and mDown)
hasBias = dirBullBias or dirBearBias

// RSI hysteresis around 50.
enterRsiBull = hasBias and dirBullBias and not na(marketRsi) and (marketRsi >= 50.0 + rsiEnterEff)
exitRsiBull = (not dirBullBias) or na(marketRsi) or (marketRsi <= 50.0 - rsiExitEff)
var bool rsiBullState = false
rsiBullState := rsiBullState ? not (exitRsiBull == true) : (enterRsiBull == true)

enterRsiBear = hasBias and dirBearBias and not na(marketRsi) and (marketRsi <= 50.0 - rsiEnterEff)
exitRsiBear = (not dirBearBias) or na(marketRsi) or (marketRsi >= 50.0 + rsiExitEff)
var bool rsiBearState = false
rsiBearState := rsiBearState ? not (exitRsiBear == true) : (enterRsiBear == true)

// MACD hist hysteresis (normalized by ATRBase).
macdNorm = (not na(marketAtrBase) and marketAtrBase != 0.0 and not na(marketMacdHist)) ? (marketMacdHist / marketAtrBase) : na

enterMacdBull = hasBias and dirBullBias and not na(macdNorm) and (macdNorm >= macdEnterEff)
exitMacdBull = (not dirBullBias) or na(macdNorm) or (macdNorm <= macdExitEff)
var bool macdBullState = false
macdBullState := macdBullState ? not (exitMacdBull == true) : (enterMacdBull == true)

enterMacdBear = hasBias and dirBearBias and not na(macdNorm) and (macdNorm <= -macdEnterEff)
exitMacdBear = (not dirBearBias) or na(macdNorm) or (macdNorm >= -macdExitEff)
var bool macdBearState = false
macdBearState := macdBearState ? not (exitMacdBear == true) : (enterMacdBear == true)

// Enforce bullish/bearish state exclusivity on bias flips.
if dirBullBias
    rsiBearState := false
    macdBearState := false
if dirBearBias
    rsiBullState := false
    macdBullState := false

// Direction-aware alignment.
rsiAligned = dirBullBias ? rsiBullState : dirBearBias ? rsiBearState : false
macdAligned = dirBullBias ? macdBullState : dirBearBias ? macdBearState : false

marketMomentumStrong = hasBias and rsiAligned and macdAligned
marketMomentumWeak = hasBias and (not marketMomentumStrong) and (rsiAligned or macdAligned)

// Opposite-side checks (beyond enter thresholds).
rsiOpp = hasBias and not na(marketRsi) and ((dirBullBias and marketRsi <= 50.0 - rsiEnterEff) or (dirBearBias and marketRsi >= 50.0 + rsiEnterEff))
macdOpp = hasBias and not na(macdNorm) and ((dirBullBias and macdNorm <= -macdEnterEff) or (dirBearBias and macdNorm >= macdEnterEff))

marketMomentumOpposed = hasBias and rsiOpp and macdOpp
marketMomentumNeutral = hasBias and (not rsiAligned) and (not macdAligned) and (not rsiOpp) and (not macdOpp)

weakTag = rsiAligned and not macdAligned ? " (RSI)" : macdAligned and not rsiAligned ? " (MACD)" : ""
marketMomentumTxt = not hasBias ? "N/A" : marketMomentumStrong ? "ALIGNED" : marketMomentumWeak ? "WEAK" + weakTag : marketMomentumOpposed ? "OPPOSED" : marketMomentumNeutral ? "NEUTRAL" : "MIXED"

// Back-compat bool.
marketMomentum = marketMomentumStrong
marketSupportive = marketRegime == "TREND"

// ---------- Stock Behavior block ----------
// Use Daily RS sources on intraday to avoid timeframe-dependent RS noise.
spyCloseD = f_sec_f("SPY", "D", close)
rsStockClose = (ctxStock4H or ctxStock1H) ? dClose : close
rsSpyClose = (ctxStock4H or ctxStock1H) ? spyCloseD : spyClose

// Estimate bars/day from observed day boundary changes.
isNewDay = ta.change(time("D")) != 0
var int dayBars = 0
var int prevDayBars = na
dayBars := isNewDay ? 1 : (dayBars + 1)
if isNewDay
    prevDayBars := dayBars[1]
barsPerDayEff = int(math.max(1.0, float(nz(prevDayBars, dayBars))))

// Convert RS lookback (days) to bars on intraday.
rsLenBars = (ctxStock4H or ctxStock1H) ? (rsLookback * barsPerDayEff) : rsLookback

spyRet = (not na(rsSpyClose[rsLenBars]) and rsSpyClose[rsLenBars] != 0.0) ? (rsSpyClose / rsSpyClose[rsLenBars] - 1.0) : na
stockRet = (not na(rsStockClose[rsLenBars]) and rsStockClose[rsLenBars] != 0.0) ? (rsStockClose / rsStockClose[rsLenBars] - 1.0) : na
rsDelta = nz(stockRet, 0.0) - nz(spyRet, 0.0)
rsRatio = (not na(rsSpyClose) and rsSpyClose != 0.0) ? (rsStockClose / rsSpyClose) : na
rsRatioSafe = nz(rsRatio, 0.0)
rsLin0 = ta.linreg(rsRatioSafe, rsLenBars, 0)
rsLin1 = ta.linreg(rsRatioSafe, rsLenBars, 1)
rsSlopeRaw = not na(rsRatio) ? (rsLin0 - rsLin1) : 0.0
rsSlopeNorm = (not na(rsRatio) and rsRatio != 0.0) ? (rsSlopeRaw / rsRatio) : 0.0
rsSlopeNorm := (ctxStock4H or ctxStock1H) ? (rsSlopeNorm * barsPerDayEff) : rsSlopeNorm
relStrong = (rsDelta >= rsDeltaMin) and (rsSlopeNorm >= rsSlopeMin)
relWeak = (rsDelta <= -rsDeltaMin) and (rsSlopeNorm <= -rsSlopeMin)
relClear = relStrong or relWeak
rsState = relStrong ? "STRONGER" : relWeak ? "WEAKER" : "NEUTRAL"

structOk = (localUp or localDown) and not localChop
structStrong = structOk and localTrendStrong
cleanStructure = structOk
volRatio = (not na(volBase) and volBase > 0.0) ? (volume / volBase) : na
volumeHealthy = not na(volRatio) and volRatio >= volMinRatio

dBull = dailyBull == true
dBear = dailyBear == true
dBiasBull = dailyBiasBull == true
dBiasBear = dailyBiasBear == true
mtfAlignedStrong = (localUp and dBull) or (localDown and dBear)
mtfAlignedWeak = (localUp and dBiasBull) or (localDown and dBiasBear)
mtfAligned = mtfAllowWeak ? (mtfAlignedStrong or mtfAlignedWeak) : mtfAlignedStrong

// ---------- Location block ----------
locationPass = nearKeyLevel and notExtended
extAtr = atr > 0 ? math.abs(close - ema20) / atr : na

// ---------- Risk Definition + Reward Justification ----------
thesisBullBase = ctxSpy1D ? mUp : (mUp and (relStrong or (rsDelta >= 0 and close > sma50)))
thesisBearBase = ctxSpy1D ? mDown : (mDown and (relWeak or (rsDelta <= 0 and close < sma50)))
thesisBull = (ctxStock4H or ctxStock1H) ? (thesisBullBase and dBull) : thesisBullBase
thesisBear = (ctxStock4H or ctxStock1H) ? (thesisBearBase and dBear) : thesisBearBase
thesisDir = thesisBull ? "BULLISH THESIS" : thesisBear ? "BEARISH THESIS" : "NO CLEAR THESIS"
setupSide = thesisBull ? "CALL" : thesisBear ? "PUT" : "WAIT"
setupSideTxt = thesisBull ? "CALL (BULLISH)" : thesisBear ? "PUT (BEARISH)" : "WAIT / NO CLEAR THESIS"

swingHigh = ta.highest(high, rewardLookback)
swingLow = ta.lowest(low, rewardLookback)

longInvalid = hasKeyLevels ? pivotLow : na
shortInvalid = hasKeyLevels ? pivotHigh : na
longTarget = hasKeyLevels ? math.max(pivotHigh, swingHigh) : swingHigh
shortTarget = hasKeyLevels ? math.min(pivotLow, swingLow) : swingLow

longRisk = thesisBull and not na(longInvalid) and longInvalid < close ? close - longInvalid : na
shortRisk = thesisBear and not na(shortInvalid) and shortInvalid > close ? shortInvalid - close : na
riskDist = thesisBull ? longRisk : thesisBear ? shortRisk : na
invalidation = thesisBull ? longInvalid : thesisBear ? shortInvalid : na

longReward = thesisBull ? longTarget - close : na
shortReward = thesisBear ? close - shortTarget : na
rewardDist = thesisBull ? longReward : thesisBear ? shortReward : na
targetLvl = thesisBull ? longTarget : thesisBear ? shortTarget : na

riskDefined = not na(riskDist) and riskDist > syminfo.mintick * 5
rewardDefined = not na(rewardDist) and rewardDist > 0
rr = riskDefined and rewardDefined ? rewardDist / riskDist : na
rrAccept = not na(rr) and rr >= 2
rrStrong = not na(rr) and rr >= 3

// ---------- Scoring ----------
erSpan = math.max(erEnterEff - erExitEff, 0.0001)
marketDirectionNorm = hasStruct ? f_clamp01((mEr - erExitEff) / erSpan) : 0.0
marketDirectionScore = 5.0 * marketDirectionNorm

marketRegimeScore = marketRegime == "TREND" ? 5.0 : marketRegime == "RANGE" ? 3.0 : marketRegime == "CHOP" ? 2.0 : 1.0
marketRegimeScore := marketVolatile and marketRegime != "VOLATILE" ? math.max(0.0, marketRegimeScore - 0.5) : marketRegimeScore

rsiDen = math.max(rsiEnterEff, 0.0001)
rsiDelta = dirBullBias ? (marketRsi - 50.0) : dirBearBias ? (50.0 - marketRsi) : na
rsiNorm = hasBias and not na(rsiDelta) ? f_clamp01(rsiDelta / rsiDen) : 0.0

macdDen = math.max(macdEnterEff, 0.0001)
macdDelta = dirBullBias ? macdNorm : dirBearBias ? -macdNorm : na
macdNormScore = hasBias and not na(macdDelta) ? f_clamp01(macdDelta / macdDen) : 0.0
marketMomentumScore = 5.0 * ((rsiNorm + macdNormScore) / 2.0)

marketScore = marketDirectionScore + marketRegimeScore + marketMAAlignScore + marketMomentumScore
minMarketScoreEff = is1D ? minMarketScore1D : is4H ? minMarketScore4H : minMarketScore1H
minMarketScoreAdj = marketRegime == "CHOP" ? 1.0 : marketRegime == "TREND" ? -0.5 : 0.0
minMarketScoreAdj := marketVolatile ? minMarketScoreAdj + 0.5 : minMarketScoreAdj
minMarketScoreReq = math.max(0.0, minMarketScoreEff + minMarketScoreAdj)

behaviorScoreStock = f_b2i(relClear) * 5.0 + f_b2i(cleanStructure) * 5.0 + f_b2i(volumeHealthy) * 5.0 + f_b2i(hasKeyLevels) * 5.0
behaviorScoreSpyRaw = f_b2i(cleanStructure) * 5.0 + f_b2i(volumeHealthy) * 5.0 + f_b2i(hasKeyLevels) * 5.0
behaviorScoreSpy = behaviorScoreSpyRaw * (20.0 / 15.0)
behaviorScore = ctxSpy1D ? behaviorScoreSpy : behaviorScoreStock
mtfScore = (ctxStock4H or ctxStock1H) ? (mtfAlignedStrong ? 0.0 : mtfAlignedWeak ? 2.5 : 5.0) : 0.0
behaviorScore := (ctxStock4H or ctxStock1H) ? (behaviorScore - mtfScore) : behaviorScore
behaviorScore := math.max(0.0, math.min(20.0, behaviorScore))

locationScore = f_b2i(nearKeyLevel) * 10 + f_b2i(notExtended) * 10
riskScore = f_b2i(riskDefined) * 10 + f_b2i(riskDefined and hasKeyLevels) * 10
rewardScore = f_b2i(rrAccept) * 10 + f_b2i(rrStrong) * 10
score = marketScore + behaviorScore + locationScore + riskScore + rewardScore

filterMarket = marketScore >= minMarketScoreReq
filterBehavior = ctxSpy1D ? (cleanStructure and volumeHealthy and hasKeyLevels) : (relClear and cleanStructure and volumeHealthy and hasKeyLevels)
filterBehavior := (ctxStock4H or ctxStock1H) ? (filterBehavior and mtfAligned) : filterBehavior
filterLocation = locationPass
filterRisk = riskDefined
filterReward = rrAccept
passCount = f_b2i(filterMarket) + f_b2i(filterBehavior) + f_b2i(filterLocation) + f_b2i(filterRisk) + f_b2i(filterReward)

// --- GRADE = jakosc setupu (bez kary srodowiskowej) ---
string gradeBase = "D"
if riskDefined
    gradeBase := passCount == 5 ? "A" : passCount >= 4 ? "B" : passCount >= 3 ? "C" : "D"

// Keep `grade` as displayed output variable used by table/colors.
grade = gradeBase

// --- SIZE = grade + kara srodowiskowa ---
sizeDecision = f_size_from_grade(gradeBase)

// Single environment penalty step for CHOP/RANGE/VOLATILE.
bool envPenalty = (marketRegime == "CHOP") or (marketRegime == "RANGE") or marketVolatile
if envPenalty
    sizeDecision := f_reduce_size(sizeDecision)

// Hard rule: D is always NO TRADE.
if gradeBase == "D"
    sizeDecision := "NO TRADE"

gradeColor = grade == "A" ? color.new(color.green, 70) : grade == "B" ? color.new(color.teal, 70) : grade == "C" ? color.new(color.orange, 70) : color.new(color.red, 70)
sizeColor = sizeDecision == "FULL" ? color.new(color.green, 70) : sizeDecision == "HALF" ? color.new(color.teal, 70) : sizeDecision == "LIGHT" ? color.new(color.orange, 70) : color.new(color.red, 70)

// ---------- Table ----------
var int MAX_ROWS = 56
var table t = table.new(position.top_right, 2, MAX_ROWS, border_width=0, frame_color=color.new(color.white, 100))

if barstate.islast
    table.clear(t, 0, 0, 1, MAX_ROWS - 1)
    if isSupportedTf
        int row = 0
        if not ctxSupported
            f_add_row(t, row, "Context", "Unsupported symbol/TF combination", false, true)
            row += 1
            f_add_row(t, row, "Allowed", "SPY 1D | QQQ 1D | STOCK 1D | STOCK 4H | STOCK 1H", true, true)
            row += 1
        else
            // Market Alignment
            f_add_header(t, row, "Market Alignment", "")
            row += 1
            regimePass = marketRegime == "TREND" or marketRegime == "RANGE"
            regimeManual = marketRegime == "CHOP" or (marketVolatile and marketRegime != "VOLATILE")
            f_add_row(t, row, "Market regime", marketRegimeTxt, regimePass, regimeManual)
            row += 1
            dirPass = marketDirectionScore >= 3.5
            dirManual = marketDirectionScore >= 1.5 and not dirPass
            f_add_row(t, row, "Market direction", marketDirection, dirPass, dirManual)
            row += 1
            maPass = marketMAAlignScore >= 3.5
            maManual = marketMAAlignScore >= 1.5 and not maPass
            f_add_row(t, row, "MA 20/50/200 alignment", marketMaTxt, maPass, maManual)
            row += 1
            momPass = marketMomentumScore >= 3.5
            momManual = marketMomentumScore >= 1.5 and not momPass
            f_add_row(t, row, "RSI + MACD confirmation", marketMomentumTxt, momPass, momManual)
            row += 1
            if showMarketDebug
                dirDbg = dirBullBias ? "BULL" : dirBearBias ? "BEAR" : "NONE"
                debugTxt = "mUp/mDown=" + str.tostring(mUp) + "/" + str.tostring(mDown) + " ER=" + str.tostring(mEr, "#.##") + " dir=" + dirDbg + " macdN=" + str.tostring(macdNorm, "#.##") + " mE/x=" + str.tostring(macdEnterEff, "#.##") + "/" + str.tostring(macdExitEff, "#.##") + " stack=" + strengthTxt
                f_add_row(t, row, "Debug (market)", debugTxt, true, true)
                row += 1

            // Stock Behavior / Structure
            f_add_header(t, row, "Stock Behavior", "")
            row += 1
            if not ctxSpy1D
                rsSlopeUnit = (ctxStock4H or ctxStock1H) ? "%/day" : "%/bar"
                rsTxt = rsState + " (" + str.tostring(rsDelta * 100, "#.##") + "%, " + str.tostring(rsSlopeNorm * 100, "#.###") + rsSlopeUnit + ")"
                f_add_row(t, row, "Relative strength vs SPY", rsTxt, relClear, false)
                row += 1
            structTxt = localUp ? "HH/HL" : localDown ? "LH/LL" : "RANGE/CHOP"
            structManual = cleanStructure and not structStrong
            f_add_row(t, row, "Price structure", structTxt, structStrong, structManual)
            row += 1
            volTxt = not na(volRatio) ? str.tostring(volRatio, "#.##") + "x BASE" : "N/A"
            volStateTxt = volumeHealthy ? "HEALTHY (" + volTxt + ")" : "LOW (" + volTxt + ")"
            f_add_row(t, row, "Volume behavior", volStateTxt, volumeHealthy, false)
            row += 1
            levelTxt = hasKeyLevels ? "S:" + str.tostring(pivotLow, format.mintick) + " R:" + str.tostring(pivotHigh, format.mintick) : "NO CLEAR PIVOT LEVELS"
            f_add_row(t, row, "Key levels / structure points", levelTxt, hasKeyLevels, false)
            row += 1
            if ctxStock4H or ctxStock1H
                mtfTxt = mtfAlignedStrong ? "ALIGNED (STRONG)" : mtfAlignedWeak ? "ALIGNED (WEAK)" : "NOT ALIGNED"
                f_add_row(t, row, "Daily alignment (MTF)", mtfTxt, mtfAlignedStrong, mtfAlignedWeak)
                row += 1
            if ctxStock1H
                vwapTxt = close > vwapSession ? "ABOVE VWAP" : close < vwapSession ? "BELOW VWAP" : "AT VWAP"
                vwapPass = thesisBull ? close >= vwapSession : thesisBear ? close <= vwapSession : false
                f_add_row(t, row, "VWAP context (secondary)", vwapTxt, vwapPass, false)
                row += 1

            // Location
            f_add_header(t, row, "Location", "")
            row += 1
            f_add_row(t, row, "Location near key level", nearKeyLevel ? "NEAR LEVEL" : "MID-RANGE", nearKeyLevel, false)
            row += 1
            extTxt = not na(extAtr) ? str.tostring(extAtr, "#.##") + "x ATR from EMA20" : "N/A"
            f_add_row(t, row, "Not extended", notExtended ? "YES (" + extTxt + ")" : "EXTENDED (" + extTxt + ")", notExtended, false)
            row += 1

            // Risk Definition
            f_add_header(t, row, "Risk Definition", "")
            row += 1
            f_add_row(t, row, "Thesis direction", thesisDir, thesisBull or thesisBear, false)
            row += 1
            f_add_row(t, row, "Setup direction (options)", setupSideTxt, thesisBull or thesisBear, false)
            row += 1
            riskTxt = riskDefined ? "Stop@" + str.tostring(invalidation, format.mintick) + " | Risk " + str.tostring(riskDist, format.mintick) : "UNDEFINED"
            f_add_row(t, row, "Risk definition / invalidation", riskTxt, riskDefined, false)
            row += 1

            // Reward Justification
            f_add_header(t, row, "Reward Justification", "")
            row += 1
            rrTxt = not na(rr) ? "1:" + str.tostring(rr, "#.##") + " (Target " + str.tostring(targetLvl, format.mintick) + ")" : "N/A"
            f_add_row(t, row, "Reward justification (R:R)", rrTxt, rrAccept, false)
            row += 1

            // Block + final outputs
            f_add_header(t, row, "Scoring Block", "Value")
            row += 1
            marketScoreTxt = str.tostring(marketScore, "#.##") + "/20"
            f_add_row(t, row, "Market Alignment", marketScoreTxt, marketScore >= minMarketScoreReq, false)
            row += 1
            f_add_row(t, row, "Stock Behavior", str.tostring(behaviorScore) + "/20", behaviorScore >= 15, false)
            row += 1
            f_add_row(t, row, "Location", str.tostring(locationScore) + "/20", locationScore >= 10, false)
            row += 1
            f_add_row(t, row, "Risk Definition", str.tostring(riskScore) + "/20", riskScore >= 10, false)
            row += 1
            f_add_row(t, row, "Reward Justification", str.tostring(rewardScore) + "/20", rewardScore >= 10, false)
            row += 1

            table.cell(t, 0, row, "TOTAL SCORE", text_color=color.white, bgcolor=color.new(color.navy, 65), text_halign=text.align_left)
            table.cell(t, 1, row, str.tostring(score, "#.##") + "/100", text_color=color.white, bgcolor=color.new(color.navy, 65), text_halign=text.align_left)
            row += 1

            table.cell(t, 0, row, "GRADE (A/B/C/D)", text_color=color.white, bgcolor=gradeColor, text_halign=text.align_left)
            table.cell(t, 1, row, grade, text_color=color.white, bgcolor=gradeColor, text_halign=text.align_left)
            row += 1

            table.cell(t, 0, row, "SIZE DECISION", text_color=color.white, bgcolor=sizeColor, text_halign=text.align_left)
            table.cell(t, 1, row, sizeDecision, text_color=color.white, bgcolor=sizeColor, text_halign=text.align_left)
