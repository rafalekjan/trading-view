//@version=6
indicator("ModMark Market", overlay=true, max_labels_count=50)

//â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”
// Inputs (UI)
//â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”
showTable       = input.bool(true,  "Show table (visibility toggle)", group="Table")
showText        = input.bool(true, "Show table text", group="Table")
showNumbers     = input.bool(false, "Show numbers", group="Table")
visibilityPct   = input.int(100, "Visibility 0-100", minval=0, maxval=100, group="Table")
fontSizeOpt     = input.string("Tiny", "Font size", options=["Tiny","Small","Normal"], group="Table")
tablePos        = input.string("Top Right", "Table position", options=["Top Right","Top Left","Bottom Right","Bottom Left"], group="Table")
compact         = input.bool(false, "Compact rows", group="Table")
summaryOnly     = input.bool(false, "Summary only", group="Table")
showWhenUnsupported = input.bool(false, "Show status on unsupported chart", group="Table")
showFrame       = input.bool(true, "Show table frame", group="Table")
showBorders     = input.bool(true, "Show cell borders", group="Table")
frameWidthInp   = input.int(1, "Frame width", minval=0, maxval=5, group="Table")
borderWidthInp  = input.int(1, "Cell border width", minval=0, maxval=5, group="Table")
frameColorInp   = input.color(color.new(color.white, 0), "Frame color", group="Table")
borderColorInp  = input.color(color.new(color.white, 0), "Cell border color", group="Table")

// Thresholds (backend only; text output uses them)
leftRight       = input.int(3, "Swing pivot L/R", minval=1, maxval=20, group="Detection")
maSlopeLen      = input.int(10, "MA slope lookback", minval=2, maxval=100, group="Detection")
flatSlopePct    = input.float(0.08, "MA flat slope threshold (%)", minval=0.0, step=0.01, group="Detection")  // per lookback, in %
maCrossLookback = input.int(20, "MA cross lookback", minval=5, maxval=200, group="Detection")
maCrossChopMin  = input.int(6, "MA crosses = choppy if above", minval=1, maxval=100, group="Detection")
near200AtrMult  = input.float(0.50, "Near 200 MA zone (x ATR)", minval=0.05, step=0.05, group="Detection")
pullbackLookback= input.int(10, "Pullback respect lookback", minval=3, maxval=100, group="Detection")
rsiStructLen    = input.int(12, "RSI structure lookback", minval=5, maxval=100, group="Detection")
chaosLookback   = input.int(20, "Chaos lookback", minval=5, maxval=200, group="Detection")
indecisionMax   = input.float(0.35, "Indecision body/range max", minval=0.05, maxval=0.95, step=0.05, group="Detection")
majorLookback   = input.int(252, "Major S/R lookback", minval=50, maxval=1000, group="Detection")
majorPivotLR    = input.int(10, "Major pivot L/R", minval=3, maxval=50, group="Detection")
majorNearAtrMult= input.float(1.0, "Near major S/R (x ATR)", minval=0.1, step=0.1, group="Detection")
extendAtrMult   = input.float(2.0, "Extended from EMA20 (x ATR)", minval=0.5, step=0.1, group="Detection")
atrLen          = input.int(14, "ATR length", minval=2, group="Volatility")
atrPctVolHigh   = input.float(2.0, "ATR% = volatile if above", minval=0.1, step=0.1, group="Volatility")
atrPctVolExtreme= input.float(3.5, "ATR% = extreme if above", minval=0.1, step=0.1, group="Volatility")
atrChangeLen    = input.int(5, "ATR change lookback", minval=1, maxval=50, group="Volatility")
atrJumpPct      = input.float(25.0, "ATR jump warning (%)", minval=1.0, step=1.0, group="Volatility")
wideRangePct    = input.float(2.0, "Wide-range day threshold (%)", minval=0.1, step=0.1, group="Volatility")
gapPctThresh    = input.float(1.0, "Big gap threshold (%)", minval=0.1, step=0.1, group="Volatility")
followBars      = input.int(2, "Follow-through confirmation bars", minval=1, maxval=10, group="Follow-through")
rangeBreakLen   = input.int(20, "Range breakout lookback", minval=10, maxval=200, group="Follow-through")
failedLookback  = input.int(30, "Failed breakout lookback", minval=5, maxval=200, group="Follow-through")
breakoutVolMult = input.float(1.10, "Breakout volume min (x volMA)", minval=0.5, step=0.05, group="Follow-through")
macdFlipLookback= input.int(20, "MACD flip lookback", minval=5, maxval=200, group="Follow-through")
macdFlipChopMin = input.int(4, "MACD flips = choppy if above", minval=1, maxval=100, group="Follow-through")

//â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”
// Eligibility: ONLY SPY/QQQ on 1D
//â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”
is1D = timeframe.period == "D" or timeframe.period == "1D" or (timeframe.isdaily and timeframe.multiplier == 1)
tickerU = str.upper(syminfo.ticker)
tickerIdU = str.upper(syminfo.tickerid)
isSpy = (tickerU == "SPY") or str.contains(tickerIdU, ":SPY") or str.contains(tickerIdU, "SPY")
isQqq = (tickerU == "QQQ") or str.contains(tickerIdU, ":QQQ") or str.contains(tickerIdU, "QQQ")
isSpyQqq = isSpy or isQqq
tkr = isSpy ? "SPY" : isQqq ? "QQQ" : syminfo.ticker
ctxEligible = is1D and isSpyQqq
ctxDebugTxt = "TF=" + timeframe.period + " M=" + str.tostring(timeframe.multiplier) + " T=" + tickerU

//â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”
// Core calculations (backend)
//â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”
// MAs
ema20  = ta.ema(close, 20)
sma50  = ta.sma(close, 50)
sma200 = ta.sma(close, 200)
atr    = ta.atr(atrLen)

// MA slope as percent over lookback
slopePct(src, len) =>
    // percent change over len bars
    base = src[len]
    na(base) or base == 0.0 ? 0.0 : nz(100.0 * (src - base) / base)

clamp(float x, float lo, float hi) =>
    math.max(lo, math.min(hi, x))

clamp01(float x) =>
    clamp(x, 0.0, 1.0)

ema20Slope = slopePct(ema20, maSlopeLen)
sma50Slope = slopePct(sma50, maSlopeLen)
sma200Slope= slopePct(sma200, maSlopeLen)

isFlatSlope(v) => math.abs(v) < flatSlopePct

ema20Flat = isFlatSlope(ema20Slope)
sma50Flat = isFlatSlope(sma50Slope)
sma200Flat= isFlatSlope(sma200Slope)

// MA cross frequency (chop proxy)
crossCount = math.sum((ta.cross(close, ema20) ? 1.0 : 0.0) + (ta.cross(close, sma50) ? 1.0 : 0.0), maCrossLookback)
maCrossChoppy = crossCount >= maCrossChopMin

// Cleanliness / chaos proxies
insideBar = high <= high[1] and low >= low[1]
outsideBar = high >= high[1] and low <= low[1]
dirFlipBar = ta.change(close > open)
barRange = high - low
bodyRangeRatio = barRange > 0.0 ? math.abs(close - open) / barRange : 1.0
indecisionBar = bodyRangeRatio <= indecisionMax

insideCount = math.sum(insideBar ? 1.0 : 0.0, chaosLookback)
outsideCount = math.sum(outsideBar ? 1.0 : 0.0, chaosLookback)
flipCount = math.sum(dirFlipBar ? 1.0 : 0.0, chaosLookback)
indecisionCount = math.sum(indecisionBar ? 1.0 : 0.0, chaosLookback)

insideRate = insideCount / chaosLookback
outsideRate = outsideCount / chaosLookback
flipRate = flipCount / chaosLookback
indecisionRate = indecisionCount / chaosLookback

chaosNorm = clamp01((insideRate * 0.25 + outsideRate * 0.25 + flipRate * 0.25 + indecisionRate * 0.25) * 2.0)
cleanNorm = 1.0 - chaosNorm
cleanlinessTxt = cleanNorm >= 0.67 ? "CLEAN" : cleanNorm >= 0.45 ? "MIXED" : "CHAOTIC"
chaosTxt = "inside " + str.tostring(insideCount, "#") + " | outside " + str.tostring(outsideCount, "#") + " | flips " + str.tostring(flipCount, "#")

// Structure via pivots (last two highs/lows)
ph = ta.pivothigh(high, leftRight, leftRight)
pl = ta.pivotlow(low,  leftRight, leftRight)

var float lastPH = na
var float prevPH = na
var float lastPL = na
var float prevPL = na

if not na(ph)
    prevPH := lastPH
    lastPH := ph

if not na(pl)
    prevPL := lastPL
    lastPL := pl

haveSwings = not na(lastPH) and not na(prevPH) and not na(lastPL) and not na(prevPL)

hh = haveSwings and (lastPH > prevPH)
lh = haveSwings and (lastPH < prevPH)
hl = haveSwings and (lastPL > prevPL)
ll = haveSwings and (lastPL < prevPL)

structureTxt =
     not haveSwings ? "N/A (waiting for swings)" :
     (hh and hl) ? "HH + HL (bullish structure)" :
     (lh and ll) ? "LH + LL (bearish structure)" :
     "Overlapping / unclear (chop risk)"

// Major S/R map (52W + major pivots)
majorHigh52 = ta.highest(high, majorLookback)
majorLow52 = ta.lowest(low, majorLookback)
majorPh = ta.pivothigh(high, majorPivotLR, majorPivotLR)
majorPl = ta.pivotlow(low, majorPivotLR, majorPivotLR)
var float lastMajorPH = na
var float lastMajorPL = na
if not na(majorPh)
    lastMajorPH := majorPh
if not na(majorPl)
    lastMajorPL := majorPl

d52Res = math.abs(close - majorHigh52)
d52Sup = math.abs(close - majorLow52)
dPivotRes = not na(lastMajorPH) ? math.abs(close - lastMajorPH) : na
dPivotSup = not na(lastMajorPL) ? math.abs(close - lastMajorPL) : na

majorDist = d52Res
majorType = "52W RES"
if not na(d52Sup) and (na(majorDist) or d52Sup < majorDist)
    majorDist := d52Sup
    majorType := "52W SUP"
if not na(dPivotRes) and (na(majorDist) or dPivotRes < majorDist)
    majorDist := dPivotRes
    majorType := "PIVOT RES"
if not na(dPivotSup) and (na(majorDist) or dPivotSup < majorDist)
    majorDist := dPivotSup
    majorType := "PIVOT SUP"

majorDistNorm = atr != 0.0 ? majorDist / atr : na
majorNear = not na(majorDistNorm) and majorDistNorm <= majorNearAtrMult
majorSRTxt =
     na(majorDistNorm) ? "Major S/R not ready" :
     majorNear ? "Near " + majorType + " (" + str.tostring(majorDistNorm, "#.##") + "x ATR)" :
     "Away from major S/R (" + str.tostring(majorDistNorm, "#.##") + "x ATR)"

// 200 MA regime filter (text only)
dist200Atr = atr != 0.0 ? math.abs(close - sma200) / atr : na
near200 = not na(dist200Atr) and dist200Atr <= near200AtrMult
bias200Txt =
     na(sma200) ? "N/A (200 MA not ready)" :
     near200 ? "Around 200 MA zone (chop risk / caution)" :
     close > sma200 ? "Above 200 MA â†’ long bias" :
     close < sma200 ? "Below 200 MA â†’ short bias" :
     "At 200 MA â†’ caution"

// Relation to 20 EMA and 50 MA (text)
rel20Txt = close > ema20 ? "Price above 20 EMA (short-term momentum up)" : "Price below 20 EMA (short-term momentum down)"
rel50Txt = close > sma50 ? "Price above 50 MA (trend support intact)"    : "Price below 50 MA (trend weakening)"

// MA shape (flat vs sloped)
maShapeTxt =
     (ema20Flat and sma50Flat) ? "20/50 MAs flat â†’ range/chop conditions" :
     (ema20Slope > 0 and sma50Slope > 0) ? "20/50 MAs sloped up â†’ trend supportive" :
     (ema20Slope < 0 and sma50Slope < 0) ? "20/50 MAs sloped down â†’ trend supportive" :
     "MAs mixed/transition â†’ caution"

// RSI / MACD (text, no triggers)
rsi = ta.rsi(close, 14)
rsiTxt =
     rsi > 50 ? "RSI above 50 (bullish momentum regime)" :
     rsi < 50 ? "RSI below 50 (bearish momentum regime)" :
     "RSI ~ 50 (neutral / chop risk)"

[macdLine, signalLine, hist] = ta.macd(close, 12, 26, 9)
macdTxt =
     macdLine > signalLine and hist > 0 ? "MACD expanding bullish momentum" :
     macdLine < signalLine and hist < 0 ? "MACD expanding bearish momentum" :
     "MACD mixed/flattening (less reliable in chop)"

// RSI structure proxy (higher lows / lower highs)
rsiPh = ta.pivothigh(rsi, leftRight, leftRight)
rsiPl = ta.pivotlow(rsi, leftRight, leftRight)
var float lastRsiPH = na
var float prevRsiPH = na
var float lastRsiPL = na
var float prevRsiPL = na
if not na(rsiPh)
    prevRsiPH := lastRsiPH
    lastRsiPH := rsiPh
if not na(rsiPl)
    prevRsiPL := lastRsiPL
    lastRsiPL := rsiPl
rsiHaveSwings = not na(lastRsiPH) and not na(prevRsiPH) and not na(lastRsiPL) and not na(prevRsiPL)
rsiHL = rsiHaveSwings and lastRsiPL > prevRsiPL
rsiLH = rsiHaveSwings and lastRsiPH < prevRsiPH
rsiRecoverBull = ta.lowest(rsi, rsiStructLen) < 50 and rsi > 50
rsiRecoverBear = ta.highest(rsi, rsiStructLen) > 50 and rsi < 50
rsiConflict = (hh and hl and rsiLH) or (lh and ll and rsiHL)
rsiStructTxt =
     not rsiHaveSwings ? "RSI structure unavailable" :
     rsiConflict ? "RSI conflicts with price structure (caution)" :
     (rsiHL or rsiRecoverBull) ? "RSI supports bullish continuation" :
     (rsiLH or rsiRecoverBear) ? "RSI supports bearish continuation" :
     "RSI structure neutral"

rsiBearDiv = hh and rsiLH
rsiBullDiv = ll and rsiHL
rsiDivTxt =
     rsiBearDiv ? "Bearish RSI divergence warning" :
     rsiBullDiv ? "Bullish RSI divergence warning" :
     "No RSI divergence warning"

// MACD flipping frequency (chop proxy)
macdBull = macdLine > signalLine
macdFlipCount = math.sum(ta.change(macdBull) ? 1.0 : 0.0, macdFlipLookback)
macdFlipChoppy = macdFlipCount >= macdFlipChopMin
macdFlipTxt = macdFlipChoppy ? "MACD flips frequently (chop risk)" : "MACD side stable enough"

// Volume confirmation (simple validation text)
volMA = ta.sma(volume, 20)
priceUp = close > close[1]
volUp   = volume > volMA

volumeTxt =
     priceUp and volUp ? "Rising price + rising volume (healthy move)" :
     priceUp and not volUp ? "Rising price + falling/weak volume (caution)" :
     (not priceUp) and volUp ? "Falling price + rising volume (distribution / pressure)" :
     "Volume not confirming (neutral)"

// ATR / volatility regime
atrPct = 100.0 * atr / close

// Follow-through / failed breakouts (heuristic)
var int failedUp = 0
var int failedDn = 0

// Define â€śbreakoutâ€ť vs last swing high/low, and â€śfailâ€ť if closes back inside quickly
breakAbove = haveSwings and close > lastPH
breakBelow = haveSwings and close < lastPL
breakAboveVolOk = breakAbove and volume > volMA * breakoutVolMult
breakBelowVolOk = breakBelow and volume > volMA * breakoutVolMult

// follow-through: stays beyond level for N bars (simple)
barsSinceBreakAbove = ta.barssince(breakAbove)
barsSinceBreakBelow = ta.barssince(breakBelow)
ftUp = haveSwings and barsSinceBreakAbove == 0 ? (math.sum(close > lastPH ? 1.0 : 0.0, followBars) == followBars) : false
ftDn = haveSwings and barsSinceBreakBelow == 0 ? (math.sum(close < lastPL ? 1.0 : 0.0, followBars) == followBars) : false

rangeHi = ta.highest(high[1], rangeBreakLen)
rangeLo = ta.lowest(low[1], rangeBreakLen)
rangeBreakAbove = close > rangeHi
rangeBreakBelow = close < rangeLo
barsSinceRangeUp = ta.barssince(rangeBreakAbove)
barsSinceRangeDn = ta.barssince(rangeBreakBelow)
ftRangeUp = barsSinceRangeUp == 0 ? (math.sum(close > rangeHi ? 1.0 : 0.0, followBars) == followBars) : false
ftRangeDn = barsSinceRangeDn == 0 ? (math.sum(close < rangeLo ? 1.0 : 0.0, followBars) == followBars) : false
followModeTxt =
     (ftUp or ftDn) ? "Swing-based follow-through" :
     (ftRangeUp or ftRangeDn) ? "Range-based follow-through" :
     "No follow-through mode"

// failed breakout counting (within lookback window)
failUpNow = haveSwings and close[1] > lastPH and close < lastPH
failDnNow = haveSwings and close[1] < lastPL and close > lastPL

failedUp := int(math.sum(failUpNow ? 1.0 : 0.0, failedLookback))
failedDn := int(math.sum(failDnNow ? 1.0 : 0.0, failedLookback))

followTxt =
     (not haveSwings and not (ftRangeUp or ftRangeDn)) ? "N/A (waiting for swings/range break)" :
     (ftUp or ftDn or ftRangeUp or ftRangeDn) ? "Follow-through present (" + followModeTxt + ")" :
     ((failedUp + failedDn) >= 3) ? "Many failed breakouts (chop behavior)" :
     "No strong follow-through signal (neutral)"

breakoutVolTxt =
     not haveSwings ? "N/A (waiting for swings)" :
     breakAbove and not breakAboveVolOk ? "Breakout up without volume confirmation (caution)" :
     breakBelow and not breakBelowVolOk ? "Breakout down without volume confirmation (caution)" :
     breakAboveVolOk or breakBelowVolOk ? "Breakout volume confirmed" :
     "No active breakout"

// Market regime (3 regimes from blueprint: Trending / Choppy / Volatile)
isTrendUp   = haveSwings and hh and hl and (ema20Slope > 0) and (sma50Slope > 0) and not (ema20Flat or sma50Flat)
isTrendDown = haveSwings and lh and ll and (ema20Slope < 0) and (sma50Slope < 0) and not (ema20Flat or sma50Flat)
isChoppy    = (not haveSwings) ? false : (structureTxt == "Overlapping / unclear (chop risk)") or (ema20Flat and sma50Flat) or ((failedUp + failedDn) >= 3) or maCrossChoppy or macdFlipChoppy or near200
atrChangePct = atr[atrChangeLen] != 0.0 ? 100.0 * (atr - atr[atrChangeLen]) / atr[atrChangeLen] : 0.0
atrUnstable = math.abs(atrChangePct) >= atrJumpPct
wideRangeNow = 100.0 * (high - low) / close >= wideRangePct
gapNow = close[1] != 0.0 ? 100.0 * math.abs(open - close[1]) / close[1] : 0.0
bigGapNow = gapNow >= gapPctThresh
wideRangeCount = int(math.sum(wideRangeNow ? 1.0 : 0.0, failedLookback))
bigGapCount = int(math.sum(bigGapNow ? 1.0 : 0.0, failedLookback))
isVolatile  = atrPct >= atrPctVolHigh or atrUnstable
volTxt =
     atrPct >= atrPctVolExtreme ? "Volatility EXTREME (reduce size / caution)" :
     isVolatile and atrUnstable ? "Volatility unstable (ATR jump risk)" :
     isVolatile ? "Volatility HIGH (defensive / selective)" :
     "Volatility controlled (acceptable)"

regimeTxt =
     isVolatile ? "VOLATILE market" :
     isTrendUp ? "TRENDING (uptrend)" :
     isTrendDown ? "TRENDING (downtrend)" :
     isChoppy ? "CHOPPY / RANGE-BOUND" :
     "TRANSITION / MIXED"

// Pullback respect of EMA20 in trend context
bullRespects20 = isTrendUp and math.sum((low <= ema20 and close >= ema20) ? 1.0 : 0.0, pullbackLookback) >= 1 and math.sum(close < ema20 ? 1.0 : 0.0, pullbackLookback) <= 1
bearRespects20 = isTrendDown and math.sum((high >= ema20 and close <= ema20) ? 1.0 : 0.0, pullbackLookback) >= 1 and math.sum(close > ema20 ? 1.0 : 0.0, pullbackLookback) <= 1
pullbackRespectTxt =
     isTrendUp and bullRespects20 ? "Pullbacks respect 20 EMA (bull trend quality)" :
     isTrendDown and bearRespects20 ? "Pullbacks respect 20 EMA (bear trend quality)" :
     (isTrendUp or isTrendDown) ? "Trend pullbacks not clean vs 20 EMA" :
     "Not in trend context"

distEmaAtr = atr != 0.0 ? math.abs(close - ema20) / atr : na
isExtended = not na(distEmaAtr) and distEmaAtr > extendAtrMult
extendedTxt =
     isExtended ? (showNumbers ? "Price extended from 20 EMA (" + str.tostring(distEmaAtr, "#.##") + "x ATR)" : "Price extended from 20 EMA") :
     (showNumbers ? "Price not extended from 20 EMA (" + str.tostring(distEmaAtr, "#.##") + "x ATR)" : "Price not extended from 20 EMA")

overnightRisk = (wideRangeCount >= 5) or (bigGapCount >= 5) or atrUnstable
overnightTxt =
     overnightRisk ? "Overnight conditions unstable (gaps/range/ATR jump)" :
     "Overnight conditions acceptable"

// â€śTradeableâ€ť environment (text gate; no signals)
tradeable =
     (isTrendUp or isTrendDown) and not isChoppy and (atrPct < atrPctVolExtreme) and (not sma200Flat) and (not isExtended) and (not overnightRisk) and ((not breakAbove and not breakBelow) or breakAboveVolOk or breakBelowVolOk)

tradeableTxt =
     tradeable ? "Tradeable environment (supports swing context)" :
     "Not tradeable / cash is valid (defensive)"

// A-grade gate from doc: if choppy â†’ cannot be A-setup
agradeTxt =
     isChoppy ? "A-setup NOT allowed (chop environment)" :
     "A-setup gate passes (market not flagged as chop)"

doNothing = not tradeable or isChoppy or atrPct >= atrPctVolExtreme
doNothingTxt = doNothing ? "DO NOTHING / CASH is valid now" : "Actionable market context"

// Final risk mode (single operational label)
hardStopA = isChoppy
hardDefensive = hardStopA or atrPct >= atrPctVolExtreme or overnightRisk
riskMode = hardDefensive ? "DEFENSIVE" : (tradeable and not isVolatile and not near200 and cleanNorm >= 0.60 ? "NORMAL" : tradeable ? "REDUCED" : "DEFENSIVE")
riskModeTxt =
     riskMode == "NORMAL" ? "NORMAL (trend + controlled conditions)" :
     riskMode == "REDUCED" ? "REDUCED (tradeable but warnings active)" :
     "DEFENSIVE (cash / very selective only)"

// Market state scoring (0..100) with hard rules
scoreA = ((isTrendUp or isTrendDown) ? 15.0 : 0.0) +
     (((isTrendUp and ema20Slope > 0 and sma50Slope > 0) or (isTrendDown and ema20Slope < 0 and sma50Slope < 0)) ? 10.0 : 0.0) +
     ((not isChoppy and cleanNorm >= 0.50) ? 10.0 : cleanNorm >= 0.35 ? 5.0 : 0.0) -
     (isChoppy ? 15.0 : 0.0) -
     (near200 ? 8.0 : 0.0)
scoreA := clamp(scoreA, 0.0, 35.0)

rsiDirOk = (isTrendUp and rsi > 50) or (isTrendDown and rsi < 50)
rsiStructOk = (isTrendUp and (rsiHL or rsiRecoverBull)) or (isTrendDown and (rsiLH or rsiRecoverBear))
macdDirOk = (isTrendUp and macdLine > signalLine and hist > 0) or (isTrendDown and macdLine < signalLine and hist < 0)
scoreB = (rsiDirOk ? 8.0 : 0.0) + (rsiStructOk ? 6.0 : 0.0) + (macdDirOk ? 6.0 : 0.0) - (macdFlipChoppy ? 6.0 : 0.0)
scoreB := clamp(scoreB, 0.0, 20.0)

volTrendOk = (isTrendUp and priceUp and volUp) or (isTrendDown and (not priceUp) and volUp)
breakoutVolPenalty = (breakAbove and not breakAboveVolOk) or (breakBelow and not breakBelowVolOk)
scoreC = (volTrendOk ? 5.0 : 0.0) + (((not breakAbove and not breakBelow) or breakAboveVolOk or breakBelowVolOk) ? 5.0 : 0.0) - (breakoutVolPenalty ? 5.0 : 0.0)
scoreC := clamp(scoreC, 0.0, 10.0)

scoreD = (atrPct < atrPctVolHigh ? 10.0 : atrPct < atrPctVolExtreme ? 4.0 : 0.0) +
     ((not atrUnstable and wideRangeCount < 5 and bigGapCount < 5) ? 10.0 : not overnightRisk ? 4.0 : 0.0) -
     ((isVolatile and atrPct < atrPctVolExtreme) ? 8.0 : 0.0) -
     ((atrPct >= atrPctVolExtreme or overnightRisk) ? 15.0 : 0.0)
scoreD := clamp(scoreD, 0.0, 20.0)

failCount = failedUp + failedDn
scoreE = ((ftUp or ftDn) ? 8.0 : 0.0) + (failCount <= 2 ? 7.0 : failCount <= 4 ? 3.0 : 0.0) - (failCount >= 3 ? 10.0 : 0.0)
scoreE := clamp(scoreE, 0.0, 15.0)

marketScore = clamp(scoreA + scoreB + scoreC + scoreD + scoreE, 0.0, 100.0)
scoreStateTxt =
     hardDefensive ? "Defensive / do nothing (hard rule)" :
     marketScore >= 80 ? "Supportive market (A-grade eligible)" :
     marketScore >= 60 ? "Tradeable but selective (reduced risk)" :
     marketScore >= 40 ? "Mixed / caution (B/C environment)" :
     "Defensive / do nothing"

sizeDecision =
     hardDefensive or (not tradeable) ? "NO TRADE" :
     (marketScore >= 80 and riskMode == "NORMAL") ? "FULL" :
     marketScore >= 60 ? "HALF" :
     marketScore >= 40 ? "LIGHT" :
     "NO TRADE"
sizeDecisionTxt =
     sizeDecision == "FULL" ? "FULL (high conviction)" :
     sizeDecision == "HALF" ? "HALF (selective)" :
     sizeDecision == "LIGHT" ? "LIGHT (pilot / caution)" :
     "NO TRADE (cash / wait)"

scoreASummary = scoreA >= 24.0 ? "Structure strong" : scoreA >= 14.0 ? "Structure ok" : "Structure weak"
scoreBSummary = scoreB >= 13.0 ? "Momentum strong" : scoreB >= 7.0 ? "Momentum ok" : "Momentum weak"
scoreDSummary = scoreD >= 14.0 ? "Risk friendly" : scoreD >= 8.0 ? "Risk mixed" : "Risk hard"
subscoreTxt = scoreASummary + " | " + scoreBSummary + " | " + scoreDSummary

scoreAStateTxt = scoreA >= 24.0 ? "Strong" : scoreA >= 14.0 ? "Moderate" : "Weak"
scoreBStateTxt = scoreB >= 13.0 ? "Strong" : scoreB >= 7.0 ? "Moderate" : "Weak"
scoreCStateTxt = scoreC >= 6.0 ? "Strong" : scoreC >= 3.0 ? "Moderate" : "Weak"
scoreDStateTxt = scoreD >= 14.0 ? "Strong" : scoreD >= 8.0 ? "Moderate" : "Weak"
scoreEStateTxt = scoreE >= 9.0 ? "Strong" : scoreE >= 5.0 ? "Moderate" : "Weak"

maCrossTxt = str.tostring(crossCount, "#") + " crosses in last " + str.tostring(maCrossLookback) + " bars" + (maCrossChoppy ? " (choppy)" : " (ok)")
atrChangeTxt = "ATR change " + str.tostring(atrChangePct, "#.##") + "% over " + str.tostring(atrChangeLen) + " bars"
failedTxt = "Failed breaks: up " + str.tostring(failedUp) + " | down " + str.tostring(failedDn)
overnightDetailTxt = "Wide-range days: " + str.tostring(wideRangeCount) + " | big gaps: " + str.tostring(bigGapCount)

crossStateTxt = maCrossChoppy ? "High crossing (choppy)" : crossCount >= maCrossChopMin * 0.5 ? "Medium crossing" : "Low crossing"
atrChangeStateTxt = math.abs(atrChangePct) >= atrJumpPct ? "ATR spiking" : math.abs(atrChangePct) >= atrJumpPct * 0.5 ? "ATR rising" : "ATR stable"
failedStateTxt = failCount >= 5 ? "Many failed breakouts" : failCount >= 3 ? "Some failed breakouts" : "Rare failed breakouts"
overnightStateTxt = overnightRisk ? "Overnight elevated/unfriendly" : "Overnight normal"
majorSRStateTxt = na(majorDistNorm) ? "Major S/R not ready" : majorNear ? "Near major S/R" : "Away from major S/R"
extensionStateTxt = isExtended ? "Price extended from 20 EMA" : "Price not extended from 20 EMA"
chaosStateTxt = cleanNorm >= 0.67 ? "Chaos low" : cleanNorm >= 0.45 ? "Chaos medium" : "Chaos high"
scoreTxt = showNumbers ? str.tostring(marketScore, "#.##") + "/100" : scoreStateTxt
scoreTotalDisplayTxt = str.tostring(marketScore, "#.##") + "/100"
maCrossDisplayTxt = showNumbers ? maCrossTxt : crossStateTxt
atrChangeDisplayTxt = showNumbers ? atrChangeTxt : atrChangeStateTxt
failedDisplayTxt = showNumbers ? failedTxt : failedStateTxt
overnightDetailDisplayTxt = showNumbers ? overnightDetailTxt : overnightStateTxt
majorSRDisplayTxt = showNumbers ? majorSRTxt : majorSRStateTxt
extensionDisplayTxt = showNumbers ? extendedTxt : extensionStateTxt
chaosDisplayTxt = showNumbers ? chaosTxt : chaosStateTxt
subscoreDisplayTxt = showNumbers ? "See numeric breakdown below" : subscoreTxt
scoreADisplayTxt = showNumbers ? str.tostring(scoreA, "#.##") + "/35" : scoreAStateTxt
scoreBDisplayTxt = showNumbers ? str.tostring(scoreB, "#.##") + "/20" : scoreBStateTxt
scoreCDisplayTxt = showNumbers ? str.tostring(scoreC, "#.##") + "/10" : scoreCStateTxt
scoreDDisplayTxt = showNumbers ? str.tostring(scoreD, "#.##") + "/20" : scoreDStateTxt
scoreEDisplayTxt = showNumbers ? str.tostring(scoreE, "#.##") + "/15" : scoreEStateTxt
goNoGo = tradeable and not hardDefensive
decisionSummaryTxt = goNoGo ? "GO" : "NO-GO"
hardStopSummaryTxt = hardDefensive ? "YES" : "NO"
aSetupSummaryTxt = isChoppy ? "BLOCKED" : "ALLOWED"

structureStatus = (isTrendUp or isTrendDown) ? 2 : isChoppy ? 0 : 1
zone200Status = near200 and isChoppy ? 0 : near200 ? 1 : close < sma200 ? 1 : 2
cleanStatus = cleanNorm >= 0.67 ? 2 : cleanNorm >= 0.45 ? 1 : 0
momentumStatus = rsiConflict ? 0 : macdFlipChoppy ? 1 : 2
crossStatus = maCrossChoppy ? 0 : crossCount >= maCrossChopMin * 0.5 ? 1 : 2
volStatus = atrPct >= atrPctVolExtreme ? 0 : isVolatile ? 1 : 2
overnightWarn = not overnightRisk and (wideRangeCount >= 3 or bigGapCount >= 3)
overnightStatus = overnightRisk ? 0 : overnightWarn ? 1 : 2
followStatus = (ftUp or ftDn or ftRangeUp or ftRangeDn) ? 2 : failCount >= 3 ? 0 : 1
aSetupStatus = isChoppy ? 0 : 2
riskStatusRaw = riskMode == "NORMAL" ? 2 : riskMode == "REDUCED" ? 1 : 0

okCount = (structureStatus == 2 ? 1 : 0) + (zone200Status == 2 ? 1 : 0) + (cleanStatus == 2 ? 1 : 0) + (momentumStatus == 2 ? 1 : 0) + (crossStatus == 2 ? 1 : 0) + (volStatus == 2 ? 1 : 0) + (overnightStatus == 2 ? 1 : 0) + (followStatus == 2 ? 1 : 0) + (aSetupStatus == 2 ? 1 : 0) + (riskStatusRaw == 2 ? 1 : 0)
warnCount = (structureStatus == 1 ? 1 : 0) + (zone200Status == 1 ? 1 : 0) + (cleanStatus == 1 ? 1 : 0) + (momentumStatus == 1 ? 1 : 0) + (crossStatus == 1 ? 1 : 0) + (volStatus == 1 ? 1 : 0) + (overnightStatus == 1 ? 1 : 0) + (followStatus == 1 ? 1 : 0) + (aSetupStatus == 1 ? 1 : 0) + (riskStatusRaw == 1 ? 1 : 0)
badCount = (structureStatus == 0 ? 1 : 0) + (zone200Status == 0 ? 1 : 0) + (cleanStatus == 0 ? 1 : 0) + (momentumStatus == 0 ? 1 : 0) + (crossStatus == 0 ? 1 : 0) + (volStatus == 0 ? 1 : 0) + (overnightStatus == 0 ? 1 : 0) + (followStatus == 0 ? 1 : 0) + (aSetupStatus == 0 ? 1 : 0) + (riskStatusRaw == 0 ? 1 : 0)
healthScore = float(okCount * 2 + warnCount)
healthMax = float((okCount + warnCount + badCount) * 2)
healthPct = healthMax > 0 ? 100.0 * healthScore / healthMax : 0.0
healthStateTxt = healthPct >= 75 ? "STRONG" : healthPct >= 55 ? "OK" : "WEAK"
checklistSummaryTxt = "OK " + str.tostring(okCount) + " | WARN " + str.tostring(warnCount) + " | BAD " + str.tostring(badCount)
checklistDisplayTxt = showNumbers ? checklistSummaryTxt + " | " + str.tostring(healthPct, "#.##") + "% " + healthStateTxt : checklistSummaryTxt + " | " + healthStateTxt

softDefensive = badCount >= 3 or healthPct < 55
softStopSummaryTxt = softDefensive ? "YES" : "NO"
riskModeEff = hardDefensive ? "DEFENSIVE" : softDefensive and riskMode == "NORMAL" ? "REDUCED" : riskMode
riskModeSummaryTxt = riskModeEff == "NORMAL" ? "NORMAL" : riskModeEff == "REDUCED" ? "REDUCED" : "DEFENSIVE"

combinedScoreBase = clamp(0.70 * marketScore + 0.30 * healthPct, 0.0, 100.0)
overallRankRaw = combinedScoreBase >= 80 ? 4 : combinedScoreBase >= 60 ? 3 : combinedScoreBase >= 40 ? 2 : 1
overallRank = hardDefensive ? 1 : overallRankRaw
overallRank := badCount >= 4 ? math.min(overallRank, 2) : overallRank
overallRank := healthPct < 55 ? math.min(overallRank, 3) : overallRank
overallStateShort = overallRank == 4 ? "SUPPORTIVE" : overallRank == 3 ? "SELECTIVE" : overallRank == 2 ? "MIXED" : "DEFENSIVE"
overallLabelTxt = overallStateShort
overallSummaryTxt = showNumbers ? overallLabelTxt + " (M " + str.tostring(marketScore, "#.##") + " | H " + str.tostring(healthPct, "#.##") + " | C " + str.tostring(combinedScoreBase, "#.##") + ")" : overallLabelTxt

issueVol = atrPct >= atrPctVolExtreme
issueOvernight = overnightRisk
issueChop = isChoppy or maCrossChoppy or near200
issueNoDir = not haveSwings or ((not isTrendUp) and (not isTrendDown))
issueMomentum = rsiConflict or macdFlipChoppy
issueChaos = cleanNorm < 0.45
issueExtended = isExtended
issuePullbackControl = (isTrendUp and not bullRespects20) or (isTrendDown and not bearRespects20)

topIssueTxt = issueVol ? "Volatility EXTREME" : issueOvernight ? "Overnight risk elevated" : issueChop ? "CHOP conditions" : issueNoDir ? "Structure unclear / no trend" : issueMomentum ? "Momentum conflict" : issueChaos ? "Chaos high" : issueExtended ? "Price extended" : "No major issue"
topIssueSeverity = issueVol or issueOvernight or issueChop or issueNoDir ? 0 : issueMomentum or issueChaos or issueExtended ? 1 : 2
secondaryIssueTxt = topIssueTxt == "No major issue" ? "None" :
     topIssueTxt != "Overnight risk elevated" and issueOvernight ? "Overnight risk elevated" :
     topIssueTxt != "CHOP conditions" and issueChop ? "CHOP conditions" :
     topIssueTxt != "Structure unclear / no trend" and issueNoDir ? "Structure unclear / no trend" :
     topIssueTxt != "Momentum conflict" and issueMomentum ? "Momentum conflict" :
     topIssueTxt != "Chaos high" and issueChaos ? "Chaos high" :
     topIssueTxt != "Price extended" and issueExtended ? "Price extended" :
     "None"
secondaryIssueSeverity = secondaryIssueTxt == "None" ? 2 : (secondaryIssueTxt == "Momentum conflict" or secondaryIssueTxt == "Chaos high" or secondaryIssueTxt == "Price extended") ? 1 : 0

primaryBlockerTxt = issueVol ? "Volatility EXTREME" : issueOvernight ? "Overnight risk elevated" : issueChop ? "CHOP conditions" : issueNoDir ? "Structure unclear / no trend" : "None"
secondaryBlockerTxt = primaryBlockerTxt != "Overnight risk elevated" and issueOvernight ? "Overnight risk elevated" :
     primaryBlockerTxt != "CHOP conditions" and issueChop ? "CHOP conditions" :
     primaryBlockerTxt != "Structure unclear / no trend" and issueNoDir ? "Structure unclear / no trend" :
     "None"
blockersTxt = primaryBlockerTxt == "None" ? (softDefensive ? "No hard blocker (soft-stop active)" : "None") : (secondaryBlockerTxt == "None" ? primaryBlockerTxt : primaryBlockerTxt + " | " + secondaryBlockerTxt)
blockersSeverity = primaryBlockerTxt == "None" ? (softDefensive ? 1 : 2) : 0

warningPrimaryTxt = issueMomentum ? "Momentum conflict" : issueChaos ? "Chaos high" : issuePullbackControl ? "Pullbacks not controlled" : issueExtended ? "Price extended" : "None"
warningSecondaryTxt = warningPrimaryTxt != "Chaos high" and issueChaos ? "Chaos high" :
     warningPrimaryTxt != "Momentum conflict" and issueMomentum ? "Momentum conflict" :
     warningPrimaryTxt != "Pullbacks not controlled" and issuePullbackControl ? "Pullbacks not controlled" :
     warningPrimaryTxt != "Price extended" and issueExtended ? "Price extended" :
     "None"
warningsTxt = warningPrimaryTxt == "None" ? "None" : (warningSecondaryTxt == "None" ? warningPrimaryTxt : warningPrimaryTxt + " | " + warningSecondaryTxt)
warningsSeverity = warningPrimaryTxt == "None" ? 2 : 1
topBlockerSummaryTxt = primaryBlockerTxt == "None" ? (softDefensive ? "No hard blocker (soft-stop active)" : "None") : primaryBlockerTxt

waitForTxt =
     issueVol ? "Wait: volatility cools down" :
     issueOvernight ? "Wait: gaps and wide ranges normalize" :
     issueChop ? (near200 ? "Wait: clean move away from 200 MA zone" : "Wait: cleaner trend and follow-through") :
     issueNoDir ? "Wait: structure and trend become clear" :
     issueMomentum ? "Wait: RSI and MACD align" :
     issueChaos ? "Wait: cleaner candles and less whipsaw" :
     issuePullbackControl ? "Wait: pullbacks hold 20 EMA cleanly" :
     issueExtended ? "Wait: pullback toward 20 EMA" :
     softDefensive ? "Wait: checklist health improves" :
     "No unlock condition needed"
waitForSeverity = primaryBlockerTxt == "None" ? (softDefensive ? 1 : 2) : 1

proceedRank = hardDefensive ? 0 : goNoGo ? (softDefensive ? 1 : 2) : 0
proceedTxt = proceedRank == 2 ? "YES" : proceedRank == 1 ? "CAUTIOUS" : "NO"
riskPlanTxt = hardDefensive or not goNoGo ? "NO TRADE" : (softDefensive or riskModeEff == "REDUCED" ? "HALF" : "FULL")
riskPlanSeverity = riskPlanTxt == "FULL" ? 2 : riskPlanTxt == "HALF" ? 1 : 0
marketQualityTxt = tradeableTxt
marketQualitySeverity = hardDefensive ? 0 : goNoGo ? (softDefensive ? 1 : 2) : 0

confidenceRank = badCount >= 3 ? 0 : badCount <= 2 ? 1 : 1
confidenceRank := badCount == 0 and warnCount <= 2 ? 2 : confidenceRank
confidenceTxt = confidenceRank == 2 ? "HIGH" : confidenceRank == 1 ? "MED" : "LOW"

nextStepTxt = hardDefensive ? "Stop: hard defensive" : not goNoGo ? "Stop: market not supportive" : softDefensive ? "Proceed with reduced/selective risk" : "Proceed to stock selection"

//â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”
// Table
//â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”
pos =
     tablePos == "Top Left" ? position.top_left :
     tablePos == "Bottom Left" ? position.bottom_left :
     tablePos == "Bottom Right" ? position.bottom_right :
     position.top_right

// Table instance with runtime-configurable frame/border visibility.
rowsSupportedSummaryOnly = 12
rowsSupportedSummary = summaryOnly ? rowsSupportedSummaryOnly : 24
rowsSupportedScoreBreakdown = summaryOnly ? 0 : 2
rowsSupportedDetail = summaryOnly ? 0 : (not compact ? 16 : 0)
rowsSupported = rowsSupportedSummary + rowsSupportedScoreBreakdown + rowsSupportedDetail
rowsUnsupported = showWhenUnsupported ? 5 : 0
rowsTarget = ctxEligible ? rowsSupported : rowsUnsupported
panelEnabled = showTable and rowsTarget > 0
var table t = na
var int rowsActive = 0
visPctNow = float(math.max(0, math.min(100, visibilityPct)))
visAlphaNow = int(math.round(100.0 - visPctNow))
textColorNow = showText ? color.new(chart.fg_color, visAlphaNow) : color.new(chart.fg_color, 100)
rowBgAlphaNow = int(math.round(100.0 - visPctNow * 0.30))
sectionBgAlphaNow = int(math.round(100.0 - visPctNow * 0.45))
rowBgColorNow = color.new(color.black, rowBgAlphaNow)
sectionBgColorNow = color.new(color.gray, sectionBgAlphaNow)
frameColorNow = color.new(frameColorInp, visAlphaNow)
borderColorNow = color.new(borderColorInp, visAlphaNow)
textSizeNow = fontSizeOpt == "Tiny" ? size.tiny : fontSizeOpt == "Small" ? size.small : size.normal
emphTextColorNow = showText ? color.new(color.white, visAlphaNow) : color.new(color.white, 100)
statusAlphaNow = int(math.min(95, visAlphaNow + 35))
goodBgColorNow = color.new(color.green, statusAlphaNow)
warnBgColorNow = color.new(color.orange, statusAlphaNow)
badBgColorNow = color.new(color.red, statusAlphaNow)
decisionBgColorNow = goNoGo ? goodBgColorNow : badBgColorNow
proceedBgColorNow = proceedRank == 2 ? goodBgColorNow : proceedRank == 1 ? warnBgColorNow : badBgColorNow
hardStopBgColorNow = hardDefensive ? badBgColorNow : goodBgColorNow
softStopBgColorNow = softDefensive ? warnBgColorNow : goodBgColorNow
overallBgColorNow = overallRank == 4 ? goodBgColorNow : overallRank == 3 ? warnBgColorNow : overallRank == 2 ? warnBgColorNow : badBgColorNow
riskModeBgColorNow = riskModeEff == "NORMAL" ? goodBgColorNow : riskModeEff == "REDUCED" ? warnBgColorNow : badBgColorNow
checklistBgColorNow = healthPct >= 75 ? goodBgColorNow : healthPct >= 55 ? warnBgColorNow : badBgColorNow
blockersBgColorNow = blockersSeverity == 2 ? goodBgColorNow : blockersSeverity == 1 ? warnBgColorNow : badBgColorNow
warningsBgColorNow = warningsSeverity == 2 ? goodBgColorNow : warningsSeverity == 1 ? warnBgColorNow : badBgColorNow
waitForBgColorNow = waitForSeverity == 2 ? goodBgColorNow : waitForSeverity == 1 ? warnBgColorNow : badBgColorNow
riskPlanBgColorNow = riskPlanSeverity == 2 ? goodBgColorNow : riskPlanSeverity == 1 ? warnBgColorNow : badBgColorNow
marketQualityBgColorNow = marketQualitySeverity == 2 ? goodBgColorNow : marketQualitySeverity == 1 ? warnBgColorNow : badBgColorNow
confidenceBgColorNow = confidenceRank == 2 ? goodBgColorNow : confidenceRank == 1 ? warnBgColorNow : badBgColorNow
nextStepBgColorNow = hardDefensive ? badBgColorNow : softDefensive ? warnBgColorNow : goNoGo ? goodBgColorNow : badBgColorNow
volatilityBgColorNow = atrPct >= atrPctVolExtreme ? badBgColorNow : isVolatile ? warnBgColorNow : goodBgColorNow
overnightBgColorNow = overnightRisk ? badBgColorNow : goodBgColorNow

setRow(_r, _k, _v) =>
    table.cell(t, 0, _r, _k, text_halign=text.align_left, text_color=textColorNow, bgcolor=rowBgColorNow, text_size=textSizeNow)
    table.cell(t, 1, _r, _v, text_halign=text.align_left, text_color=textColorNow, bgcolor=rowBgColorNow, text_size=textSizeNow)

setHeader(_r, _txt) =>
    table.cell(t, 0, _r, _txt, text_halign=text.align_left, text_color=textColorNow, bgcolor=sectionBgColorNow, text_size=textSizeNow)
    table.cell(t, 1, _r, "", text_halign=text.align_left, text_color=textColorNow, bgcolor=sectionBgColorNow, text_size=textSizeNow)
    table.merge_cells(t, 0, _r, 1, _r)

setRowStatus(_r, _k, _v, _bg) =>
    table.cell(t, 0, _r, _k, text_halign=text.align_left, text_color=emphTextColorNow, bgcolor=_bg, text_size=textSizeNow)
    table.cell(t, 1, _r, _v, text_halign=text.align_left, text_color=emphTextColorNow, bgcolor=_bg, text_size=textSizeNow)

if barstate.islast
    if not panelEnabled
        if not na(t)
            table.delete(t)
            t := na
            rowsActive := 0
    else
        if na(t) or rowsActive != rowsTarget
            if not na(t)
                table.delete(t)
            t := table.new(pos, 2, rowsTarget, frame_width=1, border_width=1, frame_color=frameColorInp, border_color=borderColorInp)
            rowsActive := rowsTarget

        table.set_position(t, pos)
        table.set_frame_color(t, frameColorNow)
        table.set_border_color(t, borderColorNow)
        table.set_frame_width(t, showFrame and visibilityPct > 0 ? frameWidthInp : 0)
        table.set_border_width(t, showBorders and visibilityPct > 0 ? borderWidthInp : 0)

        r = 0
        if not ctxEligible
            setRow(r, "Market -> Daily", syminfo.ticker + " | " + timeframe.period)
            r += 1
            setRow(r, "Status", "Unsupported chart for this module")
            r += 1
            setRow(r, "Required", "SPY or QQQ on 1D")
            r += 1
            setRow(r, "Detected", ctxDebugTxt)
            r += 1
            setRow(r, "Tip", "Switch symbol/timeframe or disable this panel")
        else
            setRow(r, "Market -> Daily", tkr + " | " + timeframe.period)
            r += 1
            setHeader(r, "--- SUMMARY ---")
            r += 1
            setRowStatus(r, "Decision", decisionSummaryTxt, decisionBgColorNow)
            r += 1
            setRowStatus(r, "Overall", overallSummaryTxt, overallBgColorNow)
            r += 1
            setRowStatus(r, "Risk Mode", riskModeSummaryTxt, riskModeBgColorNow)
            r += 1
            setRowStatus(r, "Proceed", proceedTxt, proceedBgColorNow)
            r += 1
            setRowStatus(r, "Top Blocker", topBlockerSummaryTxt, blockersBgColorNow)
            r += 1
            setRowStatus(r, "Warnings", warningsTxt, warningsBgColorNow)
            r += 1
            setRowStatus(r, "Wait For", waitForTxt, waitForBgColorNow)
            r += 1
            setRowStatus(r, "Risk Plan", riskPlanTxt, riskPlanBgColorNow)
            r += 1
            setRowStatus(r, "Trade Quality", marketQualityTxt, marketQualityBgColorNow)
            r += 1
            setRowStatus(r, "Next Step", nextStepTxt, nextStepBgColorNow)
            r += 1

            if not summaryOnly
                setHeader(r, "--- STRUCTURE ---")
                r += 1
                setRow(r, "Structure", structureTxt)
                r += 1
                setRow(r, "200 MA Filter", bias200Txt)
                r += 1
                setRow(r, "Major S/R", majorSRDisplayTxt)
                r += 1
                setRow(r, "Structure Cleanliness", cleanlinessTxt)
                r += 1

                setHeader(r, "--- MOMENTUM ---")
                r += 1
                setRow(r, "RSI Regime", rsiTxt)
                r += 1
                setRow(r, "MACD Regime", macdTxt)
                r += 1

                setHeader(r, "--- RISK / OVERNIGHT ---")
                r += 1
                setRowStatus(r, "ATR / Volatility", volTxt, volatilityBgColorNow)
                r += 1
                setRowStatus(r, "Overnight Risk", overnightTxt, overnightBgColorNow)
                r += 1
                setRow(r, "Follow-through", followTxt)
                r += 1

                if not compact
                    setHeader(r, "--- DETAILS ---")
                    r += 1
                    setRow(r, "MA Shape", maShapeTxt)
                    r += 1
                    setRow(r, "20 EMA", rel20Txt)
                    r += 1
                    setRow(r, "50 MA", rel50Txt)
                    r += 1
                    setRow(r, "MA Cross Frequency", maCrossDisplayTxt)
                    r += 1
                    setRow(r, "20 EMA Pullback Respect", pullbackRespectTxt)
                    r += 1
                    setRow(r, "Extension", extensionDisplayTxt)
                    r += 1
                    setRow(r, "RSI Structure", rsiStructTxt)
                    r += 1
                    setRow(r, "RSI Divergence", rsiDivTxt)
                    r += 1
                    setRow(r, "MACD Flip State", macdFlipTxt)
                    r += 1
                    setRow(r, "Volume", volumeTxt)
                    r += 1
                    setRow(r, "Breakout Volume", breakoutVolTxt)
                    r += 1
                    setRow(r, "ATR Change", atrChangeDisplayTxt)
                    r += 1
                    setRow(r, "Overnight Details", overnightDetailDisplayTxt)
                    r += 1
                    setRow(r, "Failed Breakouts", failedDisplayTxt)
                    r += 1
                    setRow(r, "Chaos Detail", chaosDisplayTxt)
                    r += 1

                setHeader(r, "--- SCORE ---")
                r += 1
                setRow(r, "Score Total", scoreTotalDisplayTxt)
                r += 1
// Optional: no plots (document says prefer text output)
