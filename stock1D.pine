//@version=6
indicator("Ticker - Direction & Context 1D", overlay=true, max_labels_count=500)

//====================================================
// INPUTS
//====================================================
groupUI = "UI"
showTable = input.bool(true, "Show Ticker Table", group=groupUI)
showNearestSRLines = input.bool(false, "Show nearest R/S lines", group=groupUI)
enforce1D = input.bool(true, "Warn if not 1D", group=groupUI)
hardStopWrongTF = input.bool(false, "Hard stop if not 1D", group=groupUI)

groupSrc = "Sources"
spySymbol = input.symbol("AMEX:SPY", "SPY symbol (alignment / RS)", group=groupSrc)

groupMA = "Moving Averages"
emaLen = input.int(20, "EMA length", minval=1, group=groupMA)
sma50Len = input.int(50, "SMA50 length", minval=1, group=groupMA)
sma200Len = input.int(200, "SMA200 length", minval=1, group=groupMA)

groupATR = "ATR"
atrLen = input.int(14, "ATR length", minval=1, group=groupATR)
atrPctVolatile = input.float(2.0, "ATR% volatile threshold", minval=0.5, maxval=10.0, step=0.1, group=groupATR)
atrPctLow = input.float(1.0, "ATR% low threshold", minval=0.2, maxval=5.0, step=0.1, group=groupATR)

groupStructure = "Structure / Regime"
pivotLen = input.int(5, "Pivot length (D1 structure)", minval=2, maxval=20, group=groupStructure)
rangeLookback = input.int(20, "Range lookback (days)", minval=10, maxval=120, group=groupStructure)
rangeRefLookback = input.int(60, "Range reference lookback (days)", minval=20, maxval=300, group=groupStructure)
chopAtrMult = input.float(0.6, "Chop around MAs: dist <= ATR *", minval=0.1, maxval=2.0, step=0.05, group=groupStructure)
donLen = input.int(20, "Donchian length (DCH/DCL)", minval=5, maxval=200, group=groupStructure)

groupRS = "Relative Strength vs SPY"
rsMaLen = input.int(20, "RS MA length", minval=5, maxval=200, group=groupRS)
rsSlopeLen = input.int(5, "RS slope lookback", minval=2, maxval=30, group=groupRS)
rsFlatThr = input.float(0.001, "RS flat threshold", minval=0.0, maxval=5.0, step=0.001, group=groupRS)

//====================================================
// SAFETY: designed for 1D
//====================================================
isDaily = timeframe.isdaily
isSpyTicker = syminfo.ticker == "SPY"
tfWarn =
     (enforce1D and not isDaily and isSpyTicker) ? "WARN: Use non-SPY on 1D" :
     (enforce1D and not isDaily) ? "WARN: Use 1D" :
     (enforce1D and isSpyTicker) ? "WARN: Use non-SPY ticker" :
     ""
if enforce1D and hardStopWrongTF and (not isDaily or isSpyTicker)
    runtime.error("This script is designed for non-SPY tickers on 1D timeframe.")

//====================================================
// COMMON HELPERS
//====================================================
f_fmt2(x) => na(x) ? "na" : str.tostring(x, "#.##")

//====================================================
// LEVELS (Ticker)
//====================================================
pdh = high[1]
pdl = low[1]

pwh = request.security(syminfo.tickerid, "W", high[1], barmerge.gaps_off, barmerge.lookahead_off)
pwl = request.security(syminfo.tickerid, "W", low[1],  barmerge.gaps_off, barmerge.lookahead_off)

dch = ta.highest(high, donLen)
dcl = ta.lowest(low, donLen)

ema20 = ta.ema(close, emaLen)
sma50 = ta.sma(close, sma50Len)
sma200 = ta.sma(close, sma200Len)

vwapD = ta.vwap(hlc3)
vwapState = close > vwapD ? "Above" : close < vwapD ? "Below" : "Around"

atr = ta.atr(atrLen)
atrPct = close != 0 ? (atr / close) * 100.0 : na
atrEnv = atrPct < atrPctLow ? "Low" : atrPct >= atrPctVolatile ? "High" : "Normal"

//====================================================
// TREND STRENGTH (Ticker)
//====================================================
distToMAs = math.min(math.min(math.abs(close - ema20), math.abs(close - sma50)), math.abs(close - sma200))
trendStrength =
     distToMAs <= atr * chopAtrMult ? "Chop around MAs" :
     close > ema20 and close > sma50 and close > sma200 ? "Above key MAs" :
     close < ema20 and close < sma50 and close < sma200 ? "Below key MAs" :
     "Chop around MAs"

//====================================================
// STRUCTURE (Ticker) via pivots
//====================================================
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

var float lastPH = na
var float prevPH = na
var float lastPL = na
var float prevPL = na

if not na(ph)
    prevPH := lastPH
    lastPH := ph

if not na(pl)
    prevPL := lastPL
    lastPL := pl

hasTwoHighs = not na(lastPH) and not na(prevPH)
hasTwoLows  = not na(lastPL) and not na(prevPL)

hh = hasTwoHighs and lastPH > prevPH
lh = hasTwoHighs and lastPH < prevPH
hl = hasTwoLows and lastPL > prevPL
ll = hasTwoLows and lastPL < prevPL

structure =
     (hh and hl) ? "HH/HL" :
     (lh and ll) ? "LL/LH" :
     "Mixed"

rangeHigh = ta.highest(high, rangeLookback)
rangeLow  = ta.lowest(low, rangeLookback)
rangeWidthPct = close != 0 ? ((rangeHigh - rangeLow) / close) * 100.0 : na
isRange = rangeWidthPct < (atrPctVolatile * 1.5) and trendStrength == "Chop around MAs"
structure := isRange ? "Range" : structure

//====================================================
// BIAS (auto) + REGIME (Ticker)
//====================================================
bias =
     (structure == "HH/HL" and trendStrength == "Above key MAs") ? "Bullish" :
     (structure == "LL/LH" and trendStrength == "Below key MAs") ? "Bearish" :
     "Neutral"

regime =
     structure == "Range" or trendStrength == "Chop around MAs" ? "Range" :
     atrPct >= atrPctVolatile ? "Volatile" :
     bias == "Bullish" ? "Trend Up" :
     bias == "Bearish" ? "Trend Down" :
     "Range"

//====================================================
// MOMENTUM (Ticker) – same heuristic as SPY
//====================================================
rsi = ta.rsi(close, 14)
rsiSlope = rsi - rsi[5]
atrSlope = atrPct - atrPct[5]
atrSlopeFlatThr = 0.05

rng = high - low
closePos = rng != 0 ? (close - low) / rng : 0.5
wickUp = high - math.max(open, close)
wickDn = math.min(open, close) - low

diverging =
     (bias == "Bullish" and rsiSlope < 0 and close > close[5]) or
     (bias == "Bearish" and rsiSlope > 0 and close < close[5])

exhausted =
     (bias == "Bullish" and rsi > 70 and wickUp > rng * 0.35) or
     (bias == "Bearish" and rsi < 30 and wickDn > rng * 0.35) or
     (atrSlope > 0.5 and atrPct >= atrPctVolatile)

expanding =
     (bias == "Bullish" and closePos > 0.7 and atrSlope > 0) or
     (bias == "Bearish" and closePos < 0.3 and atrSlope > 0)

momentum =
     exhausted ? "Exhausted" :
     diverging ? "Diverging" :
     expanding ? "Expanding" :
     "Stable"

//====================================================
// HELPERS (Ticker)
//====================================================
rangeRefPct = ta.sma(rangeWidthPct, rangeRefLookback)
rangeState =
     na(rangeWidthPct) or na(rangeRefPct) ? "N/A" :
     rangeWidthPct >= rangeRefPct * 1.2 ? "Wider than normal" :
     rangeWidthPct <= rangeRefPct * 0.8 ? "Narrow vs normal" :
     "Around normal range"

rsiState =
     na(rsi) ? "N/A" :
     rsi >= 70 ? "High" :
     rsi <= 30 ? "Low" :
     rsi >= 55 ? "Bullish/firm" :
     rsi <= 45 ? "Bearish/soft" :
     "Neutral"

atrSlopeState =
     na(atrSlope) ? "N/A" :
     atrSlope > atrSlopeFlatThr ? "Rising volatility" :
     atrSlope < -atrSlopeFlatThr ? "Volatility cooling" :
     "Volatility stable"

//====================================================
// SPY BIAS (for alignment) – computed in SPY context
// (simplified but consistent: structure+pivots+MAs)
//====================================================
f_spyBias() =>
    e20 = ta.ema(close, emaLen)
    s50 = ta.sma(close, sma50Len)
    s200 = ta.sma(close, sma200Len)
    a = ta.atr(atrLen)
    d = math.min(math.min(math.abs(close - e20), math.abs(close - s50)), math.abs(close - s200))
    ts =
         d <= a * chopAtrMult ? "Chop around MAs" :
         close > e20 and close > s50 and close > s200 ? "Above key MAs" :
         close < e20 and close < s50 and close < s200 ? "Below key MAs" :
         "Chop around MAs"

    _ph = ta.pivothigh(high, pivotLen, pivotLen)
    _pl = ta.pivotlow(low, pivotLen, pivotLen)

    var float _lastPH = na
    var float _prevPH = na
    var float _lastPL = na
    var float _prevPL = na

    if not na(_ph)
        _prevPH := _lastPH
        _lastPH := _ph
    if not na(_pl)
        _prevPL := _lastPL
        _lastPL := _pl

    _hasH = not na(_lastPH) and not na(_prevPH)
    _hasL = not na(_lastPL) and not na(_prevPL)

    _hh = _hasH and _lastPH > _prevPH
    _lh = _hasH and _lastPH < _prevPH
    _hl = _hasL and _lastPL > _prevPL
    _ll = _hasL and _lastPL < _prevPL

    _struct =
         (_hh and _hl) ? "HH/HL" :
         (_lh and _ll) ? "LL/LH" :
         "Mixed"

    _rangeHigh = ta.highest(high, rangeLookback)
    _rangeLow  = ta.lowest(low, rangeLookback)
    _rangeWidthPct = close != 0 ? ((_rangeHigh - _rangeLow) / close) * 100.0 : na
    _isRange = _rangeWidthPct < (atrPctVolatile * 1.5) and ts == "Chop around MAs"
    _struct := _isRange ? "Range" : _struct

    _bias =
         (_struct == "HH/HL" and ts == "Above key MAs") ? "Bullish" :
         (_struct == "LL/LH" and ts == "Below key MAs") ? "Bearish" :
         "Neutral"

    _bias

spyBias = request.security(spySymbol, timeframe.period, f_spyBias(), barmerge.gaps_off, barmerge.lookahead_off)

//====================================================
// ALIGNMENT vs SPY (Aligned / Mixed / Contra)
//====================================================
alignment =
     (bias == "Neutral" or spyBias == "Neutral") ? "Mixed" :
     (bias == spyBias) ? "Aligned" :
     "Contra"

//====================================================
// RS vs SPY (RS value, trend, state)
//====================================================
spyClose = request.security(spySymbol, timeframe.period, close, barmerge.gaps_off, barmerge.lookahead_off)
rs = (not na(spyClose) and spyClose != 0) ? close / spyClose : na
rsMa = ta.sma(rs, rsMaLen)
rsSlope = rsMa - rsMa[rsSlopeLen]

rsTrend =
     na(rsSlope) ? "N/A" :
     rsSlope > rsFlatThr ? "Rising" :
     rsSlope < -rsFlatThr ? "Falling" :
     "Flat"

rsState =
     na(rs) or na(rsMa) ? "N/A" :
     (rs > rsMa and rsTrend == "Rising") ? "Strong" :
     (rs < rsMa and rsTrend == "Falling") ? "Weak" :
     "Neutral"

//====================================================
// DERIVED SUPPORT / RESISTANCE (from key levels set)
//====================================================
float sup = na
float res = na

if not na(pdh)
    if pdh <= close and (na(sup) or close - pdh < close - sup)
        sup := pdh
    if pdh >= close and (na(res) or pdh - close < res - close)
        res := pdh
if not na(pdl)
    if pdl <= close and (na(sup) or close - pdl < close - sup)
        sup := pdl
    if pdl >= close and (na(res) or pdl - close < res - close)
        res := pdl
if not na(pwh)
    if pwh <= close and (na(sup) or close - pwh < close - sup)
        sup := pwh
    if pwh >= close and (na(res) or pwh - close < res - close)
        res := pwh
if not na(pwl)
    if pwl <= close and (na(sup) or close - pwl < close - sup)
        sup := pwl
    if pwl >= close and (na(res) or pwl - close < res - close)
        res := pwl
if not na(ema20)
    if ema20 <= close and (na(sup) or close - ema20 < close - sup)
        sup := ema20
    if ema20 >= close and (na(res) or ema20 - close < res - close)
        res := ema20
if not na(sma50)
    if sma50 <= close and (na(sup) or close - sma50 < close - sup)
        sup := sma50
    if sma50 >= close and (na(res) or sma50 - close < res - close)
        res := sma50
if not na(sma200)
    if sma200 <= close and (na(sup) or close - sma200 < close - sup)
        sup := sma200
    if sma200 >= close and (na(res) or sma200 - close < res - close)
        res := sma200
if not na(dch)
    if dch <= close and (na(sup) or close - dch < close - sup)
        sup := dch
    if dch >= close and (na(res) or dch - close < res - close)
        res := dch
if not na(dcl)
    if dcl <= close and (na(sup) or close - dcl < close - sup)
        sup := dcl
    if dcl >= close and (na(res) or dcl - close < res - close)
        res := dcl

// nearest levels for optional plot
string nearestResName = ""
float nearestResDist = 10e10
float nearestResValue = na
string nearestSupName = ""
float nearestSupDist = 10e10
float nearestSupValue = na

if not na(pdh)
    if pdh > close and pdh - close < nearestResDist
        nearestResDist := pdh - close
        nearestResName := "PDH"
        nearestResValue := pdh
    if pdh < close and close - pdh < nearestSupDist
        nearestSupDist := close - pdh
        nearestSupName := "PDH"
        nearestSupValue := pdh
if not na(pdl)
    if pdl > close and pdl - close < nearestResDist
        nearestResDist := pdl - close
        nearestResName := "PDL"
        nearestResValue := pdl
    if pdl < close and close - pdl < nearestSupDist
        nearestSupDist := close - pdl
        nearestSupName := "PDL"
        nearestSupValue := pdl
if not na(pwh)
    if pwh > close and pwh - close < nearestResDist
        nearestResDist := pwh - close
        nearestResName := "PWH"
        nearestResValue := pwh
    if pwh < close and close - pwh < nearestSupDist
        nearestSupDist := close - pwh
        nearestSupName := "PWH"
        nearestSupValue := pwh
if not na(pwl)
    if pwl > close and pwl - close < nearestResDist
        nearestResDist := pwl - close
        nearestResName := "PWL"
        nearestResValue := pwl
    if pwl < close and close - pwl < nearestSupDist
        nearestSupDist := close - pwl
        nearestSupName := "PWL"
        nearestSupValue := pwl
if not na(ema20)
    if ema20 > close and ema20 - close < nearestResDist
        nearestResDist := ema20 - close
        nearestResName := "EMA20"
        nearestResValue := ema20
    if ema20 < close and close - ema20 < nearestSupDist
        nearestSupDist := close - ema20
        nearestSupName := "EMA20"
        nearestSupValue := ema20
if not na(sma50)
    if sma50 > close and sma50 - close < nearestResDist
        nearestResDist := sma50 - close
        nearestResName := "SMA50"
        nearestResValue := sma50
    if sma50 < close and close - sma50 < nearestSupDist
        nearestSupDist := close - sma50
        nearestSupName := "SMA50"
        nearestSupValue := sma50
if not na(sma200)
    if sma200 > close and sma200 - close < nearestResDist
        nearestResDist := sma200 - close
        nearestResName := "SMA200"
        nearestResValue := sma200
    if sma200 < close and close - sma200 < nearestSupDist
        nearestSupDist := close - sma200
        nearestSupName := "SMA200"
        nearestSupValue := sma200
if not na(dch)
    if dch > close and dch - close < nearestResDist
        nearestResDist := dch - close
        nearestResName := "DCH20"
        nearestResValue := dch
    if dch < close and close - dch < nearestSupDist
        nearestSupDist := close - dch
        nearestSupName := "DCH20"
        nearestSupValue := dch
if not na(dcl)
    if dcl > close and dcl - close < nearestResDist
        nearestResDist := dcl - close
        nearestResName := "DCL20"
        nearestResValue := dcl
    if dcl < close and close - dcl < nearestSupDist
        nearestSupDist := close - dcl
        nearestSupName := "DCL20"
        nearestSupValue := dcl

plot(showNearestSRLines and barstate.islast ? nearestResValue : na, "Nearest Resistance (R)", color=color.new(color.yellow, 0), linewidth=2, style=plot.style_linebr)
plot(showNearestSRLines and barstate.islast ? nearestSupValue : na, "Nearest Support (S)", color=color.new(color.yellow, 0), linewidth=2, style=plot.style_linebr)

//====================================================
// TABLE (top-right) - 1 metric per row
//====================================================
var table t = table.new(position.top_right, 2, 30, border_width=1)

f_set(row, k, v, isHeader, valColor) =>
    leftBg  = isHeader ? color.new(color.blue, 80) : color.new(color.black, 0)
    rightBg = isHeader ? color.new(color.blue, 80) : color.new(color.black, 0)
    txtCol  = color.white
    table.cell(t, 0, row, k, text_size=size.small, text_halign=text.align_left, bgcolor=leftBg, text_color=txtCol)
    table.cell(t, 1, row, v, text_size=size.small, text_halign=text.align_left, bgcolor=rightBg, text_color=valColor)

f_lvl(name, x) =>
    suffix = name == nearestResName ? " (R)" : name == nearestSupName ? " (S)" : ""
    f_fmt2(x) + suffix

if barstate.islast
    if not showTable
        table.clear(t, 0, 0, 1, 29)
    else
        white = color.white
        nearCol = color.new(color.yellow, 0)

        f_set(0, "Ticker 1D Context", tfWarn == "" ? syminfo.ticker : "⚠ " + syminfo.ticker, true, white)

        f_set(1, "Regime", regime, false, white)
        f_set(2, "Bias (auto)", bias, false, white)
        f_set(3, "Structure", structure, false, white)
        f_set(4, "Trend Strength", trendStrength, false, white)
        f_set(5, "VWAP", f_fmt2(vwapD) + " (" + vwapState + ")", false, white)
        f_set(6, "Momentum (1D)", momentum, false, white)

        f_set(7, "Alignment vs SPY", alignment + " (SPY: " + spyBias + ")", false, white)
        f_set(8, "RS state vs SPY", rsState, false, white)
        f_set(9, "RS trend", rsTrend, false, white)
        f_set(10, "Close", f_fmt2(close), false, white)
        f_set(11, "ATR (14)", f_fmt2(atr), false, white)
        f_set(12, "Support", f_fmt2(sup), false, white)
        f_set(13, "Resistance", f_fmt2(res), false, white)

        f_set(14, "Key Levels", "", true, white)
        f_set(15, "PDH", f_lvl("PDH", pdh), false, (nearestResName == "PDH" or nearestSupName == "PDH") ? nearCol : white)
        f_set(16, "PDL", f_lvl("PDL", pdl), false, (nearestResName == "PDL" or nearestSupName == "PDL") ? nearCol : white)
        f_set(17, "PWH", f_lvl("PWH", pwh), false, (nearestResName == "PWH" or nearestSupName == "PWH") ? nearCol : white)
        f_set(18, "PWL", f_lvl("PWL", pwl), false, (nearestResName == "PWL" or nearestSupName == "PWL") ? nearCol : white)
        f_set(19, "EMA20", f_lvl("EMA20", ema20), false, (nearestResName == "EMA20" or nearestSupName == "EMA20") ? nearCol : white)
        f_set(20, "SMA50", f_lvl("SMA50", sma50), false, (nearestResName == "SMA50" or nearestSupName == "SMA50") ? nearCol : white)
        f_set(21, "SMA200", f_lvl("SMA200", sma200), false, (nearestResName == "SMA200" or nearestSupName == "SMA200") ? nearCol : white)
        f_set(22, "DCH20", f_lvl("DCH20", dch), false, (nearestResName == "DCH20" or nearestSupName == "DCH20") ? nearCol : white)
        f_set(23, "DCL20", f_lvl("DCL20", dcl), false, (nearestResName == "DCL20" or nearestSupName == "DCL20") ? nearCol : white)

        f_set(24, "Helpers", "", true, white)
        f_set(25, "Range context", rangeState, false, white)
        f_set(26, "RSI(14) context", rsiState, false, white)
        f_set(27, "ATR% slope(5)", atrSlopeState, false, white)
        f_set(28, "RS value", na(rs) ? "na" : str.tostring(rs, "#.###"), false, white)
        f_set(29, "ATR% Env", atrEnv + " (" + f_fmt2(atrPct) + "%)", false, white)
