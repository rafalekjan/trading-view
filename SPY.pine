//@version=6
indicator("SPY Gatekeeper)", overlay=true)

// ===================== Inputs =====================
vixSymbol = input.symbol("CBOE:VIX", "VIX symbol")

b1 = input.symbol("AMEX:XLB", "Breadth #1")
b2 = input.symbol("AMEX:XLC", "Breadth #2")
b3 = input.symbol("AMEX:XLE", "Breadth #3")
b4 = input.symbol("AMEX:XLF", "Breadth #4")
b5 = input.symbol("AMEX:XLI", "Breadth #5")
b6 = input.symbol("AMEX:XLK", "Breadth #6")
b7 = input.symbol("AMEX:XLP", "Breadth #7")
b8 = input.symbol("AMEX:XLU", "Breadth #8")
b9 = input.symbol("AMEX:XLV", "Breadth #9")
b10 = input.symbol("AMEX:XLY", "Breadth #10")
breadthLen = input.int(50, "Breadth SMA length", minval=10)

adxLen = input.int(14, "ADX length", minval=5)
adxSmooth = input.int(14, "ADX smoothing", minval=5)
atrLen = input.int(14, "ATR length", minval=5)
atrVolThresh = input.float(2.5, "ATR% threshold for Volatile", step=0.1)

volLookback = input.int(20, "Volume avg length", minval=5)
volExpBars = input.int(5, "Volume expansion lookback", minval=2)

bigCandleMult = input.float(1.5, "Big candle = Range > ATR *", step=0.1)
closeTopPct = input.float(0.7, "Close in top % for Up expansion", step=0.05)
closeBotPct = input.float(0.3, "Close in bottom % for Down expansion", step=0.05)

pivL = input.int(3, "Pivot left bars", minval=1)
pivR = input.int(3, "Pivot right bars", minval=1)
quickSwingLen = input.int(3, "Quick swing lookback", minval=2)

rangeN = input.int(20, "Breaking range lookback", minval=10)
vwapTF = input.timeframe("D", "VWAP timeframe")

nearPctSR = input.float(1.0, "Near level threshold (%)", step=0.1)
roomNonePct = input.float(1.0, "Room None threshold (%)", step=0.1)
roomLimPct = input.float(2.0, "Room Limited threshold (%)", step=0.1)
roomNoneATR = input.float(1.0, "Room None threshold (ATR)", step=0.1)
roomLimATR = input.float(2.0, "Room Limited threshold (ATR)", step=0.1)
showDashboard = input.bool(true, "Show dashboard")
tableVisibility = input.int(35, "Dashboard visibility (0=solid, 100=hidden)", minval=0, maxval=100)

// ===================== Helpers =====================
f_roomFromPct(distPct) => distPct <= roomNonePct ? "None" : distPct <= roomLimPct ? "Limited" : "Large"
f_roomFromATR(distATR) => distATR <= roomNoneATR ? "None" : distATR <= roomLimATR ? "Limited" : "Large"

// ===================== Breadth proxy =====================
f_aboveSMA(sym) =>
    [c, s] = request.security(sym, "D", [close, ta.sma(close, breadthLen)])
    na(c) or na(s) ? na : (c > s ? 1 : 0)

a1 = f_aboveSMA(b1), a2 = f_aboveSMA(b2), a3 = f_aboveSMA(b3), a4 = f_aboveSMA(b4), a5 = f_aboveSMA(b5)
a6 = f_aboveSMA(b6), a7 = f_aboveSMA(b7), a8 = f_aboveSMA(b8), a9 = f_aboveSMA(b9), a10 = f_aboveSMA(b10)

validCount = (na(a1)?0:1)+(na(a2)?0:1)+(na(a3)?0:1)+(na(a4)?0:1)+(na(a5)?0:1)+(na(a6)?0:1)+(na(a7)?0:1)+(na(a8)?0:1)+(na(a9)?0:1)+(na(a10)?0:1)
sumAbove = (na(a1)?0:a1)+(na(a2)?0:a2)+(na(a3)?0:a3)+(na(a4)?0:a4)+(na(a5)?0:a5)+(na(a6)?0:a6)+(na(a7)?0:a7)+(na(a8)?0:a8)+(na(a9)?0:a9)+(na(a10)?0:a10)

breadthPct = validCount == 0 ? na : (100.0 * sumAbove / validCount)
breadth = na(breadthPct) ? "Zrob sam" : breadthPct > 60 ? "Strong" : breadthPct < 40 ? "Weak" : "Neutral"

// ===================== VIX =====================
vix = request.security(vixSymbol, timeframe.period, close)
vixEma5 = ta.ema(vix, 5)
vixEma20 = ta.ema(vix, 20)
vixTrend = vixEma5 > vixEma20 ? "Rising" : vixEma5 < vixEma20 ? "Falling" : "Flat"
vixLevel = vix < 20 ? "<20" : vix <= 25 ? "20-25" : ">25"

// ===================== Daily series =====================
[dClose, dHigh, dLow, dVol, dSma20, dSma50, dSma200, dAtr, dVolAvg, dVolHighestPrev, rsi14, ema21, ema50, roc20] = request.security(syminfo.tickerid, "D", [close, high, low, volume, ta.sma(close, 20), ta.sma(close, 50), ta.sma(close, 200), ta.atr(atrLen), ta.sma(volume, volLookback), ta.highest(volume[1], volExpBars), ta.rsi(close, 14), ta.ema(close, 21), ta.ema(close, 50), ta.roc(close, 20)])
[macdLine, macdSignal, macdHist] = request.security(syminfo.tickerid, "D", ta.macd(close, 12, 26, 9))
[_, __, dAdx] = request.security(syminfo.tickerid, "D", ta.dmi(adxLen, adxSmooth))
[pwHigh, pwLow] = request.security(syminfo.tickerid, "W", [high[1], low[1]])

above2050 = (dClose > dSma20) and (dClose > dSma50)
above200 = dClose > dSma200

// ===================== VWAP (best-effort) =====================
[tfClose, tfVWAP] = request.security(syminfo.tickerid, vwapTF, [close, ta.vwap(hlc3)])
vwapState = na(tfVWAP) ? "Zrob sam" : (tfClose > tfVWAP ? "Above" : "Below")

// ===================== Market regime =====================
dAtrPerc = (dAtr / dClose) * 100.0

// ===================== Volume confirmation =====================
volGt20d = dVol > dVolAvg ? "Yes" : "No"
volExp = dVol > dVolHighestPrev ? "Yes" : "No"

// ===================== Structure from pivots =====================
ph = ta.pivothigh(dHigh, pivL, pivR)
pl = ta.pivotlow(dLow, pivL, pivR)
lastPH = ta.valuewhen(not na(ph), ph, 0)
prevPH = ta.valuewhen(not na(ph), ph, 1)
lastPL = ta.valuewhen(not na(pl), pl, 0)
prevPL = ta.valuewhen(not na(pl), pl, 1)

isHH = not na(lastPH) and not na(prevPH) and lastPH > prevPH
isLH = not na(lastPH) and not na(prevPH) and lastPH < prevPH
isHL = not na(lastPL) and not na(prevPL) and lastPL > prevPL
isLL = not na(lastPL) and not na(prevPL) and lastPL < prevPL

// =====================
// Momentum core (internal only)
// =====================
momentumBullScore = (rsi14 > 52 ? 1 : 0) + (macdLine > macdSignal ? 1 : 0) + (ema21 > ema50 ? 1 : 0)
momentumBearScore = (rsi14 < 48 ? 1 : 0) + (macdLine < macdSignal ? 1 : 0) + (ema21 < ema50 ? 1 : 0)
momentumBull = momentumBullScore >= 2
momentumBear = momentumBearScore >= 2
momentumBullStrong = momentumBull and roc20 > 0
momentumBearStrong = momentumBear and roc20 < 0

// Keep structure based on pivots; momentum is applied in bias/regime/expansion logic.
structureRaw = (isHH and isHL) ? "HH/HL" : (isLL and isLH) ? "LL/LH" : "Mixed"
structure = structureRaw
trendTxt = structure == "HH/HL" ? "Higher lows" : structure == "LL/LH" ? "Lower highs" : "None"
quickHighNow = ta.highest(dHigh, quickSwingLen)
quickHighPrev = ta.highest(dHigh[quickSwingLen], quickSwingLen)
quickLowNow = ta.lowest(dLow, quickSwingLen)
quickLowPrev = ta.lowest(dLow[quickSwingLen], quickSwingLen)
quickLH = not na(quickHighNow) and not na(quickHighPrev) and quickHighNow < quickHighPrev
quickHL = not na(quickLowNow) and not na(quickLowPrev) and quickLowNow > quickLowPrev

macdHistGrowing = macdHist > macdHist[1]
macdHistFalling = macdHist < macdHist[1]
emaSpread = math.abs(ema21 - ema50) / dClose * 100.0
emaSpreadExpanding = emaSpread > emaSpread[1]
regimeRangeFilter = rsi14 > 45 and rsi14 < 55 and macdHistFalling and emaSpread < 0.3
regimeTrendFilter = dAdx > 20 and emaSpreadExpanding and macdHistGrowing and (momentumBullStrong or momentumBearStrong)
marketRegime = dAtrPerc > atrVolThresh ? "Volatile" : regimeRangeFilter ? "Ranging" : regimeTrendFilter ? "Trending" : "Ranging"

// ===================== Pullback / Compression / Price Expansion =====================
pullback = (dClose > dSma200 and dClose < dSma20) ? "BullPB" : (dClose < dSma200 and dClose > dSma20) ? "BearPB" : "No"
compression = (dAtr < dAtr[1] and dAtr[1] < dAtr[2]) ? "Yes" : "No"

rng = dHigh - dLow
bigCandle = rng > dAtr * bigCandleMult
closePos = rng == 0 ? 0.5 : (dClose - dLow) / rng
priceExpansion = (bigCandle and closePos > closeTopPct and momentumBullStrong) ? "Up" : (bigCandle and closePos < closeBotPct and momentumBearStrong) ? "Down" : "No"

// ===================== Bias variants =====================
bias_structure = structure == "HH/HL" ? "Bullish" : structure == "LL/LH" ? "Bearish" : "Neutral"
bias_ma = (dClose > dSma200 and dSma50 > dSma200) ? "Bullish" : (dClose < dSma200 and dSma50 < dSma200) ? "Bearish" : "Neutral"
earlyBear = structureRaw == "Mixed" and (isLH or quickLH) and dClose < dSma20 and momentumBear
earlyBull = structureRaw == "Mixed" and (isHL or quickHL) and dClose > dSma20 and momentumBull
bias_hybrid = structure == "LL/LH" and dClose < dSma200 ? "Bearish" :
              structure == "HH/HL" and dClose > dSma200 ? "Bullish" :
              earlyBear ? "Bearish (Early)" :
              earlyBull ? "Bullish (Early)" :
              bias_ma
bias_selected = bias_hybrid

// ===================== Location variants =====================
priorHigh = ta.highest(dHigh, rangeN)[1]
priorLow  = ta.lowest(dLow, rangeN)[1]
distSma200Pct = math.abs(dClose - dSma200) / dClose * 100.0

loc_range = dClose > priorHigh ? "Breaking range (Up)" : dClose < priorLow ? "Breaking range (Down)" : distSma200Pct < nearPctSR ? (dClose > dSma200 ? "At support" : "At resistance") : "Mid-range"
loc_sma200 = distSma200Pct < nearPctSR ? (dClose > dSma200 ? "At support" : "At resistance") : "Mid-range"
loc_swing = (not na(lastPL) and math.abs(dClose - lastPL)/dClose*100.0 < nearPctSR) ? "At support" : (not na(lastPH) and math.abs(dClose - lastPH)/dClose*100.0 < nearPctSR) ? "At resistance" : ((not na(lastPH) and dClose > lastPH) ? "Breaking range (Up)" : (not na(lastPL) and dClose < lastPL) ? "Breaking range (Down)" : "Mid-range")

// ===================== Room variants =====================
distUpPct = pwHigh > dClose ? (pwHigh - dClose) / dClose * 100.0 : 0.0
distDownPct = pwLow < dClose ? (dClose - pwLow) / dClose * 100.0 : 0.0
distUpATR = (pwHigh > dClose and dAtr != 0) ? (pwHigh - dClose) / dAtr : 0.0
distDownATR = (pwLow < dClose and dAtr != 0) ? (dClose - pwLow) / dAtr : 0.0

room_weekly = bias_selected == "Bullish" ? f_roomFromPct(distUpPct) : bias_selected == "Bearish" ? f_roomFromPct(distDownPct) : f_roomFromPct(math.min(distUpPct, distDownPct))
room_atr = bias_selected == "Bullish" ? f_roomFromATR(distUpATR) : bias_selected == "Bearish" ? f_roomFromATR(distDownATR) : f_roomFromATR(math.min(distUpATR, distDownATR))
room_struct = structure == "HH/HL" ? f_roomFromPct(distUpPct) : structure == "LL/LH" ? f_roomFromPct(distDownPct) : "Limited"

// ===================== TABLE =====================
// Rows count: 24 (0..23)
tblBg = color.new(color.black, tableVisibility)
tblKeyBg = color.new(color.silver, tableVisibility)
tblTxt = color.new(color.white, tableVisibility)
tblHeaderBg = color.new(color.orange, tableVisibility)
tblHeaderTxt = color.new(color.black, tableVisibility)
var table dashboard = table.new(position.top_right, 2, 24, border_width=1, frame_color=color.new(color.white, tableVisibility))
f_row(r, k, v) =>
    table.cell(dashboard, 0, r, k, bgcolor=tblKeyBg, text_color=tblTxt, text_halign=text.align_left)
    table.cell(dashboard, 1, r, v, bgcolor=tblBg, text_color=tblTxt, text_halign=text.align_left)

if barstate.islast
    if showDashboard
        f_row(1, "Bias - Structure", bias_structure)
        f_row(2, "Bias - MA Alignment", bias_ma)
        f_row(3, "Bias - Hybrid", bias_hybrid)
        f_row(4, "Market regime", marketRegime)
        f_row(5, "Structure", structure)
        f_row(6, "VWAP", vwapState)
        f_row(7, "Volume > 20D avg", volGt20d)
        f_row(8, "Volume expansion", volExp)
        f_row(9, "VIX", vixTrend)
        f_row(10, "VIX level", vixLevel)
        f_row(11, "Breadth", na(breadthPct) ? "Zrob sam" : (breadth + " (" + str.tostring(math.round(breadthPct)) + "%)"))
        f_row(12, "Location - Range Breakout", loc_range)
        f_row(13, "Location - SMA200 Proximity", loc_sma200)
        f_row(14, "Location - Swing Proximity", loc_swing)
        f_row(15, "Room - Weekly %", room_weekly)
        f_row(16, "Room - ATR Multiple", room_atr)
        f_row(17, "Room - Structure Cont.", room_struct)
        f_row(18, "Above 20/50", above2050 ? "Yes" : "No")
        f_row(19, "Above 200", above200 ? "Yes" : "No")
        f_row(20, "Trend", trendTxt)
        f_row(21, "Pullback", pullback)
        f_row(22, "Compression", compression)
        f_row(23, "Price expansion", priceExpansion)
    else
        table.clear(dashboard, 0, 0, 1, 23)
