//@version=6
indicator("SPY - Gatekeeper 1D", overlay=true, max_labels_count=500)

//====================================================
// INPUTS
//====================================================
groupUI = "UI"
showTable = input.bool(true, "Show Gatekeeper Table", group=groupUI)
showNearestSRLines = input.bool(false, "Show nearest R/S lines", group=groupUI)
enforce1D = input.bool(true, "Warn if not 1D", group=groupUI)
hardStopWrongTF = input.bool(false, "Hard stop if not 1D", group=groupUI)

groupSrc = "Sources"
vixSymbol = input.symbol("CBOE:VIX", "VIX symbol", group=groupSrc)
qqqSymbol = input.symbol("NASDAQ:QQQ", "QQQ symbol (risk proxy)", group=groupSrc)
iwmSymbol = input.symbol("AMEX:IWM", "IWM symbol (breadth proxy)", group=groupSrc)

groupMA = "Moving Averages"
emaLen = input.int(20, "EMA length", minval=1, group=groupMA)
sma50Len = input.int(50, "SMA50 length", minval=1, group=groupMA)
sma200Len = input.int(200, "SMA200 length", minval=1, group=groupMA)

groupATR = "ATR"
atrLen = input.int(14, "ATR length", minval=1, group=groupATR)
atrPctVolatile = input.float(2.0, "ATR% volatile threshold", minval=0.5, maxval=10.0, step=0.1, group=groupATR)
atrPctLow = input.float(1.0, "ATR% low threshold", minval=0.2, maxval=5.0, step=0.1, group=groupATR)

groupVIX = "VIX thresholds"
vixLow = input.float(20.0, "Low (<)", minval=10, maxval=40, step=0.5, group=groupVIX)
vixHigh = input.float(25.0, "High (>=)", minval=10, maxval=60, step=0.5, group=groupVIX)
vixFast = input.int(5, "VIX fast SMA", minval=1, group=groupVIX)
vixSlow = input.int(20, "VIX slow SMA", minval=1, group=groupVIX)

groupStructure = "Structure / Regime"
pivotLen = input.int(5, "Pivot length (D1 structure)", minval=2, maxval=20, group=groupStructure)
rangeLookback = input.int(20, "Range lookback (days)", minval=10, maxval=120, group=groupStructure)
rangeRefLookback = input.int(60, "Range reference lookback (days)", minval=20, maxval=300, group=groupStructure)
chopAtrMult = input.float(0.6, "Chop around MAs: dist <= ATR *", minval=0.1, maxval=2.0, step=0.05, group=groupStructure)
donLen = input.int(20, "Donchian length (DCH/DCL)", minval=5, maxval=200, group=groupStructure)

//====================================================
// SAFETY: This script is designed for SPY 1D
//====================================================
isDaily = timeframe.isdaily
isSpyTicker = syminfo.ticker == "SPY"
tfWarn =
     (enforce1D and not isDaily and not isSpyTicker) ? "WARN: Use SPY on 1D" :
     (enforce1D and not isDaily) ? "WARN: Use 1D" :
     (enforce1D and not isSpyTicker) ? "WARN: Use SPY" :
     ""
if enforce1D and hardStopWrongTF and (not isDaily or not isSpyTicker)
    runtime.error("This script is designed for SPY on 1D timeframe. Switch chart to SPY 1D.")

//====================================================
// DATA: LEVELS
//====================================================
pdh = high[1]
pdl = low[1]

// Weekly prior week high/low (completed week)
pwh = request.security(syminfo.tickerid, "W", high[1], barmerge.gaps_off, barmerge.lookahead_off)
pwl = request.security(syminfo.tickerid, "W", low[1],  barmerge.gaps_off, barmerge.lookahead_off)

// Donchian (D1)
dch = ta.highest(high, donLen)
dcl = ta.lowest(low, donLen)

// MAs (D1)
ema20 = ta.ema(close, emaLen)
sma50 = ta.sma(close, sma50Len)
sma200 = ta.sma(close, sma200Len)
vwapD = ta.vwap(hlc3)
vwapState = close > vwapD ? "Above" : close < vwapD ? "Below" : "Around"

// ATR (D1)
atr = ta.atr(atrLen)
atrPct = close != 0 ? (atr / close) * 100.0 : na

atrEnv =     atrPct < atrPctLow ? "Low" :    atrPct >= atrPctVolatile ? "High" :    "Normal"

//====================================================
// VIX (via symbol)
//====================================================
vixClose = request.security(vixSymbol, timeframe.period, close, barmerge.gaps_off, barmerge.lookahead_off)
vixF = request.security(vixSymbol, timeframe.period, ta.sma(close, vixFast), barmerge.gaps_off, barmerge.lookahead_off)
vixS = request.security(vixSymbol, timeframe.period, ta.sma(close, vixSlow), barmerge.gaps_off, barmerge.lookahead_off)

vixLevel =    vixClose < vixLow ? "<20" :    vixClose >= vixHigh ? ">25" :    "20-25"

vixTrend =    vixF > vixS ? "Rising" :    vixF < vixS ? "Falling" :    "Flat"

//====================================================
// QQQ vs 200SMA (risk proxy)
//====================================================
qqqClose = request.security(qqqSymbol, timeframe.period, close, barmerge.gaps_off, barmerge.lookahead_off)
qqqSma200 = request.security(qqqSymbol, timeframe.period, ta.sma(close, 200), barmerge.gaps_off, barmerge.lookahead_off)

qqqVs200 =    na(qqqClose) or na(qqqSma200) ? "N/A" :    qqqClose > qqqSma200 ? "Above" :    "Below"

iwmClose = request.security(iwmSymbol, timeframe.period, close, barmerge.gaps_off, barmerge.lookahead_off)
iwmSma200 = request.security(iwmSymbol, timeframe.period, ta.sma(close, 200), barmerge.gaps_off, barmerge.lookahead_off)

spyAbove200 = not na(close) and not na(sma200) and close > sma200
qqqAbove200 = not na(qqqClose) and not na(qqqSma200) and qqqClose > qqqSma200
iwmAbove200 = not na(iwmClose) and not na(iwmSma200) and iwmClose > iwmSma200

breadthAvail = (not na(sma200) ? 1 : 0) + (not na(qqqSma200) ? 1 : 0) + (not na(iwmSma200) ? 1 : 0)
breadthAbove = (spyAbove200 ? 1 : 0) + (qqqAbove200 ? 1 : 0) + (iwmAbove200 ? 1 : 0)
breadth = breadthAvail < 2 ? "N/A" : breadthAbove >= 2 ? "Strong" : breadthAbove == 1 ? "Neutral" : "Weak"

//====================================================
// TREND STRENGTH (Above/Below/Chop around MAs)
//====================================================
distToMAs = math.min(math.min(math.abs(close - ema20), math.abs(close - sma50)), math.abs(close - sma200))
trendStrength =    distToMAs <= atr * chopAtrMult ? "Chop around MAs" :    close > ema20 and close > sma50 and close > sma200 ? "Above key MAs" :    close < ema20 and close < sma50 and close < sma200 ? "Below key MAs" :    "Chop around MAs"

//====================================================
// STRUCTURE (HH/HL, LL/LH, Mixed, Range) via pivots
//====================================================
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

var float lastPH = na
var float prevPH = na
var float lastPL = na
var float prevPL = na

if not na(ph)
    prevPH := lastPH
    lastPH := ph

if not na(pl)
    prevPL := lastPL
    lastPL := pl

hasTwoHighs = not na(lastPH) and not na(prevPH)
hasTwoLows  = not na(lastPL) and not na(prevPL)

hh = hasTwoHighs and lastPH > prevPH
lh = hasTwoHighs and lastPH < prevPH
hl = hasTwoLows and lastPL > prevPL
ll = hasTwoLows and lastPL < prevPL

structure =    (hh and hl) ? "HH/HL" :    (lh and ll) ? "LL/LH" :        "Mixed"

rangeHigh = ta.highest(high, rangeLookback)
rangeLow  = ta.lowest(low, rangeLookback)
rangeWidthPct = close != 0 ? ((rangeHigh - rangeLow) / close) * 100.0 : na
isRange = rangeWidthPct < (atrPctVolatile * 1.5) and trendStrength == "Chop around MAs"
structure := isRange ? "Range" : structure

//====================================================
// BIAS (auto) from structure + MAs
//====================================================
bias =    (structure == "HH/HL" and trendStrength == "Above key MAs") ? "Bullish" :    (structure == "LL/LH" and trendStrength == "Below key MAs") ? "Bearish" :    "Neutral"

//====================================================
// REGIME (Trend Up/Down/Range/Volatile-Unstable)
//====================================================
regime =    atrPct >= atrPctVolatile and vixTrend == "Rising" ? "Volatile-Unstable" :    structure == "Range" or trendStrength == "Chop around MAs" ? "Range" :    bias == "Bullish" ? "Trend Up" :    bias == "Bearish" ? "Trend Down" :    "Range"

//====================================================
// MOMENTUM CONDITION (Expanding/Stable/Diverging/Exhausted)
//Simple, robust daily heuristic:
//- Expanding: breakout strength (close near high) + ATR% rising
//- Diverging: RSI falling while price rising (or vice versa)
//- Exhausted: large candle + reversal wick vs direction or RSI extreme
//====================================================
rsi = ta.rsi(close, 14)
rsiSlope = rsi - rsi[5]
atrSlope = atrPct - atrPct[5]
atrSlopeFlatThr = 0.05

// close location in candle
rng = high - low
closePos = rng != 0 ? (close - low) / rng : 0.5  // 0..1
wickUp = high - math.max(open, close)
wickDn = math.min(open, close) - low

bullCandle = close > open
bearCandle = close < open

// Divergence-ish proxy
diverging =    (bias == "Bullish" and rsiSlope < 0 and close > close[5]) or    (bias == "Bearish" and rsiSlope > 0 and close < close[5])

exhausted =    (bias == "Bullish" and rsi > 70 and wickUp > rng * 0.35) or    (bias == "Bearish" and rsi < 30 and wickDn > rng * 0.35) or    (atrSlope > 0.5 and atrPct >= atrPctVolatile)

expanding =    (bias == "Bullish" and closePos > 0.7 and atrSlope > 0) or    (bias == "Bearish" and closePos < 0.3 and atrSlope > 0)

momentum =    exhausted ? "Exhausted" :    diverging ? "Diverging" :    expanding ? "Expanding" :    "Stable"

//====================================================
// HELPER DESCRIPTIONS (for readability in table)
//====================================================
rangeRefPct = ta.sma(rangeWidthPct, rangeRefLookback)
rangeState =
     na(rangeWidthPct) or na(rangeRefPct) ? "N/A" :
     rangeWidthPct >= rangeRefPct * 1.2 ? "Wider than normal (riskier/choppier)" :
     rangeWidthPct <= rangeRefPct * 0.8 ? "Narrow vs normal (compression)" :
     "Around normal range"

rsiState =
     na(rsi) ? "N/A" :
     rsi >= 70 ? "High (overbought zone)" :
     rsi <= 30 ? "Low (oversold zone)" :
     rsi >= 55 ? "Bullish/firm" :
     rsi <= 45 ? "Bearish/soft" :
     "Neutral"

atrSlopeState =
     na(atrSlope) ? "N/A" :
     atrSlope > atrSlopeFlatThr ? "Rising volatility" :
     atrSlope < -atrSlopeFlatThr ? "Volatility cooling" :
     "Volatility stable"

//====================================================
// DERIVED SUPPORT / RESISTANCE (from key levels set)
//====================================================
float sup = na
float res = na

if not na(pdh)
    if pdh <= close and (na(sup) or close - pdh < close - sup)
        sup := pdh
    if pdh >= close and (na(res) or pdh - close < res - close)
        res := pdh
if not na(pdl)
    if pdl <= close and (na(sup) or close - pdl < close - sup)
        sup := pdl
    if pdl >= close and (na(res) or pdl - close < res - close)
        res := pdl
if not na(pwh)
    if pwh <= close and (na(sup) or close - pwh < close - sup)
        sup := pwh
    if pwh >= close and (na(res) or pwh - close < res - close)
        res := pwh
if not na(pwl)
    if pwl <= close and (na(sup) or close - pwl < close - sup)
        sup := pwl
    if pwl >= close and (na(res) or pwl - close < res - close)
        res := pwl
if not na(ema20)
    if ema20 <= close and (na(sup) or close - ema20 < close - sup)
        sup := ema20
    if ema20 >= close and (na(res) or ema20 - close < res - close)
        res := ema20
if not na(sma50)
    if sma50 <= close and (na(sup) or close - sma50 < close - sup)
        sup := sma50
    if sma50 >= close and (na(res) or sma50 - close < res - close)
        res := sma50
if not na(sma200)
    if sma200 <= close and (na(sup) or close - sma200 < close - sup)
        sup := sma200
    if sma200 >= close and (na(res) or sma200 - close < res - close)
        res := sma200
if not na(dch)
    if dch <= close and (na(sup) or close - dch < close - sup)
        sup := dch
    if dch >= close and (na(res) or dch - close < res - close)
        res := dch
if not na(dcl)
    if dcl <= close and (na(sup) or close - dcl < close - sup)
        sup := dcl
    if dcl >= close and (na(res) or dcl - close < res - close)
        res := dcl

nearAtrMult = 0.30
atSupport = not na(sup) and atr > 0 and math.abs(close - sup) <= atr * nearAtrMult
atResistance = not na(res) and atr > 0 and math.abs(close - res) <= atr * nearAtrMult
breakoutAttempt = not na(res) and close > res and close[1] <= res
breakdownAttempt = not na(sup) and close < sup and close[1] >= sup
postBreakRetest = (not na(res) and close > res and low <= res) or (not na(sup) and close < sup and high >= sup)

location =
     breakoutAttempt ? "Breakout Attempt" :
     breakdownAttempt ? "Breakdown Attempt" :
     postBreakRetest ? "Post-break Retest" :
     atSupport ? "At Support" :
     atResistance ? "At Resistance" :
     "Middle of Range"

supportStatus =
     na(sup) ? "Not tested" :
     (close[1] < sup and close > sup) ? "Reclaimed" :
     (close < sup) ? "Broken" :
     (low <= sup and close >= sup and close > open) ? "Rejecting" :
     (low <= sup and close >= sup) ? "Holding" :
     "Not tested"

resistanceStatus =
     na(res) ? "Not tested" :
     (close[1] > res and close < res) ? "Reclaimed" :
     (close > res) ? "Broken" :
     (high >= res and close <= res and close < open) ? "Rejecting" :
     (high >= res and close <= res) ? "Holding" :
     "Not tested"

// nearest levels to highlight in Key Levels section:
// - nearest resistance above current price -> (R)
// - nearest support below current price    -> (S)
string nearestResName = ""
float nearestResDist = 10e10
float nearestResValue = na
string nearestSupName = ""
float nearestSupDist = 10e10
float nearestSupValue = na

if not na(pdh)
    if pdh > close and pdh - close < nearestResDist
        nearestResDist := pdh - close
        nearestResName := "PDH"
        nearestResValue := pdh
    if pdh < close and close - pdh < nearestSupDist
        nearestSupDist := close - pdh
        nearestSupName := "PDH"
        nearestSupValue := pdh
if not na(pdl)
    if pdl > close and pdl - close < nearestResDist
        nearestResDist := pdl - close
        nearestResName := "PDL"
        nearestResValue := pdl
    if pdl < close and close - pdl < nearestSupDist
        nearestSupDist := close - pdl
        nearestSupName := "PDL"
        nearestSupValue := pdl
if not na(pwh)
    if pwh > close and pwh - close < nearestResDist
        nearestResDist := pwh - close
        nearestResName := "PWH"
        nearestResValue := pwh
    if pwh < close and close - pwh < nearestSupDist
        nearestSupDist := close - pwh
        nearestSupName := "PWH"
        nearestSupValue := pwh
if not na(pwl)
    if pwl > close and pwl - close < nearestResDist
        nearestResDist := pwl - close
        nearestResName := "PWL"
        nearestResValue := pwl
    if pwl < close and close - pwl < nearestSupDist
        nearestSupDist := close - pwl
        nearestSupName := "PWL"
        nearestSupValue := pwl
if not na(ema20)
    if ema20 > close and ema20 - close < nearestResDist
        nearestResDist := ema20 - close
        nearestResName := "EMA20"
        nearestResValue := ema20
    if ema20 < close and close - ema20 < nearestSupDist
        nearestSupDist := close - ema20
        nearestSupName := "EMA20"
        nearestSupValue := ema20
if not na(sma50)
    if sma50 > close and sma50 - close < nearestResDist
        nearestResDist := sma50 - close
        nearestResName := "SMA50"
        nearestResValue := sma50
    if sma50 < close and close - sma50 < nearestSupDist
        nearestSupDist := close - sma50
        nearestSupName := "SMA50"
        nearestSupValue := sma50
if not na(sma200)
    if sma200 > close and sma200 - close < nearestResDist
        nearestResDist := sma200 - close
        nearestResName := "SMA200"
        nearestResValue := sma200
    if sma200 < close and close - sma200 < nearestSupDist
        nearestSupDist := close - sma200
        nearestSupName := "SMA200"
        nearestSupValue := sma200
if not na(dch)
    if dch > close and dch - close < nearestResDist
        nearestResDist := dch - close
        nearestResName := "DCH20"
        nearestResValue := dch
    if dch < close and close - dch < nearestSupDist
        nearestSupDist := close - dch
        nearestSupName := "DCH20"
        nearestSupValue := dch
if not na(dcl)
    if dcl > close and dcl - close < nearestResDist
        nearestResDist := dcl - close
        nearestResName := "DCL20"
        nearestResValue := dcl
    if dcl < close and close - dcl < nearestSupDist
        nearestSupDist := close - dcl
        nearestSupName := "DCL20"
        nearestSupValue := dcl

//====================================================
// TABLE (fixed: top-right corner) - readable, 1 metric per row
//====================================================
var table t = table.new(position.top_right, 2, 34, border_width=1)

f_set(row, k, v, isHeader, valColor) =>
    leftBg = isHeader ? color.new(color.blue, 80) : color.new(color.black, 0)
    rightBg = isHeader ? color.new(color.blue, 80) : color.new(color.black, 0)
    txtCol = color.white
    table.cell(t, 0, row, k, text_size=size.small, text_halign=text.align_left, bgcolor=leftBg, text_color=txtCol)
    table.cell(t, 1, row, v, text_size=size.small, text_halign=text.align_left, bgcolor=rightBg, text_color=valColor)

f_fmt(x) =>
    na(x) ? "na" : str.tostring(x, format.mintick)

f_fmt2(x) =>
    na(x) ? "na" : str.tostring(x, "#.##")

f_lvl(name, x) =>
    suffix = name == nearestResName ? " (R)" : name == nearestSupName ? " (S)" : ""
    f_fmt2(x) + suffix

plot(showNearestSRLines and barstate.islast ? nearestResValue : na, "Nearest Resistance (R)", color=color.new(color.yellow, 0), linewidth=2, style=plot.style_linebr)
plot(showNearestSRLines and barstate.islast ? nearestSupValue : na, "Nearest Support (S)", color=color.new(color.yellow, 0), linewidth=2, style=plot.style_linebr)

// Update table only on last bar to reduce flicker
if barstate.islast
    if not showTable
        table.clear(t, 0, 0, 1, 33)
    else
        white = color.white
        nearCol = color.new(color.yellow, 0)

        f_set(0, "SPY Gatekeeper", tfWarn == "" ? "OK" : tfWarn, true, white)
        f_set(1, "Regime", regime, false, white)
        f_set(2, "Bias (auto)", bias, false, white)
        f_set(3, "Structure", structure, false, white)
        f_set(4, "Trend Strength", trendStrength, false, white)
        f_set(5, "VWAP", f_fmt2(vwapD) + " (" + vwapState + ")", false, white)
        f_set(6, "Momentum (1D)", momentum, false, white)
        f_set(7, "Close", f_fmt2(close), false, white)
        f_set(8, "ATR (14)", f_fmt2(atr), false, white)
        f_set(9, "Support", f_fmt2(sup), false, white)
        f_set(10, "Resistance", f_fmt2(res), false, white)
        f_set(11, "Location", location, false, white)
        f_set(12, "Support status", supportStatus, false, white)
        f_set(13, "Resistance status", resistanceStatus, false, white)
        f_set(14, "VIX", f_fmt2(vixClose) + " (" + vixLevel + ")", false, white)
        f_set(15, "VIX Trend", vixTrend, false, white)
        f_set(16, "ATR% Env", atrEnv + " (" + f_fmt2(atrPct) + "%)", false, white)
        f_set(17, "Breadth", breadth, false, white)
        f_set(18, "QQQ vs 200SMA", qqqVs200, false, white)

        f_set(19, "Key Levels", "", true, white)
        f_set(20, "PDH", f_lvl("PDH", pdh), false, (nearestResName == "PDH" or nearestSupName == "PDH") ? nearCol : white)
        f_set(21, "PDL", f_lvl("PDL", pdl), false, (nearestResName == "PDL" or nearestSupName == "PDL") ? nearCol : white)
        f_set(22, "PWH", f_lvl("PWH", pwh), false, (nearestResName == "PWH" or nearestSupName == "PWH") ? nearCol : white)
        f_set(23, "PWL", f_lvl("PWL", pwl), false, (nearestResName == "PWL" or nearestSupName == "PWL") ? nearCol : white)
        f_set(24, "EMA20", f_lvl("EMA20", ema20), false, (nearestResName == "EMA20" or nearestSupName == "EMA20") ? nearCol : white)
        f_set(25, "SMA50", f_lvl("SMA50", sma50), false, (nearestResName == "SMA50" or nearestSupName == "SMA50") ? nearCol : white)
        f_set(26, "SMA200", f_lvl("SMA200", sma200), false, (nearestResName == "SMA200" or nearestSupName == "SMA200") ? nearCol : white)
        f_set(27, "DCH20", f_lvl("DCH20", dch), false, (nearestResName == "DCH20" or nearestSupName == "DCH20") ? nearCol : white)
        f_set(28, "DCL20", f_lvl("DCL20", dcl), false, (nearestResName == "DCL20" or nearestSupName == "DCL20") ? nearCol : white)

        f_set(29, "Helpers", "", true, white)
        f_set(30, "Range context", rangeState, false, white)
        f_set(31, "RSI(14) context", rsiState, false, white)
        f_set(32, "ATR% slope(5) context", atrSlopeState, false, white)
        f_set(33, "", "", false, white)
