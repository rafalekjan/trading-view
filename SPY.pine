//@version=6
indicator("SPY Market Regime Dashboard", overlay=true)

// =====================
// VIX DATA
// =====================
vix = request.security("CBOE:VIX", timeframe.period, close)
vixEma5 = ta.ema(vix, 5)
vixEma20 = ta.ema(vix, 20)

vixTrend =
     vixEma5 > vixEma20 ? "Rising" :
     vixEma5 < vixEma20 ? "Falling" : "Flat"

vixLevel =
     vix < 20 ? "<20" :
     vix <= 25 ? "20-25" : ">25"

// =====================
// MARKET REGIME
// =====================
adx = ta.adx(14)
atr = ta.atr(14)
atrPerc = atr / close * 100

marketRegime =
     atrPerc > 2.5 ? "Volatile" :
     adx > 20 ? "Trending" : "Ranging"

// =====================
// VOLUME CONFIRMATION
// =====================
volAvg = ta.sma(volume, 20)
volConfirm = volume > volAvg ? "Yes" : "No"
volExpansion = volume > ta.highest(volume[1], 5) ? "Yes" : "No"

// =====================
// BREADTH (SPX % > 50 SMA)
// =====================
breadthRaw = request.security("USI:SPX50R", timeframe.period, close)
breadth =
     breadthRaw > 60 ? "Strong" :
     breadthRaw < 40 ? "Weak" : "Neutral"

// =====================
// COMPRESSION
// =====================
atrDeclining = atr < atr[1] and atr[1] < atr[2]
compression = atrDeclining ? "Yes" : "No"

// =====================
// PRICE EXPANSION
// =====================
range = high - low
bigCandle = range > atr * 1.5

closePos = (close - low) / (high - low)
expansion =
     bigCandle and closePos > 0.7 ? "Up" :
     bigCandle and closePos < 0.3 ? "Down" : "No"

// =====================
// TABLE DISPLAY
// =====================
var table dashboard = table.new(position.top_right, 2, 8, border_width=1)

if barstate.islast
    table.cell(dashboard, 0, 0, "Market Regime")
    table.cell(dashboard, 1, 0, marketRegime)

    table.cell(dashboard, 0, 1, "Volume >20D")
    table.cell(dashboard, 1, 1, volConfirm)

    table.cell(dashboard, 0, 2, "Volume Expansion")
    table.cell(dashboard, 1, 2, volExpansion)

    table.cell(dashboard, 0, 3, "VIX Trend")
    table.cell(dashboard, 1, 3, vixTrend)

    table.cell(dashboard, 0, 4, "VIX Level")
    table.cell(dashboard, 1, 4, vixLevel)

    table.cell(dashboard, 0, 5, "Breadth")
    table.cell(dashboard, 1, 5, breadth)

    table.cell(dashboard, 0, 6, "Compression")
    table.cell(dashboard, 1, 6, compression)

    table.cell(dashboard, 0, 7, "Price Expansion")
    table.cell(dashboard, 1, 7, expansion)
