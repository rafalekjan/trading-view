//@version=6
indicator("Stock Direction & Context", overlay=true)

//===================== INPUTS =====================
spySymbol  = input.symbol("AMEX:SPY", "SPY symbol")
vixSymbol  = input.symbol("CBOE:VIX", "VIX symbol")

// Breadth proxy: sectors above/below their SMA
b1  = input.symbol("AMEX:XLB", "Breadth #1")
b2  = input.symbol("AMEX:XLC", "Breadth #2")
b3  = input.symbol("AMEX:XLE", "Breadth #3")
b4  = input.symbol("AMEX:XLF", "Breadth #4")
b5  = input.symbol("AMEX:XLI", "Breadth #5")
b6  = input.symbol("AMEX:XLK", "Breadth #6")
b7  = input.symbol("AMEX:XLP", "Breadth #7")
b8  = input.symbol("AMEX:XLU", "Breadth #8")
b9  = input.symbol("AMEX:XLV", "Breadth #9")
b10 = input.symbol("AMEX:XLY", "Breadth #10")

breadthLen = input.int(50, "Breadth SMA length", minval=10)

pivL = input.int(3, "Pivot left", minval=1)
pivR = input.int(3, "Pivot right", minval=1)

atrLen = input.int(14, "ATR length", minval=5)
adxLen = input.int(14, "DMI length", minval=5)
adxSmooth = input.int(14, "DMI smoothing", minval=5)

volLookback = input.int(20, "Volume avg length", minval=5)
volExpBars  = input.int(5, "Volume expansion lookback", minval=2)

emaFastLen = input.int(21, "EMA fast", minval=5)
emaSlowLen = input.int(50, "EMA slow", minval=10)
sma200Len  = input.int(200, "SMA 200", minval=100)

rsEmaLen   = input.int(20, "RS EMA length", minval=5)

nearPctSR  = input.float(1.0, "Near level threshold (%)", step=0.1)
baseBars   = input.int(12, "Base detection bars", minval=5)
rangeN     = input.int(20, "Range break lookback", minval=10)

gapLookback = input.int(10, "Gap risk lookback", minval=5)

showTable = input.bool(true, "Show dashboard")
tableVisibility = input.int(35, "Dashboard visibility (0=solid, 100=hidden)", minval=0, maxval=100)

//===================== HELPERS =====================
f_clamp(x, lo, hi) => math.max(lo, math.min(hi, x))

f_aboveSMA(sym) =>
    c = request.security(sym, "D", close)
    s = request.security(sym, "D", ta.sma(close, breadthLen))
    na(c) or na(s) ? na : (c > s ? 1 : 0)

f_roomText(x) => x ? "Yes" : "No"

//===================== DAILY SERIES (CURRENT SYMBOL) =====================
dClose = request.security(syminfo.tickerid, "D", close)
dOpen  = request.security(syminfo.tickerid, "D", open)
dHigh  = request.security(syminfo.tickerid, "D", high)
dLow   = request.security(syminfo.tickerid, "D", low)
dVol   = request.security(syminfo.tickerid, "D", volume)

dEma21  = request.security(syminfo.tickerid, "D", ta.ema(close, emaFastLen))
dEma50  = request.security(syminfo.tickerid, "D", ta.ema(close, emaSlowLen))
dSma200 = request.security(syminfo.tickerid, "D", ta.sma(close, sma200Len))

dAtr = request.security(syminfo.tickerid, "D", ta.atr(atrLen))
[_, __, dAdx] = request.security(syminfo.tickerid, "D", ta.dmi(adxLen, adxSmooth))

// Volume confirmation
dVolAvg = request.security(syminfo.tickerid, "D", ta.sma(volume, volLookback))
volGt20d = dVol > dVolAvg
volExp = dVol > request.security(syminfo.tickerid, "D", ta.highest(volume[1], volExpBars))

//===================== MOMENTUM (confirmatory internal) =====================
rsi14 = request.security(syminfo.tickerid, "D", ta.rsi(close, 14))
[macdLine, macdSignal, macdHist] = request.security(syminfo.tickerid, "D", ta.macd(close, 12, 26, 9))

momBullScore = (rsi14 > 50 ? 1 : 0) + (macdLine > macdSignal ? 1 : 0) + (dEma21 > dEma50 ? 1 : 0)
momBearScore = (rsi14 < 50 ? 1 : 0) + (macdLine < macdSignal ? 1 : 0) + (dEma21 < dEma50 ? 1 : 0)
momentumBull = momBullScore >= 2
momentumBear = momBearScore >= 2

//===================== STRUCTURE (pivots) =====================
ph = ta.pivothigh(dHigh, pivL, pivR)
pl = ta.pivotlow(dLow, pivL, pivR)

lastPH = ta.valuewhen(not na(ph), ph, 0)
prevPH = ta.valuewhen(not na(ph), ph, 1)
lastPL = ta.valuewhen(not na(pl), pl, 0)
prevPL = ta.valuewhen(not na(pl), pl, 1)

isHH = not na(lastPH) and not na(prevPH) and lastPH > prevPH
isLH = not na(lastPH) and not na(prevPH) and lastPH < prevPH
isHL = not na(lastPL) and not na(prevPL) and lastPL > prevPL
isLL = not na(lastPL) and not na(prevPL) and lastPL < prevPL

structure = (isHH and isHL) ? "HH/HL" : (isLL and isLH) ? "LL/LH" : "Mixed"

//===================== BIAS (fast hybrid for 1D context) =====================
above200 = dClose > dSma200
bias =
     (structure == "HH/HL" and above200 and momentumBull) ? "Bullish" :
     (structure == "LL/LH" and not above200 and momentumBear) ? "Bearish" :
     // early flips (react quicker)
     (structure == "Mixed" and isLH and not above200 and momentumBear) ? "Bearish" :
     (structure == "Mixed" and isHL and above200 and momentumBull) ? "Bullish" :
     "Neutral"

//===================== TREND STATE / QUALITY / PHASE =====================
trendState =
     (bias == "Bullish" and isHL and above200) ? "Intact" :
     (bias == "Bearish" and isLH and not above200) ? "Intact" :
     (bias != "Neutral" and (momentumBull or momentumBear)) ? "Weakening" :
     "Broken"

atrContracting = dAtr < dAtr[1] and dAtr[1] < dAtr[2]
inBase = (ta.highest(dHigh, baseBars) - ta.lowest(dLow, baseBars)) / dClose * 100 < 3.0
trendQuality =
     (dAdx > 22 and not atrContracting and not inBase) ? "Clean" :
     (dAdx > 16 and not inBase) ? "Acceptable" :
     "Choppy"

// Phase: impulse/pullback/base (simple & robust)
pullback =
     (bias == "Bullish" and dClose < dEma21 and above200) ? true :
     (bias == "Bearish" and dClose > dEma21 and not above200) ? true :
     false
phase = inBase ? "Base" : pullback ? "Pullback" : "Impulse"

//===================== RS vs SPY =====================
spyClose = request.security(spySymbol, "D", close)
rs = spyClose == 0 ? na : dClose / spyClose
rsEma = ta.ema(rs, rsEmaLen)
rsSlope = rsEma > rsEma[1] ? 1 : rsEma < rsEma[1] ? -1 : 0

relative =
     na(rs) ? "Zrob sam" :
     rs > rsEma and rsSlope >= 0 ? "Strong vs SPY" :
     rs < rsEma and rsSlope <= 0 ? "Weak vs SPY" :
     "Neutral"

rsState =
     na(rs) ? "Zrob sam" :
     rsSlope > 0 ? "Improving" :
     rsSlope < 0 ? "Deteriorating" :
     "Stable"

// SPY alignment (direction match)
spyBiasQuick = request.security(spySymbol, "D",
     close > ta.sma(close, 200) ? "Bullish" : close < ta.sma(close, 200) ? "Bearish" : "Neutral")

spyAlignment =
     spyBiasQuick == "Neutral" or bias == "Neutral" ? "Diverging" :
     spyBiasQuick == bias ? "Aligned" : "Opposite"

//===================== VIX + BREADTH (macro wind proxy) =====================
vix = request.security(vixSymbol, "D", close)
vixEma5 = ta.ema(vix, 5)
vixEma20 = ta.ema(vix, 20)
vixTrend = vixEma5 > vixEma20 ? "Rising" : vixEma5 < vixEma20 ? "Falling" : "Flat"
vixLevel = vix < 20 ? "<20" : vix <= 25 ? "20-25" : ">25"

a1 = f_aboveSMA(b1), a2 = f_aboveSMA(b2), a3 = f_aboveSMA(b3), a4 = f_aboveSMA(b4), a5 = f_aboveSMA(b5)
a6 = f_aboveSMA(b6), a7 = f_aboveSMA(b7), a8 = f_aboveSMA(b8), a9 = f_aboveSMA(b9), a10 = f_aboveSMA(b10)

validCount = (na(a1)?0:1)+(na(a2)?0:1)+(na(a3)?0:1)+(na(a4)?0:1)+(na(a5)?0:1)+(na(a6)?0:1)+(na(a7)?0:1)+(na(a8)?0:1)+(na(a9)?0:1)+(na(a10)?0:1)
sumAbove = (na(a1)?0:a1)+(na(a2)?0:a2)+(na(a3)?0:a3)+(na(a4)?0:a4)+(na(a5)?0:a5)+(na(a6)?0:a6)+(na(a7)?0:a7)+(na(a8)?0:a8)+(na(a9)?0:a9)+(na(a10)?0:a10)
breadthPct = validCount == 0 ? na : (100.0 * sumAbove / validCount)
breadth =
     na(breadthPct) ? "Zrob sam" :
     breadthPct > 60 ? "Strong" :
     breadthPct < 40 ? "Weak" :
     "Neutral"

macroWind =
     (vixTrend == "Rising" and breadth == "Weak") ? "Headwind" :
     ((vixTrend == "Falling" or vixTrend == "Flat") and (breadth == "Neutral" or breadth == "Strong")) ? "Tailwind" :
     "Neutral"

//===================== GAP RISK =====================
gapAbs = math.abs(dOpen - dClose[1])
gapAtr = dAtr == 0 ? na : gapAbs / dAtr
gapAvg = ta.sma(gapAtr, gapLookback)

gapRisk =
     na(gapAvg) ? "Zrob sam" :
     gapAvg < 0.35 ? "Low" :
     gapAvg < 0.70 ? "Medium" :
     "High"

//===================== LEVEL POSITION (simple) =====================
dist200Pct = math.abs(dClose - dSma200) / dClose * 100
priorHigh = ta.highest(dHigh, rangeN)[1]
priorLow  = ta.lowest(dLow, rangeN)[1]
isRangeBreak = dClose > priorHigh or dClose < priorLow
levelPosition =
     isRangeBreak ? "Range break" :
     dist200Pct <= nearPctSR ? (dClose > dSma200 ? "Near support" : "Near resistance") :
     "Mid-range"

//===================== TABLE =====================
tblBg = color.new(color.black, tableVisibility)
tblKeyBg = color.new(color.silver, tableVisibility)
tblTxt = color.new(color.white, tableVisibility)
var table t = table.new(position.top_right, 2, 18, border_width=1, frame_color=color.new(color.white, tableVisibility))

f_row(r, k, v) =>
    table.cell(t, 0, r, k, text_halign=text.align_left, bgcolor=tblKeyBg, text_color=tblTxt)
    table.cell(t, 1, r, v, text_halign=text.align_left, bgcolor=tblBg, text_color=tblTxt)

if barstate.islast and showTable
    f_row(0, "SPY alignment", spyAlignment)
    f_row(1, "Macro wind", macroWind)
    f_row(2, "Bias", bias)
    f_row(3, "Relative vs SPY", relative + " (" + rsState + ")")
    f_row(4, "Structure", structure)
    f_row(5, "Trend state", trendState)
    f_row(6, "Trend quality", trendQuality)
    f_row(7, "Phase", phase)
    f_row(8, "200 SMA", above200 ? "Above" : "Below")
    f_row(9, "Volume >20D", f_roomText(volGt20d))
    f_row(10, "Volume expansion", f_roomText(volExp))
    f_row(11, "VIX", vixTrend + " | " + vixLevel)
    f_row(12, "Breadth", na(breadthPct) ? "Zrob sam" : (breadth + " (" + str.tostring(math.round(breadthPct)) + "%)"))
    f_row(13, "Gap risk", gapRisk)
    f_row(14, "Level position", levelPosition)
else if barstate.islast and not showTable
    table.clear(t, 0, 0, 1, 14)
